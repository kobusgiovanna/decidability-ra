/-- `primeBX`'s `i`-th `zBxx'`-write carries `vals[i]` (as
`rawNthWrite_primeAX_zAxx'_eq`). -/
theorem primeBXBlockWord_zBxx'_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeBXBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zBxx', OpType.wt => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX)
        , ⟨EventLabel.wt Tid.primeBX Loc.zBxx' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeBX Loc.zBx'x v, rfl⟩ ] ++ (primeBXBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zBxx', OpType.wt => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBX Loc.xB'
            (Val.primeTag Tid.primeBX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeBX))
          (by exact (by decide : ¬ (match Loc.xB', OpType.wt with
            | Loc.zBxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeBX Loc.zBxx' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX))
          (by exact (by decide : (match Loc.zBxx', OpType.wt with
            | Loc.zBxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeBX Loc.zBx'x v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX))
          (by exact (by decide : ¬ (match Loc.zBx'x, OpType.rd with
            | Loc.zBxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_singleton, List.length_cons, List.length_nil]
      omega

theorem rawNthWrite_primeBX_zBxx'_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeBX = primeBXBlockWord I vals)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.primeBX Loc.zBxx' i = some ew) :
    ∃ v, vals[i]? = some v ∧ ew.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeBX,
      (match lab.1.loc, lab.1.op with | Loc.zBxx', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zBxx' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeBX Loc.zBxx' OpType.wt).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBX)
    (x := Loc.zBxx') (op := OpType.wt) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeBX Loc.zBxx' OpType.wt).length = vals.length :=
    hlen.trans (primeBXBlockWord_zBxx'_length I vals)
  rw [hlen'] at hilt
  obtain ⟨v, hv⟩ : ∃ v, vals[i]? = some v := ⟨vals[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeBX)
      , ⟨EventLabel.wt Tid.primeBX Loc.zBxx' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeBX Loc.zBx'x l, rfl⟩ ])
    3 1
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zBxx', OpType.wt => true | _, _ => false)
    (fun l => (⟨EventLabel.wt Tid.primeBX Loc.zBxx' l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeBX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq02 : q = 0 ∨ q = 2 := by omega
      rcases hq02 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.xB', OpType.wt with
          | Loc.zBxx', OpType.wt => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zBx'x, OpType.rd with
          | Loc.zBxx', OpType.wt => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeBX)
    (l := primeBXBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeBX Loc.zBxx' OpType.wt i = some ew := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl

