/-- `checkYBlockRestElems` has one `yB`-write per entry of `kws`, at
offset `1`. -/
theorem checkYBlockRestElems_yB_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYBWritePred I)).length
