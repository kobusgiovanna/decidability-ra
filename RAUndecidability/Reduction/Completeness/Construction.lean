        rw [← hget] <;>
        unfold checkYYBWritePred
      · exact yBWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yBWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
      · exact yBWritePredCore_false_of_ne Loc.yB OpType.rd (by decide))

/-- `checkY`'s `i`-th `yB`-write (as `rawNthWrite_checkY_yA_eq`). -/
theorem rawNthWrite_checkY_yB_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.checkY Loc.yB i = some ew) :
    (i = 0 ∧ ew.val = Val.primeTag Tid.checkY 1) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.primeTag Tid.checkY (kw.1 + 1)) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yB) (op := OpType.wt)
    (predL := checkYYBWritePred I) htrace (checkYYBWritePred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYBWritePred I)).length
      = kws.length + 1 := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yB_filter,
      checkYBlockRestElems_yB_filter]
    simp only [List.length_cons, List.length_nil]
    omega
