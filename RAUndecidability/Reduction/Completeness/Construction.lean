        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])
        ++ (primeCheckYBlockWord I cs)).filter (primeCheckYYBReadPred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBReadPredCore_false_of_ne Loc.yA' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBReadPredCore_false_of_ne Loc.yB' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBReadPred
              exact (yBReadPredCore_iff Loc.yB OpType.rd).mpr ⟨rfl, rfl⟩),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

