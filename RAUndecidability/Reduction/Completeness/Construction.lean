/-- The chain shape of `GuessAY`'s loop, with the second components of `kws` determined (as
`checkXChain_shape_val`). -/
theorem guessAYChain_shape_val (I : PCPInstance) (ws : List (Fin I.n))
    (φ : (GuessAY.Vocab I).Store)
    (hfst : φ GuessAY.Vars.fst = Sum.inr (Sum.inr false))
    (k0 : Fin 4) (hcnt0 : φ GuessAY.Vars.cnt = Sum.inr (Sum.inl k0))
    (w0 : Fin I.n) (haux0 : φ GuessAY.Vars.aux = Sum.inl (some w0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessAY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAY.Vocab I)),
      kws.length = ws.length + 2 ∧
      (∀ n, n < kws.length → ∃ w, kws[n]? = some (⟨(k0.val + n) % 4, by omega⟩, w) ∧
        w = (w0 :: ws)[n]?) ∧
      Command.Run Tid.guessAY
        (ws.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none])
        (guessAYLoop I, φ) (kws.flatMap (guessAYBlockRestElems I))
        cLast [] (Command.skip, φ') := by
  induction ws generalizing φ k0 w0 with
  | nil =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessAY_blockRest_continue_step I w0 none [] φ hfst k0 hcnt0 haux0
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        guessAY_blockRest_break_step I [] φ1 hfst1 (k0 + 1) hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(k0, some w0), (k0 + 1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro n hn
      simp only [List.length_cons, List.length_nil] at hn
      have hn01 : n = 0 ∨ n = 1 := by omega
      rcases hn01 with rfl | rfl
      · refine ⟨some w0, ?_, rfl⟩
        simp only [List.getElem?_cons_zero]
        congr 2
        apply Fin.ext
        have hk0 := k0.isLt
        simp only [Nat.add_zero]
        omega
      · refine ⟨none, ?_, rfl⟩
        simp only [List.getElem?_cons_succ, List.getElem?_cons_zero]
        congr 2
  | cons w1 ws' ih =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessAY_blockRest_continue_step I w0 (some w1)
          (ws'.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none])
          φ hfst k0 hcnt0 haux0
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        ih (φ := φ1) (k0 := k0 + 1) (w0 := w1) hfst1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(k0, some w0) :: kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro n hn
      cases n with
      | zero =>
          refine ⟨some w0, ?_, rfl⟩
          simp only [List.getElem?_cons_zero]
          congr 2
          apply Fin.ext
          have hk0 := k0.isLt
          simp only [Nat.add_zero]
          omega
      | succ n' =>
          simp only [List.length_cons] at hn
          have hn' : n' < kws.length := by omega
          obtain ⟨w, hw, hweq⟩ := hval n' hn'
          refine ⟨w, ?_, ?_⟩
          · simp only [List.getElem?_cons_succ]
            rw [hw]
            congr 2
            apply Fin.ext
            simp [Fin.add_def]
            omega
          · simpa using hweq

/-- The shape of `GuessAY`'s loop, with the second components of `kws` determined. -/
theorem guessAY_shape_val (I : PCPInstance) (ws : List (Fin I.n)) (φ : (GuessAY.Vocab I).Store)
    (hfst : φ GuessAY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ GuessAY.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : Fin I.n) (haux0 : φ GuessAY.Vars.aux = Sum.inl (some v0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessAY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAY.Vocab I)),
      kws.length = ws.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = ws[i]?) ∧
      Command.Run Tid.guessAY
        (ws.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none])
        (guessAYLoop I, φ) (guessAYBlockWord I v0 kws)
        cLast [] (Command.skip, φ') := by
  match ws with
  | [] =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessAY_block0_step I v0 none [] φ hfst hcnt0 haux0
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        guessAY_blockRest_break_step I [] φ1 hfst1 1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      exact ⟨none, rfl, rfl⟩
  | w1 :: ws' =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessAY_block0_step I v0 (some w1)
          (ws'.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none])
          φ hfst hcnt0 haux0
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        guessAYChain_shape_val I ws' φ1 hfst1 1 hcnt1 w1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro i hi
      obtain ⟨w, hw, hweq⟩ := hval i hi
      exact ⟨w, hw, hweq⟩

/-- A term-reaching run of `GuessAY.program`, with the values drawn determined. -/
theorem guessAY_general_run_val (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessAY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAY.Vocab I)),
      kws.length = js.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = js[i]?) ∧
      Command.Run Tid.guessAY
        (Sum.inl (some j0) ::
          (js.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none]))
        (GuessAY.program I,
          (GuessAY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .fst => some (Sum.inr (Sum.inr true))
            | _ => none) (Sum.inl none))
        (guessAYBlockWord I j0 kws)
        cLast [] (Command.term, φ') := by
  set φ0 : (GuessAY.Vocab I).Store :=
    (GuessAY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr true))
      | _ => none) (Sum.inl none) with hφ0
  have hfst0 : φ0 GuessAY.Vars.fst = Sum.inr (Sum.inr true) := rfl
  have hcnt0 : φ0 GuessAY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hmem : (Sum.inl (some j0) : GuessAY.Vals I) ∈ GuessAY.auxSet I := by
    unfold GuessAY.auxSet
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨j0, rfl⟩
  set rest0 : List (GuessAY.Vals I) :=
    js.map (fun w => (Sum.inl (some w) : GuessAY.Vals I)) ++ [Sum.inl none] with hrest0
  have hstep1 : Command.RunStep Tid.guessAY (Sum.inl (some j0) :: rest0) none
      (⟨Command.ndetAssign GuessAY.Vars.aux (GuessAY.auxSet I) (GuessAY.auxSet_nonempty I),
        φ0⟩ : Config (domainOf I) (GuessAY.Vocab I))
      rest0
      ⟨Command.skip, Function.update φ0 GuessAY.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.guessAY (Sum.inl (some j0) :: rest0)
      (Command.ndetAssign GuessAY.Vars.aux (GuessAY.auxSet I) (GuessAY.auxSet_nonempty I), φ0)
      [] (Command.ndetAssign GuessAY.Vars.aux (GuessAY.auxSet I) (GuessAY.auxSet_nonempty I), φ0)
      rest0 ⟨Command.skip, Function.update φ0 GuessAY.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (Command.seq (guessAYLoop I) Command.term) hrun1
  set φ1 : (GuessAY.Vocab I).Store := Function.update φ0 GuessAY.Vars.aux (Sum.inl (some j0))
    with hφ1
  have hstep2 : Command.RunStep Tid.guessAY rest0 none
      (⟨Command.seq Command.skip (Command.seq (guessAYLoop I) Command.term), φ1⟩ :
        Config (domainOf I) (GuessAY.Vocab I))
      rest0 ⟨Command.seq (guessAYLoop I) Command.term, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have haux1 : φ1 GuessAY.Vars.aux = Sum.inl (some j0) := Function.update_self _ _ _
  have hne_fst_aux : GuessAY.Vars.fst ≠ GuessAY.Vars.aux := by decide
  have hne_cnt_aux : GuessAY.Vars.cnt ≠ GuessAY.Vars.aux := by decide
  have hfst1 : φ1 GuessAY.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne_fst_aux (Sum.inl (some j0)) φ0).trans hfst0
  have hcnt1 : φ1 GuessAY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cnt_aux (Sum.inl (some j0)) φ0).trans hcnt0
  obtain ⟨kws, φ', cLastL, hlen, hval, hrun3⟩ :=
    guessAY_shape_val I js φ1 hfst1 hcnt1 j0 haux1
  have hrun3' := Command.Run.seqCongr Command.term hrun3
  obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun2 hrun3'
  have hstep4 : Command.RunStep Tid.guessAY ([] : List (GuessAY.Vals I)) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (GuessAY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨kws, φ', cLast, hlen, hval, Command.Run.silentSnoc hcomb hstep4⟩

/-! ## `rf_matches`: `guessAY`/`primeAY` `zAyy'` (Eq. (15)) -/

/-- The `zAyy'`-writes of `primeAYBlockWord`: one per entry of `vals`, at
offset `1` of its block. -/
theorem primeAYBlockWord_zAyy'_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeAYBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zAyy', OpType.wt => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY)
        , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y v, rfl⟩ ] ++ (primeAYBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zAyy', OpType.wt => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeAY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : ¬ (match Loc.yA', OpType.wt with
            | Loc.zAyy', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeAY Loc.zAyy' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : (match Loc.zAyy', OpType.wt with
            | Loc.zAyy', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeAY Loc.zAy'y v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : ¬ (match Loc.zAy'y, OpType.rd with
            | Loc.zAyy', OpType.wt => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `primeAY`'s `i`-th `zAyy'`-write in a trace with
`trace Tid.primeAY = primeAYBlockWord I vals` carries `vals[i]`. -/
theorem rawNthWrite_primeAY_zAyy'_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeAY = primeAYBlockWord I vals)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.primeAY Loc.zAyy' i = some ew) :
    ∃ v, vals[i]? = some v ∧ ew.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeAY,
      (match lab.1.loc, lab.1.op with | Loc.zAyy', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zAyy' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeAY Loc.zAyy' OpType.wt).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAY)
    (x := Loc.zAyy') (op := OpType.wt) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeAY Loc.zAyy' OpType.wt).length = vals.length :=
    hlen.trans (primeAYBlockWord_zAyy'_length I vals)
  rw [hlen'] at hilt
  obtain ⟨v, hv⟩ : ∃ v, vals[i]? = some v := ⟨vals[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeAY)
      , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y l, rfl⟩ ])
    3 1
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zAyy', OpType.wt => true | _, _ => false)
    (fun l => (⟨EventLabel.wt Tid.primeAY Loc.zAyy' l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeAY))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq02 : q = 0 ∨ q = 2 := by omega
      rcases hq02 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.yA', OpType.wt with
          | Loc.zAyy', OpType.wt => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zAy'y, OpType.rd with
          | Loc.zAyy', OpType.wt => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeAY)
    (l := primeAYBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeAY Loc.zAyy' OpType.wt i = some ew := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl

def zAyy'ReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zAyy', OpType.rd => true | _, _ => false

theorem zAyy'ReadPredCore_iff (y : Loc) (z : OpType) :
    zAyy'ReadPredCore y z = true ↔ (y = Loc.zAyy' ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem zAyy'ReadPredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.zAyy' ∧ z = OpType.rd)) :
    zAyy'ReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)


def guessAYZAyReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) : Bool :=
  zAyy'ReadPredCore lab.1.loc lab.1.op

theorem guessAYZAyReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    guessAYZAyReadPred I lab = true ↔ (lab.1.loc = Loc.zAyy' ∧ lab.1.op = OpType.rd) := by
  unfold guessAYZAyReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact zAyy'ReadPredCore_iff y z

/-- `guessAYBlock0Elems` has no reads. -/
theorem guessAYBlock0Elems_zAyy'_filter (I : PCPInstance) (v0 : Fin I.n) :
    (guessAYBlock0Elems I v0).filter (guessAYZAyReadPred I) = [] := by
  show List.filter (guessAYZAyReadPred I)
      [ (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY)
    , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩
    , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ ]
      = ([] : List (ThreadLabel (domainOf I) Tid.guessAY))
  rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.guessAY Loc.yA
      (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.guessAY))
    (by unfold guessAYZAyReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          zAyy'ReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.guessAY Loc.ellAyx
      (Val.cntAux 1 (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.guessAY))
    (by unfold guessAYZAyReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          zAyy'ReadPredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.guessAY))
    (by unfold guessAYZAyReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          zAyy'ReadPredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)),
    List.filter_nil]

theorem guessAYBlockRestElems_zAyy'_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (guessAYBlockRestElems I)).filter (guessAYZAyReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessAYBlockRestElems I kw) ++ kws.flatMap (guessAYBlockRestElems I)).filter
        (guessAYZAyReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessAYBlockRestElems I kw).filter (guessAYZAyReadPred I) =
          [(⟨EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAY)] := by
        apply list_filter_singleton_of_unique' (guessAYBlockRestElems I kw)
          (guessAYZAyReadPred I) 4
          (⟨EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt kw.1), rfl⟩)
          rfl
          (by unfold guessAYZAyReadPred
              exact (zAyy'ReadPredCore_iff Loc.zAyy' OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
            have hq4 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 := by omega
            rcases hq4 with rfl | rfl | rfl | rfl <;>
              simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold guessAYZAyReadPred
            · exact zAyy'ReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact zAyy'ReadPredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
            · exact zAyy'ReadPredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
            · exact zAyy'ReadPredCore_false_of_ne Loc.zAxy OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_guessAY_zAyy'_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.guessAY Loc.zAyy' i = some er) :
    ∃ kw, kws[i]? = some kw ∧ er.val = Val.cnt kw.1 := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.zAyy') (op := OpType.rd)
    (predL := guessAYZAyReadPred I) htrace (guessAYZAyReadPred_iff I)
  have hlen2 : ((guessAYBlockWord I v0 kws).filter (guessAYZAyReadPred I)).length
      = kws.length := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_zAyy'_filter,
      guessAYBlockRestElems_zAyy'_filter]
    simp
  have hilt : i < kws.length :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  obtain ⟨kw, hkw⟩ : ∃ kw, kws[i]? = some kw := ⟨kws[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfiltrest := zipIdx_flatMap_filter_getElem
    (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessAY)
    (guessAYBlockRestElems I) 5 4
    (fun kw => rfl)
    (guessAYZAyReadPred I)
    (fun kw => (⟨EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt kw.1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.guessAY))
    (fun a => rfl)
    (fun a => by
      unfold guessAYZAyReadPred
      exact (zAyy'ReadPredCore_iff Loc.zAyy' OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro a q b hq hget
      have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
      have hq4 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq4 with rfl | rfl | rfl | rfl <;>
        simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessAYZAyReadPred
      · exact zAyy'ReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact zAyy'ReadPredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
      · exact zAyy'ReadPredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
      · exact zAyy'ReadPredCore_false_of_ne Loc.zAxy OpType.rd (by decide))
    kws 3 i kw hkw
  have hz0 : (((guessAYBlock0Elems I v0).zipIdx).filter
      (fun p => guessAYZAyReadPred I p.1)) = [] := by
    show List.filter (fun p => guessAYZAyReadPred I p.1)
      (List.zipIdx
        [ (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY)
      , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩
      , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ ])
      = ([] : List (ThreadLabel (domainOf I) Tid.guessAY × ℕ))
    rfl
  have hzip : (guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYZAyReadPred I p.1) =
      ((kws.flatMap (guessAYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessAYZAyReadPred I p.1) := by
    unfold guessAYBlockWord
