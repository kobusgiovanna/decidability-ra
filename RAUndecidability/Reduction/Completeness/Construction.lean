        (checkXXBReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkXBlockRestElems I kw).filter (checkXXBReadPred I) =
          [(⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, false) kw.2), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkX)] := by
        apply list_filter_singleton_of_unique' (checkXBlockRestElems I kw) (checkXXBReadPred I) 3
          (⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, false) kw.2), rfl⟩)
          rfl
          (by unfold checkXXBReadPred
              exact (xBReadPredCore_iff Loc.xB OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkXXBReadPred
            · exact xBReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
            · exact xBReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
            · exact xBReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)
            · exact xBReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)
            · exact xBReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem checkXBlock0Elems_xB_read_zipIdx_filter (I : PCPInstance) (v0 : I.Γ) (k : ℕ) :
    (((checkXBlock0Elems I v0).zipIdx k).filter (fun p => checkXXBReadPred I p.1)) =
      [((⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), k + 3)] := by
  apply list_filter_singleton_of_unique' ((checkXBlock0Elems I v0).zipIdx k)
    (fun p => checkXXBReadPred I p.1) 3
    ((⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX), k + 3)
    (by rw [List.getElem?_zipIdx]; rfl)
    (by unfold checkXXBReadPred; exact (xBReadPredCore_iff Loc.xB OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      rw [List.getElem?_zipIdx] at hget
      have hqlt : q < 4 := by
        rcases Nat.lt_or_ge q 4 with hqlt | hqge
        · exact hqlt
        · exfalso
          have hqge4 : (checkXBlock0Elems I v0).length ≤ q := by
            simp only [checkXBlock0Elems, List.length_cons, List.length_nil]
            omega
          have : (checkXBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge4
          rw [this] at hget
          simp at hget
      have hq3 : q = 0 ∨ q = 1 ∨ q = 2 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkXBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.map_some, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkXXBReadPred
      · exact xBReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xA OpType.rd (by decide))

/-- `checkX`'s `i`-th `xB`-read: for `i = 0` it expects `v0` (tag `true`), for
`i ≥ 1` the second component of `kws[i-1]` (tag `false`). -/
theorem rawNthRead_checkX_xB_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkX Loc.xB i = some er) :
    (i = 0 ∧ er.val = Val.xTag (Tid.guessBX, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ er.val = Val.xTag (Tid.guessBX, false) kw.2) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xB) (op := OpType.rd)
    (predL := checkXXBReadPred I) htrace (checkXXBReadPred_iff I)
  have hlen2 : ((checkXBlockWord I v0 kws).filter (checkXXBReadPred I)).length
      = kws.length + 1 := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xB_read_filter,
      checkXBlockRestElems_xB_read_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXBReadPred I p.1) =
      [((⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 3)] ++
      ((kws.flatMap (checkXBlockRestElems I)).zipIdx 4).filter
        (fun p => checkXXBReadPred I p.1) := by
    unfold checkXBlockWord
    rw [List.zipIdx_append, List.filter_append, checkXBlock0Elems_xB_read_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXBReadPred_iff I)
      (n := 0) (lab := (⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true)
        (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX)) (origPos := 3)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkX Loc.xB OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option I.Γ) (β := ThreadLabel (domainOf I) Tid.checkX)
      (checkXBlockRestElems I) 6 3
      (fun kw => rfl)
      (checkXXBReadPred I)
      (fun kw => (⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX))
      (fun a => rfl)
      (fun a => by
        unfold checkXXBReadPred
        exact (xBReadPredCore_iff Loc.xB OpType.rd).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkXXBReadPred
        · exact xBReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
        · exact xBReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
        · exact xBReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)
        · exact xBReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)
        · exact xBReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXBReadPred I p.1))[i]?
        = some ((⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 4 + j * 6 + 3) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXBReadPred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkX Loc.xB OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-! ## `rf_matches`: `primeCheckX`/`checkX` `xA'` (Eq. (16))

`primeCheckX` writes `xA'` (offset `0` of its block) and `checkX` reads it
back, only in iterations after the first (offset `4` of
`checkXBlockRestElems`; `checkXBlock0Elems` has no primed reads). -/

/-- The `xA'`-write match, as a predicate on `Loc`/`OpType` alone. -/
def xAprimeWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xA', OpType.wt => true | _, _ => false

theorem xAprimeWritePredCore_iff (y : Loc) (z : OpType) :
    xAprimeWritePredCore y z = true ↔ (y = Loc.xA' ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem xAprimeWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.xA' ∧ z = OpType.wt)) :
    xAprimeWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

def primeCheckXXAprimeWritePred (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckX) : Bool :=
  xAprimeWritePredCore lab.1.loc lab.1.op

theorem primeCheckXXAprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckX) :
    primeCheckXXAprimeWritePred I lab = true ↔ (lab.1.loc = Loc.xA' ∧ lab.1.op = OpType.wt) := by
  unfold primeCheckXXAprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xAprimeWritePredCore_iff y z

theorem primeCheckXBlockWord_xAprimewrite_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckXBlockWord I cnts).filter (primeCheckXXAprimeWritePred I)).length
      = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckX)
        , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
        ++ (primeCheckXBlockWord I cs)).filter (primeCheckXXAprimeWritePred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              exact (xAprimeWritePredCore_iff Loc.xA' OpType.wt).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xAprimeWritePredCore_false_of_ne Loc.xB' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeAX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xAprimeWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeBX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xAprimeWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xAprimeWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xAprimeWritePredCore_false_of_ne Loc.xB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthWrite_primeCheckX_xAprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.primeCheckX Loc.xA' i = some ew) :
    ∃ c, cnts[i]? = some c ∧ ew.val = Val.primeTag Tid.primeCheckX c := by
  have hilt : i < (rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.wt).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xA') (op := OpType.wt)
    (predL := primeCheckXXAprimeWritePred I) htrace (primeCheckXXAprimeWritePred_iff I)
  have hlen' : (rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.wt).length = cnts.length :=
    hlen.trans (primeCheckXBlockWord_xAprimewrite_length I cnts)
  rw [hlen'] at hilt
  obtain ⟨c, hc⟩ : ∃ c, cnts[i]? = some c := ⟨cnts[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (α := Fin 4) (β := ThreadLabel (domainOf I) Tid.primeCheckX)
    (fun c =>
      [ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeCheckX)
      , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
    6 0
    (fun _ => rfl)
    (primeCheckXXAprimeWritePred I)
    (fun c => (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold primeCheckXXAprimeWritePred
      · exact xAprimeWritePredCore_false_of_ne Loc.xB' OpType.wt (by decide)
      · exact xAprimeWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)
      · exact xAprimeWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide)
      · exact xAprimeWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
      · exact xAprimeWritePredCore_false_of_ne Loc.xB OpType.rd (by decide))
    cnts 0 i c hc
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeCheckX)
    (l := primeCheckXBlockWord I cnts) htrace (primeCheckXXAprimeWritePred_iff I) hfilt
  have hraw : rawNthEvent trace Tid.primeCheckX Loc.xA' OpType.wt i = some ew := h
  rw [hraw] at hconn
  exact ⟨c, hc, by injection hconn with hconn; rw [hconn]; rfl⟩



