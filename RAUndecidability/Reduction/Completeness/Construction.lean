def guessAYZAxyReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) : Bool :=
  zAxyReadPredCore lab.1.loc lab.1.op

theorem guessAYZAxyReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    guessAYZAxyReadPred I lab = true ↔ (lab.1.loc = Loc.zAxy ∧ lab.1.op = OpType.rd) := by
  unfold guessAYZAxyReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
