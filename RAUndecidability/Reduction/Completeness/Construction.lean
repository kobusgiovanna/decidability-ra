    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBWritePred I p.1) =
      [((⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 1)] ++
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYBWritePred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, checkYBlock0Elems_yB_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYBWritePred_iff I)
      (n := 0) (lab := (⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)) (origPos := 1)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkY Loc.yB OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
      (checkYBlockRestElems I) 6 1
      (fun kw => rfl)
      (checkYYBWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY))
      (fun a => rfl)
      (fun a => by
        unfold checkYYBWritePred
        exact (yBWritePredCore_iff Loc.yB OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 0 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkYYBWritePred
        · exact yBWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact yBWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
        · exact yBWritePredCore_false_of_ne Loc.yB OpType.rd (by decide)
        · exact yBWritePredCore_false_of_ne Loc.yA' OpType.rd (by decide)
        · exact yBWritePredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 4 + j * 6 + 1) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYBWritePred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkY Loc.yB OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `primeCheckYBlockWord` has one `yB`-read per entry of `cnts` (offset `5`). -/
theorem primeCheckYBlockWord_yB_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckYBlockWord I cnts).filter (primeCheckYYBReadPred I)).length = cnts.length := by
  induction cnts with
