/-- The word of `guessBY_block0_step`. -/
def guessBYBlock0Elems (I : PCPInstance) (v0 : Fin I.n) :
    List (ThreadLabel (domainOf I) Tid.guessBY) :=
  [ ⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩
  , ⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩
  , ⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ ]

/-- `GuessBY`'s events in an iteration after the first, with counter `k` and
`aux = w`. -/
def guessBYBlockRestElems (I : PCPInstance) (kw : Fin 4 × Option (Fin I.n)) :
    List (ThreadLabel (domainOf I) Tid.guessBY) :=
  [ ⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩
  , ⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux (kw.1 + 1) kw.2), rfl⟩
  , ⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.rd Tid.guessBY Loc.zBxy (Val.cnt kw.1), rfl⟩
  , ⟨EventLabel.rd Tid.guessBY Loc.zByy' (Val.cnt kw.1), rfl⟩ ]

/-- The word of `guessBYLoop`: block 0, then one `guessBYBlockRestElems` block
per entry of `kws`. -/
def guessBYBlockWord (I : PCPInstance) (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n))) :
    Word (ThreadLabel (domainOf I) Tid.guessBY) :=
  guessBYBlock0Elems I v0 ++ kws.flatMap (guessBYBlockRestElems I)

/-! ## `GuessBY`'s whole run -/

/-- The chain shape of `GuessBY`'s loop, with the second components of `kws` determined. -/
theorem guessBYChain_shape_val (I : PCPInstance) (ws : List (Fin I.n))
    (φ : (GuessBY.Vocab I).Store)
    (hfst : φ GuessBY.Vars.fst = Sum.inr (Sum.inr false))
    (k0 : Fin 4) (hcnt0 : φ GuessBY.Vars.cnt = Sum.inr (Sum.inl k0))
    (w0 : Fin I.n) (haux0 : φ GuessBY.Vars.aux = Sum.inl (some w0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessBY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessBY.Vocab I)),
      kws.length = ws.length + 2 ∧
      (∀ n, n < kws.length → ∃ w, kws[n]? = some (⟨(k0.val + n) % 4, by omega⟩, w) ∧
        w = (w0 :: ws)[n]?) ∧
      Command.Run Tid.guessBY
        (ws.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none])
        (guessBYLoop I, φ) (kws.flatMap (guessBYBlockRestElems I))
        cLast [] (Command.skip, φ') := by
  induction ws generalizing φ k0 w0 with
  | nil =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessBY_blockRest_continue_step I w0 none [] φ hfst k0 hcnt0 haux0
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        guessBY_blockRest_break_step I [] φ1 hfst1 (k0 + 1) hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(k0, some w0), (k0 + 1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro n hn
      simp only [List.length_cons, List.length_nil] at hn
      have hn01 : n = 0 ∨ n = 1 := by omega
      rcases hn01 with rfl | rfl
      · refine ⟨some w0, ?_, rfl⟩
        simp only [List.getElem?_cons_zero]
        congr 2
        apply Fin.ext
        have hk0 := k0.isLt
        simp only [Nat.add_zero]
        omega
      · refine ⟨none, ?_, rfl⟩
        simp only [List.getElem?_cons_succ, List.getElem?_cons_zero]
        congr 2
  | cons w1 ws' ih =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessBY_blockRest_continue_step I w0 (some w1)
          (ws'.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none])
          φ hfst k0 hcnt0 haux0
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        ih (φ := φ1) (k0 := k0 + 1) (w0 := w1) hfst1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(k0, some w0) :: kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro n hn
      cases n with
      | zero =>
          refine ⟨some w0, ?_, rfl⟩
          simp only [List.getElem?_cons_zero]
          congr 2
          apply Fin.ext
          have hk0 := k0.isLt
          simp only [Nat.add_zero]
          omega
      | succ n' =>
          simp only [List.length_cons] at hn
          have hn' : n' < kws.length := by omega
          obtain ⟨w, hw, hweq⟩ := hval n' hn'
          refine ⟨w, ?_, ?_⟩
          · simp only [List.getElem?_cons_succ]
            rw [hw]
            congr 2
            apply Fin.ext
            simp [Fin.add_def]
            omega
          · simpa using hweq

/-- The shape of `GuessBY`'s loop, with the second components of `kws` determined. -/
theorem guessBY_shape_val (I : PCPInstance) (ws : List (Fin I.n)) (φ : (GuessBY.Vocab I).Store)
    (hfst : φ GuessBY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ GuessBY.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : Fin I.n) (haux0 : φ GuessBY.Vars.aux = Sum.inl (some v0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessBY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessBY.Vocab I)),
      kws.length = ws.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = ws[i]?) ∧
      Command.Run Tid.guessBY
        (ws.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none])
        (guessBYLoop I, φ) (guessBYBlockWord I v0 kws)
        cLast [] (Command.skip, φ') := by
  match ws with
  | [] =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessBY_block0_step I v0 none [] φ hfst hcnt0 haux0
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        guessBY_blockRest_break_step I [] φ1 hfst1 1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      exact ⟨none, rfl, rfl⟩
  | w1 :: ws' =>
      obtain ⟨φ1, cLast1, haux1, hfst1, hcnt1, hrun1⟩ :=
        guessBY_block0_step I v0 (some w1)
          (ws'.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none])
          φ hfst hcnt0 haux0
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        guessBYChain_shape_val I ws' φ1 hfst1 1 hcnt1 w1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro i hi
      obtain ⟨w, hw, hweq⟩ := hval i hi
      exact ⟨w, hw, hweq⟩

/-- A term-reaching run of `GuessBY.program`, with the values drawn determined. -/
theorem guessBY_general_run_val (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (GuessBY.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessBY.Vocab I)),
      kws.length = js.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = js[i]?) ∧
      Command.Run Tid.guessBY
        (Sum.inl (some j0) ::
          (js.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none]))
        (GuessBY.program I,
          (GuessBY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .fst => some (Sum.inr (Sum.inr true))
            | _ => none) (Sum.inl none))
        (guessBYBlockWord I j0 kws)
        cLast [] (Command.term, φ') := by
  set φ0 : (GuessBY.Vocab I).Store :=
    (GuessBY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr true))
      | _ => none) (Sum.inl none) with hφ0
  have hfst0 : φ0 GuessBY.Vars.fst = Sum.inr (Sum.inr true) := rfl
  have hcnt0 : φ0 GuessBY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hmem : (Sum.inl (some j0) : GuessBY.Vals I) ∈ GuessBY.auxSet I := by
    unfold GuessBY.auxSet
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨j0, rfl⟩
  set rest0 : List (GuessBY.Vals I) :=
    js.map (fun w => (Sum.inl (some w) : GuessBY.Vals I)) ++ [Sum.inl none] with hrest0
  have hstep1 : Command.RunStep Tid.guessBY (Sum.inl (some j0) :: rest0) none
      (⟨Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSet I) (GuessBY.auxSet_nonempty I),
        φ0⟩ : Config (domainOf I) (GuessBY.Vocab I))
      rest0
      ⟨Command.skip, Function.update φ0 GuessBY.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.guessBY (Sum.inl (some j0) :: rest0)
      (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSet I) (GuessBY.auxSet_nonempty I), φ0)
      [] (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSet I) (GuessBY.auxSet_nonempty I), φ0)
      rest0 ⟨Command.skip, Function.update φ0 GuessBY.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (Command.seq (guessBYLoop I) Command.term) hrun1
  set φ1 : (GuessBY.Vocab I).Store := Function.update φ0 GuessBY.Vars.aux (Sum.inl (some j0))
    with hφ1
  have hstep2 : Command.RunStep Tid.guessBY rest0 none
      (⟨Command.seq Command.skip (Command.seq (guessBYLoop I) Command.term), φ1⟩ :
        Config (domainOf I) (GuessBY.Vocab I))
      rest0 ⟨Command.seq (guessBYLoop I) Command.term, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have haux1 : φ1 GuessBY.Vars.aux = Sum.inl (some j0) := Function.update_self _ _ _
  have hne_fst_aux : GuessBY.Vars.fst ≠ GuessBY.Vars.aux := by decide
  have hne_cnt_aux : GuessBY.Vars.cnt ≠ GuessBY.Vars.aux := by decide
  have hfst1 : φ1 GuessBY.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne_fst_aux (Sum.inl (some j0)) φ0).trans hfst0
  have hcnt1 : φ1 GuessBY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cnt_aux (Sum.inl (some j0)) φ0).trans hcnt0
  obtain ⟨kws, φ', cLastL, hlen, hval, hrun3⟩ :=
    guessBY_shape_val I js φ1 hfst1 hcnt1 j0 haux1
  have hrun3' := Command.Run.seqCongr Command.term hrun3
  obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun2 hrun3'
  have hstep4 : Command.RunStep Tid.guessBY ([] : List (GuessBY.Vals I)) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (GuessBY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨kws, φ', cLast, hlen, hval, Command.Run.silentSnoc hcomb hstep4⟩

/-! ## `rf_matches`: `guessBY`/`primeBY` `zByy'` (Eq. (15)) -/

/-- The `zByy'`-writes of `primeBYBlockWord`: one per entry of `vals`, at
offset `1` of its block. -/
theorem primeBYBlockWord_zByy'_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeBYBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zByy', OpType.wt => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY)
        , ⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ ] ++ (primeBYBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zByy', OpType.wt => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : ¬ (match Loc.yB', OpType.wt with
            | Loc.zByy', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : (match Loc.zByy', OpType.wt with
            | Loc.zByy', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : ¬ (match Loc.zBy'y, OpType.rd with
            | Loc.zByy', OpType.wt => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `primeBY`'s `i`-th `zByy'`-write carries `vals[i]`. -/
theorem rawNthWrite_primeBY_zByy'_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeBY = primeBYBlockWord I vals)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.primeBY Loc.zByy' i = some ew) :
    ∃ v, vals[i]? = some v ∧ ew.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeBY,
      (match lab.1.loc, lab.1.op with | Loc.zByy', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zByy' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeBY Loc.zByy' OpType.wt).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBY)
    (x := Loc.zByy') (op := OpType.wt) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeBY Loc.zByy' OpType.wt).length = vals.length :=
