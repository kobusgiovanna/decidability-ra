/-- The word of `checkX_block0_step`. -/
def checkXBlock0Elems (I : PCPInstance) (v0 : I.Γ) :
    List (ThreadLabel (domainOf I) Tid.checkX) :=
  [ ⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩
  , ⟨EventLabel.wt Tid.checkX Loc.xB (Val.primeTag Tid.checkX 1), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ ]

/-- The word of `checkXLoop`: block 0, then one `checkXBlockRestElems` block
per entry of `kws`. -/
def checkXBlockWord (I : PCPInstance) (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ)) :
    Word (ThreadLabel (domainOf I) Tid.checkX) :=
  checkXBlock0Elems I v0 ++ kws.flatMap (checkXBlockRestElems I)

/-! ## `CheckX`'s whole run -/

/-- The chain shape of `CheckX`'s loop (blocks after block 0), with the second
components of `kws` determined:
`kws[n].2 = (w0 :: ws)[n]?`, the letter read at position `n`. -/
theorem checkXChain_shape_val (I : PCPInstance) (ws : List I.Γ) (φ : (CheckX.Vocab I).Store)
    (hfst : φ CheckX.Vars.fst = Sum.inr (Sum.inr false))
    (k0 : Fin 4) (hcnt0 : φ CheckX.Vars.cnt = Sum.inr (Sum.inl k0))
    (w0 : I.Γ) (haux0 : φ CheckX.Vars.aux = Sum.inl (some w0)) :
    ∃ (kws : List (Fin 4 × Option I.Γ)) (φ' : (CheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckX.Vocab I)),
      kws.length = ws.length + 2 ∧
      (∀ n, n < kws.length → ∃ w, kws[n]? = some (⟨(k0.val + n) % 4, by omega⟩, w) ∧
        w = (w0 :: ws)[n]?) ∧
      Command.Run Tid.checkX
        (ws.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none])
        (checkXLoop I, φ) (kws.flatMap (checkXBlockRestElems I))
        cLast [] (Command.skip, φ') := by
  induction ws generalizing φ k0 w0 with
  | nil =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkX_blockRest_continue_step I (Sum.inl none) [] φ hfst k0 hcnt0 w0 haux0 (by
          simp only [CheckX.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
          exact ⟨none, rfl⟩)
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        checkX_blockRest_break_step I [] φ1 hfst1 (k0 + 1) hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(k0, some w0), (k0 + 1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro n hn
      simp only [List.length_cons, List.length_nil] at hn
      have hn01 : n = 0 ∨ n = 1 := by omega
      rcases hn01 with rfl | rfl
      · refine ⟨some w0, ?_, rfl⟩
        simp only [List.getElem?_cons_zero]
        congr 2
        apply Fin.ext
        have hk0 := k0.isLt
        simp only [Nat.add_zero]
        omega
      · refine ⟨none, ?_, rfl⟩
        simp only [List.getElem?_cons_succ, List.getElem?_cons_zero]
        congr 2
  | cons w1 ws' ih =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkX_blockRest_continue_step I (Sum.inl (some w1))
          (ws'.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none])
          φ hfst k0 hcnt0 w0 haux0 (by
            simp only [CheckX.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
            exact ⟨some w1, rfl⟩)
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        ih (φ := φ1) (k0 := k0 + 1) (w0 := w1) hfst1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(k0, some w0) :: kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro n hn
      cases n with
      | zero =>
          refine ⟨some w0, ?_, rfl⟩
          simp only [List.getElem?_cons_zero]
          congr 2
          apply Fin.ext
          have hk0 := k0.isLt
          simp only [Nat.add_zero]
          omega
      | succ n' =>
          simp only [List.length_cons] at hn
          have hn' : n' < kws.length := by omega
          obtain ⟨w, hw, hweq⟩ := hval n' hn'
          refine ⟨w, ?_, ?_⟩
          · simp only [List.getElem?_cons_succ]
            rw [hw]
            congr 2
            apply Fin.ext
            simp [Fin.add_def]
            omega
          · simpa using hweq

/-- The shape of `CheckX`'s loop, with the second components of `kws` determined:
`kws[i].2 = ws[i]?`. -/
theorem checkX_shape_val (I : PCPInstance) (ws : List I.Γ) (φ : (CheckX.Vocab I).Store)
    (hfst : φ CheckX.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ CheckX.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : I.Γ) (haux0 : φ CheckX.Vars.aux = Sum.inl (some v0)) :
    ∃ (kws : List (Fin 4 × Option I.Γ)) (φ' : (CheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckX.Vocab I)),
      kws.length = ws.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = ws[i]?) ∧
      Command.Run Tid.checkX
        (ws.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none])
        (checkXLoop I, φ) (checkXBlockWord I v0 kws)
        cLast [] (Command.skip, φ') := by
  match ws with
  | [] =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkX_block0_step I (Sum.inl none) [] φ hfst hcnt0 v0 haux0 (by
          simp only [CheckX.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
          exact ⟨none, rfl⟩)
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        checkX_blockRest_break_step I [] φ1 hfst1 1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      exact ⟨none, rfl, rfl⟩
  | w1 :: ws' =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkX_block0_step I (Sum.inl (some w1))
          (ws'.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none])
          φ hfst hcnt0 v0 haux0 (by
            simp only [CheckX.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
            exact ⟨some w1, rfl⟩)
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        checkXChain_shape_val I ws' φ1 hfst1 1 hcnt1 w1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro i hi
      obtain ⟨w, hw, hweq⟩ := hval i hi
      exact ⟨w, hw, hweq⟩

/-- A term-reaching run of `CheckX.program`, with the letters read determined: `checkX`'s
`i`-th read carries `ws[i]?`. -/
theorem checkX_general_run_val (I : PCPInstance) (v0 : I.Γ) (js : List I.Γ) :
    ∃ (kws : List (Fin 4 × Option I.Γ)) (φ' : (CheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckX.Vocab I)),
      kws.length = js.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = js[i]?) ∧
      Command.Run Tid.checkX
        (Sum.inl (some v0) ::
          (js.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none]))
        (CheckX.program I,
          (CheckX.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .fst => some (Sum.inr (Sum.inr true))
            | _ => none) (Sum.inl none))
        (checkXBlockWord I v0 kws)
        cLast [] (Command.term, φ') := by
  set φ0 : (CheckX.Vocab I).Store :=
    (CheckX.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr true))
      | _ => none) (Sum.inl none) with hφ0
  have hfst0 : φ0 CheckX.Vars.fst = Sum.inr (Sum.inr true) := rfl
  have hcnt0 : φ0 CheckX.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hmem : (Sum.inl (some v0) : CheckX.Vals I) ∈ CheckX.auxSet I := by
    unfold CheckX.auxSet
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨v0, rfl⟩
  set rest0 : List (CheckX.Vals I) :=
    js.map (fun w => (Sum.inl (some w) : CheckX.Vals I)) ++ [Sum.inl none] with hrest0
  have hstep1 : Command.RunStep Tid.checkX (Sum.inl (some v0) :: rest0) none
      (⟨Command.ndetAssign CheckX.Vars.aux (CheckX.auxSet I) (CheckX.auxSet_nonempty I),
        φ0⟩ : Config (domainOf I) (CheckX.Vocab I))
      rest0
      ⟨Command.skip, Function.update φ0 CheckX.Vars.aux (Sum.inl (some v0))⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.checkX (Sum.inl (some v0) :: rest0)
      (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSet I) (CheckX.auxSet_nonempty I), φ0)
      [] (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSet I) (CheckX.auxSet_nonempty I), φ0)
      rest0 ⟨Command.skip, Function.update φ0 CheckX.Vars.aux (Sum.inl (some v0))⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (Command.seq (checkXLoop I) Command.term) hrun1
  set φ1 : (CheckX.Vocab I).Store := Function.update φ0 CheckX.Vars.aux (Sum.inl (some v0))
    with hφ1
  have hstep2 : Command.RunStep Tid.checkX rest0 none
      (⟨Command.seq Command.skip (Command.seq (checkXLoop I) Command.term), φ1⟩ :
        Config (domainOf I) (CheckX.Vocab I))
      rest0 ⟨Command.seq (checkXLoop I) Command.term, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have haux1 : φ1 CheckX.Vars.aux = Sum.inl (some v0) := Function.update_self _ _ _
  have hne_fst_aux : CheckX.Vars.fst ≠ CheckX.Vars.aux := by decide
  have hne_cnt_aux : CheckX.Vars.cnt ≠ CheckX.Vars.aux := by decide
  have hfst1 : φ1 CheckX.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne_fst_aux (Sum.inl (some v0)) φ0).trans hfst0
  have hcnt1 : φ1 CheckX.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cnt_aux (Sum.inl (some v0)) φ0).trans hcnt0
  obtain ⟨kws, φ', cLastL, hlen, hval, hrun3⟩ :=
    checkX_shape_val I js φ1 hfst1 hcnt1 v0 haux1
  have hrun3' := Command.Run.seqCongr Command.term hrun3
  obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun2 hrun3'
  have hstep4 : Command.RunStep Tid.checkX ([] : List (CheckX.Vals I)) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (CheckX.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨kws, φ', cLast, hlen, hval, Command.Run.silentSnoc hcomb hstep4⟩

/-- The `xA`-write match, as a predicate on `Loc`/`OpType` alone. -/
def xAWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xA, OpType.wt => true | _, _ => false

theorem xAWritePredCore_iff (y : Loc) (z : OpType) :
    xAWritePredCore y z = true ↔ (y = Loc.xA ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem xAWritePredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.xA ∧ z = OpType.wt)) :
    xAWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `xA` is not a bridge location. -/
theorem xAWritePredCore_bridge : ∀ y : Loc, ∀ z : OpType, y ∈ BridgeLoc →
    xAWritePredCore y z = false := by
  intro y z hb0
  cases y <;> cases z <;> revert hb0 <;> decide

/-- `checkX`'s `xA`-write predicate, lifted from `xAWritePredCore`. -/
def checkXXAWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) : Bool :=
  xAWritePredCore lab.1.loc lab.1.op

theorem checkXXAWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) :
    checkXXAWritePred I lab = true ↔ (lab.1.loc = Loc.xA ∧ lab.1.op = OpType.wt) := by
  unfold checkXXAWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xAWritePredCore_iff y z

/-- `checkXBlock0Elems` has one `xA`-write, its first entry. -/
theorem checkXBlock0Elems_xA_filter (I : PCPInstance) (v0 : I.Γ) :
    (checkXBlock0Elems I v0).filter (checkXXAWritePred I) =
      [(⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX)] := by
  apply list_filter_singleton_of_unique' (checkXBlock0Elems I v0) (checkXXAWritePred I) 0
    (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩)
    rfl
    (by unfold checkXXAWritePred; exact (xAWritePredCore_iff Loc.xA OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 1 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkXBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkXXAWritePred
      · exact xAWritePredCore_false_of_ne Loc.xB OpType.wt (by decide)
      · exact xAWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
      · exact xAWritePredCore_false_of_ne Loc.xB OpType.rd (by decide))

/-- `checkXBlockRestElems` has one `xA`-write per entry of `kws`. -/
theorem checkXBlockRestElems_xA_filter (I : PCPInstance) (kws : List (Fin 4 × Option I.Γ)) :
    ((kws.flatMap (checkXBlockRestElems I)).filter (checkXXAWritePred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkXBlockRestElems I kw) ++ kws.flatMap (checkXBlockRestElems I)).filter
        (checkXXAWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkXBlockRestElems I kw).filter (checkXXAWritePred I) =
          [(⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkX)] := by
        apply list_filter_singleton_of_unique' (checkXBlockRestElems I kw) (checkXXAWritePred I) 0
          (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩)
          rfl
          (by unfold checkXXAWritePred
              exact (xAWritePredCore_iff Loc.xA OpType.wt).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkXXAWritePred
            · exact xAWritePredCore_false_of_ne Loc.xB OpType.wt (by decide)
            · exact xAWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
            · exact xAWritePredCore_false_of_ne Loc.xB OpType.rd (by decide)
            · exact xAWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)
            · exact xAWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `checkXBlock0Elems_xA_filter` for the `zipIdx`-filter, starting at
offset `k`. -/
theorem checkXBlock0Elems_xA_zipIdx_filter (I : PCPInstance) (v0 : I.Γ) (k : ℕ) :
    (((checkXBlock0Elems I v0).zipIdx k).filter (fun p => checkXXAWritePred I p.1)) =
      [((⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), k)] := by
  apply list_filter_singleton_of_unique' ((checkXBlock0Elems I v0).zipIdx k)
    (fun p => checkXXAWritePred I p.1) 0
    ((⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX), k)
    (by rw [List.getElem?_zipIdx]; rfl)
    (by unfold checkXXAWritePred; exact (xAWritePredCore_iff Loc.xA OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      rw [List.getElem?_zipIdx] at hget
      have hqlt : q < 4 := by
        rcases Nat.lt_or_ge q 4 with hqlt | hqge
        · exact hqlt
        · exfalso
          have hqge4 : (checkXBlock0Elems I v0).length ≤ q := by
            simp only [checkXBlock0Elems, List.length_cons, List.length_nil]
            omega
          have : (checkXBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge4
          rw [this] at hget
          simp at hget
      have hq3 : q = 1 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkXBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.map_some, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkXXAWritePred
      · exact xAWritePredCore_false_of_ne Loc.xB OpType.wt (by decide)
      · exact xAWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
      · exact xAWritePredCore_false_of_ne Loc.xB OpType.rd (by decide))

/-- `checkX`'s `i`-th `xA`-write: for `i = 0` block 0's
`Val.primeTag Tid.checkX 1`, for `i ≥ 1` the value
`Val.primeTag Tid.checkX (kw.1 + 1)` of `kws[i-1]`. -/
theorem rawNthWrite_checkX_xA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.checkX Loc.xA i = some ew) :
    (i = 0 ∧ ew.val = Val.primeTag Tid.checkX 1) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.primeTag Tid.checkX (kw.1 + 1)) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xA) (op := OpType.wt)
    (predL := checkXXAWritePred I) htrace (checkXXAWritePred_iff I)
  have hlen2 : ((checkXBlockWord I v0 kws).filter (checkXXAWritePred I)).length
      = kws.length + 1 := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xA_filter,
      checkXBlockRestElems_xA_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAWritePred I p.1) =
      [((⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 0)] ++
      ((kws.flatMap (checkXBlockRestElems I)).zipIdx 4).filter
        (fun p => checkXXAWritePred I p.1) := by
    unfold checkXBlockWord
    rw [List.zipIdx_append, List.filter_append, checkXBlock0Elems_xA_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXAWritePred_iff I)
      (n := 0) (lab := (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX)) (origPos := 0)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkX Loc.xA OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option I.Γ) (β := ThreadLabel (domainOf I) Tid.checkX)
      (checkXBlockRestElems I) 6 0
      (fun kw => rfl)
      (checkXXAWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX))
      (fun a => rfl)
      (fun a => by
        unfold checkXXAWritePred
        exact (xAWritePredCore_iff Loc.xA OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkXXAWritePred
        · exact xAWritePredCore_false_of_ne Loc.xB OpType.wt (by decide)
        · exact xAWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
        · exact xAWritePredCore_false_of_ne Loc.xB OpType.rd (by decide)
        · exact xAWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)
        · exact xAWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 4 + j * 6 + 0) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXAWritePred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkX Loc.xA OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `primeCheckX`/`xA` branch (Eq. (16)): `primeCheckX`
makes `cnts.length` `xA`-reads and `checkX` makes `1 + kws.length`
`xA`-writes, with `kws.length = cnts.length`. -/
theorem traceRf_total_primeCheckX_xA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cs : List I.Γ) (cnts : List (Fin 4)) (hcnts : cnts.length = cs.length + 1)
    (htraceP : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1)
    (htraceV : trace Tid.checkX = checkXBlockWord I v0 kws)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeCheckX) (her_loc : er.loc = Loc.xA)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeCheckX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeCheckX Loc.xA OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeCheckX Loc.xA OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeCheckX Loc.xA i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeCheckX Loc.xA OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xA) (op := OpType.rd) (predL := primeCheckXXAReadPred I) htraceP
    (primeCheckXXAReadPred_iff I)
  rw [hlen.trans (primeCheckXBlockWord_xA_length I cnts)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xA) (op := OpType.wt) (predL := checkXXAWritePred I) htraceV
    (checkXXAWritePred_iff I)
  have hlenW2 : ((checkXBlockWord I v0 kws).filter (checkXXAWritePred I)).length
      = 1 + kws.length := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xA_filter,
      checkXBlockRestElems_xA_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.checkX Loc.xA OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

/-- `rf_matches` for the `primeCheckX`/`xA` branch (Eq. (16)/(16)): from `checkX_shape_val`'s and `primeCheckX_shape`'s value
conjuncts (the latter at `cnt0 = 0`), both sides are
`Val.primeTag Tid.checkX ⟨(i + 1) % 4, _⟩` at the shared index `i`. -/
theorem traceRf_matches_checkX_primeCheckX_xA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkX Loc.xA i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xA i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, herval⟩ := rawNthRead_primeCheckX_xA_eq I cnts htracePVX her
  have hilen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hcform := hcntsVal i hilen
  rw [hcform] at hc
  injection hc with hc
  rcases rawNthWrite_checkX_xA_eq I v0 kws htraceVX hew with ⟨hi0, hewval⟩ | ⟨kw, hkw, hi1, hewval⟩
  · subst hi0
    rw [hewval, herval, ← hc]
    congr 1
  · have hjlen : i - 1 < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
    obtain ⟨w, hw⟩ := hkwsVal (i - 1) hjlen
    have hkweq := hkw.symm.trans hw
    injection hkweq with hkweq
    rw [hewval, herval, ← hc, hkweq]
    congr 1
    apply Fin.ext
    simp [Fin.add_def]
    omega

/-- `traceRf_matches_checkX_primeCheckX_xA` for the general construction. -/
theorem traceRf_matches_checkX_primeCheckX_xA_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkX Loc.xA i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xA i = some er) :
    ew.val = er.val :=
  traceRf_matches_checkX_primeCheckX_xA I v0 kws htraceVX hkwsVal cnts htracePVX hcntsVal h

/-! ## `rf_matches`: `guessAX`/`checkX` `xA` (Eq. (17))

`w_i(g_α^x,x_α) ⟶rf r_i(c^x,x_α)`. This section has `checkX`'s read
side: the `xA`-read is at offset `2` of both `checkXBlock0Elems`
(`[wt xA, wt xB, rd xA, rd xB]`) and `checkXBlockRestElems`
(`[wt xA, wt xB, rd xA, rd xB, rd xA', rd xB']`). The write side is in
`Completeness/Graph.lean`. -/

/-- `checkX`'s `xA`-read predicate, lifted from `xAReadPredCore`. -/
def checkXXAReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) : Bool :=
  xAReadPredCore lab.1.loc lab.1.op

theorem checkXXAReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) :
    checkXXAReadPred I lab = true ↔ (lab.1.loc = Loc.xA ∧ lab.1.op = OpType.rd) := by
  unfold checkXXAReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xAReadPredCore_iff y z

/-- `checkXBlock0Elems` has one `xA`-read, at offset `2`. -/
theorem checkXBlock0Elems_xA_read_filter (I : PCPInstance) (v0 : I.Γ) :
    (checkXBlock0Elems I v0).filter (checkXXAReadPred I) =
