      PosEdge (BetaPos t) (BetaPos t'))
    (l : List Tid) (hne : l ≠ []) (hnodup : l.Nodup)
    (hsub : ∀ x ∈ l, x ∈ BetaGuesserTids)
    (hcycle : List.IsChain E (l ++ [l.headI])) :
    l.length = 2 := by
  have hlmap : List.IsChain PosEdge ((l.map BetaPos) ++ [(l.map BetaPos).headI]) := by
    have heq : (l.map BetaPos) ++ [(l.map BetaPos).headI] = (l ++ [l.headI]).map BetaPos := by
      rw [List.map_append, List.map_cons, List.map_nil]
      congr 1
      cases l with
      | nil => exact absurd rfl hne
      | cons a l' => rfl
    rw [heq, List.isChain_map]
    have hsub' : ∀ x ∈ l ++ [l.headI], x ∈ BetaGuesserTids := by
      intro x hx
      simp only [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hsub x hx
      · exact hsub l.headI (by
          cases l with
          | nil => exact absurd rfl hne
          | cons a l' => simp)
    exact chain_map_of_mem BetaGuesserTids
      (fun a b h ha hb => hEdge a b h ha hb) (l ++ [l.headI]) hsub' hcycle
  have hnodupmap : (l.map BetaPos).Nodup :=
    hnodup.map_on (fun x hx y hy => betaPos_inj x (hsub x hx) y (hsub y hy))
  have hbound : l.length ≤ 4 := by
    have h1 : l.toFinset.card = l.length := List.toFinset_card_of_nodup hnodup
    have h2 : l.toFinset ⊆ BetaGuesserTids := fun x hx => hsub x (List.mem_toFinset.mp hx)
    have h3 : l.toFinset.card ≤ BetaGuesserTids.card := Finset.card_le_card h2
    have h4 : BetaGuesserTids.card = 4 := by decide
    omega
  match hl : l with
  | [] => exact (hne rfl).elim
  | [a] =>
      exfalso
      simp only [List.map_cons, List.map_nil, List.singleton_append, List.headI_cons] at hlmap
      rw [List.isChain_cons_cons] at hlmap
      have hself : PosEdge (BetaPos a) (BetaPos a) := hlmap.1
      unfold PosEdge at hself
      omega
  | [a, b] => rfl
  | (a :: b :: c :: rest) =>
      exfalso
      have hrestlen : rest.length ≤ 1 := by
        simp only [List.length_cons] at hbound; omega
      have hcase : rest.length = 0 ∨ rest.length = 1 := by omega
      rcases hcase with hr | hr
      · obtain hrnil := List.length_eq_zero_iff.mp hr
        subst hrnil
        apply no_alphaPos_cycle3
        refine ⟨BetaPos a, BetaPos b, BetaPos c, ?_, ?_⟩
        · have := hnodupmap; simp only [List.map_cons, List.map_nil] at this; simpa using this
        · have := hlmap
          simp only [List.map_cons, List.map_nil, List.headI_cons] at this
          simpa using this
      · obtain ⟨d, hd⟩ := List.length_eq_one_iff.mp hr
        subst hd
        apply no_alphaPos_cycle4
        refine ⟨BetaPos a, BetaPos b, BetaPos c, BetaPos d, ?_, ?_⟩
        · have := hnodupmap; simp only [List.map_cons, List.map_nil] at this; simpa using this
        · have := hlmap
          simp only [List.map_cons, List.map_nil, List.headI_cons] at this
          simpa using this

/-- The thread-level `rf` topology (Fig. 4), second half: every cyclic sequence of pairwise distinct
threads under `→rf` has length `2`. By cases on the group of `l.headI`. -/
theorem traceRf_cycle_length_two {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (l : List Tid) (hne : l ≠ []) (hnodup : l.Nodup)
    (hcycle : List.IsChain (ThreadRf I trace) (l ++ [l.headI])) :
    l.length = 2 := by
  have hcycle' : List.IsChain (fun t t' =>
      (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) (l ++ [l.headI]) :=
    hcycle.imp (fun a b h => threadRf_pairs I h)
  rcases threadGroups_cover l.headI with hh | hh | hh | hh
  · -- l.headI ∈ AlphaGuesserTids: AlphaGuesserTids is backward-closed
    have hsub : ∀ x ∈ l, x ∈ AlphaGuesserTids := by
      have hall := chain_closure_backward _ AlphaGuesserTids
        (fun b hb a hab => alphaGuesserTids_closed hb hab) l.headI l hcycle' hh
      intro x hx
      exact hall x (List.mem_append_left _ hx)
    exact alphaGroup_cycle_length_two
      (fun t t' h ht ht' => alphaPosEdge_of_pairs h ht ht') l hne hnodup hsub hcycle'
  · have hsub : ∀ x ∈ l, x ∈ BetaGuesserTids := by
      have hall := chain_closure_backward _ BetaGuesserTids
        (fun b hb a hab => betaGuesserTids_closed hb hab) l.headI l hcycle' hh
      intro x hx
      exact hall x (List.mem_append_left _ hx)
    exact betaGroup_cycle_length_two
      (fun t t' h ht ht' => betaPosEdge_of_pairs h ht ht') l hne hnodup hsub hcycle'
  · -- l.headI ∈ XCheckerTids: forward-closed
    have hsub : ∀ x ∈ l, x ∈ XCheckerTids := by
      cases hlc : l with
      | nil => exact absurd hlc hne
      | cons a l' =>
          have hchain2 : List.IsChain (fun t t' =>
              (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
              (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
              (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
              (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
              (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
              (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
              (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
              (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
              (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
              (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
              (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
              (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
              (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
              (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
              (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
              (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
              (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
              (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
              (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
              (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
              (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) (a :: (l' ++ [l.headI])) := by
            have : l ++ [l.headI] = a :: (l' ++ [l.headI]) := by rw [hlc]; rfl
            rwa [this] at hcycle'
          have hha : a ∈ XCheckerTids := by rw [hlc] at hh; simpa using hh
          have hall := chain_closure _ XCheckerTids
            (fun t ht t' htt' => xCheckerTids_closed ht htt') a (l' ++ [l.headI]) hchain2 hha
          intro x hx
          apply hall
          simp only [List.mem_cons, List.mem_append] at hx ⊢
          tauto
    have hbound : l.length ≤ 2 := by
      have h1 : l.toFinset.card = l.length := List.toFinset_card_of_nodup hnodup
      have h2 : l.toFinset ⊆ XCheckerTids := fun x hx => hsub x (List.mem_toFinset.mp hx)
      have h3 : l.toFinset.card ≤ XCheckerTids.card := Finset.card_le_card h2
      have h4 : XCheckerTids.card = 2 := by decide
      omega
    match hl : l with
    | [] => exact (hne rfl).elim
    | [a] =>
        exfalso
        have hchain2 : List.IsChain (fun t t' =>
            (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
            (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
            (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
            (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
            (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
            (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
            (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
            (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
            (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
            (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
            (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
            (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
            (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
            (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
            (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
            (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
            (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
            (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
            (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
            (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
            (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) ([a] ++ [a]) := by
          have h' := hcycle'
          simp only [List.headI_cons] at h'
          exact h'
        rw [List.singleton_append, List.isChain_cons_cons] at hchain2
        clear hl hcycle hcycle' hne hnodup hh hsub hbound
        cases a <;> exact absurd hchain2.1 (by decide)
    | [a, b] => rfl
    | (a :: b :: c :: rest) =>
        exfalso
        have : (a :: b :: c :: rest).length ≤ 2 := hl ▸ hbound
        simp at this
  · -- l.headI ∈ YCheckerTids: forward-closed, symmetric to the XChecker case
    have hsub : ∀ x ∈ l, x ∈ YCheckerTids := by
      cases hlc : l with
      | nil => exact absurd hlc hne
      | cons a l' =>
          have hchain2 : List.IsChain (fun t t' =>
              (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
              (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
              (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
              (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
              (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
              (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
              (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
              (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
              (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
              (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
              (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
              (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
              (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
              (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
              (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
              (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
              (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
              (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
              (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
              (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
              (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
              (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) (a :: (l' ++ [l.headI])) := by
            have : l ++ [l.headI] = a :: (l' ++ [l.headI]) := by rw [hlc]; rfl
            rwa [this] at hcycle'
          have hha : a ∈ YCheckerTids := by rw [hlc] at hh; simpa using hh
          have hall := chain_closure _ YCheckerTids
            (fun t ht t' htt' => yCheckerTids_closed ht htt') a (l' ++ [l.headI]) hchain2 hha
          intro x hx
          apply hall
          simp only [List.mem_cons, List.mem_append] at hx ⊢
          tauto
    have hbound : l.length ≤ 2 := by
      have h1 : l.toFinset.card = l.length := List.toFinset_card_of_nodup hnodup
      have h2 : l.toFinset ⊆ YCheckerTids := fun x hx => hsub x (List.mem_toFinset.mp hx)
      have h3 : l.toFinset.card ≤ YCheckerTids.card := Finset.card_le_card h2
      have h4 : YCheckerTids.card = 2 := by decide
      omega
    match hl : l with
    | [] => exact (hne rfl).elim
    | [a] =>
        exfalso
        have hchain2 : List.IsChain (fun t t' =>
            (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
            (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
            (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
            (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
            (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
            (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
            (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
            (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
            (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
            (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
            (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
            (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
            (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
            (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
            (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
            (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
            (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
            (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
            (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
            (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
            (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
            (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) ([a] ++ [a]) := by
          have h' := hcycle'
          simp only [List.headI_cons] at h'
          exact h'
        rw [List.singleton_append, List.isChain_cons_cons] at hchain2
        clear hl hcycle hcycle' hne hnodup hh hsub hbound
        cases a <;> exact absurd hchain2.1 (by decide)
    | [a, b] => rfl
    | (a :: b :: c :: rest) =>
        exfalso
        have : (a :: b :: c :: rest).length ≤ 2 := hl ▸ hbound
        simp at this

/-- `G`'s `rf_subset`: `ew` is a write and `er` a read of `traceEvents
trace` on the same location (`rawNthEvent_mem`). By cases on `er.tid` and
then on all twenty locations (every branch of `traceRf` explicitly, so that
the `match` reduces). -/
theorem traceRf_subset {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {ew er : Event (domainOf I)} (h : traceRf I trace ew er) :
    ew ∈ traceEvents trace ∧ er ∈ traceEvents trace ∧
      ew ∈ WriteDom (domainOf I) ∧ er ∈ ReadDom (domainOf I) ∧ ew.loc = er.loc := by
  unfold traceRf at h
  match her : er.tid with
  | Tid.guessAX =>
      rw [her] at h
      match hel : er.loc with
      | Loc.xA =>
          rw [hel] at h
          simp at h
      | Loc.xB =>
          rw [hel] at h
          simp at h
      | Loc.yA =>
          rw [hel] at h
          simp at h
      | Loc.yB =>
          rw [hel] at h
          simp at h
      | Loc.xA' =>
          rw [hel] at h
          simp at h
      | Loc.xB' =>
          rw [hel] at h
          simp at h
      | Loc.yA' =>
          rw [hel] at h
