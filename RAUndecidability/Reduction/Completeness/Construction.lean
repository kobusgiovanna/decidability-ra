    ∃ (φ' : (GuessAY.Vocab I).Store) (cLast : Config (domainOf I) (GuessAY.Vocab I)),
      φ' GuessAY.Vars.aux = Sum.inl v0' ∧ φ' GuessAY.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' GuessAY.Vars.cnt = Sum.inr (Sum.inl (k + 1)) ∧
      Command.Run Tid.guessAY (Sum.inl v0' :: rest)
        (guessAYLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) (some v)), rfl⟩
        , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux (k + 1) (some v)), rfl⟩
        , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt (k + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt k), rfl⟩
        , ⟨EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt k), rfl⟩ ]
