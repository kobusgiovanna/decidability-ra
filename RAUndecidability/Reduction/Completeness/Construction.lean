      have hbl : (checkYBlockRestElems I kw).filter (checkYYBWritePred I) =
          [(⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw) (checkYYBWritePred I) 1
          (⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩)
          rfl
          (by unfold checkYYBWritePred
              exact (yBWritePredCore_iff Loc.yB OpType.wt).mpr ⟨rfl, rfl⟩)
