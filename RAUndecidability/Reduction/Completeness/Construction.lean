/-- See `primeAY_stop_step`. -/
theorem primeCheckY_stop_step (I : PCPInstance) (rest : List PrimeCheckY.Vals)
    (φ : (PrimeCheckY.Vocab I).Store) (hb : φ PrimeCheckY.Vars.b = Sum.inr false) :
    Command.Run Tid.primeCheckY rest (primeCheckYLoop I, φ) [] (primeCheckYLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeCheckY rest none (primeCheckYLoop I, φ) rest
      (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeCheckYLoop, Command.step, PrimeCheckY.Vocab, PrimeCheckY.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- `M + 1` iterations of `primeCheckYLoop` (as `primeCheckX_shape`). -/
theorem primeCheckY_shape (I : PCPInstance) (M : ℕ) (φ : (PrimeCheckY.Vocab I).Store)
    (hb : φ PrimeCheckY.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeCheckY.Vars.cnt = Sum.inl cnt0) :
    ∃ (cnts : List (Fin 4)) (φ' : (PrimeCheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckY.Vocab I)),
      cnts.length = M + 1 ∧
      (∀ i, i < cnts.length →
        cnts[i]? = some (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4)) ∧
      φ' PrimeCheckY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeCheckY (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeCheckYLoop I, φ) (primeCheckYBlockWord I cnts) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeCheckY_iter_step I (Sum.inr false) [] φ hb (by simp [PrimeCheckY.X]) cnt0 hcnt0
      have hrun2 := primeCheckY_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[cnt0 + 1], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeCheckY_iter_step I (Sum.inr true)
          (List.replicate M (Sum.inr true) ++ [Sum.inr false]) φ hb (by simp [PrimeCheckY.X])
          cnt0 hcnt0
      obtain ⟨cnts, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(cnt0 + 1) :: cnts, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < cnts.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 1
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-! ## `PrimeCheckY`'s whole run -/

/-- `PrimeCheckY`'s program, run from its initial store (as
`primeAX_general_run`). -/
theorem primeCheckY_general_run (I : PCPInstance) (M : ℕ) :
    ∃ (cnts : List (Fin 4)) (φ' : (PrimeCheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckY.Vocab I)),
      cnts.length = M + 1 ∧
      (∀ i, i < cnts.length →
        cnts[i]? = some (⟨(i + 1) % 4, by omega⟩ : Fin 4)) ∧
      φ' PrimeCheckY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeCheckY
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeCheckY.program I,
          (PrimeCheckY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeCheckYBlockWord I cnts)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeCheckY.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty)
        (primeCheckYLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeCheckY.Vocab I).Store :=
    (PrimeCheckY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeCheckY.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeCheckY.Vals) ∈ PrimeCheckY.X := by
    unfold PrimeCheckY.X; decide
  set rest0 : List PrimeCheckY.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeCheckY (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeCheckY.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeCheckY.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeCheckY (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeCheckY.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeCheckYLoop I) hrun1
  set φ1 : (PrimeCheckY.Vocab I).Store := Function.update φ0 PrimeCheckY.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeCheckY rest0 none
      (⟨Command.seq Command.skip (primeCheckYLoop I), φ1⟩ : Config (domainOf I) (PrimeCheckY.Vocab I))
      rest0 ⟨primeCheckYLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeCheckY.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeCheckY.Vars.cnt ≠ PrimeCheckY.Vars.b := by decide
  have hcnt1 : φ1 PrimeCheckY.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨cnts, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeCheckY_shape I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < cnts.length →
      cnts[i]? = some (⟨(i + 1) % 4, by omega⟩ : Fin 4) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeCheckY ([] : List PrimeCheckY.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeCheckY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨cnts, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩

/-! ## `rf_matches`: `primeCheckY`/`yA` (Eq. (16))

As for `primeCheckX`/`xA`. -/

def yAReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yA, OpType.rd => true | _, _ => false

theorem yAReadPredCore_iff (y : Loc) (z : OpType) :
    yAReadPredCore y z = true ↔ (y = Loc.yA ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem yAReadPredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.yA ∧ z = OpType.rd)) :
    yAReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `primeCheckY`'s `yA`-read predicate, lifted from `yAReadPredCore`. -/
def primeCheckYYAReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    Bool :=
  yAReadPredCore lab.1.loc lab.1.op

theorem primeCheckYYAReadPred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    primeCheckYYAReadPred I lab = true ↔ (lab.1.loc = Loc.yA ∧ lab.1.op = OpType.rd) := by
  unfold primeCheckYYAReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yAReadPredCore_iff y z

/-- `primeCheckYBlockWord` has one `yA`-read per entry of `cnts`. -/
theorem primeCheckYBlockWord_yA_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckYBlockWord I cnts).filter (primeCheckYYAReadPred I)).length = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckY)
        , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])
        ++ (primeCheckYBlockWord I cs)).filter (primeCheckYYAReadPred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yAReadPredCore_false_of_ne Loc.yA' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yAReadPredCore_false_of_ne Loc.yB' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yAReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yAReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              exact (yAReadPredCore_iff Loc.yA OpType.rd).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yAReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `primeCheckY`'s `i`-th `yA`-read expects `Val.primeTag Tid.checkY c` for
`cnts[i]? = some c`. -/
theorem rawNthRead_primeCheckY_yA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.primeCheckY Loc.yA i = some er) :
    ∃ c, cnts[i]? = some c ∧ er.val = Val.primeTag Tid.checkY c := by
  have hilt : i < (rawOpEvents trace Tid.primeCheckY Loc.yA OpType.rd).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckY)
    (x := Loc.yA) (op := OpType.rd)
    (predL := primeCheckYYAReadPred I) htrace (primeCheckYYAReadPred_iff I)
  have hlen' : (rawOpEvents trace Tid.primeCheckY Loc.yA OpType.rd).length = cnts.length :=
    hlen.trans (primeCheckYBlockWord_yA_length I cnts)
  rw [hlen'] at hilt
  obtain ⟨c, hc⟩ : ∃ c, cnts[i]? = some c := ⟨cnts[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (α := Fin 4) (β := ThreadLabel (domainOf I) Tid.primeCheckY)
    (fun c =>
      [ (⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY c), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeCheckY)
      , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])
    6 4
    (fun _ => rfl)
    (primeCheckYYAReadPred I)
    (fun c => (⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckY))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold primeCheckYYAReadPred
      · exact yAReadPredCore_false_of_ne Loc.yA' OpType.wt (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yB' OpType.wt (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yB OpType.rd (by decide))
    cnts 0 i c hc
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeCheckY)
    (l := primeCheckYBlockWord I cnts) htrace (primeCheckYYAReadPred_iff I) hfilt
  have hraw : rawNthEvent trace Tid.primeCheckY Loc.yA OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨c, hc, by injection hconn with hconn; rw [hconn]; rfl⟩

/-! ## Lemma 3.4 for the primed threads

The word of each primed thread is a uniform-block flatMap
(`primeAXBlockWord I vals = vals.flatMap (primeAXBlockElems I)`, by `rfl`),
whose block has the shape `primeAXBlockShape` (pairwise distinct locations),
so `flatLoop_po_monotone_of_shape` applies. The hypothesis `hnb2 : ¬ e2.IsBridge`
of Lemma 3.4 is vacuous for these threads, which access no
bridge location (`*BlockShape_no_bridge`). -/

/-- `PrimeAX`'s events in one iteration with value `l`. -/
def primeAXBlockElems (I : PCPInstance) (l : Val I) :
    List (ThreadLabel (domainOf I) Tid.primeAX) :=
  [ ⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
  , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' l, rfl⟩
  , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x l, rfl⟩ ]

theorem primeAXBlockWord_eq_flatMap (I : PCPInstance) (vals : List (Val I)) :
    primeAXBlockWord I vals = vals.flatMap (primeAXBlockElems I) := rfl

/-- `PrimeAX`'s block shape: two writes (`xA'`, `zAxx'`) then one read
(`zAx'x`). -/
def primeAXBlockShape : List (Loc × OpType) :=
  [(Loc.xA', .wt), (Loc.zAxx', .wt), (Loc.zAx'x, .rd)]

theorem primeAXBlockElems_shape (I : PCPInstance) :
    ∀ l : Val I, (primeAXBlockElems I l).map (fun ev => (ev.1.loc, ev.1.op)) = primeAXBlockShape :=
  fun _ => rfl

theorem primeAXBlockShape_nodup : primeAXBlockShape.Nodup := by decide

/-- `PrimeAX` accesses no bridge location. -/
theorem primeAXBlockShape_no_bridge : ∀ p ∈ primeAXBlockShape, p.1 ∉ BridgeLoc := by decide

/-- `shape[p]? = some _` for a shape of length `N` implies `p < N`. -/
theorem blockShapeLen_lt {x : Loc} {op : OpType} {shape : List (Loc × OpType)} {N : ℕ}
    (hlen : shape.length = N) (p : ℕ) (hpx : shape[p]? = some (x, op)) : p < N := by
  rcases Nat.lt_or_ge p N with h | h
  · exact h
  · exfalso
    have hnone : shape[p]? = none := List.getElem?_eq_none (by omega)
    rw [hnone] at hpx; simp at hpx

/-- Lemma 3.4 for the primed threads for `PrimeAX`: along a `tracePo`-edge into a
write, `rawIndex` is non-decreasing (strictly if the source is a read). -/
theorem primeAX_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (vals : List (Val I)) (htrace : trace Tid.primeAX = primeAXBlockWord I vals)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.primeAX) (he2 : e2 ∈ traceEventsOf trace Tid.primeAX)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 2 ≤ primeAXBlockShape.length := by decide
  have hshapewrites : ∀ p x, primeAXBlockShape[p]? = some (x, OpType.rd) → 2 ≤ p := by
    intro p x hpx
    have h3 := blockShapeLen_lt (N := 3) (shape := primeAXBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 := by omega
    rcases this with rfl | rfl | rfl <;> simp_all [primeAXBlockShape]
  have hshapewrites2 : ∀ p x, primeAXBlockShape[p]? = some (x, OpType.wt) → p < 2 := by
    intro p x hpx
    have h3 := blockShapeLen_lt (N := 3) (shape := primeAXBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 := by omega
    rcases this with rfl | rfl | rfl <;> simp_all [primeAXBlockShape]
  have htrace' : trace Tid.primeAX = vals.flatMap (primeAXBlockElems I) := by
    rw [htrace, primeAXBlockWord_eq_flatMap]
  exact flatLoop_po_monotone_of_shape (primeAXBlockElems I) primeAXBlockShape
    (primeAXBlockElems_shape I) primeAXBlockShape_nodup 2 hWL hshapewrites hshapewrites2
    trace vals htrace' he1 he2 hpo hwt2

/-- Lemma 3.5 for `PrimeAX`: its only read location is
`zAx'x`, so `po`-edges between reads are increasing
(`rawIndex_lt_of_tracePo_sameLocOp`). -/
theorem primeAX_reads_nondecreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (vals : List (Val I)) (htrace : trace Tid.primeAX = primeAXBlockWord I vals)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.primeAX) (he2 : e2 ∈ traceEventsOf trace Tid.primeAX)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hrd2 : e2.op = .rd)
    (_hnb1 : ¬ e1.IsBridge) (_hnb2 : ¬ e2.IsBridge)
    (hdec : rawIndex trace e2 < rawIndex trace e1) : False := by
  have htrace' : trace Tid.primeAX = vals.flatMap (primeAXBlockElems I) := by
    rw [htrace, primeAXBlockWord_eq_flatMap]
  have hpos0 : primeAXBlockShape[0]? = some (Loc.xA', OpType.wt) := by decide
  have hpos1 : primeAXBlockShape[1]? = some (Loc.zAxx', OpType.wt) := by decide
  have hpos2 : primeAXBlockShape[2]? = some (Loc.zAx'x, OpType.rd) := by decide
  obtain ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula (primeAXBlockElems I) primeAXBlockShape
      (primeAXBlockElems_shape I) primeAXBlockShape_nodup trace vals htrace' he1
  obtain ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
    flatLoop_index_formula (primeAXBlockElems I) primeAXBlockShape
      (primeAXBlockElems_shape I) primeAXBlockShape_nodup trace vals htrace' he2
  have hp1L' : p1 < 3 := hp1L
  have hp2L' : p2 < 3 := hp2L
  have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 := by omega
  have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 := by omega
  have e1loc : e1.loc = Loc.zAx'x := by
    rcases hp1cases with rfl | rfl | rfl
    · have h := hshape1.symm.trans hpos0
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1.symm.trans hpos1
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1.symm.trans hpos2
      injection h with h; injection h with a _
  have e2loc : e2.loc = Loc.zAx'x := by
    rcases hp2cases with rfl | rfl | rfl
    · have h := hshape2.symm.trans hpos0
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
    · have h := hshape2.symm.trans hpos1
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
    · have h := hshape2.symm.trans hpos2
      injection h with h; injection h with a _
  have heloc : e1.loc = e2.loc := e1loc.trans e2loc.symm
  have heop : e1.op = e2.op := hrd1.trans hrd2.symm
  exact absurd (rawIndex_lt_of_tracePo_sameLocOp he1 he2 hpo heloc heop) (by omega)


