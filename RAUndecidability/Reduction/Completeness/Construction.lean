    6 5
    (fun _ => rfl)
    (primeCheckYYBReadPred I)
    (fun c => (⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckY))
    (fun a => rfl)
    (fun a => rfl)
