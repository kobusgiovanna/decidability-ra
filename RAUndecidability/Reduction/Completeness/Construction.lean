theorem guessAXInnerFlatMap_ellAyx_filter (vs : List (Val I × Val I × Val I)) :
    (vs.flatMap (guessAXInnerBlockElems I)).filter (guessAXEllAReadPred I) = [] := by
  induction vs with
  | nil => rfl
  | cons a vs ih =>
      rw [List.flatMap_cons, List.filter_append, ih, List.append_nil,
        List.filter_eq_nil_iff]
      intro x hx
      have hshape := guessAXInnerBlockElems_shape I a
      have hxshape : (x.1.loc, x.1.op) ∈ guessAXInnerBlockShape := by
        rw [← hshape]; exact List.mem_map_of_mem hx
      have hxne := guessAXInnerBlockShape_no_ellAyx_rd _ hxshape
      unfold guessAXEllAReadPred
      obtain ⟨y, hy⟩ : ∃ y : Loc, x.1.loc = y := ⟨x.1.loc, rfl⟩
      obtain ⟨z, hz⟩ : ∃ z : OpType, x.1.op = z := ⟨x.1.op, rfl⟩
      rw [hy, hz]
      have hne : ¬ (y = Loc.ellAyx ∧ z = OpType.rd) := by rw [← hy, ← hz]; exact hxne
      rw [ellAyxReadPredCore_false_of_ne y z hne]
      decide

theorem guessAXOuterBlockElems_ellAyx_filter (b : Val I × Val I) (vs : List (Val I × Val I × Val I)) :
    (guessAXOuterBlockElems I b vs).filter (guessAXEllAReadPred I) =
      [(⟨EventLabel.rd Tid.guessAX Loc.ellAyx b.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)] := by
  show List.filter (guessAXEllAReadPred I)
      ((⟨EventLabel.wt Tid.guessAX Loc.zAxy b.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX) ::
        (vs.flatMap (guessAXInnerBlockElems I) ++
          [⟨EventLabel.rd Tid.guessAX Loc.ellAyx b.2, rfl⟩]))
      = [(⟨EventLabel.rd Tid.guessAX Loc.ellAyx b.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
  rw [List.filter_cons_of_neg
      (by unfold guessAXEllAReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellAyxReadPredCore_false_of_ne Loc.zAxy OpType.wt (by decide)),
    List.filter_append, guessAXInnerFlatMap_ellAyx_filter, List.nil_append,
    List.filter_cons_of_pos
      (by unfold guessAXEllAReadPred; exact (ellAyxReadPredCore_iff Loc.ellAyx OpType.rd).mpr ⟨rfl, rfl⟩),
    List.filter_nil]

theorem guessAXBlockWord_ellAyx_filter_eq (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I))) :
    (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter (guessAXEllAReadPred I)
      = [(⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.rd Tid.guessAX Loc.ellAyx p.1.2, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAX)) := by
  show List.filter (guessAXEllAReadPred I)
      (([ (⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
        , ⟨EventLabel.wt Tid.guessAX Loc.xA v1, rfl⟩
        , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x v2, rfl⟩ ] ++
        inner0Rest.flatMap (guessAXInnerBlockElems I) ++
        [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ ]) ++
        outerRest.flatMap (fun p => guessAXOuterBlockElems I p.1 p.2))
      = [(⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.rd Tid.guessAX Loc.ellAyx p.1.2, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAX))
  rw [List.filter_append, List.filter_append, List.filter_append,
    List.filter_cons_of_neg
      (by unfold guessAXEllAReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellAyxReadPredCore_false_of_ne Loc.zAxy OpType.wt (by decide)),
    List.filter_cons_of_neg
      (by unfold guessAXEllAReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellAyxReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)),
    List.filter_cons_of_neg
      (by unfold guessAXEllAReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellAyxReadPredCore_false_of_ne Loc.zAx'x OpType.wt (by decide)),
    List.filter_nil, guessAXInnerFlatMap_ellAyx_filter,
    List.filter_cons_of_pos
      (by unfold guessAXEllAReadPred; exact (ellAyxReadPredCore_iff Loc.ellAyx OpType.rd).mpr ⟨rfl, rfl⟩),
    list_filter_flatMap_distrib]
  simp only [List.nil_append, List.append_nil]
  congr 1
  rw [show (fun p : (Val I × Val I) × List (Val I × Val I × Val I) =>
      (guessAXOuterBlockElems I p.1 p.2).filter (guessAXEllAReadPred I))
      = (fun p => [(⟨EventLabel.rd Tid.guessAX Loc.ellAyx p.1.2, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAX)]) from by
    funext p
    exact guessAXOuterBlockElems_ellAyx_filter I p.1 p.2]
  induction outerRest with
  | nil => rfl
  | cons p ps ih => rw [List.flatMap_cons, List.map_cons, ih]; rfl

theorem rawNthRead_guessAX_ellAyx_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htrace : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.guessAX Loc.ellAyx i = some er) :
    (i = 0 ∧ er.val = vB0.2) ∨
    (∃ m, i = m + 1 ∧ ∃ a vs, outerRest[m]? = some (a, vs) ∧ er.val = a.2) := by
  have hpredL := guessAXEllAReadPred_iff I
  have hfilt := guessAXBlockWord_ellAyx_filter_eq I v1 v2 vB0 inner0Rest outerRest
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessAXEllAReadPred I) 0
      (⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
      (by rw [hfilt]; rfl)
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAX)
      (l := guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessAX Loc.ellAyx OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set m := i - 1 with hm
    have him : i = m + 1 := by omega
    obtain ⟨a, hval⟩ : ∃ a, outerRest[m]? = some a :=
      by
        have hilt : i < (rawOpEvents trace Tid.guessAX Loc.ellAyx OpType.rd).length :=
          (List.getElem?_eq_some_iff.mp h).1
        have hlen_eq := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAX)
          (x := Loc.ellAyx) (op := OpType.rd) (predL := guessAXEllAReadPred I) htrace hpredL
        rw [hlen_eq, hfilt, List.length_append, List.length_singleton, List.length_map] at hilt
        exact ⟨outerRest[m]'(by omega), List.getElem?_eq_getElem (by omega)⟩
    refine ⟨m, him, a.1, a.2, hval, ?_⟩
    have hgetf :
        ((guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
          (guessAXEllAReadPred I))[i]? =
        some (⟨EventLabel.rd Tid.guessAX Loc.ellAyx a.1.2, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAX) := by
      rw [hfilt, him, List.getElem?_append_right (by simp), List.length_singleton]
      have hidxeq : m + 1 - 1 = m := by omega
      rw [hidxeq, List.getElem?_map, hval]
      rfl
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessAXEllAReadPred I) i
      (⟨EventLabel.rd Tid.guessAX Loc.ellAyx a.1.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
      hgetf
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAX)
      (l := guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessAX Loc.ellAyx OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl

/-- `rf_total` for the `guessAX`/`ellAyx` branch (Eq. (15)): `guessAX` makes
`1 + outerRest.length` `ellAyx`-reads, `guessAY` makes `1 + kws.length`
`ellAyx`-writes. -/
theorem traceRf_total_guessAX_ellAyx (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hcount : 1 + outerRest.length ≤ 1 + kws.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessAX) (her_loc : er.loc = Loc.ellAyx)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.guessAX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.guessAX Loc.ellAyx OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.guessAX Loc.ellAyx OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.guessAX Loc.ellAyx i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.guessAX Loc.ellAyx OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAX)
    (x := Loc.ellAyx) (op := OpType.rd) (predL := guessAXEllAReadPred I) htraceGAX
    (guessAXEllAReadPred_iff I)
  have hlen2 : ((guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
      (guessAXEllAReadPred I)).length = 1 + outerRest.length := by
    rw [guessAXBlockWord_ellAyx_filter_eq, List.length_append, List.length_singleton,
      List.length_map]
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.ellAyx) (op := OpType.wt) (predL := guessAYEllAWritePred I) htraceG
    (guessAYEllAWritePred_iff I)
  have hlenW2 : ((guessAYBlockWord I v0 kws).filter (guessAYEllAWritePred I)).length
      = 1 + kws.length := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_ellAyx_filter,
      guessAYBlockRestElems_ellAyx_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessAY Loc.ellAyx OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_guessAX_guessAY_ellAyx (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (cntY0 : Fin 4) (hcntY0 : cntY0 = 0)
    (hvB0 : vB0.2 = Val.cntAux (cntY0 + 1) (some v0))
    (js : List (Fin I.n)) (hlen2 : outerRest.length = js.length + 1)
    (houterB2 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧
        a.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
       (m = js.length → a.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) none)))
    (hauxAgree : ∀ m, m ≤ js.length → ∃ kw, kws[m]? = some kw ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧ kw.2 = some w) ∧
       (m = js.length → kw.2 = none)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.ellAyx i = some ew ∧
      rawNthRead trace Tid.guessAX Loc.ellAyx i = some er) :
    ew.val = er.val := by
  subst hcntY0
  obtain ⟨i, hew, her⟩ := h
  rcases rawNthWrite_guessAY_ellAyx_eq I v0 kws htraceGAY hew with
    ⟨hi0, hewval⟩ | ⟨kw, hkw, hipos, hewval⟩
  · subst hi0
    rcases rawNthRead_guessAX_ellAyx_eq I v1 v2 vB0 inner0Rest outerRest htraceGAX her with
      ⟨-, herval⟩ | ⟨m, hieq, a, vs, hav, herval⟩
    · rw [hewval, herval, hvB0]
      congr 1
    · omega
  · rcases rawNthRead_guessAX_ellAyx_eq I v1 v2 vB0 inner0Rest outerRest htraceGAX her with
      ⟨hi0, herval⟩ | ⟨m, hieq, a, vs, hav, herval⟩
    · omega
    · have hilen : i - 1 = m := by omega
      rw [hilen] at hkw
      have hmlt : m < outerRest.length := (List.getElem?_eq_some_iff.mp hav).1
      have hmle : m ≤ js.length := by rw [hlen2] at hmlt; omega
      obtain ⟨a', vs', hav', hb2⟩ := houterB2 m hmlt
      rw [hav] at hav'
      simp only [Option.some.injEq, Prod.mk.injEq] at hav'
      obtain ⟨haeq, -⟩ := hav'
      subst haeq
      obtain ⟨kw', hkw', hkwb⟩ := hauxAgree m hmle
      rw [hkw] at hkw'
      injection hkw' with hkw'
      subst hkw'
      have hklen : m < kws.length := by
        have := (List.getElem?_eq_some_iff.mp hkw).1; exact this
      obtain ⟨w0, hkwform⟩ := hkwsVal m hklen
      rw [hkw] at hkwform
      injection hkwform with hkwform
      rcases Nat.lt_or_ge m js.length with hmlt' | hmge'
      · obtain ⟨w, hjw, ha2⟩ := hb2.1 hmlt'
        obtain ⟨w', hjw', hkwaux⟩ := hkwb.1 hmlt'
        rw [hjw] at hjw'
        injection hjw' with hjw'
        subst hjw'
        rw [hewval, herval, ha2, hkwaux, hkwform]
        congr 1
        apply Fin.ext
        simp [Fin.add_def]
        omega
      · have hmeq : m = js.length := by omega
        have ha2 := hb2.2 hmeq
        have hkwaux := hkwb.2 hmeq
        rw [hewval, herval, ha2, hkwaux, hkwform]
        congr 1
        apply Fin.ext
        simp [Fin.add_def]
        omega

/-- `traceRf_matches_guessAX_guessAY_ellAyx` for the general construction,
with `GuessAX` and `GuessAY` drawing the same solution. -/
theorem traceRf_matches_guessAX_guessAY_ellAyx_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (j0 : Fin I.n) (js : List (Fin I.n))
    (kwsAY : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I j0 kwsAY)
    (hlenAY : kwsAY.length = js.length + 1)
    (hvalAY : ∀ i, i < kwsAY.length → ∃ w, kwsAY[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (hlen2A : outerRest.length = js.length + 1)
    (hvB02A : vB0.2 = Val.cntAux (1 : Fin 4) (some j0))
    (houterBA : ∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
      b.1 = Val.cnt (⟨(2 + m) % 4, by omega⟩ : Fin 4) ∧
      (m < js.length → ∃ w, js[m]? = some w ∧
        b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
      (m = js.length → b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) none))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.ellAyx i = some ew ∧
      rawNthRead trace Tid.guessAX Loc.ellAyx i = some er) :
    ew.val = er.val := by
  have hkwsVal : ∀ j, j < kwsAY.length → ∃ w, kwsAY[j]? = some (⟨(1 + j) % 4, by omega⟩, w) := by
    intro j hj
    obtain ⟨w, hw, _⟩ := hvalAY j hj
    exact ⟨w, hw⟩
  have hvB0 : vB0.2 = Val.cntAux ((0 : Fin 4) + 1) (some j0) := by
    rw [hvB02A]; congr 1
  have houterB2 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧
        a.2 = Val.cntAux (⟨((0 : Fin 4).val + 2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
       (m = js.length →
        a.2 = Val.cntAux (⟨((0 : Fin 4).val + 2 + m) % 4, by omega⟩ : Fin 4) none)) := by
    intro m hm
    rw [hlen2A] at hm
    obtain ⟨b, vs, hbv, _, hb2lt, hb2eq⟩ := houterBA m hm
    exact ⟨b, vs, hbv, hb2lt, hb2eq⟩
  have hauxAgree : ∀ m, m ≤ js.length → ∃ kw, kwsAY[m]? = some kw ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧ kw.2 = some w) ∧
       (m = js.length → kw.2 = none)) := by
    intro m hm
    have hmlt : m < kwsAY.length := by omega
    obtain ⟨w, hw, hweq⟩ := hvalAY m hmlt
    refine ⟨(⟨(1 + m) % 4, by omega⟩, w), hw, ?_, ?_⟩
    · intro hmlt2
      refine ⟨js[m], List.getElem?_eq_getElem hmlt2, ?_⟩
      rw [hweq, List.getElem?_eq_getElem hmlt2]
    · intro hmeq
      rw [hweq, hmeq]
      exact List.getElem?_eq_none (le_refl _)
  exact traceRf_matches_guessAX_guessAY_ellAyx I j0 kwsAY htraceGAY hkwsVal v1 v2 vB0
    inner0Rest outerRest htraceGAX 0 rfl hvB0 js hlen2A houterB2 hauxAgree h

/-! ## `rf_matches`: `guessAY`/`checkY` `yA` (Eq. (17))

`w_i(g_α^y,y_α) ⟶rf r_i(c^y,y_α)`. `guessAY` writes its `aux` draw to
`yA` at offset `0` of each block; `checkY` reads `yA` at offset `2`. The
agreement of the two threads' draws is a hypothesis (`hv0eq`/`hkwsAgree`),
discharged from a solution in `traceRf_matches_checkY_guessAY_yA_general`. -/

def guessAYYAWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) : Bool :=
  yAWritePredCore lab.1.loc lab.1.op

theorem guessAYYAWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    guessAYYAWritePred I lab = true ↔ (lab.1.loc = Loc.yA ∧ lab.1.op = OpType.wt) := by
  unfold guessAYYAWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yAWritePredCore_iff y z

theorem guessAYBlock0Elems_yA_filter (I : PCPInstance) (v0 : Fin I.n) :
    (guessAYBlock0Elems I v0).filter (guessAYYAWritePred I) =
      [(⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY)] := by
  apply list_filter_singleton_of_unique' (guessAYBlock0Elems I v0) (guessAYYAWritePred I) 0
    (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩)
    rfl
    (by unfold guessAYYAWritePred
        exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq12 : q = 1 ∨ q = 2 := by omega
      rcases hq12 with rfl | rfl <;>
        simp only [guessAYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessAYYAWritePred
      · exact yAWritePredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
      · exact yAWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide))

theorem guessAYBlockRestElems_yA_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (guessAYBlockRestElems I)).filter (guessAYYAWritePred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessAYBlockRestElems I kw) ++ kws.flatMap (guessAYBlockRestElems I)).filter
        (guessAYYAWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessAYBlockRestElems I kw).filter (guessAYYAWritePred I) =
          [(⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAY)] := by
        apply list_filter_singleton_of_unique' (guessAYBlockRestElems I kw)
          (guessAYYAWritePred I) 0
          (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩)
          rfl
          (by unfold guessAYYAWritePred
              exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
            have hq4 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
            rcases hq4 with rfl | rfl | rfl | rfl <;>
              simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold guessAYYAWritePred
            · exact yAWritePredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
            · exact yAWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
            · exact yAWritePredCore_false_of_ne Loc.zAxy OpType.rd (by decide)
            · exact yAWritePredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthWrite_guessAY_yA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessAY Loc.yA i = some ew) :
    (i = 0 ∧ ew.val = Val.yTag (Tid.guessAY, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.yTag (Tid.guessAY, false) kw.2) := by
  have hpredL := guessAYYAWritePred_iff I
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.yA) (op := OpType.wt)
    (predL := guessAYYAWritePred I) htrace hpredL
  have hlen2 : ((guessAYBlockWord I v0 kws).filter (guessAYYAWritePred I)).length
      = kws.length + 1 := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_yA_filter,
      guessAYBlockRestElems_yA_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYYAWritePred I p.1) =
      [((⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 0)] ++
      ((kws.flatMap (guessAYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessAYYAWritePred I p.1) := by
    unfold guessAYBlockWord
    have hz0 : (((guessAYBlock0Elems I v0).zipIdx).filter
        (fun p => guessAYYAWritePred I p.1)) =
        [((⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 0)] := by
      apply list_filter_singleton_of_unique' ((guessAYBlock0Elems I v0).zipIdx)
        (fun p => guessAYYAWritePred I p.1) 0
        ((⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 0)
        (by rw [List.getElem?_zipIdx]; rfl)
        (by unfold guessAYYAWritePred
            exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
        (by
          intro q b hq hget
          rw [List.getElem?_zipIdx] at hget
          have hqlt : q < 3 := by
            rcases Nat.lt_or_ge q 3 with hqlt | hqge
            · exact hqlt
            · exfalso
              have hqge3 : (guessAYBlock0Elems I v0).length ≤ q := by
                simp only [guessAYBlock0Elems, List.length_cons, List.length_nil]; omega
              have : (guessAYBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge3
              rw [this] at hget; simp at hget
          have hq12 : q = 1 ∨ q = 2 := by omega
          rcases hq12 with rfl | rfl <;>
            simp only [guessAYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
              Option.map_some, Option.some.injEq] at hget <;>
            rw [← hget] <;>
            unfold guessAYYAWritePred
          · exact yAWritePredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
          · exact yAWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide))
    rw [List.zipIdx_append, List.filter_append, hz0]
    congr 2
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
      (l := guessAYBlockWord I v0 kws) htrace hpredL
      (n := 0) (lab := (⟨EventLabel.wt Tid.guessAY Loc.yA
        (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY)) (origPos := 0)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.guessAY Loc.yA OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessAY)
      (guessAYBlockRestElems I) 5 0
      (fun kw => rfl)
      (guessAYYAWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY))
      (fun a => rfl)
      (fun a => by
        unfold guessAYYAWritePred
