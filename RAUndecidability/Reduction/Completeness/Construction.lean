          exact ⟨hwmem, hrmem, hwop, hrop, hwloc⟩
      | Loc.yB =>
          rw [hel] at h
          obtain ⟨i, hw, hr⟩ := h
          obtain ⟨hwmem, -, hwloc, hwop⟩ := rawNthEvent_mem hw
          obtain ⟨hrmem, -, -, hrop⟩ := rawNthEvent_mem hr
          exact ⟨hwmem, hrmem, hwop, hrop, hwloc⟩
      | Loc.xA' =>
          rw [hel] at h
          simp at h
      | Loc.xB' =>
          rw [hel] at h
          simp at h
      | Loc.yA' =>
          rw [hel] at h
          obtain ⟨i, hw, hr⟩ := h
          obtain ⟨hwmem, -, hwloc, hwop⟩ := rawNthEvent_mem hw
          obtain ⟨hrmem, -, -, hrop⟩ := rawNthEvent_mem hr
          exact ⟨hwmem, hrmem, hwop, hrop, hwloc⟩
      | Loc.yB' =>
          rw [hel] at h
          obtain ⟨i, hw, hr⟩ := h
          obtain ⟨hwmem, -, hwloc, hwop⟩ := rawNthEvent_mem hw
          obtain ⟨hrmem, -, -, hrop⟩ := rawNthEvent_mem hr
          exact ⟨hwmem, hrmem, hwop, hrop, hwloc⟩
      | Loc.zAxx' =>
          rw [hel] at h
          simp at h
      | Loc.zAyy' =>
          rw [hel] at h
          simp at h
      | Loc.zBxx' =>
          rw [hel] at h
          simp at h
      | Loc.zByy' =>
          rw [hel] at h
          simp at h
      | Loc.zAxy =>
          rw [hel] at h
          simp at h
      | Loc.zBxy =>
          rw [hel] at h
          simp at h
      | Loc.ellAyx =>
          rw [hel] at h
          simp at h
      | Loc.ellByx =>
          rw [hel] at h
          simp at h
      | Loc.zAx'x =>
          rw [hel] at h
          simp at h
      | Loc.zAy'y =>
          rw [hel] at h
          simp at h
      | Loc.zBx'x =>
          rw [hel] at h
          simp at h
      | Loc.zBy'y =>
          rw [hel] at h
          simp at h

/-! ## `G`'s `mo` ingredient -/

/-- The threads writing each location (as in `Reduction/Threads.lean`): eight
locations with two writers, twelve with one. Used as the hypothesis
`hwriters` of `mo_total` (proved for the constructed trace by
`traceMo_writers_confined`). -/
def writerTids : Loc → Finset Tid
  | .xA => {Tid.checkX, Tid.guessAX}
  | .xB => {Tid.checkX, Tid.guessBX}
  | .yA => {Tid.checkY, Tid.guessAY}
  | .yB => {Tid.checkY, Tid.guessBY}
  | .xA' => {Tid.primeCheckX, Tid.primeAX}
  | .xB' => {Tid.primeCheckX, Tid.primeBX}
  | .yA' => {Tid.primeCheckY, Tid.primeAY}
  | .yB' => {Tid.primeCheckY, Tid.primeBY}
  | .zAxx' => {Tid.primeAX}
  | .zAx'x => {Tid.guessAX}
  | .zAxy => {Tid.guessAX}
  | .zBxx' => {Tid.primeBX}
  | .zBx'x => {Tid.guessBX}
  | .zBxy => {Tid.guessBX}
  | .zAyy' => {Tid.primeAY}
  | .zAy'y => {Tid.guessAY}
  | .ellAyx => {Tid.guessAY}
  | .zByy' => {Tid.primeBY}
  | .zBy'y => {Tid.guessBY}
  | .ellByx => {Tid.guessBY}

/-- The case analysis of Lemma 3.12 ("a
case analysis on `u` shows that either `tid(w_i),tid(w_j) ∈ Tid_x`
or `tid(w_i),tid(w_j) ∈ Tid_y`"): two distinct writers of a location
make it one of the eight two-writer locations, which are non-bridge, with
both writers in the same `ThreadDomX`/`ThreadDomY`. (Stated without
parameters so that `decide` applies.) -/
theorem writerTids_two_diff_dom :
    ∀ (u : Loc) (t1 t2 : Tid), t1 ∈ writerTids u → t2 ∈ writerTids u → t1 ≠ t2 →
      ((t1 ∈ ThreadDomX ∧ t2 ∈ ThreadDomX) ∨ (t1 ∈ ThreadDomY ∧ t2 ∈ ThreadDomY)) ∧
        u ∉ BridgeLoc := by decide

/-- `G`'s `mo` ("Specifying `G.mo`"): writes on a location ordered by
index, with same-index writes on the eight two-writer locations ordered by
Eq. (18). -/
def traceMo (trace : ∀ t, Word (ThreadLabel (domainOf I) t)) (ew1 ew2 : Event (domainOf I)) :
    Prop :=
  ew1.IsWriting ∧ ew2.IsWriting ∧ ew1.loc = ew2.loc ∧
    (rawIndex trace ew1 < rawIndex trace ew2 ∨
      (rawIndex trace ew1 = rawIndex trace ew2 ∧
        ((ew1.tid = Tid.checkX ∧ ew2.tid = Tid.guessAX ∧ ew1.loc = Loc.xA) ∨
         (ew1.tid = Tid.checkX ∧ ew2.tid = Tid.guessBX ∧ ew1.loc = Loc.xB) ∨
         (ew1.tid = Tid.checkY ∧ ew2.tid = Tid.guessAY ∧ ew1.loc = Loc.yA) ∨
         (ew1.tid = Tid.checkY ∧ ew2.tid = Tid.guessBY ∧ ew1.loc = Loc.yB) ∨
         (ew1.tid = Tid.primeCheckX ∧ ew2.tid = Tid.primeAX ∧ ew1.loc = Loc.xA') ∨
         (ew1.tid = Tid.primeCheckX ∧ ew2.tid = Tid.primeBX ∧ ew1.loc = Loc.xB') ∨
         (ew1.tid = Tid.primeCheckY ∧ ew2.tid = Tid.primeAY ∧ ew1.loc = Loc.yA') ∨
         (ew1.tid = Tid.primeCheckY ∧ ew2.tid = Tid.primeBY ∧ ew1.loc = Loc.yB'))))

/-- `G`'s `mo`: `traceMo`, restricted to events of `traceEvents trace`. -/
def traceEventsMo (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (ew1 ew2 : Event (domainOf I)) : Prop :=
  ew1 ∈ traceEvents trace ∧ ew2 ∈ traceEvents trace ∧ traceMo I trace ew1 ew2

/-- `G`'s `mo_subset`, for `traceEventsMo`. -/
theorem traceEventsMo_subset {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {ew1 ew2 : Event (domainOf I)} (h : traceEventsMo I trace ew1 ew2) :
    ew1 ∈ traceEvents trace ∧ ew2 ∈ traceEvents trace ∧
      ew1 ∈ WriteDom (domainOf I) ∧ ew2 ∈ WriteDom (domainOf I) ∧ ew1.loc = ew2.loc := by
  obtain ⟨hmem1, hmem2, hwriting1, hwriting2, hloc, -⟩ := h
  exact ⟨hmem1, hmem2, hwriting1, hwriting2, hloc⟩

/-- `G`'s `mo_total`: the writes on a location `x` are totally ordered.
Two writes of the same thread have different `rawIndex`
(`rawIndex_inj_of_sameTidLocOp`); a tie between different threads only
happens on the eight two-writer locations, where `traceMo` breaks it. For
transitivity, two consecutive tie-breaks on the same location are
impossible. -/
theorem traceEventsMo_total (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (hwriters : ∀ e ∈ traceEvents trace, e.IsWriting → e.tid ∈ writerTids e.loc)
    (x : (domainOf I).Loc) :
    IsStrictTotalOrder {e // e ∈ (traceEvents trace).filter (fun e => e.IsWriting ∧ e.loc = x)}
      (fun a b => traceEventsMo I trace a.1 b.1) := by
  have hmemx : ∀ a : {e // e ∈ (traceEvents trace).filter (fun e => e.IsWriting ∧ e.loc = x)},
      a.1 ∈ traceEvents trace ∧ a.1.IsWriting ∧ a.1.loc = x := fun a => Finset.mem_filter.mp a.2
  have hequiv : ∀ a b : {e // e ∈ (traceEvents trace).filter (fun e => e.IsWriting ∧ e.loc = x)},
      traceEventsMo I trace a.1 b.1 ↔
        (rawIndex trace a.1 < rawIndex trace b.1 ∨ (rawIndex trace a.1 = rawIndex trace b.1 ∧
          ((a.1.tid = Tid.checkX ∧ b.1.tid = Tid.guessAX ∧ a.1.loc = Loc.xA) ∨
           (a.1.tid = Tid.checkX ∧ b.1.tid = Tid.guessBX ∧ a.1.loc = Loc.xB) ∨
           (a.1.tid = Tid.checkY ∧ b.1.tid = Tid.guessAY ∧ a.1.loc = Loc.yA) ∨
           (a.1.tid = Tid.checkY ∧ b.1.tid = Tid.guessBY ∧ a.1.loc = Loc.yB) ∨
           (a.1.tid = Tid.primeCheckX ∧ b.1.tid = Tid.primeAX ∧ a.1.loc = Loc.xA') ∨
           (a.1.tid = Tid.primeCheckX ∧ b.1.tid = Tid.primeBX ∧ a.1.loc = Loc.xB') ∨
           (a.1.tid = Tid.primeCheckY ∧ b.1.tid = Tid.primeAY ∧ a.1.loc = Loc.yA') ∨
           (a.1.tid = Tid.primeCheckY ∧ b.1.tid = Tid.primeBY ∧ a.1.loc = Loc.yB')))) := by
    intro a b
    obtain ⟨hmem_a, hw_a, hloc_a⟩ := hmemx a
    obtain ⟨hmem_b, hw_b, hloc_b⟩ := hmemx b
    unfold traceEventsMo traceMo
    constructor
    · rintro ⟨-, -, -, -, -, h⟩; exact h
    · intro h; exact ⟨hmem_a, hmem_b, hw_a, hw_b, hloc_a.trans hloc_b.symm, h⟩
  have hsame : ∀ a b : {e // e ∈ (traceEvents trace).filter (fun e => e.IsWriting ∧ e.loc = x)},
      a.1.tid = b.1.tid → rawIndex trace a.1 = rawIndex trace b.1 → a = b := by
    intro a b htid heq
    obtain ⟨hmem_a, hw_a, hloc_a⟩ := hmemx a
    obtain ⟨hmem_b, hw_b, hloc_b⟩ := hmemx b
    apply Subtype.ext
    refine rawIndex_inj_of_sameTidLocOp
      (t := a.1.tid) (x := x) (op := OpType.wt) (e1 := a.1) (e2 := b.1)
      (mem_traceEvents_of_tid hmem_a rfl) (mem_traceEvents_of_tid hmem_b htid.symm)
      rfl hloc_a hw_a htid.symm hloc_b hw_b heq
  refine
  { trichotomous := fun a b hab hba => ?_
    irrefl := fun a h => ?_
    trans := fun a b c hab hbc => ?_ }
  · -- trichotomous
    rw [hequiv] at hab hba
    rcases lt_trichotomy (rawIndex trace a.1) (rawIndex trace b.1) with hlt | heqidx | hgt
    · exact absurd (Or.inl hlt) hab
    · by_cases htideq : a.1.tid = b.1.tid
      · exact hsame a b htideq heqidx
      · exfalso
        obtain ⟨hmem_a, hw_a, hloc_a⟩ := hmemx a
        obtain ⟨hmem_b, hw_b, hloc_b⟩ := hmemx b
        have haw : a.1.tid ∈ writerTids x := by
          have := hwriters a.1 hmem_a hw_a; rwa [hloc_a] at this
        have hbw : b.1.tid ∈ writerTids x := by
          have := hwriters b.1 hmem_b hw_b; rwa [hloc_b] at this
        have mem2 : ∀ {t c1 c2 : Tid}, t ∈ ({c1, c2} : Finset Tid) → t = c1 ∨ t = c2 := by
          intro t c1 c2 h
          rcases Finset.mem_insert.mp h with h | h
          · exact Or.inl h
          · exact Or.inr (Finset.mem_singleton.mp h)
        change Loc at x
        rcases x with _|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_ <;>
          first
            | exact absurd ((Finset.mem_singleton.mp haw).trans
                (Finset.mem_singleton.mp hbw).symm) htideq
            | rcases mem2 haw with haw | haw <;> rcases mem2 hbw with hbw | hbw <;>
          first
            | exact absurd (haw.trans hbw.symm) htideq
            | exact absurd (Or.inr ⟨heqidx, by
                first
                  | exact Or.inl ⟨haw, hbw, hloc_a⟩
                  | exact Or.inr (Or.inl ⟨haw, hbw, hloc_a⟩)
                  | exact Or.inr (Or.inr (Or.inl ⟨haw, hbw, hloc_a⟩))
                  | exact Or.inr (Or.inr (Or.inr (Or.inl ⟨haw, hbw, hloc_a⟩)))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨haw, hbw, hloc_a⟩))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨haw, hbw, hloc_a⟩)))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
                      (Or.inl ⟨haw, hbw, hloc_a⟩))))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
                      (Or.inr ⟨haw, hbw, hloc_a⟩))))))⟩) hab
            | exact absurd (Or.inr ⟨heqidx.symm, by
                first
                  | exact Or.inl ⟨hbw, haw, hloc_b⟩
                  | exact Or.inr (Or.inl ⟨hbw, haw, hloc_b⟩)
                  | exact Or.inr (Or.inr (Or.inl ⟨hbw, haw, hloc_b⟩))
                  | exact Or.inr (Or.inr (Or.inr (Or.inl ⟨hbw, haw, hloc_b⟩)))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hbw, haw, hloc_b⟩))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl ⟨hbw, haw, hloc_b⟩)))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
                      (Or.inl ⟨hbw, haw, hloc_b⟩))))))
                  | exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr
                      (Or.inr ⟨hbw, haw, hloc_b⟩))))))⟩) hba
    · exact absurd (Or.inl hgt) hba
  · -- irrefl
    rw [hequiv] at h
    rcases h with h | ⟨-, h⟩
    · exact absurd h (lt_irrefl _)
    · rcases h with ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ |
        ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ <;>
        (have heq := h1.symm.trans h2; cases heq)
  · -- trans
    rw [hequiv] at hab hbc ⊢
    rcases hab with hab | ⟨habidx, habTB⟩
    · rcases hbc with hbc | ⟨hbcidx, -⟩
      · exact Or.inl (hab.trans hbc)
      · exact Or.inl (hbcidx ▸ hab)
    · rcases hbc with hbc | ⟨hbcidx, hbcTB⟩
      · exact Or.inl (habidx ▸ hbc)
      · exfalso
        rcases habTB with ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ |
          ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ | ⟨h1, h2, -⟩ <;>
        rcases hbcTB with ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ |
          ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ | ⟨h3, h4, -⟩ <;>
          (have heq := h2.symm.trans h3; cases heq)

/-! ## `PrimeAX` (`g_α^{x'}`) -/

/-- The PCP instance of the concrete runs below (`n = 1`, `Γ = Bool`,
`α = β = [true]`), with solution `j = [0]`. -/
def testInstance : PCPInstance where
  n := 1
  hn := by omega
  Γ := Bool
  α := fun _ => [true]
  β := fun _ => [true]
  hα := by simp
  hβ := by simp

/-- `PrimeAX`'s initial store. -/
noncomputable def primeAXInit : (PrimeAX.Vocab testInstance).Store :=
  (PrimeAX.Vocab testInstance).mkStore
    (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none)
    (Sum.inl 0)

/-- The resolution of `PrimeAX`'s `while NDet({False, True})` loop: `L_x = 2`
iterations, `[True, True, False]`. -/
def primeAXRes : List (PrimeAX.Vals) := [Sum.inr true, Sum.inr true, Sum.inr false]

/-- `PrimeAX`'s word under `primeAXRes` (checked by `primeAX_word_check`): two
iterations, each writing `xA'`/`zAxx'` and reading `zAx'x`. -/
noncomputable def primeAXExpectedWord : Word (EventLabel (domainOf testInstance)) :=
  [ EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0)
  , EventLabel.wt Tid.primeAX Loc.zAxx' (Val.cnt 1)
  , EventLabel.rd Tid.primeAX Loc.zAx'x (Val.cnt 1)
  , EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0)
  , EventLabel.wt Tid.primeAX Loc.zAxx' (Val.cnt 2)
  , EventLabel.rd Tid.primeAX Loc.zAx'x (Val.cnt 2) ]

theorem primeAX_status :
    (Command.runFuel Tid.primeAX (PrimeAX.program testInstance, primeAXInit)
      primeAXRes 50).1 = .stuck := by decide

theorem primeAX_word_check :
    (Command.runFuel Tid.primeAX (PrimeAX.program testInstance, primeAXInit)
      primeAXRes 50).2.1.map Subtype.val = primeAXExpectedWord := by decide

/-- The `Command.Run` of `PrimeAX`, from `primeAX_status` by
`Command.runFuel_sound`. -/
theorem primeAX_run_witness :
    ∃ cLast sf cf,
      Command.Run Tid.primeAX primeAXRes (PrimeAX.program testInstance, primeAXInit)
        (Command.runFuel Tid.primeAX (PrimeAX.program testInstance, primeAXInit)
          primeAXRes 50).2.1
        cLast sf cf := by
  have hstatus := primeAX_status
  generalize hcomp : Command.runFuel Tid.primeAX (PrimeAX.program testInstance, primeAXInit)
    primeAXRes 50 = result at hstatus ⊢
  obtain ⟨res, σ, cf, sf⟩ := result
  have hres : res = .stuck := hstatus
  subst hres
  obtain ⟨cLast, hrun⟩ := Command.runFuel_sound Tid.primeAX 50
    (PrimeAX.program testInstance, primeAXInit) primeAXRes σ cf sf hcomp
  exact ⟨cLast, sf, cf, hrun⟩

/-! ## `GuessAY` (`g_α^y`) -/

/-- `GuessAY`'s initial store: `cnt := 0`, `fst := True`. -/
noncomputable def guessAYInit : (GuessAY.Vocab testInstance).Store :=
  (GuessAY.Vocab testInstance).mkStore
    (fun v => match v with
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr true))
      | _ => none)
    (Sum.inr (Sum.inl 0))

/-- The resolution of `GuessAY`'s `NDet`s on `aux`: `some 0`, then `none`. -/
def guessAYRes : List (GuessAY.Vals testInstance) :=
  [Sum.inl (some (⟨0, testInstance.hn⟩ : Fin testInstance.n)), Sum.inl none]

/-- `GuessAY`'s word under `guessAYRes` (checked by `guessAY_word_check`):
the first iteration takes the `First()` branch (three writes), the second the
`else` branch (three writes, two reads), then the loop exits. -/
noncomputable def guessAYExpectedWord : Word (EventLabel (domainOf testInstance)) :=
  [ EventLabel.wt Tid.guessAY Loc.yA
      (Val.yTag (Tid.guessAY, true) (some (⟨0, testInstance.hn⟩ : Fin testInstance.n)))
  , EventLabel.wt Tid.guessAY Loc.ellAyx
      (Val.cntAux 1 (some (⟨0, testInstance.hn⟩ : Fin testInstance.n)))
  , EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1)
  , EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) none)
  , EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 2 none)
  , EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 2)
  , EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt 1)
  , EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt 1) ]

theorem guessAY_status :
    (Command.runFuel Tid.guessAY (GuessAY.program testInstance, guessAYInit)
      guessAYRes 50).1 = .stuck := by decide

theorem guessAY_word_check :
    (Command.runFuel Tid.guessAY (GuessAY.program testInstance, guessAYInit)
      guessAYRes 50).2.1.map Subtype.val = guessAYExpectedWord := by decide

/-- The `Command.Run` of `GuessAY`, from `guessAY_status`. -/
theorem guessAY_run_witness :
    ∃ cLast sf cf,
      Command.Run Tid.guessAY guessAYRes (GuessAY.program testInstance, guessAYInit)
        (Command.runFuel Tid.guessAY (GuessAY.program testInstance, guessAYInit)
          guessAYRes 50).2.1
        cLast sf cf := by
  have hstatus := guessAY_status
  generalize hcomp : Command.runFuel Tid.guessAY (GuessAY.program testInstance, guessAYInit)
    guessAYRes 50 = result at hstatus ⊢
  obtain ⟨res, σ, cf, sf⟩ := result
  have hres : res = .stuck := hstatus
  subst hres
  obtain ⟨cLast, hrun⟩ := Command.runFuel_sound Tid.guessAY 50
    (GuessAY.program testInstance, guessAYInit) guessAYRes σ cf sf hcomp
  exact ⟨cLast, sf, cf, hrun⟩

/-! ## `GuessAX` (`g_α^x`) -/

/-- `GuessAX`'s initial store. -/
noncomputable def guessAXInit : (GuessAX.Vocab testInstance).Store :=
  (GuessAX.Vocab testInstance).mkStore
    (fun v => match v with
      | .cntY => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr (Sum.inr true)))
      | _ => none)
    (Sum.inl none)

/-- The resolution of `GuessAX`'s `NDet`s on `aux`: `some 0`, then `none`
(`j_1, …, j_k, ⊥`). The bound `N := |α_aux|` of the inner `for` loop is
computed, not drawn. -/
def guessAXRes : List (GuessAX.Vals testInstance) :=
  [Sum.inl (some (⟨0, testInstance.hn⟩ : Fin testInstance.n)), Sum.inl none]

/-- `GuessAX`'s word under `guessAXRes` (checked by `guessAX_word_check`): two
outer iterations, each writing `z_α^{x,y}`, running the inner loop once
(`|α_0| = 1`, `α_⊥ = [⊥]`) and reading `ℓ_α^{y,x}`; the first inner call takes
the `First()` branch (no read of `z_α^{x,x'}`). -/
noncomputable def guessAXExpectedWord : Word (EventLabel (domainOf testInstance)) :=
  [ EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt 1)
  , EventLabel.wt Tid.guessAX Loc.xA (Val.xTag (Tid.guessAX, true) (some true))
  , EventLabel.wt Tid.guessAX Loc.zAx'x (Val.cnt 1)
  , EventLabel.rd Tid.guessAX Loc.ellAyx
      (Val.cntAux 1 (some (⟨0, testInstance.hn⟩ : Fin testInstance.n)))
  , EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt 2)
  , EventLabel.wt Tid.guessAX Loc.xA (Val.xTag (Tid.guessAX, false) none)
