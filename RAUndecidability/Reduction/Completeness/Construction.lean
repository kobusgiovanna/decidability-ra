import RAUndecidability.Reduction.Index
import RAUndecidability.Reduction.Threads
import RAUndecidability.ProgramSemantics.Interpreter
import RAUndecidability.Reduction.ConcProg
import RAUndecidability.Util.List
import Mathlib.Data.Nat.Pairing
import Mathlib.Tactic.Linarith
import Mathlib.Data.List.Chain
import Mathlib.Data.Finset.Card
import Mathlib.Tactic.FinCases

/-!
# The constructed execution graph `G`

The ingredients of Section 3.5's construction: the execution graph `G` (§3.5), bridge events (§3.5)
and the thread sets (§3.5), and the twelve threads' runs from which `G` is built.

* **Events and `po`**, for an arbitrary trace assignment
  `trace : ∀ t, Word (ThreadLabel D t)`: `traceEventId`/`idPos` (event ids and
  the positions they encode), `traceEventsOf`/`traceEvents` (`G`'s
  `Events`), `tracePo`/`traceEventsPo` ("Specifying `G.po`": same thread,
  earlier position), and `rawOpEvents`/`rawNthEvent`/`rawNthWrite`/
  `rawNthRead`/`rawIndex`, the counterparts of `ExecutionGraph.opEvents`/
  `nthEvent`/`nthWrite`/`nthRead`/`index` computed from the trace directly, so
  that `rf` and `mo` can be defined before `G` exists. For any `G` with
  `G.Events = traceEvents trace` and `G.po = traceEventsPo trace`, the two
  agree (`ExecutionGraph.threadEvents_map_val_eq_traceEventsOf`,
  `ExecutionGraph.threadWord_eq_trace`, `ExecutionGraph.opEvents_eq_rawOpEvents`,
  `nthEvent_eq_rawNthEvent`, `index_eq_rawIndex`).
* **`traceRf`** (`G`'s `rf`): Eq. (15)-(17) (Eq. (15),
  Eq. (16)/(17)), as in "Specifying `G.rf`": "`w_i` is
  the `i`-th write of the *unique* thread writing a value that matches that of
  `r_i`", a case split on the reader's thread and location naming the
  writer. Agreement of values is the obligation `rf_matches`.
* **`traceMo`** (`G`'s `mo`): writes ordered by index (`rawIndex`), with
  ties on the eight two-writer locations broken by the eight edges of
  Eq. (18).
* **bridge events (§3.5)**: `BridgeLoc` and `Event.IsBridge`.
* **the thread sets (§3.5)**: `ThreadDomX`/`ThreadDomY`.

## Runs of the twelve threads

Each thread's run is obtained from a resolution (the sequence of values its
`NDet`s draw, as described in "The events of `G`") by the interpreter
`Command.runFuel`, and turned into a `Command.Run` by `Command.runFuel_sound`.
For a concrete instance `testInstance` and solution `[0]`
(`α_0 = β_0 = [true]`), the emitted words are checked by `decide`
(`*_word_check`). For `GuessAX`/`GuessBX`/`GuessAY`/`GuessBY` the values
written to `x_α`/`x_β`/`y_α`/`y_β` are moreover compared with those named in
"The events of `G`" (`α_{j_1}⋯ α_{j_k}· ⊥`, `β_{j_1}⋯ β_{j_k}· ⊥`,
`j_1,…,j_k,⊥`): `guessAX_writes_construction_letters` and its siblings.

For the concrete instance, `L_x := |α_{j_1} ⋯ α_{j_k} · ⊥| = 2` and
`L_y := k + 1 = 2`. As in "The event sequence of the primed threads", `g_α^{x'}`,
`g_β^{x'}`, `c^{x'}` run `L_x` times and `g_α^{y'}`, `g_β^{y'}`, `c^{y'}` run `L_y` times; `c^x`
iterates over the letters of `α_{j_1}⋯ α_{j_k}· ⊥` and `c^y` over
`j_1,…,j_k,⊥`. A `while NDet` loop running `N` times has resolution
`List.replicate N true ++ [false]`.
-/

namespace RAUndecidability

variable {D : Domains}

/-- Decidable equality on events. -/
instance : DecidableEq (Event D) := fun e1 e2 =>
  decidable_of_iff (e1.id = e2.id ∧ e1.lab = e2.lab) (by rcases e1; rcases e2; simp)

section Generic

variable [Fintype D.Tid]

/-- A globally unique id for the `i`-th event of thread `t`: the thread's
index (as a `Fin`) paired with `i` via `Nat.pair`. Events from different
threads, or at different positions of the same thread, never collide, even
when their labels coincide. -/
noncomputable def traceEventId (t : D.Tid) (i : ℕ) : ℕ :=
  Nat.pair ((Fintype.equivFin D.Tid t : Fin (Fintype.card D.Tid)) : ℕ) i

/-- The position of an event within its own thread's trace, recovered from
its id (the second component of the `Nat.pair` encoding underlying
`traceEventId`). Meaningful for events actually produced by `traceEventsOf`
below; a junk but total value otherwise. -/
def idPos (e : Event D) : ℕ := (Nat.unpair e.id).2

/-- The events of thread `t` under a trace assignment: one event per
position, with id `traceEventId t i` and label the `i`-th entry of the
trace's underlying `EventLabel`. Already in `tracePo`-order: `List.zipIdx`
walks `trace t` in increasing position, and `idPos` reads that same position
straight back off the id. -/
noncomputable def traceEventsOf (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) :
    List (Event D) :=
  ((trace t).zipIdx).map fun (l, i) => (⟨traceEventId t i, l.1⟩ : Event D)

/-- `G`'s `Events`: the events of every thread under a trace assignment,
collected into one `Finset`. -/
noncomputable def traceEvents (trace : ∀ t, Word (ThreadLabel D t)) : Finset (Event D) :=
  Finset.univ.biUnion fun t => (traceEventsOf trace t).toFinset

/-- `G`'s `po` ("Specifying `G.po`"): events of the same thread, ordered
by position. (Membership in `traceEvents trace` is added in
`traceEventsPo`.) -/
def tracePo (e1 e2 : Event D) : Prop := e1.tid = e2.tid ∧ idPos e1 < idPos e2

/-- `G`'s `po`: `tracePo`, restricted to events of `traceEvents trace`. -/
def traceEventsPo (trace : ∀ t, Word (ThreadLabel D t)) (e1 e2 : Event D) : Prop :=
  e1 ∈ traceEvents trace ∧ e2 ∈ traceEvents trace ∧ tracePo e1 e2

/-- `G`'s `po_subset`, for `traceEventsPo`. -/
theorem traceEventsPo_subset {trace : ∀ t, Word (ThreadLabel D t)} {e1 e2 : Event D}
    (h : traceEventsPo trace e1 e2) :
    e1 ∈ traceEvents trace ∧ e2 ∈ traceEvents trace ∧ e1.tid = e2.tid :=
  ⟨h.1, h.2.1, h.2.2.1⟩

/-- The events of thread `t`, location `x`, operation `op`, in `tracePo`-order:
the counterpart of `ExecutionGraph.opEvents`, filtering `traceEventsOf`. -/
noncomputable def rawOpEvents (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) (x : D.Loc)
    (op : OpType) : List (Event D) :=
  (traceEventsOf trace t).filter fun e => e.loc = x ∧ e.op = op

/-- The standalone analogue of `ExecutionGraph.nthEvent`. -/
noncomputable def rawNthEvent (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) (x : D.Loc)
    (op : OpType) (i : ℕ) : Option (Event D) :=
  (rawOpEvents trace t x op)[i]?

/-- The standalone analogue of `ExecutionGraph.nthWrite`. -/
noncomputable def rawNthWrite (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) (x : D.Loc)
    (i : ℕ) : Option (Event D) :=
  rawNthEvent trace t x .wt i

/-- The standalone analogue of `ExecutionGraph.nthRead`. -/
noncomputable def rawNthRead (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) (x : D.Loc)
    (i : ℕ) : Option (Event D) :=
  rawNthEvent trace t x .rd i

/-- The standalone analogue of `ExecutionGraph.index`. -/
noncomputable def rawIndex (trace : ∀ t, Word (ThreadLabel D t)) (e : Event D) : ℕ :=
  (rawOpEvents trace e.tid e.loc e.op).idxOf e

/-- `rawNthEvent trace t x op n = some e` implies that `e` is in
`traceEvents trace`, with thread `t`, location `x`, operation `op`. -/
theorem rawNthEvent_mem {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {x : D.Loc}
    {op : OpType} {n : ℕ} {e : Event D} (h : rawNthEvent trace t x op n = some e) :
    e ∈ traceEvents trace ∧ e.tid = t ∧ e.loc = x ∧ e.op = op := by
  have hmemraw : e ∈ rawOpEvents trace t x op := by
    unfold rawNthEvent at h
    obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.mp h
    exact heq ▸ List.getElem_mem hlt
  have hmemE : e ∈ traceEventsOf trace t ∧ e.loc = x ∧ e.op = op := by
    unfold rawOpEvents at hmemraw
    simpa using hmemraw
  have hteq : e.tid = t := by
    obtain ⟨hmemEv, -, -⟩ := hmemE
    unfold traceEventsOf at hmemEv
    simp only [List.mem_map] at hmemEv
    obtain ⟨⟨l, i⟩, -, heq⟩ := hmemEv
    have hlabeq : e.lab = l.1 := congrArg Event.lab heq.symm
    change e.tid = t
    unfold Event.tid
    rw [hlabeq, l.2]
  have hmemG : e ∈ traceEvents trace := by
    unfold traceEvents
    exact Finset.mem_biUnion.mpr ⟨t, Finset.mem_univ t, List.mem_toFinset.mpr hmemE.1⟩
  exact ⟨hmemG, hteq, hmemE.2.1, hmemE.2.2⟩

/-- If each block starts where the previous one ends (`hstart`), block `a`
ends at or before the start of block `b`, for `a < b`. -/
theorem blockStart_add_blockLen_le {blockStart blockLen : ℕ → ℕ}
    (hstart : ∀ n, blockStart (n + 1) = blockStart n + blockLen n)
    {a b : ℕ} (hab : a < b) : blockStart a + blockLen a ≤ blockStart b := by
  induction b with
  | zero => omega
  | succ b ih =>
      rcases Nat.lt_succ_iff_lt_or_eq.mp hab with h | h
      · have := ih h
        have hrec := hstart b
        omega
      · subst h
        rw [hstart a]

omit [Fintype D.Tid] in
/-- The arithmetic behind Lemma 3.4: for blocks as in
`hstart`, two events of the same thread at positions `blockStart n + p`
(within their blocks) satisfy, along a `tracePo`-edge into a write,
`n1 ≤ n2`, strictly if the source is a read. -/
theorem blockIndex_po_monotone {blockStart blockLen writesLen : ℕ → ℕ}
    (hstart : ∀ n, blockStart (n + 1) = blockStart n + blockLen n)
    {e1 e2 : Event D} {n1 p1 n2 p2 : ℕ}
    (hp1 : p1 < blockLen n1) (hp2 : p2 < blockLen n2)
    (hidPos1 : idPos e1 = blockStart n1 + p1) (hidPos2 : idPos e2 = blockStart n2 + p2)
    (hread1 : e1.op = .rd → writesLen n1 ≤ p1) (hwrite2 : e2.op = .wt → p2 < writesLen n2)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) :
    n1 ≤ n2 ∧ (e1.op = .rd → n1 < n2) := by
  obtain ⟨_, hidlt⟩ := hpo
  rw [hidPos1, hidPos2] at hidlt
  have hp2' := hwrite2 hwt2
  have hle : n1 ≤ n2 := by
    by_contra hcon
    have h : n2 < n1 := Nat.not_le.mp hcon
    have := blockStart_add_blockLen_le hstart h
    omega
  refine ⟨hle, fun hrd => ?_⟩
  have hp1' := hread1 hrd
  rcases Nat.lt_or_ge n1 n2 with h | h
  · exact h
  · exfalso
    rcases Nat.eq_or_lt_of_le h with heq | hgt
    · subst heq
      omega
    · have := blockStart_add_blockLen_le hstart hgt
      omega

/-- Lemma 3.4 for the primed threads's index lemma: if the positions of two events of
the same thread are `block * L + offset` (with `offset < L`, and in the
block's write prefix for a write), a `tracePo`-edge between them gives the
stated inequality on their `rawIndex`. -/
theorem flatLoop_po_monotone (trace : ∀ t, Word (ThreadLabel D t))
    (writesLen L : ℕ) (_hWL : writesLen ≤ L)
    {e1 e2 : Event D} {n1 p1 n2 p2 : ℕ} (hp1L : p1 < L) (hp2L : p2 < L)
    (hidPos1 : idPos e1 = n1 * L + p1) (hidPos2 : idPos e2 = n2 * L + p2)
    (hrawIdx1 : rawIndex trace e1 = n1) (hrawIdx2 : rawIndex trace e2 = n2)
    (hread1 : e1.op = .rd → writesLen ≤ p1) (hwrite2 : e2.op = .wt → p2 < writesLen)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have h := blockIndex_po_monotone (blockStart := fun n => n * L) (blockLen := fun _ => L)
    (writesLen := fun _ => writesLen) (fun n => Nat.succ_mul n L) hp1L hp2L hidPos1 hidPos2
    hread1 hwrite2 hpo hwt2
  rw [hrawIdx1, hrawIdx2]
  exact h

/-- Membership in `traceEventsOf`, in terms of a position in `trace t` and its
label. -/
theorem mem_traceEventsOf_iff' {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {e : Event D} :
    e ∈ traceEventsOf trace t ↔
      ∃ i : ℕ, ∃ l : ThreadLabel D t, (trace t)[i]? = some l ∧ e = ⟨traceEventId t i, l.1⟩ := by
  unfold traceEventsOf
  simp only [List.mem_iff_getElem?, List.getElem?_map, List.getElem?_zipIdx, Nat.zero_add,
    Option.map_eq_some_iff]
  constructor
  · rintro ⟨i, ⟨l, j⟩, ⟨l', hget, heq⟩, rfl⟩
    injection heq with h1 h2
    subst h1; subst h2
    exact ⟨i, l', hget, rfl⟩
  · rintro ⟨i, l, hget, rfl⟩
    exact ⟨i, (l, i), ⟨l, hget, rfl⟩, rfl⟩

/-- If every label of a thread's word has its `(loc, op)` in `shape`, so does
every event of that thread in `traceEventsOf`. -/
theorem traceEventsOf_locOp_mem_of_forall {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {shape : List (D.Loc × OpType)} (hshape : ∀ x ∈ l, (x.1.loc, x.1.op) ∈ shape)
    {e : Event D} (he : e ∈ traceEventsOf trace t) :
    (e.loc, e.op) ∈ shape := by
  obtain ⟨i, lab, hget, rfl⟩ := mem_traceEventsOf_iff'.mp he
  rw [htrace] at hget
  have hmem : lab ∈ l := List.mem_iff_getElem?.mpr ⟨i, hget⟩
  exact hshape lab hmem

/-- `rawNthEvent trace t x op n`, computed from a position in
`l.zipIdx.filter` (where `trace t = l`). -/
theorem rawNthEvent_of_zipIdx_filter {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {predL : ThreadLabel D t → Bool} {x : D.Loc} {op : OpType}
    (hpredL : ∀ lab, predL lab = true ↔ (lab.1.loc = x ∧ lab.1.op = op))
    {n : ℕ} {lab : ThreadLabel D t} {origPos : ℕ}
    (hfilt : (l.zipIdx.filter (fun p => predL p.1))[n]? = some (lab, origPos)) :
    rawNthEvent trace t x op n = some (⟨traceEventId t origPos, lab.1⟩ : Event D) := by
  unfold rawNthEvent rawOpEvents traceEventsOf
  rw [htrace, List.filter_map]
  have hpred_eq : (fun e : Event D => decide (e.loc = x ∧ e.op = op)) ∘
      (fun p : ThreadLabel D t × ℕ => (⟨traceEventId t p.2, p.1.1⟩ : Event D)) =
      fun p : ThreadLabel D t × ℕ => predL p.1 := by
    funext p
    obtain ⟨la, i⟩ := p
    simp only [Function.comp]
    apply Bool.eq_iff_iff.mpr
    rw [decide_eq_true_iff]
    exact (hpredL la).symm
  rw [hpred_eq, List.getElem?_map, hfilt]
  rfl

/-- The length of `rawOpEvents trace t x op` as the length of a filter of `l`
(where `trace t = l`). -/
theorem rawOpEvents_length_eq {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {predL : ThreadLabel D t → Bool} {x : D.Loc} {op : OpType}
    (hpredL : ∀ lab, predL lab = true ↔ (lab.1.loc = x ∧ lab.1.op = op)) :
    (rawOpEvents trace t x op).length = (l.filter predL).length := by
  unfold rawOpEvents traceEventsOf
  rw [htrace, List.filter_map, List.length_map]
  have h1 : (l.zipIdx).map Prod.fst = l := List.zipIdx_map_fst 0 l
  have h2 : (l.filter predL) = ((l.zipIdx).map Prod.fst).filter predL := by rw [h1]
  have h3 : ((l.zipIdx).map Prod.fst).filter predL =
      ((l.zipIdx).filter (predL ∘ Prod.fst)).map Prod.fst := List.filter_map
  have hpred_eq : (fun e : Event D => decide (e.loc = x ∧ e.op = op)) ∘
      (fun p : ThreadLabel D t × ℕ => (⟨traceEventId t p.2, p.1.1⟩ : Event D)) =
      predL ∘ Prod.fst := by
    funext p
    obtain ⟨la, i⟩ := p
    simp only [Function.comp]
    apply Bool.eq_iff_iff.mpr
    rw [decide_eq_true_iff]
    exact (hpredL la).symm
  rw [hpred_eq, h2, h3, List.length_map]

/-- If every `(x, op)` label of thread `t`'s word carries the same value `c`,
so does every `rawNthEvent trace t x op n`. -/
theorem rawNthEvent_val_of_forall_mem {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {x : D.Loc} {op : OpType} {c : D.Val}
    (hval : ∀ lab ∈ l, lab.1.loc = x → lab.1.op = op → lab.1.val = c)
    {n : ℕ} {e : Event D} (h : rawNthEvent trace t x op n = some e) :
    e.val = c := by
  unfold rawNthEvent rawOpEvents traceEventsOf at h
  rw [htrace, List.filter_map, List.getElem?_map] at h
  rw [Option.map_eq_some_iff] at h
  obtain ⟨p, hget, hpe⟩ := h
  have hmemf := List.mem_of_getElem? hget
  rw [List.mem_filter] at hmemf
  obtain ⟨hzip, hp⟩ := hmemf
  simp only [Function.comp_apply, decide_eq_true_eq] at hp
  have hlab_mem : p.1 ∈ l := by
    rw [← List.zipIdx_map_fst 0 l]
    exact List.mem_map_of_mem hzip
  have hvaleq := hval p.1 hlab_mem hp.1 hp.2
  rw [← hpe]
  exact hvaleq

/-- `rawNthEvent_val_of_forall_mem`, specialized to a write. -/
theorem rawNthWrite_val_of_forall_mem {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {x : D.Loc} {c : D.Val}
    (hval : ∀ lab ∈ l, lab.1.loc = x → lab.1.op = OpType.wt → lab.1.val = c)
    {n : ℕ} {e : Event D} (h : rawNthWrite trace t x n = some e) :
    e.val = c :=
  rawNthEvent_val_of_forall_mem htrace hval h

/-- `rawNthEvent_val_of_forall_mem`, specialized to a read. -/
theorem rawNthRead_val_of_forall_mem {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {l : Word (ThreadLabel D t)} (htrace : trace t = l)
    {x : D.Loc} {c : D.Val}
    (hval : ∀ lab ∈ l, lab.1.loc = x → lab.1.op = OpType.rd → lab.1.val = c)
    {n : ℕ} {e : Event D} (h : rawNthRead trace t x n = some e) :
    e.val = c :=
  rawNthEvent_val_of_forall_mem htrace hval h

/-- `traceEventsOf`'s events are pairwise distinct (their ids are). -/
theorem traceEventsOf_nodup (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) :
    (traceEventsOf trace t).Nodup := by
  unfold traceEventsOf
  apply List.Nodup.map
  · rintro ⟨l1, i1⟩ ⟨l2, i2⟩ heq
    simp only at heq
    have hid : traceEventId t i1 = traceEventId t i2 := congrArg Event.id heq
    have hlab : l1.1 = l2.1 := congrArg Event.lab heq
    unfold traceEventId at hid
    have := Nat.pair_eq_pair.mp hid
    simp [Subtype.ext hlab, this.2]
  · exact List.Nodup.of_map Prod.snd (by
      rw [List.zipIdx_map_snd]; exact List.nodup_range')

/-- Within one `traceRf` branch, two writes into the same read coincide:
`rawNthRead trace TR L` is injective. -/
theorem rawNthWrite_unique_of_rawNthRead {trace : ∀ t, Word (ThreadLabel D t)}
    {TW TR : D.Tid} {L : D.Loc} {ew1 ew2 er : Event D}
    (h1 : ∃ i, rawNthWrite trace TW L i = some ew1 ∧ rawNthRead trace TR L i = some er)
    (h2 : ∃ i, rawNthWrite trace TW L i = some ew2 ∧ rawNthRead trace TR L i = some er) :
    ew1 = ew2 := by
  obtain ⟨i1, hw1, hr1⟩ := h1
  obtain ⟨i2, hw2, hr2⟩ := h2
  unfold rawNthRead at hr1 hr2
  have hnodup : (rawOpEvents trace TR L .rd).Nodup := (traceEventsOf_nodup trace TR).filter _
  have hlt1 : i1 < (rawOpEvents trace TR L .rd).length := by
    unfold rawNthEvent at hr1
    exact (List.getElem?_eq_some_iff.mp hr1).1
  have hidx : i1 = i2 := (List.getElem?_inj hlt1 hnodup).mp (hr1.trans hr2.symm)
  rw [hidx] at hw1
  exact Option.some.inj (hw1.symm.trans hw2)

/-- The `n`-th entry of `traceEventsOf trace t`, from the `n`-th entry of
`trace t`. -/
theorem traceEventsOf_getElem? (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) (n : ℕ) :
    (traceEventsOf trace t)[n]? =
      ((trace t)[n]?).map fun x => (⟨traceEventId t n, x.1⟩ : Event D) := by
  unfold traceEventsOf
  rw [List.getElem?_map, List.getElem?_zipIdx]
  rcases h : (trace t)[n]? with _ | x <;> simp [h]

/-- `idPos` is injective on `traceEventsOf trace t`. -/
theorem traceEventsOf_idPos_inj {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {e1 e2 : Event D} (h1 : e1 ∈ traceEventsOf trace t) (h2 : e2 ∈ traceEventsOf trace t)
    (heq : idPos e1 = idPos e2) : e1 = e2 := by
  obtain ⟨n1, hn1⟩ := List.mem_iff_getElem?.mp h1
  obtain ⟨n2, hn2⟩ := List.mem_iff_getElem?.mp h2
  rw [traceEventsOf_getElem?] at hn1 hn2
  have hpos : ∀ n e, ((trace t)[n]?).map (fun x => (⟨traceEventId t n, x.1⟩ : Event D)) = some e →
      idPos e = n := by
    intro n e he
    rcases h : (trace t)[n]? with _ | x
    · rw [h] at he; simp at he
    · rw [h] at he
      simp only [Option.map_some, Option.some.injEq] at he
      rw [← he]
      unfold idPos traceEventId
      simp [Nat.unpair_pair]
  have hp1 := hpos n1 e1 hn1
  have hp2 := hpos n2 e2 hn2
  have hn12 : n1 = n2 := by rw [← hp1, ← hp2, heq]
  rw [hn12] at hn1
  have hsome : some e1 = some e2 := hn1.symm.trans hn2
  injection hsome

/-- An event of thread `t` in `traceEvents trace` is in
`traceEventsOf trace t`. -/
theorem mem_traceEvents_of_tid {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {e : Event D}
    (hmem : e ∈ traceEvents trace) (htid : e.tid = t) : e ∈ traceEventsOf trace t := by
  unfold traceEvents at hmem
  obtain ⟨t', -, hmem'⟩ := Finset.mem_biUnion.mp hmem
  have hmem'' : e ∈ traceEventsOf trace t' := List.mem_toFinset.mp hmem'
  have ht' : e.tid = t' := by
    have hcopy := hmem''
    unfold traceEventsOf at hcopy
    simp only [List.mem_map] at hcopy
    obtain ⟨⟨l, i⟩, -, heq⟩ := hcopy
    have hlabeq : e.lab = l.1 := congrArg Event.lab heq.symm
    change e.tid = t'
    unfold Event.tid
    rw [hlabeq, l.2]
  have heqt : t' = t := ht'.symm.trans htid
  rw [heqt] at hmem''
  exact hmem''

/-- `G`'s `ids_unique` obligation (§2.2's "arbitrary unique
identifier", `ExecutionGraph`'s own field, `Defs/Execution.lean`): two events
of `traceEvents trace` sharing an `id` are the same event. The content
`traceEventId`'s own docstring already asserts ("events from different
threads... never collide"), now established for `traceEvents trace` as a
whole, not just one thread's own list. First pins both events to a common
thread — `Nat.pair_eq_pair`'s own first component gives the two events' own
`Fintype.equivFin D.Tid`-images equal (the same step `traceEventsOf_nodup`
already uses on its second component instead), and injectivity of
`Fintype.equivFin D.Tid` turns that into `e1.tid = e2.tid` — then closes with
`traceEventsOf_idPos_inj` once both events are known (via
`mem_traceEvents_of_tid`) to be members of that one thread's own
`traceEventsOf`. -/
theorem traceEvents_ids_unique {trace : ∀ t, Word (ThreadLabel D t)} {e1 e2 : Event D}
    (hmem1 : e1 ∈ traceEvents trace) (hmem2 : e2 ∈ traceEvents trace)
    (heq : e1.id = e2.id) : e1 = e2 := by
  have hmem1' : e1 ∈ traceEventsOf trace e1.tid := mem_traceEvents_of_tid hmem1 rfl
  have hmem2' : e2 ∈ traceEventsOf trace e2.tid := mem_traceEvents_of_tid hmem2 rfl
  obtain ⟨n1, hn1⟩ := List.mem_iff_getElem?.mp hmem1'
  obtain ⟨n2, hn2⟩ := List.mem_iff_getElem?.mp hmem2'
  rw [traceEventsOf_getElem?] at hn1 hn2
  have hid : ∀ t n e, ((trace t)[n]?).map (fun x => (⟨traceEventId t n, x.1⟩ : Event D)) = some e →
      e.id = traceEventId t n := by
    intro t n e he
    rcases h : (trace t)[n]? with _ | x
    · rw [h] at he; simp at he
    · rw [h] at he; simp only [Option.map_some, Option.some.injEq] at he; rw [← he]
  have hid1 : e1.id = traceEventId e1.tid n1 := hid e1.tid n1 e1 hn1
  have hid2 : e2.id = traceEventId e2.tid n2 := hid e2.tid n2 e2 hn2
  have hpaireq : traceEventId e1.tid n1 = traceEventId e2.tid n2 :=
    (hid1.symm.trans heq).trans hid2
  unfold traceEventId at hpaireq
  have ht : e1.tid = e2.tid :=
    (Fintype.equivFin D.Tid).injective (Fin.ext (Nat.pair_eq_pair.mp hpaireq).1)
  rw [ht] at hmem1'
  exact traceEventsOf_idPos_inj hmem1' hmem2' (by unfold idPos; rw [heq])

/-- `G`'s `po_total`, for `traceEventsPo`: on the thread-`t` events, it is
the order induced by the injective map `idPos` into `ℕ`
(`Function.Injective.isStrictTotalOrder_onFun`). -/
theorem traceEventsPo_total (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) :
    IsStrictTotalOrder {e // e ∈ (traceEvents trace).filter (fun e => e.tid = t)}
      (fun a b => traceEventsPo trace a.1 b.1) := by
  have hmem : ∀ a : {e // e ∈ (traceEvents trace).filter (fun e => e.tid = t)},
      a.1 ∈ traceEvents trace ∧ a.1.tid = t := fun a => Finset.mem_filter.mp a.2
  have hequiv : ∀ a b : {e // e ∈ (traceEvents trace).filter (fun e => e.tid = t)},
      traceEventsPo trace a.1 b.1 ↔ idPos a.1 < idPos b.1 := by
    intro a b
    unfold traceEventsPo tracePo
    constructor
    · rintro ⟨-, -, -, h⟩; exact h
    · intro h; exact ⟨(hmem a).1, (hmem b).1, (hmem a).2.trans (hmem b).2.symm, h⟩
  have hinj : Function.Injective
      (fun a : {e // e ∈ (traceEvents trace).filter (fun e => e.tid = t)} => idPos a.1) := by
    intro a b hab
    exact Subtype.ext (traceEventsOf_idPos_inj
      (mem_traceEvents_of_tid (hmem a).1 (hmem a).2)
      (mem_traceEvents_of_tid (hmem b).1 (hmem b).2) hab)
  have hSTO := hinj.isStrictTotalOrder_onFun (r := (· < · : ℕ → ℕ → Prop))
  exact
  { trichotomous := fun a b hab hba =>
      hSTO.trichotomous a b (fun h => hab ((hequiv a b).mpr h)) (fun h => hba ((hequiv b a).mpr h))
    irrefl := fun a h => hSTO.irrefl a ((hequiv a a).mp h)
    trans := fun a b c hab hbc => (hequiv a c).mpr
      (hSTO.trans a b c ((hequiv a b).mp hab) ((hequiv b c).mp hbc)) }

/-- The standalone analogue of `nthEvent_index`: if `n` is `e`'s position in
its own `rawOpEvents` list, `rawIndex trace e = n`. -/
theorem rawNthEvent_rawIndex {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {x : D.Loc}
    {op : OpType} {n : ℕ} {e : Event D} (h : rawNthEvent trace t x op n = some e) :
    rawIndex trace e = n := by
  have hmemraw : e ∈ rawOpEvents trace t x op := by
    unfold rawNthEvent at h
    obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.mp h
    exact heq ▸ List.getElem_mem hlt
  have hmemE : e ∈ traceEventsOf trace t ∧ e.loc = x ∧ e.op = op := by
    unfold rawOpEvents at hmemraw
    simpa using hmemraw
  have hteq : e.tid = t := by
    obtain ⟨hmemEv, -, -⟩ := hmemE
    unfold traceEventsOf at hmemEv
    simp only [List.mem_map] at hmemEv
    obtain ⟨⟨l, i⟩, -, heq⟩ := hmemEv
    have hlabeq : e.lab = l.1 := congrArg Event.lab heq.symm
    change e.tid = t
    unfold Event.tid
    rw [hlabeq, l.2]
  have hloc : e.loc = x := hmemE.2.1
  have hop : e.op = op := hmemE.2.2
  unfold rawIndex
  rw [hteq, hloc, hop]
  unfold rawNthEvent at h
  obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.mp h
  have hmem : e ∈ rawOpEvents trace t x op := heq ▸ List.getElem_mem hlt
  have hidx_lt : (rawOpEvents trace t x op).idxOf e < (rawOpEvents trace t x op).length :=
    List.idxOf_lt_length_iff.mpr hmem
  have hidx_eq : (rawOpEvents trace t x op)[(rawOpEvents trace t x op).idxOf e]? = some e := by
    rw [List.getElem?_eq_getElem hidx_lt]
    congr 1
    exact List.getElem_idxOf hidx_lt
  have hnodup : (rawOpEvents trace t x op).Nodup :=
    (traceEventsOf_nodup trace t).filter _
  exact (List.getElem?_inj hidx_lt hnodup).mp (hidx_eq.trans h.symm)

/-- A member of `rawOpEvents` is recovered by `rawNthEvent` at its position. -/
theorem rawNthEvent_of_mem {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {x : D.Loc}
    {op : OpType} {e : Event D} (hmem : e ∈ rawOpEvents trace t x op) :
    rawNthEvent trace t x op ((rawOpEvents trace t x op).idxOf e) = some e := by
  unfold rawNthEvent
  rw [List.getElem?_eq_getElem (List.idxOf_lt_length_iff.mpr hmem)]
  congr 1
  exact List.getElem_idxOf (List.idxOf_lt_length_iff.mpr hmem)

/-- An index within the length of a `rawOpEvents` list is realized by
`rawNthEvent`. -/
theorem rawNthEvent_exists_of_lt_length {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {x : D.Loc} {op : OpType} {i : ℕ} (hi : i < (rawOpEvents trace t x op).length) :
    ∃ e, rawNthEvent trace t x op i = some e :=
  ⟨_, List.getElem?_eq_getElem hi⟩

/-- The `i`-th element of `traceEventsOf trace t` has `idPos` equal to `i`. -/
theorem traceEventsOf_pairwise_idPos_lt (trace : ∀ t, Word (ThreadLabel D t)) (t : D.Tid) :
    (traceEventsOf trace t).Pairwise (fun e1 e2 => idPos e1 < idPos e2) := by
  unfold traceEventsOf
  rw [List.pairwise_iff_getElem]
  intro i j hi hj hij
  simp only [List.getElem_map]
  have hi' : i < ((trace t).zipIdx).length := by simpa using hi
  have hj' : j < ((trace t).zipIdx).length := by simpa using hj
  have hilen : i < (trace t).length := by simpa [List.length_zipIdx] using hi'
  have hjlen : j < (trace t).length := by simpa [List.length_zipIdx] using hj'
  have hgeti : ((trace t).zipIdx)[i] = ((trace t)[i], i) := by
    simp
  have hgetj : ((trace t).zipIdx)[j] = ((trace t)[j], j) := by
    simp
  show idPos (⟨traceEventId t (((trace t).zipIdx)[i]).2, (((trace t).zipIdx)[i]).1.1⟩ : Event D) <
    idPos (⟨traceEventId t (((trace t).zipIdx)[j]).2, (((trace t).zipIdx)[j]).1.1⟩ : Event D)
  rw [hgeti, hgetj]
  unfold idPos traceEventId
  simpa using hij

/-- Membership in `traceEventsOf trace t`, in terms of `traceEvents trace` and
`tid`. -/
theorem mem_traceEventsOf_iff {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid} {e : Event D} :
    e ∈ traceEventsOf trace t ↔ e ∈ traceEvents trace ∧ e.tid = t := by
  constructor
  · intro he
    refine ⟨Finset.mem_biUnion.mpr ⟨t, Finset.mem_univ t, List.mem_toFinset.mpr he⟩, ?_⟩
    obtain ⟨i, l, hget, rfl⟩ := mem_traceEventsOf_iff'.mp he
    exact l.2
  · rintro ⟨he, htid⟩
    exact mem_traceEvents_of_tid he htid

/-- For any `G` with `Events = traceEvents trace` and `po = traceEventsPo trace`,
`G.threadEvents t`, mapped through `Subtype.val`, is `traceEventsOf trace t`,
in the same order: both are `po`-sorted lists with the same elements
(`List.Subset.antisymm_of_pairwise`). -/
theorem ExecutionGraph.threadEvents_map_val_eq_traceEventsOf (G : ExecutionGraph D)
    (trace : ∀ t, Word (ThreadLabel D t))
    (hEvents : G.Events = traceEvents trace) (hpo : G.po = traceEventsPo trace)
    (t : D.Tid) :
    (G.threadEvents t).map Subtype.val = traceEventsOf trace t := by
  have hmem : ∀ e : Event D, e ∈ G.Events.filter (fun e => e.tid = t) ↔
      e ∈ traceEventsOf trace t := by
    intro e
    rw [Finset.mem_filter, hEvents, mem_traceEventsOf_iff]
  have hidPos_iff : ∀ a b : {e // e ∈ G.Events.filter (fun e => e.tid = t)},
      G.po a.1 b.1 ↔ idPos a.1 < idPos b.1 := by
    intro a b
    have ha := Finset.mem_filter.mp a.2
    have hb := Finset.mem_filter.mp b.2
    have ha' : (a.1 : Event D) ∈ traceEvents trace := hEvents ▸ ha.1
    have hb' : (b.1 : Event D) ∈ traceEvents trace := hEvents ▸ hb.1
    rw [hpo]
    unfold traceEventsPo tracePo
    constructor
    · rintro ⟨-, -, -, h⟩; exact h
    · intro h; exact ⟨ha', hb', ha.2.trans hb.2.symm, h⟩
  -- `G.threadEvents t` as the explicit `Finset.univ.sort`, under the same
  -- local instances as `ExecutionGraph.threadEvents`.
  have hl_unfold :
      haveI := G.po_total t
      haveI : DecidableRel
          (fun a b : {e : Event D // e ∈ G.Events.filter (fun e => e.tid = t)} => G.po a.1 b.1) :=
        Classical.decRel _
      haveI : LinearOrder {e : Event D // e ∈ G.Events.filter (fun e => e.tid = t)} :=
        linearOrderOfSTO fun a b => G.po a.1 b.1
      G.threadEvents t = Finset.univ.sort (· ≤ ·) := by
    unfold ExecutionGraph.threadEvents
    rfl
  have hnodup : (G.threadEvents t).Nodup := by
    unfold ExecutionGraph.threadEvents
    exact Finset.sort_nodup _ _
  have hpwLE :
      haveI := G.po_total t
      haveI : DecidableRel
          (fun a b : {e : Event D // e ∈ G.Events.filter (fun e => e.tid = t)} => G.po a.1 b.1) :=
        Classical.decRel _
      haveI : LinearOrder {e : Event D // e ∈ G.Events.filter (fun e => e.tid = t)} :=
        linearOrderOfSTO fun a b => G.po a.1 b.1
      (G.threadEvents t).Pairwise (· ≤ ·) := by
    rw [hl_unfold]
    exact Finset.pairwise_sort _ _
  have hpwLT : (G.threadEvents t).Pairwise (fun a b => G.po a.1 b.1) := by
    rw [List.pairwise_iff_getElem] at hpwLE ⊢
    intro i j hi hj hij
    rcases hpwLE i j hi hj hij with heq | hlt
    · exact absurd ((List.getElem_inj hnodup).mp heq) (by omega)
    · exact hlt
  have hpairR : ((G.threadEvents t).map Subtype.val).Pairwise
      (fun e1 e2 => idPos e1 < idPos e2) :=
    (hpwLT.imp (fun {a b} hab => (hidPos_iff a b).mp hab)).map _ (fun {a b} h => h)
  have hsub1 : (G.threadEvents t).map Subtype.val ⊆ traceEventsOf trace t := by
    intro e he
    obtain ⟨a, -, rfl⟩ := List.mem_map.mp he
    exact (hmem a.1).mp a.2
  have hsub2 : traceEventsOf trace t ⊆ (G.threadEvents t).map Subtype.val := by
    intro e he
    have hmemE : e ∈ G.Events.filter (fun e => e.tid = t) := (hmem e).mpr he
    refine List.mem_map.mpr ⟨⟨e, hmemE⟩, ?_, rfl⟩
    unfold ExecutionGraph.threadEvents
    exact Finset.mem_sort _ |>.mpr (Finset.mem_univ _)
  have hpairL : (traceEventsOf trace t).Pairwise (fun e1 e2 => idPos e1 < idPos e2) :=
    traceEventsOf_pairwise_idPos_lt trace t
  exact List.Subset.antisymm_of_pairwise hpairR hpairL hsub1 hsub2

/-- For any `G` with `Events = traceEvents trace` and `po = traceEventsPo trace`,
`G.threadWord t = (trace t).map some`. From
`threadEvents_map_val_eq_traceEventsOf`, position by position. -/
theorem ExecutionGraph.threadWord_eq_trace (G : ExecutionGraph D)
    (trace : ∀ t, Word (ThreadLabel D t))
    (hEvents : G.Events = traceEvents trace) (hpo : G.po = traceEventsPo trace)
    (t : D.Tid) :
    G.threadWord t = (trace t).map some := by
  have heqEvents := G.threadEvents_map_val_eq_traceEventsOf trace hEvents hpo t
  apply List.ext_getElem?_iff.mpr
  intro n
  unfold ExecutionGraph.threadWord
  have hstep : ((G.threadEvents t)[n]?).map Subtype.val = (traceEventsOf trace t)[n]? := by
    rw [← List.getElem?_map, heqEvents]
  rw [traceEventsOf_getElem?] at hstep
  rw [List.getElem?_map, List.getElem?_map]
  rcases hlt : (trace t)[n]? with _ | lab
  · rw [hlt] at hstep
    simp only [Option.map_none] at hstep
    have hln : (G.threadEvents t)[n]? = none := by
      rcases hgt : (G.threadEvents t)[n]? with _ | e
      · rfl
      · rw [hgt] at hstep; simp at hstep
    rw [hln]
    rfl
  · rw [hlt] at hstep
    simp only [Option.map_some] at hstep
    obtain ⟨e, hgt, heq⟩ := Option.map_eq_some_iff.mp hstep
    rw [hgt]
    simp only [Option.map_some, Option.some.injEq]
    have hlab : e.1.lab = lab.1 := congrArg Event.lab heq
    have hfin : (⟨e.1.lab, (Finset.mem_filter.mp e.2).2⟩ : ThreadLabel D t) = lab :=
      Subtype.ext hlab
    rw [hfin]

/-- `G.opEvents t x op = rawOpEvents trace t x op`, for any `G` with
`Events = traceEvents trace` and `po = traceEventsPo trace`: both filter the
same list (`threadEvents_map_val_eq_traceEventsOf`) by the same predicate. -/
theorem ExecutionGraph.opEvents_eq_rawOpEvents (G : ExecutionGraph D)
    (trace : ∀ t, Word (ThreadLabel D t))
    (hEvents : G.Events = traceEvents trace) (hpo : G.po = traceEventsPo trace)
    (t : D.Tid) (x : D.Loc) (op : OpType) :
    G.opEvents t x op = rawOpEvents trace t x op := by
  have heq := G.threadEvents_map_val_eq_traceEventsOf trace hEvents hpo t
  unfold ExecutionGraph.opEvents rawOpEvents
  rw [← heq, List.filter_map]
  rfl

/-- `G.nthEvent t x op i = rawNthEvent trace t x op i`. -/
theorem ExecutionGraph.nthEvent_eq_rawNthEvent (G : ExecutionGraph D)
    (trace : ∀ t, Word (ThreadLabel D t))
    (hEvents : G.Events = traceEvents trace) (hpo : G.po = traceEventsPo trace)
    (t : D.Tid) (x : D.Loc) (op : OpType) (i : ℕ) :
    G.nthEvent t x op i = rawNthEvent trace t x op i := by
  unfold ExecutionGraph.nthEvent rawNthEvent
  rw [G.opEvents_eq_rawOpEvents trace hEvents hpo t x op]

/-- `G.index e = rawIndex trace e`, for any event `e` of `G`. Via
`G.index_nthEvent`, `nthEvent_eq_rawNthEvent` and `rawNthEvent_rawIndex` (the
two `List.idxOf`s use different `DecidableEq` instances). -/
theorem ExecutionGraph.index_eq_rawIndex (G : ExecutionGraph D)
    (trace : ∀ t, Word (ThreadLabel D t))
    (hEvents : G.Events = traceEvents trace) (hpo : G.po = traceEventsPo trace)
    {e : Event D} (he : e ∈ G.Events) :
    G.index e = rawIndex trace e := by
  have h1 : G.nthEvent e.tid e.loc e.op (G.index e) = some e := G.index_nthEvent he
  rw [G.nthEvent_eq_rawNthEvent trace hEvents hpo e.tid e.loc e.op] at h1
  exact (rawNthEvent_rawIndex h1).symm

/-- If `l` is `Pairwise` under an asymmetric `R`, and `R a b` with
`a, b ∈ l`, then `a` occurs before `b` in `l`. -/
theorem idxOf_lt_idxOf_of_pairwise {α : Type} [DecidableEq α] {l : List α}
    {R : α → α → Prop} (hpw : l.Pairwise R) (hasymm : ∀ x y, R x y → ¬ R y x)
    {a b : α} (ha : a ∈ l) (hb : b ∈ l) (hR : R a b) :
    l.idxOf a < l.idxOf b := by
  have hia : l.idxOf a < l.length := List.idxOf_lt_length_iff.mpr ha
  have hib : l.idxOf b < l.length := List.idxOf_lt_length_iff.mpr hb
  have hgeta? : l[l.idxOf a]? = some a := by
    rw [List.getElem?_eq_getElem hia]; exact congrArg some (List.getElem_idxOf hia)
  have hgetb? : l[l.idxOf b]? = some b := by
    rw [List.getElem?_eq_getElem hib]; exact congrArg some (List.getElem_idxOf hib)
  rcases lt_trichotomy (l.idxOf a) (l.idxOf b) with h | h | h
  · exact h
  · exfalso
    have heq : a = b := by
      have := hgeta?
      rw [h] at this
      rw [hgetb?] at this
      exact (Option.some.injEq _ _).mp this.symm
    exact hasymm a b hR (heq ▸ hR)
  · exfalso
    have hRba : R b a := by
      have := (List.pairwise_iff_getElem.mp hpw) (l.idxOf b) (l.idxOf a) hib hia h
      have hgeta : l[l.idxOf a] = a := List.getElem_idxOf hia
      have hgetb : l[l.idxOf b] = b := List.getElem_idxOf hib
      rwa [hgeta, hgetb] at this
    exact hasymm a b hR hRba

/-- `rawIndex` strictly increases along `tracePo` between two events with the
same location and operation. -/
theorem rawIndex_lt_of_tracePo_sameLocOp {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {e1 e2 : Event D} (he1 : e1 ∈ traceEventsOf trace t) (he2 : e2 ∈ traceEventsOf trace t)
    (hpo : tracePo e1 e2) (hloc : e1.loc = e2.loc) (hop : e1.op = e2.op) :
    rawIndex trace e1 < rawIndex trace e2 := by
  have htid : ∀ e : Event D, e ∈ traceEventsOf trace t → e.tid = t := by
    intro e he
    unfold traceEventsOf at he
    simp only [List.mem_map] at he
    obtain ⟨⟨l, i⟩, -, heq⟩ := he
    have hlabeq : e.lab = l.1 := congrArg Event.lab heq.symm
    change e.tid = t
    unfold Event.tid
    rw [hlabeq, l.2]
  have ht1 : e1.tid = t := htid e1 he1
  have ht2 : e2.tid = t := htid e2 he2
  have hidlt : idPos e1 < idPos e2 := hpo.2
  have hmem1 : e1 ∈ rawOpEvents trace t e1.loc e1.op := by
    unfold rawOpEvents; simp [he1]
  have hmem2 : e2 ∈ rawOpEvents trace t e1.loc e1.op := by
    unfold rawOpEvents; simp [he2, hloc, hop]
  have hpw : (rawOpEvents trace t e1.loc e1.op).Pairwise (fun a b => idPos a < idPos b) :=
    (traceEventsOf_pairwise_idPos_lt trace t).filter _
  have hlt := idxOf_lt_idxOf_of_pairwise hpw (fun _ _ h1 h2 => absurd (h1.trans h2) (lt_irrefl _))
    hmem1 hmem2 hidlt
  have he1eq : rawIndex trace e1 = (rawOpEvents trace t e1.loc e1.op).idxOf e1 := by
    unfold rawIndex; rw [ht1]
  have he2eq : rawIndex trace e2 = (rawOpEvents trace t e1.loc e1.op).idxOf e2 := by
    unfold rawIndex; rw [ht2, hloc, hop]
  rw [he1eq, he2eq]
  exact hlt

/-- `rawIndex` is injective on events with the same thread, location and
operation. -/
theorem rawIndex_inj_of_sameTidLocOp {trace : ∀ t, Word (ThreadLabel D t)} {t : D.Tid}
    {x : D.Loc} {op : OpType} {e1 e2 : Event D}
    (he1 : e1 ∈ traceEventsOf trace t) (he2 : e2 ∈ traceEventsOf trace t)
    (htid1 : e1.tid = t) (hloc1 : e1.loc = x) (hop1 : e1.op = op)
    (htid2 : e2.tid = t) (hloc2 : e2.loc = x) (hop2 : e2.op = op)
    (heq : rawIndex trace e1 = rawIndex trace e2) : e1 = e2 := by
  have hmem1 : e1 ∈ rawOpEvents trace t x op := by unfold rawOpEvents; simp [he1, hloc1, hop1]
  have hmem2 : e2 ∈ rawOpEvents trace t x op := by unfold rawOpEvents; simp [he2, hloc2, hop2]
  have he1eq : rawIndex trace e1 = (rawOpEvents trace t x op).idxOf e1 := by
    unfold rawIndex; rw [htid1, hloc1, hop1]
  have he2eq : rawIndex trace e2 = (rawOpEvents trace t x op).idxOf e2 := by
    unfold rawIndex; rw [htid2, hloc2, hop2]
  rw [he1eq, he2eq] at heq
  exact (List.idxOf_inj hmem1).mp heq

/-- For a thread whose word is a uniform-block flatMap: each event lies at
offset `p` of block `n`, with `idPos = n * L + p`, `rawIndex = n`, and
`(loc, op)` given by `blockShape[p]`. -/
theorem flatLoop_index_formula {t : D.Tid} {α : Type}
    (block : α → List (ThreadLabel D t)) (blockShape : List (D.Loc × OpType))
    (hshape : ∀ a, (block a).map (fun l => (l.1.loc, l.1.op)) = blockShape)
    (hnodup : blockShape.Nodup)
    (trace : ∀ t', Word (ThreadLabel D t')) (vals : List α)
    (htrace : trace t = vals.flatMap block)
    {e : Event D} (he : e ∈ traceEventsOf trace t) :
    ∃ n p, p < blockShape.length ∧
      idPos e = n * blockShape.length + p ∧ rawIndex trace e = n ∧
      blockShape[p]? = some (e.loc, e.op) := by
  set L := blockShape.length with hLdef
  have hL : ∀ a, (block a).length = L := fun a => by rw [hLdef, ← hshape a, List.length_map]
  obtain ⟨i, l, hget, hee⟩ := mem_traceEventsOf_iff'.mp he
  have hidPos : idPos e = i := by
    rw [hee]; unfold idPos traceEventId; simp [Nat.unpair_pair]
  have hloce : e.loc = l.1.loc := by rw [hee]; rfl
  have hope : e.op = l.1.op := by rw [hee]; rfl
  rw [htrace] at hget
  have hlenflat : (vals.flatMap block).length = vals.length * L := by
    rw [List.length_flatMap]; simp [hL]
  have hilt : i < vals.length * L := by
    have h := (List.getElem?_eq_some_iff.mp hget).1
    rwa [hlenflat] at h
  obtain ⟨n, p, a, hpL, hip, hva, heqget⟩ := flatMap_uniform_getElem block L hL vals i hilt
  have hbl : (block a)[p]? = some l := by rw [← heqget]; exact hget
  have hshapep : blockShape[p]? = some (e.loc, e.op) := by
    have h1 : blockShape[p]? = ((block a).map (fun l' => (l'.1.loc, l'.1.op)))[p]? := by
      rw [hshape a]
    rw [h1, List.getElem?_map, hbl]
    simp [hloce, hope]
  refine ⟨n, p, hpL, ?_, ?_, hshapep⟩
  · rw [hidPos, hip]
  · set bval : α → ThreadLabel D t := fun a => (block a)[p]'(by rw [hL]; exact hpL)
      with hbvaldef
    have hbval : ∀ a, (block a)[p]? = some (bval a) := fun a => List.getElem?_eq_getElem _
    have hshapepgen : ∀ a, blockShape[p]? = some ((bval a).1.loc, (bval a).1.op) := by
      intro a
      have h1 : blockShape[p]? = ((block a).map (fun l' => (l'.1.loc, l'.1.op)))[p]? := by
        rw [hshape a]
      rw [h1, List.getElem?_map, hbval a]
      rfl
    have hbvalprop : ∀ a, (bval a).1.loc = e.loc ∧ (bval a).1.op = e.op := by
      intro a
      have h1 := hshapepgen a
      rw [hshapep] at h1
      simpa using h1.symm
    set predL : ThreadLabel D t → Bool := fun l' => decide (l'.1.loc = e.loc ∧ l'.1.op = e.op)
      with hpredLdef
    have htruepred : ∀ a, predL (bval a) = true := by
      intro a
      simp [hpredLdef, hbvalprop a]
    have hplt : p < blockShape.length := by rw [← hLdef]; exact hpL
    have hfalsepred : ∀ a q b, q ≠ p → (block a)[q]? = some b → predL b = false := by
      intro a q b hq hqget
      have hshapeq : blockShape[q]? = some (b.1.loc, b.1.op) := by
        have h1 : blockShape[q]? = ((block a).map (fun l' => (l'.1.loc, l'.1.op)))[q]? := by
          rw [hshape a]
        rw [h1, List.getElem?_map, hqget]
        rfl
      by_contra hcon
      simp only [hpredLdef, decide_eq_false_iff_not, not_not] at hcon
      have heqbs : blockShape[q]? = blockShape[p]? := by
        rw [hshapeq, hshapep, hcon.1, hcon.2]
      have hqlt : q < blockShape.length := by
        have hq0 := (List.getElem?_eq_some_iff.mp hqget).1
        rw [hL, hLdef] at hq0
        exact hq0
      exact hq ((List.getElem?_inj hqlt hnodup).mp heqbs)
    have hmain := zipIdx_flatMap_filter_getElem block L p hL predL bval hbval htruepred
      hfalsepred vals 0 n a hva
    have hrawop : rawOpEvents trace t e.loc e.op =
        ((trace t).zipIdx.filter (fun p' => predL p'.1)).map
          (fun p' => (⟨traceEventId t p'.2, p'.1.1⟩ : Event D)) := by
      unfold rawOpEvents traceEventsOf
      rw [List.filter_map]
      congr 1
    have hbaeql : bval a = l := by
      have h1 := hbval a
      rw [hbl] at h1
      exact (Option.some.injEq _ _).mp h1.symm
    have hrawnth : rawNthEvent trace t e.loc e.op n = some e := by
      unfold rawNthEvent
      rw [hrawop, htrace, List.getElem?_map, hmain]
      simp only [Nat.zero_add, Option.map_some]
      rw [hee, ← hip, hbaeql]
    exact rawNthEvent_rawIndex hrawnth

/-- For a thread whose first iteration is a prefix `block0` of every later
block `blockRest` (Lemma 3.4 for the threads skipping a first read's "Threads `c^x,c^y,g_α^y,g_β^y`"):
an event is either in `block0` (`rawIndex 0`) or at offset `p` of the `n`-th
later block, with `rawIndex` `n + 1` if offset `p` also occurs in `block0`
and `n` otherwise (the skipped reads of the first iteration). -/
theorem flatLoop_index_formula_skip {t : D.Tid} {α : Type}
    (block0 blockRest : α → List (ThreadLabel D t))
    (block0Shape blockShape : List (D.Loc × OpType))
    (hshape0 : ∀ a, (block0 a).map (fun l => (l.1.loc, l.1.op)) = block0Shape)
    (hshapeRest : ∀ a, (blockRest a).map (fun l => (l.1.loc, l.1.op)) = blockShape)
    (hprefix : block0Shape = blockShape.take block0Shape.length)
    (hnodup : blockShape.Nodup)
    (trace : ∀ t', Word (ThreadLabel D t')) (v0 : α) (vals : List α)
    (htrace : trace t = block0 v0 ++ vals.flatMap blockRest)
    {e : Event D} (he : e ∈ traceEventsOf trace t) :
    (∃ p, p < block0Shape.length ∧ idPos e = p ∧ rawIndex trace e = 0 ∧
      blockShape[p]? = some (e.loc, e.op)) ∨
    (∃ n p, p < blockShape.length ∧
      idPos e = block0Shape.length + n * blockShape.length + p ∧
      rawIndex trace e = (if p < block0Shape.length then n + 1 else n) ∧
      blockShape[p]? = some (e.loc, e.op)) := by
  have hL0 : (block0 v0).length = block0Shape.length := by rw [← hshape0 v0, List.length_map]
  have hLrest : ∀ a, (blockRest a).length = blockShape.length := fun a => by
    rw [← hshapeRest a, List.length_map]
  have hnodup0 : block0Shape.Nodup := by
    rw [hprefix]; exact List.Sublist.nodup (List.take_sublist _ _) hnodup
  have hL0leL : block0Shape.length ≤ blockShape.length := by
    have := congrArg List.length hprefix
    rw [List.length_take] at this
    omega
  obtain ⟨i, l, hget, hee⟩ := mem_traceEventsOf_iff'.mp he
  have hidPosi : idPos e = i := by
    rw [hee]; unfold idPos traceEventId; simp [Nat.unpair_pair]
  have hloce : e.loc = l.1.loc := by rw [hee]; rfl
  have hope : e.op = l.1.op := by rw [hee]; rfl
  rw [htrace] at hget
  set predL : ThreadLabel D t → Bool := fun l' => decide (l'.1.loc = e.loc ∧ l'.1.op = e.op)
    with hpredLdef
  have hzip : (block0 v0 ++ vals.flatMap blockRest).zipIdx
      = (block0 v0).zipIdx 0 ++ (vals.flatMap blockRest).zipIdx block0Shape.length := by
    rw [List.zipIdx_append, hL0, Nat.zero_add]
  have hrawop : rawOpEvents trace t e.loc e.op =
      (((block0 v0).zipIdx 0).filter (fun p => predL p.1)).map
        (fun p => (⟨traceEventId t p.2, p.1.1⟩ : Event D)) ++
      (((vals.flatMap blockRest).zipIdx block0Shape.length).filter (fun p => predL p.1)).map
        (fun p => (⟨traceEventId t p.2, p.1.1⟩ : Event D)) := by
    unfold rawOpEvents traceEventsOf
    rw [htrace, List.filter_map, hzip, List.filter_append, List.map_append]
    rfl
  rcases Nat.lt_or_ge i block0Shape.length with hi | hi
  · left
    rw [List.getElem?_append_left (by rw [hL0]; exact hi)] at hget
    have hbl : (block0 v0)[i]? = some l := hget
    have hshapei0 : block0Shape[i]? = some (e.loc, e.op) := by
      have h1 : block0Shape[i]? = ((block0 v0).map (fun l' => (l'.1.loc, l'.1.op)))[i]? := by
        rw [hshape0 v0]
      rw [h1, List.getElem?_map, hbl]
      simp [hloce, hope]
    have hshapep : blockShape[i]? = some (e.loc, e.op) := by
      rw [hprefix] at hshapei0
      rwa [List.getElem?_take_of_lt hi] at hshapei0
    refine ⟨i, hi, hidPosi, ?_, hshapep⟩
    have hsingle0 : ((block0 v0).zipIdx 0).filter (fun p => predL p.1) = [(l, i)] := by
      apply list_filter_singleton_of_unique' ((block0 v0).zipIdx 0) (fun p => predL p.1) i (l, i)
      · rw [List.getElem?_zipIdx, hbl]; simp
      · simp [hpredLdef, hloce, hope]
      · intro q b hq hget2
        rw [List.getElem?_zipIdx] at hget2
        rcases hb : (block0 v0)[q]? with _ | b0
        · rw [hb] at hget2; simp at hget2
        · rw [hb] at hget2
          simp only [Option.map_some, Option.some.injEq] at hget2
          rw [← hget2]
          simp only [hpredLdef, decide_eq_false_iff_not]
          rintro ⟨hbl1, hbl2⟩
          have hshapeq : block0Shape[q]? = some (b0.1.loc, b0.1.op) := by
            have h1 : block0Shape[q]? = ((block0 v0).map (fun l' => (l'.1.loc, l'.1.op)))[q]? := by
              rw [hshape0 v0]
            rw [h1, List.getElem?_map, hb]
            rfl
          have hqlt : q < block0Shape.length := by
            have := (List.getElem?_eq_some_iff.mp hb).1
            rwa [hL0] at this
          have heqbs : block0Shape[q]? = block0Shape[i]? := by
            rw [hshapeq, hshapei0, hbl1, hbl2]
          exact hq ((List.getElem?_inj hqlt hnodup0).mp heqbs)
    have hrawnth : rawNthEvent trace t e.loc e.op 0 = some e := by
      unfold rawNthEvent
      rw [hrawop, hsingle0]
      simp [hee]
    exact rawNthEvent_rawIndex hrawnth
  · right
    rw [List.getElem?_append_right (by rw [hL0]; exact hi), hL0] at hget
    have hi' : i - block0Shape.length < vals.length * blockShape.length := by
      have hbound := (List.getElem?_eq_some_iff.mp hget).1
      rw [List.length_flatMap] at hbound
      simpa [hLrest] using hbound
    obtain ⟨n, p, a, hpL, hip, hva, heqget⟩ :=
      flatMap_uniform_getElem blockRest blockShape.length hLrest vals (i - block0Shape.length) hi'
    have hbl : (blockRest a)[p]? = some l := by rw [← heqget]; exact hget
    have hshapep : blockShape[p]? = some (e.loc, e.op) := by
      have h1 : blockShape[p]? = ((blockRest a).map (fun l' => (l'.1.loc, l'.1.op)))[p]? := by
        rw [hshapeRest a]
      rw [h1, List.getElem?_map, hbl]
      simp [hloce, hope]
    have hidEq : i = block0Shape.length + n * blockShape.length + p := by omega
    have hbval : ∀ a, (blockRest a)[p]? = some ((blockRest a)[p]'(by rw [hLrest]; exact hpL)) :=
      fun a => List.getElem?_eq_getElem _
    set bval : α → ThreadLabel D t := fun a => (blockRest a)[p]'(by rw [hLrest]; exact hpL)
      with hbvaldef
    have htruepred : ∀ a, predL (bval a) = true := by
      intro a'
      have hshapepa :
          blockShape[p]? = ((blockRest a').map (fun l' => (l'.1.loc, l'.1.op)))[p]? := by
        rw [hshapeRest a']
      rw [hshapep, List.getElem?_map, hbval a'] at hshapepa
      simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hshapepa
      simp only [hpredLdef, decide_eq_true_eq]
      exact ⟨hshapepa.1.symm, hshapepa.2.symm⟩
    have hfalsepred : ∀ a' q b, q ≠ p → (blockRest a')[q]? = some b → predL b = false := by
      intro a' q b hq hqget
      have hshapeq : blockShape[q]? = some (b.1.loc, b.1.op) := by
        have h1 : blockShape[q]? = ((blockRest a').map (fun l' => (l'.1.loc, l'.1.op)))[q]? := by
          rw [hshapeRest a']
        rw [h1, List.getElem?_map, hqget]; rfl
      by_contra hcon
      simp only [hpredLdef, decide_eq_false_iff_not, not_not] at hcon
      have hqlt : q < blockShape.length := by
        have := (List.getElem?_eq_some_iff.mp hqget).1; rwa [hLrest] at this
      have heqbs : blockShape[q]? = blockShape[p]? := by
        rw [hshapeq, hshapep, hcon.1, hcon.2]
      exact hq ((List.getElem?_inj hqlt hnodup).mp heqbs)
    have hmain := zipIdx_flatMap_filter_getElem blockRest blockShape.length p hLrest predL bval
      hbval htruepred hfalsepred vals block0Shape.length n a hva
    have hbveq : bval a = l := by
      have h1 := hbval a
      rw [hbl] at h1
      exact (Option.some.injEq _ _).mp h1.symm
    rw [hbveq] at hmain
    refine ⟨n, p, hpL, ?_, ?_, hshapep⟩
    · rw [hidPosi, hidEq]
    · split_ifs with hcase
      · obtain ⟨l0, hl0⟩ : ∃ l0, (block0 v0)[p]? = some l0 :=
          ⟨(block0 v0)[p]'(by rw [hL0]; exact hcase), List.getElem?_eq_getElem _⟩
        have hshapep0 : block0Shape[p]? = some (e.loc, e.op) := by
          rw [hprefix]; rwa [List.getElem?_take_of_lt hcase]
        have hl0shape :
            block0Shape[p]? = ((block0 v0).map (fun l' => (l'.1.loc, l'.1.op)))[p]? := by
          rw [hshape0 v0]
        have hl0eq : l0.1.loc = e.loc ∧ l0.1.op = e.op := by
          rw [hl0shape, List.getElem?_map, hl0] at hshapep0
          simp only [Option.map_some, Option.some.injEq, Prod.mk.injEq] at hshapep0
          exact ⟨hshapep0.1, hshapep0.2⟩
        have hsingle0 : ((block0 v0).zipIdx 0).filter (fun p => predL p.1) = [(l0, p)] := by
          apply list_filter_singleton_of_unique' ((block0 v0).zipIdx 0) (fun p => predL p.1) p
            (l0, p)
          · rw [List.getElem?_zipIdx, hl0]; simp
          · simp only [hpredLdef, decide_eq_true_eq]; exact ⟨hl0eq.1, hl0eq.2⟩
          · intro q b hq hget2
            rw [List.getElem?_zipIdx] at hget2
            rcases hb : (block0 v0)[q]? with _ | b0
            · rw [hb] at hget2; simp at hget2
            · rw [hb] at hget2
              simp only [Option.map_some, Option.some.injEq] at hget2
              rw [← hget2]
              simp only [hpredLdef, decide_eq_false_iff_not]
              rintro ⟨hbl1, hbl2⟩
              have hshapeq : block0Shape[q]? = some (b0.1.loc, b0.1.op) := by
                have h1 :
                    block0Shape[q]? = ((block0 v0).map (fun l' => (l'.1.loc, l'.1.op)))[q]? := by
                  rw [hshape0 v0]
                rw [h1, List.getElem?_map, hb]; rfl
              have hqlt : q < block0Shape.length := by
                have := (List.getElem?_eq_some_iff.mp hb).1; rwa [hL0] at this
              have heqbs : block0Shape[q]? = block0Shape[p]? := by
                rw [hshapeq, hshapep0, hbl1, hbl2]
              exact hq ((List.getElem?_inj hqlt hnodup0).mp heqbs)
        have hrawnth : rawNthEvent trace t e.loc e.op (n + 1) = some e := by
          unfold rawNthEvent
          rw [hrawop, hsingle0]
          simp only [List.map_cons, List.map_nil, List.singleton_append]
          rw [List.getElem?_cons_succ, List.getElem?_map, hmain]
          rw [hee, hidEq]
          rfl
        exact rawNthEvent_rawIndex hrawnth
      · have hempty0 : ((block0 v0).zipIdx 0).filter (fun p => predL p.1) = [] := by
          rw [List.filter_eq_nil_iff]
          rintro ⟨b, q⟩ hmem
          obtain ⟨_, hqeq⟩ := List.mk_mem_zipIdx_iff_le_and_getElem?_sub.mp hmem
          simp only [Nat.sub_zero] at hqeq
          simp only [hpredLdef, decide_eq_true_eq]
          rintro ⟨hbl1, hbl2⟩
          have hqlt : q < block0Shape.length := by
            have := (List.getElem?_eq_some_iff.mp hqeq).1; rwa [hL0] at this
          have hshapeq : block0Shape[q]? = some (b.1.loc, b.1.op) := by
            have h1 : block0Shape[q]? = ((block0 v0).map (fun l' => (l'.1.loc, l'.1.op)))[q]? := by
              rw [hshape0 v0]
            rw [h1, List.getElem?_map, hqeq]; rfl
          have hshapeqB : blockShape[q]? = some (b.1.loc, b.1.op) := by
            rw [hprefix] at hshapeq; rwa [List.getElem?_take_of_lt hqlt] at hshapeq
          have heqbs : blockShape[q]? = blockShape[p]? := by
            rw [hshapeqB, hshapep, hbl1, hbl2]
          have hqp : q = p := (List.getElem?_inj (hqlt.trans_le hL0leL) hnodup).mp heqbs
          omega
        have hrawnth : rawNthEvent trace t e.loc e.op n = some e := by
          unfold rawNthEvent
          rw [hrawop, hempty0]
          simp only [List.map_nil, List.nil_append, List.getElem?_map, hmain]
          rw [hee, hidEq]
          rfl
        exact rawNthEvent_rawIndex hrawnth

/-- `flatLoop_po_monotone`, from a thread's uniform-block shape: the form used
by the six primed threads (Lemma 3.4 for the primed threads). -/
theorem flatLoop_po_monotone_of_shape {t : D.Tid} {α : Type}
    (block : α → List (ThreadLabel D t)) (blockShape : List (D.Loc × OpType))
    (hshape : ∀ a, (block a).map (fun l => (l.1.loc, l.1.op)) = blockShape)
    (hnodup : blockShape.Nodup) (writesLen : ℕ) (hWL : writesLen ≤ blockShape.length)
    (hshapewrites : ∀ p x, blockShape[p]? = some (x, OpType.rd) → writesLen ≤ p)
    (hshapewrites2 : ∀ p x, blockShape[p]? = some (x, OpType.wt) → p < writesLen)
    (trace : ∀ t', Word (ThreadLabel D t')) (vals : List α)
    (htrace : trace t = vals.flatMap block)
    {e1 e2 : Event D} (he1 : e1 ∈ traceEventsOf trace t) (he2 : e2 ∈ traceEventsOf trace t)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  obtain ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula block blockShape hshape hnodup trace vals htrace he1
  obtain ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
    flatLoop_index_formula block blockShape hshape hnodup trace vals htrace he2
  refine flatLoop_po_monotone trace writesLen blockShape.length hWL hp1L hp2L hidPos1 hidPos2
    hrawIdx1 hrawIdx2 ?_ ?_ hpo hwt2
  · intro hrd
    exact hshapewrites p1 e1.loc (by rw [hshape1, hrd])
  · intro hwt
    exact hshapewrites2 p2 e2.loc (by rw [hshape2, hwt])

/-- `flatLoop_po_monotone_of_shape` for threads whose first iteration is
shorter (Lemma 3.4 for the threads skipping a first read). By cases on whether `e1`, `e2` are in
`block0` or in later blocks. -/
theorem flatLoop_po_monotone_of_shape_skip {t : D.Tid} {α : Type}
    (block0 blockRest : α → List (ThreadLabel D t))
    (block0Shape blockShape : List (D.Loc × OpType))
    (hshape0 : ∀ a, (block0 a).map (fun l => (l.1.loc, l.1.op)) = block0Shape)
    (hshapeRest : ∀ a, (blockRest a).map (fun l => (l.1.loc, l.1.op)) = blockShape)
    (hprefix : block0Shape = blockShape.take block0Shape.length)
    (hnodup : blockShape.Nodup) (writesLen : ℕ) (hWL : writesLen ≤ block0Shape.length)
    (hshapewrites : ∀ p x, blockShape[p]? = some (x, OpType.rd) → writesLen ≤ p)
    (hshapewrites2 : ∀ p x, blockShape[p]? = some (x, OpType.wt) → p < writesLen)
    (trace : ∀ t', Word (ThreadLabel D t')) (v0 : α) (vals : List α)
    (htrace : trace t = block0 v0 ++ vals.flatMap blockRest)
    {e1 e2 : Event D} (he1 : e1 ∈ traceEventsOf trace t) (he2 : e2 ∈ traceEventsOf trace t)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  obtain h1 | ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula_skip block0 blockRest block0Shape blockShape hshape0 hshapeRest
      hprefix hnodup trace v0 vals htrace he1
  · obtain ⟨p1', hp1L', hidPos1', hrawIdx1', hshape1'⟩ := h1
    obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip block0 blockRest block0Shape blockShape hshape0 hshapeRest
        hprefix hnodup trace v0 vals htrace he2
    · obtain ⟨p2', hp2L', hidPos2', hrawIdx2', hshape2'⟩ := h2
      rw [hrawIdx1', hrawIdx2']
      refine ⟨le_refl 0, fun hrd => ?_⟩
      exfalso
      obtain ⟨_, hidlt⟩ := hpo
      rw [hidPos1', hidPos2'] at hidlt
      have hw2 := hshapewrites2 p2' e2.loc (by rw [hshape2', hwt2])
      have hr1 := hshapewrites p1' e1.loc (by rw [hshape1', hrd])
      omega
    · rw [hrawIdx1']
      have hw2 : p2 < writesLen := hshapewrites2 p2 e2.loc (by rw [hshape2, hwt2])
      have hp2L0 : p2 < block0Shape.length := lt_of_lt_of_le hw2 hWL
      rw [hrawIdx2, if_pos hp2L0]
      omega
  · obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip block0 blockRest block0Shape blockShape hshape0 hshapeRest
        hprefix hnodup trace v0 vals htrace he2
    · exfalso
      obtain ⟨p2', hp2L', hidPos2', _, _⟩ := h2
      obtain ⟨_, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · have hw2 : p2 < writesLen := hshapewrites2 p2 e2.loc (by rw [hshape2, hwt2])
      have hp2L0 : p2 < block0Shape.length := lt_of_lt_of_le hw2 hWL
      rw [hrawIdx2, if_pos hp2L0]
      have hcore := blockIndex_po_monotone
        (blockStart := fun n => block0Shape.length + n * blockShape.length)
        (blockLen := fun _ => blockShape.length) (writesLen := fun _ => writesLen)
        (fun n => by rw [Nat.succ_mul]; omega) hp1L hp2L hidPos1 hidPos2
        (fun hrd => hshapewrites p1 e1.loc (by rw [hshape1, hrd]))
        (fun _ => hw2) hpo hwt2
      rw [hrawIdx1]
      split_ifs with hcase
      · exact ⟨by omega, fun hrd => by have := hcore.2 hrd; omega⟩
      · exact ⟨by omega, fun hrd => by have := hcore.2 hrd; omega⟩

end Generic

variable (I : PCPInstance)

/-! ## Bridge events (§3.5) -/

/-- The bridge locations `z_α^{x,y}, ℓ_α^{y,x}, z_β^{x,y}, ℓ_β^{y,x}`: `Loc.zAxy`,
`Loc.ellAyx`, `Loc.zBxy`, `Loc.ellByx`. -/
def BridgeLoc : Finset Loc := {Loc.zAxy, Loc.ellAyx, Loc.zBxy, Loc.ellByx}

/-- **Paper:** §3.5, ¶ Bridge events.

An event accessing a bridge location. -/
def Event.IsBridge (e : Event (domainOf I)) : Prop := e.loc ∈ BridgeLoc

/-! ## The thread sets (§3.5) -/

/-- **Paper:** §3.5, ¶ Thread sets (`Tid_x`).

`Tid_x`: the guessers, primed guessers and checker on the `x`
side. -/
def ThreadDomX : Finset Tid :=
  {Tid.guessAX, Tid.primeAX, Tid.guessBX, Tid.primeBX, Tid.checkX, Tid.primeCheckX}

/-- **Paper:** §3.5, ¶ Thread sets (`Tid_y`).

`Tid_y`: the guessers, primed guessers and checker on the `y`
side. -/
def ThreadDomY : Finset Tid :=
  {Tid.guessAY, Tid.primeAY, Tid.guessBY, Tid.primeBY, Tid.checkY, Tid.primeCheckY}

/-! ## `G`'s `rf` ingredient -/

/-- `G`'s `rf` ("Specifying `G.rf`"): "We construct a reads-from relation
that specifies `w_i ⟶rf r_i` for all `i`, where `w_i` is the
`i`-th write of the *unique* thread writing a value that matches that of
`r_i`... `rf` consists exactly of the relations shown in
[Eq. (15)/(16),Eq. (17)] of
[Lemma 3.2]." A case split on the reader's
`(tid, loc)`, naming the writer thread in each branch.

28 branches, one for each `(reader, location)` pair of Eq. (15)-(17):
Eq. (15) gives 12, one per bridge or `z`-location; Eq. (16) and Eq. (17)
give 8 each, on the two-writer locations `xA`, `xA'`, `xB`, `xB'`, `yA`,
`yA'`, `yB`, `yB'` (each read once from each of its two writers). -/
def traceRf (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (ew er : Event (domainOf I)) : Prop :=
  match er.tid, er.loc with
  -- Eq. (15) / Eq. (15)
  | Tid.guessAX, Loc.zAxx' =>
      ∃ i, rawNthWrite trace Tid.primeAX Loc.zAxx' i = some ew ∧
        rawNthRead trace Tid.guessAX Loc.zAxx' i = some er
  | Tid.primeAX, Loc.zAx'x =>
      ∃ i, rawNthWrite trace Tid.guessAX Loc.zAx'x i = some ew ∧
        rawNthRead trace Tid.primeAX Loc.zAx'x i = some er
  | Tid.guessAY, Loc.zAyy' =>
      ∃ i, rawNthWrite trace Tid.primeAY Loc.zAyy' i = some ew ∧
        rawNthRead trace Tid.guessAY Loc.zAyy' i = some er
  | Tid.primeAY, Loc.zAy'y =>
      ∃ i, rawNthWrite trace Tid.guessAY Loc.zAy'y i = some ew ∧
        rawNthRead trace Tid.primeAY Loc.zAy'y i = some er
  | Tid.guessBX, Loc.zBxx' =>
      ∃ i, rawNthWrite trace Tid.primeBX Loc.zBxx' i = some ew ∧
        rawNthRead trace Tid.guessBX Loc.zBxx' i = some er
  | Tid.primeBX, Loc.zBx'x =>
      ∃ i, rawNthWrite trace Tid.guessBX Loc.zBx'x i = some ew ∧
        rawNthRead trace Tid.primeBX Loc.zBx'x i = some er
  | Tid.guessBY, Loc.zByy' =>
      ∃ i, rawNthWrite trace Tid.primeBY Loc.zByy' i = some ew ∧
        rawNthRead trace Tid.guessBY Loc.zByy' i = some er
  | Tid.primeBY, Loc.zBy'y =>
      ∃ i, rawNthWrite trace Tid.guessBY Loc.zBy'y i = some ew ∧
        rawNthRead trace Tid.primeBY Loc.zBy'y i = some er
  | Tid.guessAY, Loc.zAxy =>
      ∃ i, rawNthWrite trace Tid.guessAX Loc.zAxy i = some ew ∧
        rawNthRead trace Tid.guessAY Loc.zAxy i = some er
  | Tid.guessAX, Loc.ellAyx =>
      ∃ i, rawNthWrite trace Tid.guessAY Loc.ellAyx i = some ew ∧
        rawNthRead trace Tid.guessAX Loc.ellAyx i = some er
  | Tid.guessBY, Loc.zBxy =>
      ∃ i, rawNthWrite trace Tid.guessBX Loc.zBxy i = some ew ∧
        rawNthRead trace Tid.guessBY Loc.zBxy i = some er
  | Tid.guessBX, Loc.ellByx =>
      ∃ i, rawNthWrite trace Tid.guessBY Loc.ellByx i = some ew ∧
        rawNthRead trace Tid.guessBX Loc.ellByx i = some er
  -- Eq. (16) / Eq. (16)
  | Tid.primeCheckX, Loc.xA =>
      ∃ i, rawNthWrite trace Tid.checkX Loc.xA i = some ew ∧
        rawNthRead trace Tid.primeCheckX Loc.xA i = some er
  | Tid.checkX, Loc.xA' =>
      ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xA' i = some ew ∧
        rawNthRead trace Tid.checkX Loc.xA' i = some er
  | Tid.primeCheckX, Loc.xB =>
      ∃ i, rawNthWrite trace Tid.checkX Loc.xB i = some ew ∧
        rawNthRead trace Tid.primeCheckX Loc.xB i = some er
  | Tid.checkX, Loc.xB' =>
      ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xB' i = some ew ∧
        rawNthRead trace Tid.checkX Loc.xB' i = some er
  | Tid.primeCheckY, Loc.yA =>
      ∃ i, rawNthWrite trace Tid.checkY Loc.yA i = some ew ∧
        rawNthRead trace Tid.primeCheckY Loc.yA i = some er
  | Tid.checkY, Loc.yA' =>
      ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yA' i = some ew ∧
        rawNthRead trace Tid.checkY Loc.yA' i = some er
  | Tid.primeCheckY, Loc.yB =>
      ∃ i, rawNthWrite trace Tid.checkY Loc.yB i = some ew ∧
        rawNthRead trace Tid.primeCheckY Loc.yB i = some er
  | Tid.checkY, Loc.yB' =>
      ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yB' i = some ew ∧
        rawNthRead trace Tid.checkY Loc.yB' i = some er
  -- Eq. (17) / Eq. (17)
  | Tid.checkX, Loc.xA =>
      ∃ i, rawNthWrite trace Tid.guessAX Loc.xA i = some ew ∧
        rawNthRead trace Tid.checkX Loc.xA i = some er
  | Tid.primeCheckX, Loc.xA' =>
      ∃ i, rawNthWrite trace Tid.primeAX Loc.xA' i = some ew ∧
        rawNthRead trace Tid.primeCheckX Loc.xA' i = some er
  | Tid.checkX, Loc.xB =>
      ∃ i, rawNthWrite trace Tid.guessBX Loc.xB i = some ew ∧
        rawNthRead trace Tid.checkX Loc.xB i = some er
  | Tid.primeCheckX, Loc.xB' =>
      ∃ i, rawNthWrite trace Tid.primeBX Loc.xB' i = some ew ∧
        rawNthRead trace Tid.primeCheckX Loc.xB' i = some er
  | Tid.checkY, Loc.yA =>
      ∃ i, rawNthWrite trace Tid.guessAY Loc.yA i = some ew ∧
        rawNthRead trace Tid.checkY Loc.yA i = some er
  | Tid.primeCheckY, Loc.yA' =>
      ∃ i, rawNthWrite trace Tid.primeAY Loc.yA' i = some ew ∧
        rawNthRead trace Tid.primeCheckY Loc.yA' i = some er
  | Tid.checkY, Loc.yB =>
      ∃ i, rawNthWrite trace Tid.guessBY Loc.yB i = some ew ∧
        rawNthRead trace Tid.checkY Loc.yB i = some er
  | Tid.primeCheckY, Loc.yB' =>
      ∃ i, rawNthWrite trace Tid.primeBY Loc.yB' i = some ew ∧
        rawNthRead trace Tid.primeCheckY Loc.yB' i = some er
  | _, _ => False

/-- The thread-level `rf` topology (Fig. 4), first half: `traceRf I trace ew er` forces
