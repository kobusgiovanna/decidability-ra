        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessAYEllAWritePred
        · exact ellAyxWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact ellAyxWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
        · exact ellAyxWritePredCore_false_of_ne Loc.zAxy OpType.rd (by decide)
        · exact ellAyxWritePredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
