theorem rawNthWrite_primeCheckY_yAprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
