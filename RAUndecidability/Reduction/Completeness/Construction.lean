    rfl
  have hzipj :
      ((checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXBprimeReadPred I p.1))[i]?
      = some ((⟨EventLabel.rd Tid.checkX Loc.xB' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX), 4 + i * 6 + 5) := by
    rw [hzip]
