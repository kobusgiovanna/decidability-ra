/-- `checkYBlock0Elems_yB_filter` for the `zipIdx`-filter, starting at
offset `k` (the match is at `k + 1`). -/
theorem checkYBlock0Elems_yB_zipIdx_filter (I : PCPInstance) (v0 : (Fin I.n)) (k : ℕ) :
    (((checkYBlock0Elems I v0).zipIdx k).filter (fun p => checkYYBWritePred I p.1)) =
