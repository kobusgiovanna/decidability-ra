theorem traceRf_matches_primeCheckY_checkY_yBprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVX : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yB' i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yB' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, hewval⟩ := rawNthWrite_primeCheckY_yBprime_eq I cnts htracePVX hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_checkY_yBprime_eq I v0 kws htraceVX her
  have hclen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hcform := hcntsVal i hclen
  rw [hcform] at hc
  injection hc with hc
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hc, hkweq]
  congr 2
  omega

/-- `traceRf_matches_primeCheckY_checkY_yBprime` for the general
construction. -/
theorem traceRf_matches_primeCheckY_checkY_yBprime_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVY : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yB' i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yB' i = some er) :
    ew.val = er.val :=
  traceRf_matches_primeCheckY_checkY_yBprime I cnts htracePVY hcntsVal v0 kws htraceVY hkwsVal h

/-! ## `GuessAY`

`GuessAY`'s loop is `while True do … break …`. Its first iteration
(`fst = true`) writes `y_α` with the tag `ḡ_α^y` and skips the two reads
of `z_α^{x,y}`, `z_α^{y,y'}`. `guessAYLoop` is the loop, without the leading
`aux ← NDet({1,…,n})`. -/

/-- `GuessAY.program`'s loop, without the leading `ndetAssign`. -/
def guessAYLoop (I : PCPInstance) : Command (domainOf I) (GuessAY.Vocab I) :=
  Command.whileLoop GuessAY.BExpr.tt (GuessAY.loopBody I)

/-- The first iteration of `guessAYLoop`, from a state with `fst = true`,
`aux = some v0`: emits the three writes of block 0 (`w(yA)`, `w(ellAyx)`,
`w(zAy'y)`) and returns to the loop with `fst = false` and `aux` drawn from
`v0' :: rest`. Eighteen `Command.RunStep`s. -/
theorem guessAY_block0_step (I : PCPInstance) (v0 : Fin I.n) (v0' : Option (Fin I.n))
    (rest : List (GuessAY.Vals I))
    (φ : (GuessAY.Vocab I).Store) (hfst : φ GuessAY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ GuessAY.Vars.cnt = Sum.inr (Sum.inl 0))
    (haux : φ GuessAY.Vars.aux = Sum.inl (some v0)) :
    ∃ (φ' : (GuessAY.Vocab I).Store) (cLast : Config (domainOf I) (GuessAY.Vocab I)),
      φ' GuessAY.Vars.aux = Sum.inl v0' ∧ φ' GuessAY.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' GuessAY.Vars.cnt = Sum.inr (Sum.inl 1) ∧
      Command.Run Tid.guessAY (Sum.inl v0' :: rest)
        (guessAYLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
        , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩
        , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ ]
        cLast rest (guessAYLoop I, φ') := by
  set φ0 : (GuessAY.Vocab I).Store :=
    Function.update φ GuessAY.Vars.prev (GuessAY.eval I GuessAY.Expr.readCnt φ) with hφ0
  set φ1 : (GuessAY.Vocab I).Store :=
    Function.update φ0 GuessAY.Vars.cnt (GuessAY.eval I GuessAY.Expr.nextCnt φ0) with hφ1
  have hne1 : GuessAY.Vars.fst ≠ GuessAY.Vars.cnt := by decide
  have hne2 : GuessAY.Vars.fst ≠ GuessAY.Vars.prev := by decide
  have hfst1 : φ1 GuessAY.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne1 _ _).trans ((Function.update_of_ne hne2 _ _).trans hfst)
  set φ2 : (GuessAY.Vocab I).Store :=
    Function.update φ1 GuessAY.Vars.fst (GuessAY.eval I GuessAY.Expr.fstFalse φ1) with hφ2
  have hne3 : GuessAY.Vars.aux ≠ GuessAY.Vars.fst := by decide
  have hne4 : GuessAY.Vars.aux ≠ GuessAY.Vars.cnt := by decide
  have hne5 : GuessAY.Vars.aux ≠ GuessAY.Vars.prev := by decide
  have haux2 : φ2 GuessAY.Vars.aux = Sum.inl (some v0) :=
    (Function.update_of_ne hne3 _ _).trans ((Function.update_of_ne hne4 _ _).trans
