    (h : rawNthRead trace Tid.primeBY Loc.zBy'y i = some er) :
    ∃ v, vals[i]? = some v ∧ er.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeBY,
      (match lab.1.loc, lab.1.op with | Loc.zBy'y, OpType.rd => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zBy'y ∧ lab.1.op = OpType.rd) := by
    intro lab
