/-! ## `PrimeCheckY` (`c^{y'}`) -/

/-- `PrimeCheckY`'s initial store. -/
noncomputable def primeCheckYInit : (PrimeCheckY.Vocab testInstance).Store :=
  (PrimeCheckY.Vocab testInstance).mkStore
    (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none)
    (Sum.inl 0)

/-- The resolution of `PrimeCheckY`'s `while NDet({False, True})` loop:
`L_y = k + 1 = 2` iterations. -/
def primeCheckYRes : List (PrimeCheckY.Vals) := [Sum.inr true, Sum.inr true, Sum.inr false]

/-- `PrimeCheckY`'s word under `primeCheckYRes` (checked by
`primeCheckY_word_check`). -/
noncomputable def primeCheckYExpectedWord : Word (EventLabel (domainOf testInstance)) :=
  [ EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY 1)
  , EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY 1)
  , EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0)
  , EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0)
  , EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY 1)
  , EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY 1)
  , EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY 2)
  , EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY 2)
  , EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0)
  , EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0)
  , EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY 2)
  , EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY 2) ]

theorem primeCheckY_status :
    (Command.runFuel Tid.primeCheckY (PrimeCheckY.program testInstance, primeCheckYInit)
      primeCheckYRes 80).1 = .stuck := by decide

theorem primeCheckY_word_check :
    (Command.runFuel Tid.primeCheckY (PrimeCheckY.program testInstance, primeCheckYInit)
      primeCheckYRes 80).2.1.map Subtype.val = primeCheckYExpectedWord := by decide

/-- The `Command.Run` of `PrimeCheckY`, from `primeCheckY_status`. -/
theorem primeCheckY_run_witness :
    ∃ cLast sf cf,
      Command.Run Tid.primeCheckY primeCheckYRes
        (PrimeCheckY.program testInstance, primeCheckYInit)
        (Command.runFuel Tid.primeCheckY (PrimeCheckY.program testInstance, primeCheckYInit)
          primeCheckYRes 80).2.1
        cLast sf cf := by
  have hstatus := primeCheckY_status
  generalize hcomp : Command.runFuel Tid.primeCheckY
    (PrimeCheckY.program testInstance, primeCheckYInit)
    primeCheckYRes 80 = result at hstatus ⊢
  obtain ⟨res, σ, cf, sf⟩ := result
  have hres : res = .stuck := hstatus
  subst hres
  obtain ⟨cLast, hrun⟩ := Command.runFuel_sound Tid.primeCheckY 80
    (PrimeCheckY.program testInstance, primeCheckYInit) primeCheckYRes σ cf sf hcomp
  exact ⟨cLast, sf, cf, hrun⟩

/-! ## The values written by the guessers

The values `GuessAX`/`GuessBX`/`GuessAY`/`GuessBY` write to
`x_α`/`x_β`/`y_α`/`y_β`, compared with those named in "The events of `G`". -/

/-- The letter of an `xTag` value (`none` otherwise). -/
def xTagLetter : Val testInstance → Option testInstance.Γ
  | .xTag _ letter => letter
  | _ => none

/-- The index of a `yTag` value (`none` otherwise). -/
def yTagAux : Val testInstance → Option (Fin testInstance.n)
  | .yTag _ aux => aux
  | _ => none

/-- The letters written to `loc` by a word, in order. -/
def letterWritesAt (loc : (domainOf testInstance).Loc)
    (w : Word (EventLabel (domainOf testInstance))) : List (Option testInstance.Γ) :=
  (w.filter fun l => decide (l.op = .wt ∧ l.loc = loc)).map (fun l => xTagLetter l.val)

/-- The indices written to `loc` by a word, in order. -/
def auxWritesAt (loc : (domainOf testInstance).Loc)
    (w : Word (EventLabel (domainOf testInstance))) : List (Option (Fin testInstance.n)) :=
  (w.filter fun l => decide (l.op = .wt ∧ l.loc = loc)).map (fun l => yTagAux l.val)

/-- `GuessAX` writes `α_{j_1}⋯ α_{j_k}· ⊥` letter by letter to `x_α`
("The events of `G`"), for `testInstance` and the solution `[0]`. -/
theorem guessAX_writes_construction_letters :
    letterWritesAt Loc.xA
      ((Command.runFuel Tid.guessAX (GuessAX.program testInstance, guessAXInit)
        guessAXRes 80).2.1.map Subtype.val)
      = (testInstance.α ⟨0, testInstance.hn⟩).map some ++ [none] := by decide

/-- `GuessBX` writes `β_{j_1}⋯ β_{j_k}· ⊥` letter by letter to `x_β`. -/
theorem guessBX_writes_construction_letters :
    letterWritesAt Loc.xB
      ((Command.runFuel Tid.guessBX (GuessBX.program testInstance, guessBXInit)
        guessBXRes 80).2.1.map Subtype.val)
      = (testInstance.β ⟨0, testInstance.hn⟩).map some ++ [none] := by decide

/-- `GuessAY` writes `j_1,…,j_k,⊥` to `y_α` ("The events of `G`"), for the
solution `[0]`. -/
theorem guessAY_writes_construction_indices :
    auxWritesAt Loc.yA
      ((Command.runFuel Tid.guessAY (GuessAY.program testInstance, guessAYInit)
        guessAYRes 50).2.1.map Subtype.val)
      = [some (⟨0, testInstance.hn⟩ : Fin testInstance.n), none] := by decide

/-- `GuessBY` writes `j_1,…,j_k,⊥` to `y_β`. -/
theorem guessBY_writes_construction_indices :
    auxWritesAt Loc.yB
      ((Command.runFuel Tid.guessBY (GuessBY.program testInstance, guessBYInit)
        guessBYRes 80).2.1.map Subtype.val)
      = [some (⟨0, testInstance.hn⟩ : Fin testInstance.n), none] := by decide

/-! ## Runs of the primed threads (Lemma 3.4 for the primed threads)

For an arbitrary instance `I` and number of iterations `M`, by induction on
`M`. One iteration of a loop with `k` actions is `5 + 2k` steps
(`Command.RunStep`s), each computed by `Command.step` and lifted by
`Command.step_sound`. -/

def primeAXLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeAX.Vocab I) :=
  Command.seq (PrimeAX.body I) (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)

/-- `PrimeAX`'s loop, without the initial `ndetAssign` of
`Command.whileNdet`. -/
def primeAXLoop (I : PCPInstance) : Command (domainOf I) (PrimeAX.Vocab I) :=
  Command.whileLoop PrimeAX.BExpr.isB (primeAXLoopBody I)

/-- The word of `M + 1` iterations of `primeAXLoop`: `M + 1` copies of the
block `[wt xA', wt zAxx', rd zAx'x]`, with values `vals`. -/
def primeAXBlockWord (I : PCPInstance) (vals : List (Val I)) :
    Word (ThreadLabel (domainOf I) Tid.primeAX) :=
  vals.flatMap (fun l =>
    [ (⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeAX)
    , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' l, rfl⟩
    , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x l, rfl⟩ ])

/-- The `zAxx'`-writes of `primeAXBlockWord`: one per entry of `vals`, at
offset `1` of its block. -/
theorem primeAXBlockWord_zAxx'_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeAXBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zAxx', OpType.wt => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAX)
        , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x v, rfl⟩ ] ++ (primeAXBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zAxx', OpType.wt => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeAX Loc.xA'
            (Val.primeTag Tid.primeAX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeAX))
          (by exact (by decide : ¬ (match Loc.xA', OpType.wt with
            | Loc.zAxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeAX Loc.zAxx' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAX))
          (by exact (by decide : (match Loc.zAxx', OpType.wt with
            | Loc.zAxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeAX Loc.zAx'x v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAX))
          (by exact (by decide : ¬ (match Loc.zAx'x, OpType.rd with
            | Loc.zAxx', OpType.wt => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_singleton, List.length_cons, List.length_nil]
      omega

/-- `primeAX`'s `i`-th `zAxx'`-write in a trace with
`trace Tid.primeAX = primeAXBlockWord I vals` carries `vals[i]`. -/
theorem rawNthWrite_primeAX_zAxx'_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeAX = primeAXBlockWord I vals)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.primeAX Loc.zAxx' i = some ew) :
    ∃ v, vals[i]? = some v ∧ ew.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeAX,
      (match lab.1.loc, lab.1.op with | Loc.zAxx', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zAxx' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeAX Loc.zAxx' OpType.wt).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAX)
    (x := Loc.zAxx') (op := OpType.wt) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeAX Loc.zAxx' OpType.wt).length = vals.length :=
    hlen.trans (primeAXBlockWord_zAxx'_length I vals)
  rw [hlen'] at hilt
  obtain ⟨v, hv⟩ : ∃ v, vals[i]? = some v := ⟨vals[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeAX)
      , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x l, rfl⟩ ])
    3 1
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zAxx', OpType.wt => true | _, _ => false)
    (fun l => (⟨EventLabel.wt Tid.primeAX Loc.zAxx' l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeAX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq02 : q = 0 ∨ q = 2 := by omega
      rcases hq02 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.xA', OpType.wt with
          | Loc.zAxx', OpType.wt => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zAx'x, OpType.rd with
          | Loc.zAxx', OpType.wt => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeAX)
    (l := primeAXBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeAX Loc.zAxx' OpType.wt i = some ew := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl
