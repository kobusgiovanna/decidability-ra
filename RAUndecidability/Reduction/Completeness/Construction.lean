  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeAX)
      , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x l, rfl⟩ ])
    3 2
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zAx'x, OpType.rd => true | _, _ => false)
    (fun l => (⟨EventLabel.rd Tid.primeAX Loc.zAx'x l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeAX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq01 : q = 0 ∨ q = 1 := by omega
      rcases hq01 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.xA', OpType.wt with
          | Loc.zAx'x, OpType.rd => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zAxx', OpType.wt with
          | Loc.zAx'x, OpType.rd => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeAX)
    (l := primeAXBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeAX Loc.zAx'x OpType.rd i = some er := h
