  have hprevVal1 : (GuessBY.Vocab I).evalV GuessBY.VExpr.prevVal φ1 = Val.cnt k := by
    simp only [GuessBY.Vocab, GuessBY.evalV, GuessBY.prevOf, hprev1raw]; rfl
  have h1 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
