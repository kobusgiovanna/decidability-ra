  obtain ⟨c, hc⟩ : ∃ c, cnts[i]? = some c := ⟨cnts[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (α := Fin 4) (β := ThreadLabel (domainOf I) Tid.primeCheckX)
    (fun c =>
      [ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeCheckX)
      , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
    6 5
    (fun _ => rfl)
    (primeCheckXXBReadPred I)
    (fun c => (⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold primeCheckXXBReadPred
      · exact xBReadPredCore_false_of_ne Loc.xA' OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xB' OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xA OpType.rd (by decide))
    cnts 0 i c hc
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeCheckX)
    (l := primeCheckXBlockWord I cnts) htrace (primeCheckXXBReadPred_iff I) hfilt
  have hraw : rawNthEvent trace Tid.primeCheckX Loc.xB OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨c, hc, by injection hconn with hconn; rw [hconn]; rfl⟩

/-- `rf_total` for the `primeCheckX`/`xB` branch (Eq. (16)). -/
theorem traceRf_total_primeCheckX_xB (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cs : List I.Γ) (cnts : List (Fin 4)) (hcnts : cnts.length = cs.length + 1)
    (htraceP : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1)
    (htraceV : trace Tid.checkX = checkXBlockWord I v0 kws)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeCheckX) (her_loc : er.loc = Loc.xB)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeCheckX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeCheckX Loc.xB OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeCheckX Loc.xB OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeCheckX Loc.xB i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeCheckX Loc.xB OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xB) (op := OpType.rd) (predL := primeCheckXXBReadPred I) htraceP
    (primeCheckXXBReadPred_iff I)
  rw [hlen.trans (primeCheckXBlockWord_xB_length I cnts)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xB) (op := OpType.wt) (predL := checkXXBWritePred I) htraceV
    (checkXXBWritePred_iff I)
  have hlenW2 : ((checkXBlockWord I v0 kws).filter (checkXXBWritePred I)).length
      = 1 + kws.length := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xB_filter,
      checkXBlockRestElems_xB_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.checkX Loc.xB OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

/-- `rf_matches` for the `checkX`/`primeCheckX` `xB` branch (Eq. (16)/(16)). -/
theorem traceRf_matches_checkX_primeCheckX_xB (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkX Loc.xB i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xB i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, herval⟩ := rawNthRead_primeCheckX_xB_eq I cnts htracePVX her
  have hilen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hcform := hcntsVal i hilen
  rw [hcform] at hc
  injection hc with hc
  rcases rawNthWrite_checkX_xB_eq I v0 kws htraceVX hew with ⟨hi0, hewval⟩ | ⟨kw, hkw, hi1, hewval⟩
  · subst hi0
    rw [hewval, herval, ← hc]
    congr 1
  · have hjlen : i - 1 < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
    obtain ⟨w, hw⟩ := hkwsVal (i - 1) hjlen
    have hkweq := hkw.symm.trans hw
    injection hkweq with hkweq
    rw [hewval, herval, ← hc, hkweq]
    congr 1
    apply Fin.ext
    simp [Fin.add_def]
    omega

/-- `traceRf_matches_checkX_primeCheckX_xB` for the general construction. -/
theorem traceRf_matches_checkX_primeCheckX_xB_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkX Loc.xB i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xB i = some er) :
    ew.val = er.val :=
  traceRf_matches_checkX_primeCheckX_xB I v0 kws htraceVX hkwsVal cnts htracePVX hcntsVal h

/-! ## `rf_matches`: `guessBX`/`checkX` `xB` (Eq. (17))

`w_i(g_β^x,x_β) ⟶rf r_i(c^x,x_β)`. `checkX`'s `xB`-read is at
offset `3` of both its block shapes. The write side is in
`Completeness/Graph.lean`. -/

/-- `checkX`'s `xB`-read predicate, lifted from `xBReadPredCore`. -/
def checkXXBReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) : Bool :=
  xBReadPredCore lab.1.loc lab.1.op

theorem checkXXBReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) :
    checkXXBReadPred I lab = true ↔ (lab.1.loc = Loc.xB ∧ lab.1.op = OpType.rd) := by
  unfold checkXXBReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xBReadPredCore_iff y z

/-- `checkXBlock0Elems` has one `xB`-read, at offset `3`. -/
theorem checkXBlock0Elems_xB_read_filter (I : PCPInstance) (v0 : I.Γ) :
    (checkXBlock0Elems I v0).filter (checkXXBReadPred I) =
      [(⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX)] := by
  apply list_filter_singleton_of_unique' (checkXBlock0Elems I v0) (checkXXBReadPred I) 3
    (⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩)
    rfl
    (by unfold checkXXBReadPred; exact (xBReadPredCore_iff Loc.xB OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 0 ∨ q = 1 ∨ q = 2 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkXBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkXXBReadPred
      · exact xBReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
      · exact xBReadPredCore_false_of_ne Loc.xA OpType.rd (by decide))

/-- `checkXBlockRestElems` has one `xB`-read per entry of `kws`. -/
theorem checkXBlockRestElems_xB_read_filter (I : PCPInstance) (kws : List (Fin 4 × Option I.Γ)) :
    ((kws.flatMap (checkXBlockRestElems I)).filter (checkXXBReadPred I)).length
