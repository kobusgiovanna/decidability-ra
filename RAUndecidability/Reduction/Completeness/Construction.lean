theorem guessAYBlockRestElems_zAxy_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (guessAYBlockRestElems I)).filter (guessAYZAxyReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessAYBlockRestElems I kw) ++ kws.flatMap (guessAYBlockRestElems I)).filter
        (guessAYZAxyReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessAYBlockRestElems I kw).filter (guessAYZAxyReadPred I) =
          [(⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAY)] := by
        apply list_filter_singleton_of_unique' (guessAYBlockRestElems I kw)
          (guessAYZAxyReadPred I) 3
          (⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt kw.1), rfl⟩)
          rfl
          (by unfold guessAYZAxyReadPred
              exact (zAxyReadPredCore_iff Loc.zAxy OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
            have hq4 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 := by omega
            rcases hq4 with rfl | rfl | rfl | rfl <;>
              simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold guessAYZAxyReadPred
            · exact zAxyReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact zAxyReadPredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
            · exact zAxyReadPredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
            · exact zAxyReadPredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_guessAY_zAxy_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.guessAY Loc.zAxy i = some er) :
    ∃ kw, kws[i]? = some kw ∧ er.val = Val.cnt kw.1 := by
  have hpredL := guessAYZAxyReadPred_iff I
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.zAxy) (op := OpType.rd)
    (predL := guessAYZAxyReadPred I) htrace hpredL
  have hlen2 : ((guessAYBlockWord I v0 kws).filter (guessAYZAxyReadPred I)).length
      = kws.length := by
    unfold guessAYBlockWord
