    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeBY Loc.zBy'y OpType.rd).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBY)
    (x := Loc.zBy'y) (op := OpType.rd) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeBY Loc.zBy'y OpType.rd).length = vals.length :=
    hlen.trans (primeBYBlockWord_zBy'y_length I vals)
  rw [hlen'] at hilt
  obtain ⟨v, hv⟩ : ∃ v, vals[i]? = some v := ⟨vals[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeBY)
      , ⟨EventLabel.wt Tid.primeBY Loc.zByy' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y l, rfl⟩ ])
    3 2
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zBy'y, OpType.rd => true | _, _ => false)
    (fun l => (⟨EventLabel.rd Tid.primeBY Loc.zBy'y l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeBY))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq01 : q = 0 ∨ q = 1 := by omega
      rcases hq01 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.yB', OpType.wt with
          | Loc.zBy'y, OpType.rd => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zByy', OpType.wt with
          | Loc.zBy'y, OpType.rd => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeBY)
    (l := primeBYBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeBY Loc.zBy'y OpType.rd i = some er := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl

def zBy'yWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zBy'y, OpType.wt => true | _, _ => false

theorem zBy'yWritePredCore_iff (y : Loc) (z : OpType) :
    zBy'yWritePredCore y z = true ↔ (y = Loc.zBy'y ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem zBy'yWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.zBy'y ∧ z = OpType.wt)) :
    zBy'yWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)


def guessBYZByprimeWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessBY) :
    Bool :=
  zBy'yWritePredCore lab.1.loc lab.1.op

theorem guessBYZByprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.guessBY) :
    guessBYZByprimeWritePred I lab = true ↔ (lab.1.loc = Loc.zBy'y ∧ lab.1.op = OpType.wt) := by
  unfold guessBYZByprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact zBy'yWritePredCore_iff y z

theorem guessBYBlock0Elems_zBy'y_filter (I : PCPInstance) (v0 : Fin I.n) :
    (guessBYBlock0Elems I v0).filter (guessBYZByprimeWritePred I) =
      [(⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY)] := by
  apply list_filter_singleton_of_unique' (guessBYBlock0Elems I v0) (guessBYZByprimeWritePred I) 2
    (⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩)
    rfl
    (by unfold guessBYZByprimeWritePred
        exact (zBy'yWritePredCore_iff Loc.zBy'y OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq01 : q = 0 ∨ q = 1 := by omega
      rcases hq01 with rfl | rfl <;>
        simp only [guessBYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessBYZByprimeWritePred
      · exact zBy'yWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact zBy'yWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide))

theorem guessBYBlockRestElems_zBy'y_filter (I : PCPInstance)
    (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (guessBYBlockRestElems I)).filter (guessBYZByprimeWritePred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessBYBlockRestElems I kw) ++ kws.flatMap (guessBYBlockRestElems I)).filter
        (guessBYZByprimeWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessBYBlockRestElems I kw).filter (guessBYZByprimeWritePred I) =
          [(⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (kw.1 + 1)), rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessBY)] := by
        apply list_filter_singleton_of_unique' (guessBYBlockRestElems I kw)
          (guessBYZByprimeWritePred I) 2
          (⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (kw.1 + 1)), rfl⟩)
          rfl
          (by unfold guessBYZByprimeWritePred
              exact (zBy'yWritePredCore_iff Loc.zBy'y OpType.wt).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
            have hq4 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 := by omega
            rcases hq4 with rfl | rfl | rfl | rfl <;>
