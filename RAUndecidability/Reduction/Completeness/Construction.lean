  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
    (l := guessAYBlockWord I v0 kws) htrace (guessAYZAyReadPred_iff I) hzipj
  have hraw : rawNthEvent trace Tid.guessAY Loc.zAyy' OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨kw, hkw, by injection hconn with hconn; rw [hconn]; rfl⟩

/-- `rf_total` for the `guessAY`/`zAyy'` branch (Eq. (15)): `guessAY` makes
`kws.length` `zAyy'`-reads, `primeAY` makes `vals.length` `zAyy'`-writes. -/
theorem traceRf_total_guessAY_zAyy' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (vals : List (Val I)) (htraceP : trace Tid.primeAY = primeAYBlockWord I vals)
    (hcount : kws.length ≤ vals.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessAY) (her_loc : er.loc = Loc.zAyy')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.guessAY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.guessAY Loc.zAyy' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.guessAY Loc.zAyy' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.guessAY Loc.zAyy' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.guessAY Loc.zAyy' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.zAyy') (op := OpType.rd) (predL := guessAYZAyReadPred I) htraceG
    (guessAYZAyReadPred_iff I)
  have hlen2 : ((guessAYBlockWord I v0 kws).filter (guessAYZAyReadPred I)).length
      = kws.length := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_zAyy'_filter,
      guessAYBlockRestElems_zAyy'_filter]
    simp
  rw [hlen.trans hlen2] at hilt_reader
  have hpredW : ∀ lab : ThreadLabel (domainOf I) Tid.primeAY,
      (match lab.1.loc, lab.1.op with | Loc.zAyy', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zAyy' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAY)
    (x := Loc.zAyy') (op := OpType.wt) htraceP hpredW
  have hilt_writer : i < (rawOpEvents trace Tid.primeAY Loc.zAyy' OpType.wt).length := by
    rw [hlenW.trans (primeAYBlockWord_zAyy'_length I vals)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_primeAY_guessAY_zAyy' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htracePAY : trace Tid.primeAY = primeAYBlockWord I vals)
    (cnt0 : Fin 4) (hcnt0 : cnt0 = 0)
    (hvalsVal : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4)))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeAY Loc.zAyy' i = some ew ∧
      rawNthRead trace Tid.guessAY Loc.zAyy' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨v, hv, hewval⟩ := rawNthWrite_primeAY_zAyy'_eq I vals htracePAY hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_guessAY_zAyy'_eq I v0 kws htraceGAY her
  have hvlen : i < vals.length := (List.getElem?_eq_some_iff.mp hv).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hvform := hvalsVal i hvlen
  rw [hvform] at hv
  injection hv with hv
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hv, hkweq]
  congr 2
  rw [hcnt0]
  simp
  omega

/-- `traceRf_matches_primeAY_guessAY_zAyy'` for the general construction. -/
theorem traceRf_matches_primeAY_guessAY_zAyy'_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htracePAY : trace Tid.primeAY = primeAYBlockWord I vals)
    (hvalsVal : ∀ i, i < vals.length → vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeAY Loc.zAyy' i = some ew ∧
      rawNthRead trace Tid.guessAY Loc.zAyy' i = some er) :
    ew.val = er.val := by
  have hvalsVal' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨((0 : Fin 4).val + i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; rw [hvalsVal i hi]; congr 2; apply Fin.ext; simp
  exact traceRf_matches_primeAY_guessAY_zAyy' I vals htracePAY 0 rfl hvalsVal' v0 kws htraceGAY
    hkwsVal h

/-! ## `rf_matches`: `guessAY`/`primeAY` `zAy'y` (Eq. (15)) -/

theorem primeAYBlockWord_zAy'y_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeAYBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zAy'y, OpType.rd => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY)
        , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y v, rfl⟩ ] ++ (primeAYBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zAy'y, OpType.rd => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeAY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : ¬ (match Loc.yA', OpType.wt with
            | Loc.zAy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeAY Loc.zAyy' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : ¬ (match Loc.zAyy', OpType.wt with
            | Loc.zAy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeAY Loc.zAy'y v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeAY))
          (by exact (by decide : (match Loc.zAy'y, OpType.rd with
            | Loc.zAy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_primeAY_zAy'y_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeAY = primeAYBlockWord I vals)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.primeAY Loc.zAy'y i = some er) :
    ∃ v, vals[i]? = some v ∧ er.val = v := by
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeAY,
      (match lab.1.loc, lab.1.op with | Loc.zAy'y, OpType.rd => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zAy'y ∧ lab.1.op = OpType.rd) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hilt : i < (rawOpEvents trace Tid.primeAY Loc.zAy'y OpType.rd).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAY)
    (x := Loc.zAy'y) (op := OpType.rd) htrace hpredL
  have hlen' : (rawOpEvents trace Tid.primeAY Loc.zAy'y OpType.rd).length = vals.length :=
    hlen.trans (primeAYBlockWord_zAy'y_length I vals)
  rw [hlen'] at hilt
  obtain ⟨v, hv⟩ : ∃ v, vals[i]? = some v := ⟨vals[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (fun l => [ (⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeAY)
      , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' l, rfl⟩
      , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y l, rfl⟩ ])
    3 2
    (fun _ => rfl)
    (fun lab => match lab.1.loc, lab.1.op with | Loc.zAy'y, OpType.rd => true | _, _ => false)
    (fun l => (⟨EventLabel.rd Tid.primeAY Loc.zAy'y l, rfl⟩ : ThreadLabel (domainOf I) Tid.primeAY))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq01 : q = 0 ∨ q = 1 := by omega
      rcases hq01 with rfl | rfl
      · simp only [List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.yA', OpType.wt with
          | Loc.zAy'y, OpType.rd => true | _, _ => false) = false)
      · simp only [List.getElem?_cons_succ, List.getElem?_cons_zero, Option.some.injEq] at hget
        rw [← hget]
        exact (by decide : (match Loc.zAyy', OpType.wt with
          | Loc.zAy'y, OpType.rd => true | _, _ => false) = false))
    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeAY)
    (l := primeAYBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeAY Loc.zAy'y OpType.rd i = some er := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl

def zAy'yWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zAy'y, OpType.wt => true | _, _ => false

theorem zAy'yWritePredCore_iff (y : Loc) (z : OpType) :
    zAy'yWritePredCore y z = true ↔ (y = Loc.zAy'y ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem zAy'yWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.zAy'y ∧ z = OpType.wt)) :
    zAy'yWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)


def guessAYZAyprimeWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    Bool :=
  zAy'yWritePredCore lab.1.loc lab.1.op

theorem guessAYZAyprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    guessAYZAyprimeWritePred I lab = true ↔ (lab.1.loc = Loc.zAy'y ∧ lab.1.op = OpType.wt) := by
  unfold guessAYZAyprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact zAy'yWritePredCore_iff y z

