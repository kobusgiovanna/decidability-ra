theorem checkXBlockRestElems_xBprime_filter (I : PCPInstance) (kws : List (Fin 4 × Option I.Γ)) :
    ((kws.flatMap (checkXBlockRestElems I)).filter (checkXXBprimeReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkXBlockRestElems I kw) ++ kws.flatMap (checkXBlockRestElems I)).filter
        (checkXXBprimeReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkXBlockRestElems I kw).filter (checkXXBprimeReadPred I) =
          [(⟨EventLabel.rd Tid.checkX Loc.xB' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkX)] := by
        apply list_filter_singleton_of_unique' (checkXBlockRestElems I kw)
          (checkXXBprimeReadPred I) 5
          (⟨EventLabel.rd Tid.checkX Loc.xB' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩)
          rfl
          (by unfold checkXXBprimeReadPred
              exact (xBprimeReadPredCore_iff Loc.xB' OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkXXBprimeReadPred
            · exact xBprimeReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
            · exact xBprimeReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
            · exact xBprimeReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)
            · exact xBprimeReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)
            · exact xBprimeReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_checkX_xBprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
