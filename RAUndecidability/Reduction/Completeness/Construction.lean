/-- The exit of `guessAXInnerLoop` (`j > N`): two silent steps to the
continuation `C2`. -/
theorem guessAXOuterExit_step (I : PCPInstance) (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store) (C2 : Command (domainOf I) (GuessAX.Vocab I))
    (hguard : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ = false) :
    ∃ (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      Command.Run Tid.guessAX rest
        (Command.seq (guessAXInnerLoop I) C2, φ) [] cLast rest (C2, φ) := by
  have hguard' : GuessAX.evalB I GuessAX.BExpr.jLeN φ = false := hguard
  have h1 : Command.RunStep Tid.guessAX rest none
      (Command.seq (guessAXInnerLoop I) C2, φ) rest
      (Command.seq Command.skip C2, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [guessAXInnerLoop, Command.step, GuessAX.Vocab, hguard']; rfl)
  have h2 : Command.RunStep Tid.guessAX rest none
      (Command.seq Command.skip C2, φ) rest (C2, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.guessAX) (s := rest)
    (c := (Command.seq (guessAXInnerLoop I) C2, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  exact ⟨_, run2⟩

/-- The end of a continuing iteration of `guessAXLoop`:
`r(ℓ_α^{y,x}, ⟨cntY, aux⟩)`, `aux = ⊥` false, `aux ← NDet({1,…,n,⊥})` draws
`v0'`, back to `guessAXLoop I`. Six `Command.RunStep`s. -/
theorem guessAXOuterTail_continue_step (I : PCPInstance) (v : Fin I.n) (v0' : Option (Fin I.n))
    (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store)
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0))
    (haux : φ GuessAX.Vars.aux = Sum.inl (some v)) :
    ∃ (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      φ' GuessAX.Vars.aux = Sum.inl v0' ∧
      φ' GuessAX.Vars.cnt = φ GuessAX.Vars.cnt ∧
      φ' GuessAX.Vars.fst = φ GuessAX.Vars.fst ∧
      φ' GuessAX.Vars.cntY = φ GuessAX.Vars.cntY ∧
      Command.Run Tid.guessAX (Sum.inl v0' :: rest)
        (Command.loopSeq
          (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
            (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
                (GuessAX.auxSetBot_nonempty I))))
          (guessAXLoop I), φ)
        [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx (Val.cntAux cntY0 (some v)), rfl⟩ ]
        cLast rest (guessAXLoop I, φ') := by
  have hellVal :
      (GuessAX.Vocab I).evalV GuessAX.VExpr.cntYAuxVal φ = Val.cntAux cntY0 (some v) := by
    have hcntYOfφ : GuessAX.cntYOf I φ = cntY0 := by simp only [GuessAX.cntYOf, hcntY0]
    have hauxOfφ : GuessAX.auxOf I φ = some v := by simp only [GuessAX.auxOf, haux]
    simp only [GuessAX.Vocab, GuessAX.evalV, hcntYOfφ, hauxOfφ]; rfl
  have h1 : Command.RunStep Tid.guessAX (Sum.inl v0' :: rest)
      (some ⟨EventLabel.rd Tid.guessAX Loc.ellAyx
        ((GuessAX.Vocab I).evalV GuessAX.VExpr.cntYAuxVal φ),
        rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h2 : Command.RunStep Tid.guessAX (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have haux' : (GuessAX.Vocab I).evalB GuessAX.BExpr.isBot φ = false := by
    simp [GuessAX.Vocab, GuessAX.evalB, haux]
  have h3 : Command.RunStep Tid.guessAX (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp [Command.step, haux'])
  have h4 : Command.RunStep Tid.guessAX (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hmem : (Sum.inl v0' : GuessAX.Vals I) ∈ GuessAX.auxSetBot I := by
    simp only [GuessAX.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨v0', rfl⟩
  have h5 : Command.RunStep Tid.guessAX (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I))
        (guessAXLoop I), φ)
      rest
      (Command.loopSeq Command.skip (guessAXLoop I),
        Function.update φ GuessAX.Vars.aux (Sum.inl v0')) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hmem h
  have h6 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq Command.skip (guessAXLoop I),
        Function.update φ GuessAX.Vars.aux (Sum.inl v0'))
      rest
      (guessAXLoop I, Function.update φ GuessAX.Vars.aux (Sum.inl v0')) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.guessAX) (s := Sum.inl v0' :: rest)
    (c := (Command.loopSeq
        (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ))
  have run1 := Command.Run.labelledSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.silentSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.silentSnoc run5 h6
  rw [hellVal] at run6
  have hne_cnt_aux : GuessAX.Vars.cnt ≠ GuessAX.Vars.aux := by decide
  have hne_fst_aux : GuessAX.Vars.fst ≠ GuessAX.Vars.aux := by decide
  have hne_cntY_aux : GuessAX.Vars.cntY ≠ GuessAX.Vars.aux := by decide
  exact ⟨Function.update φ GuessAX.Vars.aux (Sum.inl v0'), _,
    Function.update_self _ _ _,
    Function.update_of_ne hne_cnt_aux _ _,
    Function.update_of_ne hne_fst_aux _ _,
    Function.update_of_ne hne_cntY_aux _ _,
    run6⟩

/-- The end of the terminating iteration of `guessAXLoop` (`aux = ⊥`): the
read of `ℓ_α^{y,x}`, then `break` skips the draw and exits the loop to
`(Command.skip, φ')`. Five `Command.RunStep`s. -/
theorem guessAXOuterTail_break_step (I : PCPInstance) (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store)
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0))
    (haux : φ GuessAX.Vars.aux = Sum.inl none) :
    ∃ (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      Command.Run Tid.guessAX rest
        (Command.loopSeq
          (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
            (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
                (GuessAX.auxSetBot_nonempty I))))
          (guessAXLoop I), φ)
        [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx (Val.cntAux cntY0 none), rfl⟩ ]
        cLast rest (Command.skip, φ') := by
  have hellVal : (GuessAX.Vocab I).evalV GuessAX.VExpr.cntYAuxVal φ = Val.cntAux cntY0 none := by
    have hcntYOfφ : GuessAX.cntYOf I φ = cntY0 := by simp only [GuessAX.cntYOf, hcntY0]
    have hauxOfφ : GuessAX.auxOf I φ = none := by simp only [GuessAX.auxOf, haux]
    simp only [GuessAX.Vocab, GuessAX.evalV, hcntYOfφ, hauxOfφ]; rfl
  have h1 : Command.RunStep Tid.guessAX rest
      (some ⟨EventLabel.rd Tid.guessAX Loc.ellAyx
        ((GuessAX.Vocab I).evalV GuessAX.VExpr.cntYAuxVal φ),
        rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ)
      rest
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h2 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ)
      rest
      (Command.loopSeq
        (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have haux' : (GuessAX.Vocab I).evalB GuessAX.BExpr.isBot φ = true := by
    simp [GuessAX.Vocab, GuessAX.evalB, haux]
  have h3 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq
        (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ)
      rest
      (Command.loopSeq
        (Command.seq Command.brk
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp [Command.step, haux'])
  have h4 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq
        (Command.seq Command.brk
          (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
            (GuessAX.auxSetBot_nonempty I)))
        (guessAXLoop I), φ)
      rest
      (Command.loopSeq Command.brk (guessAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h5 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq Command.brk (guessAXLoop I), φ) rest (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.guessAX) (s := rest)
    (c := (Command.loopSeq
        (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
          (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
            (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
              (GuessAX.auxSetBot_nonempty I))))
        (guessAXLoop I), φ))
  have run1 := Command.Run.labelledSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.silentSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  rw [hellVal] at run5
  exact ⟨φ, _, run5⟩

/-- The first iteration of `guessAXLoop` (drawing `v0 : Fin I.n`, so not the
last): `guessAXOuterHead_step`, the thread's first inner call
(`guessAX_innerLoop_first_step`), `K` further calls
(`guessAXInnerLoop_chain_shape`), `guessAXOuterExit_step` and
`guessAXOuterTail_continue_step`. `v1`/`v2` are the values written by the
first call and `vs` those of the `K` others (Lemma 3.4 for the nested-loop threads's
`v1`/`v2`/`inner0Rest`); `v2 = Val.cnt (cnt0 + 1)`, and the final counter is
`(cnt0 + 1) + K`. -/
theorem guessAX_outer0_step (I : PCPInstance) (K : ℕ) (v0 : Fin I.n)
    (hlen : (I.α v0).length = K + 1)
    (rest : List (GuessAX.Vals I)) (φ : (GuessAX.Vocab I).Store)
    (hfst0 : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr true)))
    (cnt0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0))
    (haux0 : φ GuessAX.Vars.aux = Sum.inl (some v0))
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0))
    (v0' : Option (Fin I.n)) :
    ∃ (v1 v2 : Val I) (vs : List (Val I × Val I × Val I)) (φ' : (GuessAX.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAX.Vocab I)) (cntF : Fin 4),
      vs.length = K ∧
      v2 = Val.cnt (cnt0 + 1) ∧
      (∃ j : Fin (GuessAX.maxLen I + 2), j.val = 1 ∧
        v1 = Val.xTag (Tid.guessAX, true) (GuessAX.jthLetter I (some v0) j)) ∧
      (∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
        e.2.2 = Val.cnt (⟨((cnt0 + 1).val + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨((cnt0 + 1).val + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 2 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some v0) j)) ∧
      φ' GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) ∧
      φ' GuessAX.Vars.aux = Sum.inl v0' ∧
      φ' GuessAX.Vars.cnt = Sum.inr (Sum.inl cntF) ∧
      cntF = (⟨((cnt0 + 1).val + K) % 4, by omega⟩ : Fin 4) ∧
      φ' GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) ∧
      Command.Run Tid.guessAX (Sum.inl v0' :: rest)
        (guessAXLoop I, φ)
        ([ ⟨EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt (cntY0 + 1)), rfl⟩
         , ⟨EventLabel.wt Tid.guessAX Loc.xA v1, rfl⟩
         , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x v2, rfl⟩ ] ++
          vs.flatMap (guessAXInnerBlockElems I) ++
          [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx (Val.cntAux (cntY0 + 1) (some v0)), rfl⟩ ])
        cLast rest (guessAXLoop I, φ') := by
  obtain ⟨φh, cLastH, hcnt_h, hfst_h, haux_h, hcntY_h, hjOf_h, hNOf_h, runH⟩ :=
    guessAXOuterHead_step I (Sum.inl v0' :: rest) φ (some v0) haux0 cntY0 hcntY0
  have hNOf_h' : (GuessAX.NOf I φh).val = (I.α v0).length := by
    rw [hNOf_h]; simp [GuessAX.extAlpha, List.length_map]
  have hNOf_hK : (GuessAX.NOf I φh).val = K + 1 := by rw [hNOf_h', hlen]
  have hfst_head : φh GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr true)) := by
    rw [hfst_h, hfst0]
  have hcnt_head : φh GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0) := by rw [hcnt_h, hcnt0]
  have hmaxpos := GuessAX.maxLen_pos I
  have hNbound_head : (GuessAX.NOf I φh).val ≤ GuessAX.maxLen I := by
    rw [hNOf_hK]
    have hextle := GuessAX.extAlpha_length_le I (some v0)
    simp only [GuessAX.extAlpha, List.length_map] at hextle
    omega
  have hguard_first : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φh = true := by
    simp only [GuessAX.Vocab, GuessAX.evalB, decide_eq_true_eq, Fin.le_def]
    omega
  obtain ⟨φ1, cLast1, hfst1, hcnt1, hj1, haux1, hcntY1, hN1, hrun1⟩ :=
    guessAX_innerLoop_first_step I (Sum.inl v0' :: rest) φh hguard_first hfst_head cnt0 hcnt_head
  have hjOf1eq : GuessAX.jOf I φ1 = GuessAX.jOf I φh + 1 := by
    simp only [GuessAX.jOf, hj1, GuessAX.eval]
  have hjOf1val : (GuessAX.jOf I φ1).val = (GuessAX.jOf I φh).val + 1 := by
    rw [hjOf1eq]
    simp only [Fin.add_def, Fin.val_one]
    exact Nat.mod_eq_of_lt (by omega)
  have hNOf1 : GuessAX.NOf I φ1 = GuessAX.NOf I φh := by simp only [GuessAX.NOf, hN1]
  have hNbound1 : (GuessAX.NOf I φ1).val ≤ GuessAX.maxLen I := by rw [hNOf1]; exact hNbound_head
  have hK1 : (GuessAX.jOf I φ1).val + K = (GuessAX.NOf I φ1).val + 1 := by
    rw [hNOf1]; omega
  obtain ⟨vs, φ2, cLast2, cntF, hlen2, hfst2, hcnt2, hcntFeq2, haux2, hcntY2, hN2, hj2, hval2,
    hvalxA2, hrun2⟩ :=
    guessAXInnerLoop_chain_shape I K (Sum.inl v0' :: rest) φ1 hfst1 (cnt0 + 1) hcnt1
      hNbound1 hK1
  obtain ⟨cLastComb, hcombInner⟩ := Command.Run.append hrun1 hrun2
  have liftedInner := Command.Run.loopCongr (guessAXLoop I)
    (Command.Run.seqCongr (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I)))) hcombInner)
  obtain ⟨cLastHI, runHI⟩ := Command.Run.append runH liftedInner
  have hNOf2 : GuessAX.NOf I φ2 = GuessAX.NOf I φ1 := by simp only [GuessAX.NOf, hN2]
  have hguardFalse2 : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ2 = false := by
    simp only [GuessAX.Vocab, GuessAX.evalB, decide_eq_false_iff_not, Fin.le_def]
    omega
  obtain ⟨cLastE, runE⟩ := guessAXOuterExit_step I (Sum.inl v0' :: rest) φ2
    (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I))))
    hguardFalse2
  have liftedExit := Command.Run.loopCongr (guessAXLoop I) runE
  obtain ⟨cLastHIE, runHIE⟩ := Command.Run.append runHI liftedExit
  have haux_φ2 : φ2 GuessAX.Vars.aux = Sum.inl (some v0) := by
    rw [haux2, haux1, haux_h, haux0]
  have hcntY_φ2 : φ2 GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) := by
    rw [hcntY2, hcntY1, hcntY_h]
  obtain ⟨φ', cLastT, haux', hcnt', hfst', hcntY', runT⟩ :=
    guessAXOuterTail_continue_step I v0 v0' rest φ2 (cntY0 + 1) hcntY_φ2 haux_φ2
  obtain ⟨cLastFinal, runFinal⟩ := Command.Run.append runHIE runT
  have hauxOfh : GuessAX.auxOf I φh = some v0 := by
    simp only [GuessAX.auxOf, haux_h, haux0]
  have hauxOf1 : GuessAX.auxOf I φ1 = some v0 := by
    simp only [GuessAX.auxOf, haux1, haux_h, haux0]
  refine ⟨Val.xTag (Tid.guessAX, true)
      (GuessAX.jthLetter I (GuessAX.auxOf I φh) (GuessAX.jOf I φh)),
    Val.cnt (cnt0 + 1), vs, φ', cLastFinal, cntF, hlen2, rfl, ⟨GuessAX.jOf I φh, hjOf_h, ?_⟩,
    hval2, ?_, ?_, haux', ?_, hcntFeq2, ?_, ?_⟩
  · rw [hauxOfh]
  · intro n hn
    have hn' : n < K := by rw [← hlen2]; exact hn
    obtain ⟨e, j, he, hjval, he1⟩ := hvalxA2 n hn'
    refine ⟨e, j, he, ?_, ?_⟩
    · rw [hjval, hjOf1val, hjOf_h]; omega
    · rw [he1, hauxOf1]
  · rw [hfst', hfst2]
  · rw [hcnt', hcnt2]
  · rw [hcntY', hcntY_φ2]
  · have hrunFinal := runFinal
    simp only [List.append_assoc, List.append_nil] at hrunFinal
    exact hrunFinal

/-- A continuing iteration of `guessAXLoop` after the first (`fst = false`,
`aux = some w`): all its `K + 1` inner calls are `guessAXInnerLoop_chain_shape`.
The final counter is `cnt0 + (K + 1)`. -/
theorem guessAX_outerRest_continue_step (I : PCPInstance) (K : ℕ) (w : Fin I.n)
    (hlen : (I.α w).length = K + 1)
    (rest : List (GuessAX.Vals I)) (φ : (GuessAX.Vocab I).Store)
    (hfst : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (cnt0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0))
    (haux : φ GuessAX.Vars.aux = Sum.inl (some w))
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0))
    (v0' : Option (Fin I.n)) :
    ∃ (vs : List (Val I × Val I × Val I)) (φ' : (GuessAX.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAX.Vocab I)) (cntF : Fin 4),
      vs.length = K + 1 ∧
      φ' GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) ∧
      φ' GuessAX.Vars.aux = Sum.inl v0' ∧
      φ' GuessAX.Vars.cnt = Sum.inr (Sum.inl cntF) ∧
      cntF = (⟨(cnt0.val + (K + 1)) % 4, by omega⟩ : Fin 4) ∧
      φ' GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) ∧
      (∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
        e.2.2 = Val.cnt (⟨(cnt0.val + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨(cnt0.val + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w) j)) ∧
      Command.Run Tid.guessAX (Sum.inl v0' :: rest)
        (guessAXLoop I, φ)
        ([ ⟨EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt (cntY0 + 1)), rfl⟩ ] ++
          vs.flatMap (guessAXInnerBlockElems I) ++
          [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx (Val.cntAux (cntY0 + 1) (some w)), rfl⟩ ])
        cLast rest (guessAXLoop I, φ') := by
  obtain ⟨φh, cLastH, hcnt_h, hfst_h, haux_h, hcntY_h, hjOf_h, hNOf_h, runH⟩ :=
    guessAXOuterHead_step I (Sum.inl v0' :: rest) φ (some w) haux cntY0 hcntY0
  have hNOf_h' : (GuessAX.NOf I φh).val = (I.α w).length := by
    rw [hNOf_h]; simp [GuessAX.extAlpha, List.length_map]
  have hNOf_hK : (GuessAX.NOf I φh).val = K + 1 := by rw [hNOf_h', hlen]
  have hfst_head : φh GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) := by
    rw [hfst_h, hfst]
  have hcnt_head : φh GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0) := by rw [hcnt_h, hcnt0]
  have hmaxpos := GuessAX.maxLen_pos I
  have hNbound_head : (GuessAX.NOf I φh).val ≤ GuessAX.maxLen I := by
    rw [hNOf_hK]
    have hextle := GuessAX.extAlpha_length_le I (some w)
    simp only [GuessAX.extAlpha, List.length_map] at hextle
    omega
  have hK_head : (GuessAX.jOf I φh).val + (K + 1) = (GuessAX.NOf I φh).val + 1 := by
    rw [hjOf_h, hNOf_hK]; omega
  obtain ⟨vs, φ2, cLast2, cntF, hlen2, hfst2, hcnt2, hcntFeq2, haux2, hcntY2, hN2, hj2, hval2,
    hvalxA2, hrun2⟩ :=
    guessAXInnerLoop_chain_shape I (K + 1) (Sum.inl v0' :: rest) φh hfst_head cnt0 hcnt_head
      hNbound_head hK_head
  have liftedInner := Command.Run.loopCongr (guessAXLoop I)
    (Command.Run.seqCongr (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I)))) hrun2)
  obtain ⟨cLastHI, runHI⟩ := Command.Run.append runH liftedInner
  have hNOf2 : GuessAX.NOf I φ2 = GuessAX.NOf I φh := by simp only [GuessAX.NOf, hN2]
  have hNOf2val : (GuessAX.NOf I φ2).val = (GuessAX.NOf I φh).val := by rw [hNOf2]
  have hguardFalse2 : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ2 = false := by
    simp only [GuessAX.Vocab, GuessAX.evalB, decide_eq_false_iff_not, Fin.le_def]
    omega
  obtain ⟨cLastE, runE⟩ := guessAXOuterExit_step I (Sum.inl v0' :: rest) φ2
    (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I))))
    hguardFalse2
  have liftedExit := Command.Run.loopCongr (guessAXLoop I) runE
  obtain ⟨cLastHIE, runHIE⟩ := Command.Run.append runHI liftedExit
  have haux_φ2 : φ2 GuessAX.Vars.aux = Sum.inl (some w) := by rw [haux2, haux_h, haux]
  have hcntY_φ2 : φ2 GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) := by
    rw [hcntY2, hcntY_h]
  obtain ⟨φ', cLastT, haux', hcnt', hfst', hcntY', runT⟩ :=
    guessAXOuterTail_continue_step I w v0' rest φ2 (cntY0 + 1) hcntY_φ2 haux_φ2
  obtain ⟨cLastFinal, runFinal⟩ := Command.Run.append runHIE runT
  have hauxOfh : GuessAX.auxOf I φh = some w := by
    simp only [GuessAX.auxOf, haux_h, haux]
  refine ⟨vs, φ', cLastFinal, cntF, hlen2, ?_, haux', ?_, hcntFeq2, ?_, hval2, ?_, ?_⟩
  · rw [hfst', hfst2]
  · rw [hcnt', hcnt2]
  · rw [hcntY', hcntY_φ2]
  · intro n hn
    have hn' : n < K + 1 := by rw [← hlen2]; exact hn
    obtain ⟨e, j, he, hjval, he1⟩ := hvalxA2 n hn'
    refine ⟨e, j, he, ?_, ?_⟩
    · rw [hjval, hjOf_h]; omega
    · rw [he1, hauxOfh]
  · have hrunFinal := runFinal
    simp only [List.append_assoc, List.append_nil] at hrunFinal
    exact hrunFinal

/-- The terminating iteration of `guessAXLoop` (`aux = ⊥`): one inner call
(`extAlpha I none = [none]`), then `guessAXOuterTail_break_step`; the
resolution is untouched. -/
theorem guessAX_outerRest_break_step (I : PCPInstance)
    (rest : List (GuessAX.Vals I)) (φ : (GuessAX.Vocab I).Store)
    (hfst : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (cnt0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0))
    (haux : φ GuessAX.Vars.aux = Sum.inl none)
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0)) :
    ∃ (vs : List (Val I × Val I × Val I)) (φ' : (GuessAX.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      vs.length = 1 ∧
      (∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
        e.2.2 = Val.cnt (⟨(cnt0.val + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨(cnt0.val + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I none j)) ∧
      Command.Run Tid.guessAX rest
        (guessAXLoop I, φ)
        ([ ⟨EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt (cntY0 + 1)), rfl⟩ ] ++
          vs.flatMap (guessAXInnerBlockElems I) ++
          [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx (Val.cntAux (cntY0 + 1) none), rfl⟩ ])
        cLast rest (Command.skip, φ') := by
  obtain ⟨φh, cLastH, hcnt_h, hfst_h, haux_h, hcntY_h, hjOf_h, hNOf_h, runH⟩ :=
    guessAXOuterHead_step I rest φ none haux cntY0 hcntY0
  have hNOf_hK : (GuessAX.NOf I φh).val = 1 := by
    rw [hNOf_h]; simp [GuessAX.extAlpha]
  have hfst_head : φh GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) := by
    rw [hfst_h, hfst]
  have hcnt_head : φh GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0) := by rw [hcnt_h, hcnt0]
  have hmaxpos := GuessAX.maxLen_pos I
  have hNbound_head : (GuessAX.NOf I φh).val ≤ GuessAX.maxLen I := by rw [hNOf_hK]; omega
  have hK_head : (GuessAX.jOf I φh).val + 1 = (GuessAX.NOf I φh).val + 1 := by
    rw [hjOf_h, hNOf_hK]
  obtain ⟨vs, φ2, cLast2, cntF, hlen2, hfst2, hcnt2, hcntFeq2, haux2, hcntY2, hN2, hj2, hval2,
    hvalxA2, hrun2⟩ :=
    guessAXInnerLoop_chain_shape I 1 rest φh hfst_head cnt0 hcnt_head hNbound_head hK_head
  have liftedInner := Command.Run.loopCongr (guessAXLoop I)
    (Command.Run.seqCongr (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I)))) hrun2)
  obtain ⟨cLastHI, runHI⟩ := Command.Run.append runH liftedInner
  have hNOf2 : GuessAX.NOf I φ2 = GuessAX.NOf I φh := by simp only [GuessAX.NOf, hN2]
  have hNOf2val : (GuessAX.NOf I φ2).val = (GuessAX.NOf I φh).val := by rw [hNOf2]
  have hguardFalse2 : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ2 = false := by
    simp only [GuessAX.Vocab, GuessAX.evalB, decide_eq_false_iff_not, Fin.le_def]
    omega
  obtain ⟨cLastE, runE⟩ := guessAXOuterExit_step I rest φ2
    (Command.seq (Command.read Loc.ellAyx GuessAX.VExpr.cntYAuxVal)
      (Command.seq (Command.ite GuessAX.BExpr.isBot Command.brk Command.skip)
        (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSetBot I)
          (GuessAX.auxSetBot_nonempty I))))
    hguardFalse2
  have liftedExit := Command.Run.loopCongr (guessAXLoop I) runE
  obtain ⟨cLastHIE, runHIE⟩ := Command.Run.append runHI liftedExit
  have haux_φ2 : φ2 GuessAX.Vars.aux = Sum.inl none := by rw [haux2, haux_h, haux]
  have hcntY_φ2 : φ2 GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) := by
    rw [hcntY2, hcntY_h]
  obtain ⟨φ', cLastT, runT⟩ :=
    guessAXOuterTail_break_step I rest φ2 (cntY0 + 1) hcntY_φ2 haux_φ2
  obtain ⟨cLastFinal, runFinal⟩ := Command.Run.append runHIE runT
  have hauxOfh : GuessAX.auxOf I φh = none := by
    simp only [GuessAX.auxOf, haux_h, haux]
  refine ⟨vs, φ', cLastFinal, hlen2, hval2, ?_, ?_⟩
  · intro n hn
    have hn' : n < 1 := by rw [← hlen2]; exact hn
    obtain ⟨e, j, he, hjval, he1⟩ := hvalxA2 n hn'
    refine ⟨e, j, he, ?_, ?_⟩
    · rw [hjval, hjOf_h]; omega
    · rw [he1, hauxOfh]
  · have hrunFinal := runFinal
    simp only [List.append_assoc, List.append_nil] at hrunFinal
    exact hrunFinal

/-- `GuessAX`'s events in one outer iteration: the bridge pair `b`
(`z_α^{x,y}`'s write, `ℓ_α^{y,x}`'s read) around the inner calls `vs`. -/
def guessAXOuterBlockElems (I : PCPInstance) (b : Val I × Val I)
    (vs : List (Val I × Val I × Val I)) : List (ThreadLabel (domainOf I) Tid.guessAX) :=
  ⟨EventLabel.wt Tid.guessAX Loc.zAxy b.1, rfl⟩ ::
    (vs.flatMap (guessAXInnerBlockElems I) ++ [⟨EventLabel.rd Tid.guessAX Loc.ellAyx b.2, rfl⟩])

/-- The `ks` of a sequence of tile indices `js`: `ks[m] = (I.α (js[m])).length - 1`,
so that `ks[m] + 1 = |α_{js[m]}|` (tiles are non-empty, `I.hα`). -/
def guessAXJsToKs (I : PCPInstance) (js : List (Fin I.n)) : List ℕ :=
  js.map (fun idx => (I.α idx).length - 1)

/-- The total number of inner calls for tiles `js`, `Σ (ks[m] + 1)`, is the
length of `(js.map I.α).flatten`. By induction on `js`. -/
theorem guessAXJsToKs_succ_sum_eq_flatten_length (I : PCPInstance) :
    ∀ js : List (Fin I.n), ((guessAXJsToKs I js).map (· + 1)).sum = (js.map I.α).flatten.length
  | [] => rfl
  | j0 :: js' => by
      have hne : I.α j0 ≠ [] := I.hα j0
      have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil hne
      have hcons : guessAXJsToKs I (j0 :: js') = ((I.α j0).length - 1) :: guessAXJsToKs I js' :=
        rfl
      have ih := guessAXJsToKs_succ_sum_eq_flatten_length I js'
      rw [hcons]
      simp only [List.map_cons, List.sum_cons, List.flatten_cons, List.length_append]
      omega

/-- The outer iterations of `guessAXLoop` after the first, from a state with
`fst = false`, `aux = some w0`: `js.length + 1` continuing iterations (the
`m`-th drawing `js[m]`) and one terminating one, so
`outerRest.length = js.length + 2`. Entry `m` has
`(K0 :: guessAXJsToKs I js)[m] + 1` inner calls, the last has `1`; the values
of entry `m` are given relative to `cnt0` and
`ksPrefix (K0 :: guessAXJsToKs I js) m`, and its bridge pair is
`b.1 = Val.cnt (cntY0 + 1 + m)`, with `b.2` carrying `w0`/`js[m]` (`none` at
the end). Stated with `outerRest[m]?`, since `m` is rewritten in the proof.
By induction on `js`. -/
theorem guessAXChain_shape (I : PCPInstance) (js : List (Fin I.n)) (K0 : ℕ) (w0 : Fin I.n)
    (hlen0 : (I.α w0).length = K0 + 1)
    (φ : (GuessAX.Vocab I).Store)
    (hfst : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (cnt0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0))
    (haux0 : φ GuessAX.Vars.aux = Sum.inl (some w0))
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0)) :
    ∃ (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
      (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      outerRest.length = js.length + 2 ∧
      (∀ m, m < js.length + 1 → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
        (K0 :: guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1) ∧
      (∃ b vs, outerRest[js.length + 1]? = some (b, vs) ∧ vs.length = 1) ∧
      (∀ m, m < js.length + 2 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        ∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
          e.2.2 = Val.cnt (⟨(cnt0.val + ksPrefix (K0 :: guessAXJsToKs I js) m + n) % 4,
            by omega⟩ : Fin 4) ∧
          e.2.1 = Val.cnt (⟨(cnt0.val + ksPrefix (K0 :: guessAXJsToKs I js) m + n + 1) % 4,
            by omega⟩ : Fin 4)) ∧
      (∀ m, m < js.length + 2 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        b.1 = Val.cnt (⟨(cntY0.val + 1 + m) % 4, by omega⟩ : Fin 4) ∧
        (m = 0 → b.2 = Val.cntAux (⟨(cntY0.val + 1 + m) % 4, by omega⟩ : Fin 4) (some w0)) ∧
        (1 ≤ m → m ≤ js.length → ∃ w, js[m - 1]? = some w ∧
          b.2 = Val.cntAux (⟨(cntY0.val + 1 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
        (m = js.length + 1 → b.2 = Val.cntAux (⟨(cntY0.val + 1 + m) % 4, by omega⟩ : Fin 4) none)) ∧
      (∀ m, m < js.length + 2 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        (m = 0 → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w0) j)) ∧
        (1 ≤ m → m ≤ js.length → ∃ w, js[m - 1]? = some w ∧
          ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
            e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w) j)) ∧
        (m = js.length + 1 → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I none j))) ∧
      Command.Run Tid.guessAX
        (js.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none])
        (guessAXLoop I, φ)
        (outerRest.flatMap (fun p => guessAXOuterBlockElems I p.1 p.2))
        cLast [] (Command.skip, φ') := by
  induction js generalizing φ cnt0 cntY0 K0 w0 with
  | nil =>
      obtain ⟨vs1, φ1, cLast1, cntF1, hlen1, hfst1, haux1, hcnt1, hcntFeq1, hcntY1, hval1,
        hvalxA1, hrun1⟩ :=
        guessAX_outerRest_continue_step I K0 w0 hlen0 [] φ hfst cnt0 hcnt0 haux0 cntY0 hcntY0
          none
      obtain ⟨vs2, φ2, cLast2, hlen2, hval2, hvalxA2, hrun2⟩ :=
        guessAX_outerRest_break_step I [] φ1 hfst1 cntF1 hcnt1 haux1 (cntY0 + 1) hcntY1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[((Val.cnt (cntY0 + 1), Val.cntAux (cntY0 + 1) (some w0)), vs1),
          ((Val.cnt (cntY0 + 1 + 1), Val.cntAux (cntY0 + 1 + 1) none), vs2)],
        φ2, cLast, rfl, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro m hm
        simp only [List.length_nil] at hm
        have hm0 : m = 0 := by omega
        subst hm0
        exact ⟨_, vs1, K0, rfl, rfl, hlen1⟩
      · exact ⟨_, vs2, rfl, hlen2⟩
      · have hcntFeq1' : cntF1.val = (cnt0.val + (K0 + 1)) % 4 := by rw [hcntFeq1]
        have hks0 : ksPrefix (K0 :: guessAXJsToKs I ([] : List (Fin I.n))) 0 = 0 := rfl
        have hks1 : ksPrefix (K0 :: guessAXJsToKs I ([] : List (Fin I.n))) 1 = K0 + 1 := by
          rw [show (1 : ℕ) = 0 + 1 from rfl, ksPrefix_cons]
          simp [ksPrefix]
        intro m hm
        have hm2 : m = 0 ∨ m = 1 := by simp at hm; omega
        rcases hm2 with rfl | rfl
        · refine ⟨_, vs1, rfl, ?_⟩
          intro n hn
          obtain ⟨e, he, he22, he21⟩ := hval1 n hn
          refine ⟨e, he, ?_, ?_⟩
          · rw [he22]; simp only [Val.cnt.injEq, Fin.ext_iff]; omega
          · rw [he21]; simp only [Val.cnt.injEq, Fin.ext_iff]; omega
        · refine ⟨_, vs2, rfl, ?_⟩
          intro n hn
          obtain ⟨e, he, he22, he21⟩ := hval2 n hn
          refine ⟨e, he, ?_, ?_⟩
          · rw [he22]; simp only [Val.cnt.injEq, Fin.ext_iff]; omega
          · rw [he21]; simp only [Val.cnt.injEq, Fin.ext_iff]; omega
      · intro m hm
        simp only [List.length_nil] at hm
        have hm2 : m = 0 ∨ m = 1 := by omega
        rcases hm2 with rfl | rfl
        · refine ⟨_, vs1, rfl, ?_, ?_, ?_, ?_⟩
          · rfl
          · intro _; rfl
          · omega
          · omega
        · refine ⟨_, vs2, rfl, ?_, ?_, ?_, ?_⟩
          · dsimp only; first | rfl | (congr 1; apply Fin.ext; simp [Fin.add_def])
          · omega
          · intro _ hmle; simp only [List.length_nil] at hmle; omega
          · intro _; dsimp only; first | rfl | (congr 1; apply Fin.ext; simp [Fin.add_def])
      · intro m hm
        simp only [List.length_nil] at hm
        have hm2 : m = 0 ∨ m = 1 := by omega
        rcases hm2 with rfl | rfl
        · exact ⟨_, vs1, rfl, fun _ => hvalxA1, by omega, by omega⟩
        · refine ⟨_, vs2, rfl, ?_, ?_, ?_⟩
          · omega
          · intro _ hmle; simp only [List.length_nil] at hmle; omega
          · intro _; exact hvalxA2
      · simp only [List.map_nil, Fin.isValue, List.flatMap_cons,
          List.flatMap_nil, List.append_nil] at hcomb ⊢
        exact hcomb
  | cons j0 js' ih =>
      have hne : I.α j0 ≠ [] := I.hα j0
      have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil hne
      have hlen0' : (I.α j0).length = (I.α j0).length - 1 + 1 := by omega
      obtain ⟨vs1, φ1, cLast1, cntF1, hlen1, hfst1, haux1, hcnt1, hcntFeq1, hcntY1, hval1,
        hvalxA1, hrun1⟩ :=
        guessAX_outerRest_continue_step I K0 w0 hlen0
          (js'.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none])
          φ hfst cnt0 hcnt0 haux0 cntY0 hcntY0 (some j0)
      obtain ⟨outerRest, φ', cLast2, hlen2, houterIH, houterLastIH, hvalIH, hbIH, hbxAIH, hrun2⟩ :=
        ih (φ := φ1) (cnt0 := cntF1) (cntY0 := cntY0 + 1) (K0 := (I.α j0).length - 1) (w0 := j0)
          hlen0' hfst1 hcnt1 haux1 hcntY1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      have hcntFeq1' : cntF1.val = (cnt0.val + (K0 + 1)) % 4 := by rw [hcntFeq1]
      refine ⟨((Val.cnt (cntY0 + 1), Val.cntAux (cntY0 + 1) (some w0)), vs1) :: outerRest,
        φ', cLast, by simp [hlen2], ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro m hm
        cases m with
        | zero => exact ⟨_, vs1, K0, rfl, rfl, hlen1⟩
        | succ m =>
            simp only [List.length_cons] at hm
            have hm' : m < js'.length + 1 := by omega
            obtain ⟨b, vs, km, hbv, hksm, hlenvs⟩ := houterIH m hm'
            refine ⟨b, vs, km, by simpa using hbv, ?_, hlenvs⟩
            change (guessAXJsToKs I (j0 :: js'))[m]? = some km
            rw [show guessAXJsToKs I (j0 :: js')
                = ((I.α j0).length - 1) :: guessAXJsToKs I js' from rfl]
            exact hksm
      · obtain ⟨b, vs, hbv, hlenvs⟩ := houterLastIH
        exact ⟨b, vs, by simpa using hbv, hlenvs⟩
      · intro m hm
        cases m with
        | zero =>
          refine ⟨_, vs1, rfl, ?_⟩
          intro n hn
          obtain ⟨e, he, he22, he21⟩ := hval1 n hn
          refine ⟨e, he, ?_, ?_⟩
          · rw [he22]; congr 1
          · rw [he21]; congr 1
        | succ m =>
          simp only [List.length_cons] at hm
          have hm' : m < js'.length + 2 := by omega
          obtain ⟨b, vs, hbv, hval'⟩ := hvalIH m hm'
          refine ⟨b, vs, by simpa using hbv, ?_⟩
          intro n hn
          obtain ⟨e, he, he22, he21⟩ := hval' n hn
          have hks : ksPrefix (K0 :: guessAXJsToKs I (j0 :: js')) (m + 1)
              = (K0 + 1) + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m := by
            rw [show guessAXJsToKs I (j0 :: js')
                = ((I.α j0).length - 1) :: guessAXJsToKs I js' from rfl]
            exact ksPrefix_cons K0 (((I.α j0).length - 1) :: guessAXJsToKs I js') m
          refine ⟨e, he, ?_, ?_⟩
          · rw [he22]
            congr 1
            apply Fin.ext
            show (cntF1.val + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n) % 4 =
              (cnt0.val + ksPrefix (K0 :: guessAXJsToKs I (j0 :: js')) (m + 1) + n) % 4
            rw [hks]
            omega
          · rw [he21]
            congr 1
            apply Fin.ext
            show (cntF1.val + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n + 1)
                % 4 =
              (cnt0.val + ksPrefix (K0 :: guessAXJsToKs I (j0 :: js')) (m + 1) + n + 1) % 4
            rw [hks]
            omega
      · intro m hm
        cases m with
        | zero =>
          refine ⟨_, vs1, rfl, ?_, ?_, ?_, ?_⟩
          · rfl
          · intro _; rfl
          · intro h; omega
          · intro heq; simp only [List.length_cons] at heq; omega
        | succ m =>
          simp only [List.length_cons] at hm
          have hm' : m < js'.length + 2 := by omega
          obtain ⟨b, vs, hbv, hb1, hb2z, hb2m, hb2last⟩ := hbIH m hm'
          refine ⟨b, vs, by simpa using hbv, ?_, ?_, ?_, ?_⟩
          · rw [hb1]; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
          · intro h; omega
          · intro _ hmle
            have hmle' : m + 1 ≤ js'.length + 1 := by simpa [List.length_cons] using hmle
            rcases Nat.eq_zero_or_pos m with hm0 | hmpos
            · subst hm0
              have hb2z' := hb2z rfl
              refine ⟨j0, rfl, ?_⟩
              rw [hb2z']; congr 1; apply Fin.ext; simp [Fin.add_def]
            · have hm'le : m ≤ js'.length := by omega
              obtain ⟨w, hw, hb2⟩ := hb2m (by omega) hm'le
              refine ⟨w, ?_, ?_⟩
              · show (j0 :: js')[m]? = some w
                rw [show m = (m - 1) + 1 from by omega, List.getElem?_cons_succ]
                exact hw
              · rw [hb2]; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
          · intro heq
            simp only [List.length_cons] at heq
            have hm'eq : m = js'.length + 1 := by omega
            have hlast := hb2last hm'eq
            rw [hlast]; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
      · intro m hm
        cases m with
        | zero => exact ⟨_, vs1, rfl, fun _ => hvalxA1, by omega, by omega⟩
        | succ m =>
          simp only [List.length_cons] at hm
          have hm' : m < js'.length + 2 := by omega
          obtain ⟨b, vs, hbv, hbxA0, hbxAm, hbxAlast⟩ := hbxAIH m hm'
          refine ⟨b, vs, by simpa using hbv, ?_, ?_, ?_⟩
          · intro h; omega
          · intro _ hmle
            have hmle' : m + 1 ≤ js'.length + 1 := by simpa [List.length_cons] using hmle
            rcases Nat.eq_zero_or_pos m with hm0 | hmpos
            · subst hm0
              refine ⟨j0, rfl, ?_⟩
              exact hbxA0 rfl
            · have hm'le : m ≤ js'.length := by omega
              obtain ⟨w, hw, hbxA⟩ := hbxAm (by omega) hm'le
              refine ⟨w, ?_, hbxA⟩
              show (j0 :: js')[m]? = some w
              rw [show m = (m - 1) + 1 from by omega, List.getElem?_cons_succ]
              exact hw
          · intro heq
            simp only [List.length_cons] at heq
            have hm'eq : m = js'.length + 1 := by omega
            exact hbxAlast hm'eq
      · simp only [List.map_cons, List.cons_append, Fin.isValue, List.flatMap_cons] at hcomb ⊢
        exact hcomb

/-- The word of `guessAXLoop`, from its five pieces. -/
def guessAXBlockWord (I : PCPInstance) (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I))) :
    Word (ThreadLabel (domainOf I) Tid.guessAX) :=
  ([ ⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩
   , ⟨EventLabel.wt Tid.guessAX Loc.xA v1, rfl⟩
   , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x v2, rfl⟩ ] ++
    inner0Rest.flatMap (guessAXInnerBlockElems I) ++
    [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ ]) ++
  outerRest.flatMap (fun p => guessAXOuterBlockElems I p.1 p.2)

/-- The word of `guessAXLoop`: `v1`/`v2` (the thread's first inner call),
`vB0` (the bridge pair of outer iteration `0`), `inner0Rest` (the `K0` other
inner calls of iteration `0`), and `outerRest` (the `N + 1` later outer
iterations). From `guessAX_outer0_step` and `guessAXChain_shape` (or, for
`N = 0`, `guessAX_outerRest_break_step`). With the number of inner calls of
each entry, the values of `v2`, `inner0Rest` and `outerRest` (relative to
`cnt0 + 1`, `cnt0 + 1 + K0` and `ksPrefix (guessAXJsToKs I js)`), and the
bridge pairs (`vB0 = (Val.cnt (cntY0 + 1), Val.cntAux (cntY0 + 1) (some v0))`,
`b.1 = Val.cnt (cntY0 + 2 + m)`). The values written to `xA` are left
existential here. -/
theorem guessAX_shape (I : PCPInstance) (js : List (Fin I.n)) (φ : (GuessAX.Vocab I).Store)
    (hfst0 : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr true)))
    (cnt0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl cnt0))
    (v0 : Fin I.n) (K0 : ℕ) (hlen0 : (I.α v0).length = K0 + 1)
    (haux0 : φ GuessAX.Vars.aux = Sum.inl (some v0))
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0)) :
    ∃ (v1 v2 : Val I) (vB0 : Val I × Val I) (inner0Rest : List (Val I × Val I × Val I))
      (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
      (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      inner0Rest.length = K0 ∧
      outerRest.length = js.length + 1 ∧
      (∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
        (guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1) ∧
      (∃ b vs, outerRest[js.length]? = some (b, vs) ∧ vs.length = 1) ∧
      v2 = Val.cnt (cnt0 + 1) ∧
      (∀ n, n < inner0Rest.length → ∃ e, inner0Rest[n]? = some e ∧
        e.2.2 = Val.cnt (⟨((cnt0 + 1).val + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨((cnt0 + 1).val + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        ∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
          e.2.2 = Val.cnt (⟨((cnt0 + 1).val + K0 + ksPrefix (guessAXJsToKs I js) m + n) % 4,
            by omega⟩ : Fin 4) ∧
          e.2.1 = Val.cnt (⟨((cnt0 + 1).val + K0 + ksPrefix (guessAXJsToKs I js) m + n + 1) % 4,
            by omega⟩ : Fin 4)) ∧
      vB0.1 = Val.cnt (cntY0 + 1) ∧
      vB0.2 = Val.cntAux (cntY0 + 1) (some v0) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        b.1 = Val.cnt (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) ∧
        (m < js.length → ∃ w, js[m]? = some w ∧
          b.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
        (m = js.length → b.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) none)) ∧
      (∃ j : Fin (GuessAX.maxLen I + 2), j.val = 1 ∧
        v1 = Val.xTag (Tid.guessAX, true) (GuessAX.jthLetter I (some v0) j)) ∧
      (∀ n, n < inner0Rest.length → ∃ e j, inner0Rest[n]? = some e ∧ j.val = n + 2 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some v0) j)) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        (m < js.length → ∃ w, js[m]? = some w ∧
          ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
            e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w) j)) ∧
        (m = js.length → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I none j))) ∧
      Command.Run Tid.guessAX
        (js.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none])
        (guessAXLoop I, φ)
        (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
        cLast [] (Command.skip, φ') := by
  match js with
  | [] =>
      obtain ⟨v1, v2, inner0Rest, φ1, cLast1, cntF1, hlen1, hveq1, hv1eq, hval1, hvalxA1, hfst1,
        haux1, hcnt1, hcntFeq1, hcntY1, hrun1⟩ :=
        guessAX_outer0_step I K0 v0 hlen0 [] φ hfst0 cnt0 hcnt0 haux0 cntY0 hcntY0 none
      obtain ⟨vs2, φ2, cLast2, hlen2, hval2, hvalxA2, hrun2⟩ :=
        guessAX_outerRest_break_step I [] φ1 hfst1 cntF1 hcnt1 haux1 (cntY0 + 1) hcntY1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      have hcntF1' : cntF1.val = ((cnt0 + 1).val + K0) % 4 := by rw [hcntFeq1]
      have hcnt01' : (cnt0 + 1).val = (cnt0.val + 1) % 4 := by simp [Fin.add_def]
      refine ⟨v1, v2, (Val.cnt (cntY0 + 1), Val.cntAux (cntY0 + 1) (some v0)), inner0Rest,
        [((Val.cnt (cntY0 + 1 + 1), Val.cntAux (cntY0 + 1 + 1) none), vs2)], φ2, cLast, hlen1,
        rfl, ?_, ?_, hveq1, hval1, ?_, rfl, rfl, ?_, hv1eq, hvalxA1, ?_, ?_⟩
      · intro m hm
        simp only [List.length_nil] at hm
        exact absurd hm (by omega)
      · exact ⟨_, vs2, rfl, hlen2⟩
      · intro m hm
        have hm0 : m = 0 := by simp only [List.length_nil] at hm; omega
        subst hm0
        refine ⟨_, vs2, rfl, ?_⟩
        intro n hn
        obtain ⟨e, he, he22, he21⟩ := hval2 n hn
        have hks0 : ksPrefix (guessAXJsToKs I ([] : List (Fin I.n))) 0 = 0 := rfl
        refine ⟨e, he, ?_, ?_⟩
        · rw [he22]
          congr 1
          apply Fin.ext
          show (cntF1.val + n) % 4 = ((cnt0 + 1).val + K0 + 0 + n) % 4
          omega
        · rw [he21]
          congr 1
          apply Fin.ext
          show (cntF1.val + n + 1) % 4 = ((cnt0 + 1).val + K0 + 0 + n + 1) % 4
          omega
      · intro m hm
        simp only [List.length_nil] at hm
        have hm0 : m = 0 := by omega
        subst hm0
        refine ⟨_, vs2, rfl, ?_, ?_, ?_⟩
        · dsimp only; congr 1; apply Fin.ext; simp [Fin.add_def]
        · intro h; simp only [List.length_nil] at h; omega
        · intro _; dsimp only; congr 1; apply Fin.ext; simp [Fin.add_def]
      · intro m hm
        simp only [List.length_nil] at hm
        have hm0 : m = 0 := by omega
        subst hm0
        refine ⟨_, vs2, rfl, ?_, fun _ => hvalxA2⟩
        intro h
        simp only [List.length_nil] at h
        omega
      · simp only [guessAXBlockWord, guessAXOuterBlockElems, List.map_nil, List.nil_append,
          Fin.isValue, List.flatMap_cons, List.flatMap_nil, List.append_nil,
          List.append_assoc] at hcomb ⊢
        exact hcomb
  | j0 :: js' =>
      obtain ⟨v1, v2, inner0Rest, φ1, cLast1, cntF1, hlen1, hveq1, hv1eq, hval1, hvalxA1, hfst1,
        haux1, hcnt1, hcntFeq1, hcntY1, hrun1⟩ :=
        guessAX_outer0_step I K0 v0 hlen0
          (js'.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none])
          φ hfst0 cnt0 hcnt0 haux0 cntY0 hcntY0 (some j0)
      have hne : I.α j0 ≠ [] := I.hα j0
      have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil hne
      have hlen0' : (I.α j0).length = (I.α j0).length - 1 + 1 := by omega
      obtain ⟨outerRest, φ', cLast2, hlen2, houterC, houterLastC, hvalC, hbC, hbxAC, hrun2⟩ :=
        guessAXChain_shape I js' ((I.α j0).length - 1) j0 hlen0' φ1 hfst1 cntF1 hcnt1 haux1
          (cntY0 + 1) hcntY1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      have hcntF1' : cntF1.val = ((cnt0 + 1).val + K0) % 4 := by rw [hcntFeq1]
      have hcnt01' : (cnt0 + 1).val = (cnt0.val + 1) % 4 := by simp [Fin.add_def]
      refine ⟨v1, v2, (Val.cnt (cntY0 + 1), Val.cntAux (cntY0 + 1) (some v0)), inner0Rest,
        outerRest, φ', cLast, hlen1, by simp [hlen2], ?_, ?_, hveq1, hval1, ?_, rfl, rfl, ?_,
        hv1eq, hvalxA1, ?_, ?_⟩
      · intro m hm
        exact houterC m hm
      · exact houterLastC
      · intro m hm
        obtain ⟨b, vs, hbv, hval'⟩ := hvalC m (by omega)
        refine ⟨b, vs, hbv, ?_⟩
        intro n hn
        obtain ⟨e, he, he22, he21⟩ := hval' n hn
        refine ⟨e, he, ?_, ?_⟩
        · rw [he22]
          congr 1
          apply Fin.ext
          show (cntF1.val + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n) % 4 =
            ((cnt0 + 1).val + K0 + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n)
              % 4
          omega
        · rw [he21]
          congr 1
          apply Fin.ext
          show (cntF1.val + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n + 1)
              % 4 =
            ((cnt0 + 1).val + K0 + ksPrefix (((I.α j0).length - 1) :: guessAXJsToKs I js') m + n
              + 1) % 4
          omega
      · intro m hm
        obtain ⟨b, vs, hbv, hb1, hb2z, hb2m, hb2last⟩ := hbC m (by omega)
        refine ⟨b, vs, hbv, ?_, ?_, ?_⟩
        · rw [hb1]; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
        · intro hmlt
          rcases Nat.eq_zero_or_pos m with hm0 | hmpos
          · subst hm0
            obtain hb2z' := hb2z rfl
            refine ⟨j0, rfl, ?_⟩
            rw [hb2z']; congr 1; apply Fin.ext; simp [Fin.add_def]
          · have hm'le : m ≤ js'.length := by
              simp only [List.length_cons] at hm hmlt; omega
            obtain ⟨w, hw, hb2⟩ := hb2m (by omega) hm'le
            refine ⟨w, ?_, ?_⟩
            · show (j0 :: js')[m]? = some w
              rw [show m = (m - 1) + 1 from by omega, List.getElem?_cons_succ]
              exact hw
            · rw [hb2]; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
        · intro hmeq
          simp only [List.length_cons] at hmeq
          have hb2last' := hb2last hmeq
          rw [hb2last']; congr 1; apply Fin.ext; simp [Fin.add_def]; omega
      · intro m hm
        obtain ⟨b, vs, hbv, hbxA0, hbxAm, hbxAlast⟩ := hbxAC m (by omega)
        refine ⟨b, vs, hbv, ?_, ?_⟩
        · intro hmlt
          rcases Nat.eq_zero_or_pos m with hm0 | hmpos
          · subst hm0
            exact ⟨j0, rfl, hbxA0 rfl⟩
          · have hm'le : m ≤ js'.length := by
              simp only [List.length_cons] at hm hmlt; omega
            obtain ⟨w, hw, hbxA⟩ := hbxAm (by omega) hm'le
            refine ⟨w, ?_, hbxA⟩
            show (j0 :: js')[m]? = some w
            rw [show m = (m - 1) + 1 from by omega, List.getElem?_cons_succ]
            exact hw
        · intro hmeq
          simp only [List.length_cons] at hmeq
          exact hbxAlast hmeq
      · simp only [guessAXBlockWord, List.map_cons, List.cons_append, List.append_assoc] at hcomb ⊢
        exact hcomb

/-! ## `GuessAX`'s whole run

For an arbitrary instance `I` and solution: the leading `ndetAssign` draw,
lifted through the program's leading `.seq` (`Command.Run.seqCongr`), followed
by `guessAX_shape` (`Command.Run.append`) and the final step to
`Command.term`, from the initial store of `Reduction/ConcProg.lean`. -/

/-- `GuessAX`'s program, run from its initial store, for an arbitrary instance
`I` and resolution `j0 :: js`, with `guessAX_shape`'s conjuncts. -/
theorem guessAX_general_run (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (K0 : ℕ) (hlen0 : (I.α j0).length = K0 + 1) :
    ∃ (v1 v2 : Val I) (vB0 : Val I × Val I) (inner0Rest : List (Val I × Val I × Val I))
      (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
      (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      inner0Rest.length = K0 ∧
      outerRest.length = js.length + 1 ∧
      (∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
        (guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1) ∧
      (∃ b vs, outerRest[js.length]? = some (b, vs) ∧ vs.length = 1) ∧
      v2 = Val.cnt (1 : Fin 4) ∧
      (∀ n, n < inner0Rest.length → ∃ e, inner0Rest[n]? = some e ∧
        e.2.2 = Val.cnt (⟨(1 + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨(1 + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        ∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
          e.2.2 = Val.cnt (⟨(1 + K0 + ksPrefix (guessAXJsToKs I js) m + n) % 4,
            by omega⟩ : Fin 4) ∧
          e.2.1 = Val.cnt (⟨(1 + K0 + ksPrefix (guessAXJsToKs I js) m + n + 1) % 4,
            by omega⟩ : Fin 4)) ∧
      vB0.1 = Val.cnt (1 : Fin 4) ∧
      vB0.2 = Val.cntAux (1 : Fin 4) (some j0) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        b.1 = Val.cnt (⟨(2 + m) % 4, by omega⟩ : Fin 4) ∧
        (m < js.length → ∃ w, js[m]? = some w ∧
          b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
        (m = js.length → b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) none)) ∧
      (∃ j : Fin (GuessAX.maxLen I + 2), j.val = 1 ∧
        v1 = Val.xTag (Tid.guessAX, true) (GuessAX.jthLetter I (some j0) j)) ∧
      (∀ n, n < inner0Rest.length → ∃ e j, inner0Rest[n]? = some e ∧ j.val = n + 2 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some j0) j)) ∧
      (∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
        (m < js.length → ∃ w, js[m]? = some w ∧
          ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
            e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w) j)) ∧
        (m = js.length → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I none j))) ∧
      Command.Run Tid.guessAX
        (Sum.inl (some j0) ::
          (js.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none]))
        (GuessAX.program I,
          (GuessAX.Vocab I).mkStore (fun v => match v with
            | .cntY => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .fst => some (Sum.inr (Sum.inr (Sum.inr true)))
            | _ => none) (Sum.inl none))
        (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
        cLast [] (Command.term, φ') := by
  set φ0 : (GuessAX.Vocab I).Store :=
    (GuessAX.Vocab I).mkStore (fun v => match v with
      | .cntY => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr (Sum.inr true)))
      | _ => none) (Sum.inl none) with hφ0
  have hfst0 : φ0 GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr true)) := rfl
  have hcnt0 : φ0 GuessAX.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hcntY0 : φ0 GuessAX.Vars.cntY = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hmem : (Sum.inl (some j0) : GuessAX.Vals I) ∈ GuessAX.auxSet I := by
    unfold GuessAX.auxSet
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨j0, rfl⟩
  set rest0 : List (GuessAX.Vals I) :=
    js.map (fun idx => (Sum.inl (some idx) : GuessAX.Vals I)) ++ [Sum.inl none] with hrest0
  have hstep1 : Command.RunStep Tid.guessAX (Sum.inl (some j0) :: rest0) none
      (⟨Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSet I) (GuessAX.auxSet_nonempty I),
        φ0⟩ : Config (domainOf I) (GuessAX.Vocab I))
      rest0
      ⟨Command.skip, Function.update φ0 GuessAX.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.guessAX (Sum.inl (some j0) :: rest0)
      (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSet I) (GuessAX.auxSet_nonempty I), φ0)
      [] (Command.ndetAssign GuessAX.Vars.aux (GuessAX.auxSet I) (GuessAX.auxSet_nonempty I), φ0)
      rest0 ⟨Command.skip, Function.update φ0 GuessAX.Vars.aux (Sum.inl (some j0))⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (Command.seq (guessAXLoop I) Command.term) hrun1
  set φ1 : (GuessAX.Vocab I).Store := Function.update φ0 GuessAX.Vars.aux (Sum.inl (some j0))
    with hφ1
  have hstep2 : Command.RunStep Tid.guessAX rest0 none
      (⟨Command.seq Command.skip (Command.seq (guessAXLoop I) Command.term), φ1⟩ :
        Config (domainOf I) (GuessAX.Vocab I))
      rest0 ⟨Command.seq (guessAXLoop I) Command.term, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have haux1 : φ1 GuessAX.Vars.aux = Sum.inl (some j0) := Function.update_self _ _ _
  have hne_fst_aux : GuessAX.Vars.fst ≠ GuessAX.Vars.aux := by decide
  have hne_cnt_aux : GuessAX.Vars.cnt ≠ GuessAX.Vars.aux := by decide
  have hne_cntY_aux : GuessAX.Vars.cntY ≠ GuessAX.Vars.aux := by decide
  have hfst1 : φ1 GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr true)) :=
    (Function.update_of_ne hne_fst_aux (Sum.inl (some j0)) φ0).trans hfst0
  have hcnt1 : φ1 GuessAX.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cnt_aux (Sum.inl (some j0)) φ0).trans hcnt0
  have hcntY1 : φ1 GuessAX.Vars.cntY = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cntY_aux (Sum.inl (some j0)) φ0).trans hcntY0
  obtain ⟨v1, v2, vB0, inner0Rest, outerRest, φ', cLastL, hlen1, hlen2, houterC, houterLastC,
    hv2eq, hval1, hval2, hvB01, hvB02, houterB2, hv1eq, hvalxA1, hvalxA2, hrun3⟩ :=
    guessAX_shape I js φ1 hfst1 0 hcnt1 j0 K0 hlen0 haux1 0 hcntY1
  have hrun3' := Command.Run.seqCongr Command.term hrun3
  obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun2 hrun3'
  have hstep4 : Command.RunStep Tid.guessAX ([] : List (GuessAX.Vals I)) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (GuessAX.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨v1, v2, vB0, inner0Rest, outerRest, φ', cLast, hlen1, hlen2, houterC, houterLastC,
    hv2eq, hval1, hval2, hvB01, hvB02, houterB2, hv1eq, hvalxA1, hvalxA2,
    Command.Run.silentSnoc hcomb hstep4⟩

/-! ## `rf_matches`: `guessAY`/`guessAX` `zAxy` (Eq. (15)) -/

/-- The `zAxy`-write match, as a predicate on `Loc`/`OpType` alone. -/
def zAxyWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zAxy, OpType.wt => true | _, _ => false

theorem zAxyWritePredCore_iff (y : Loc) (z : OpType) :
    zAxyWritePredCore y z = true ↔ (y = Loc.zAxy ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem zAxyWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.zAxy ∧ z = OpType.wt)) :
    zAxyWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

theorem guessAXInnerBlockShape_no_zAxy : ∀ p ∈ guessAXInnerBlockShape, p.1 ≠ Loc.zAxy := by decide

variable (I : PCPInstance)

/-- `zAxyWritePredCore`, lifted to `guessAX`'s `ThreadLabel`. -/
def guessAXZAxyWritePred (lab : ThreadLabel (domainOf I) Tid.guessAX) : Bool :=
  zAxyWritePredCore lab.1.loc lab.1.op

theorem guessAXZAxyWritePred_iff (lab : ThreadLabel (domainOf I) Tid.guessAX) :
    guessAXZAxyWritePred I lab = true ↔ (lab.1.loc = Loc.zAxy ∧ lab.1.op = OpType.wt) := by
  unfold guessAXZAxyWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact zAxyWritePredCore_iff y z

theorem guessAXInnerFlatMap_zAxy_filter (vs : List (Val I × Val I × Val I)) :
    (vs.flatMap (guessAXInnerBlockElems I)).filter (guessAXZAxyWritePred I) = [] := by
  induction vs with
  | nil => rfl
  | cons a vs ih =>
      rw [List.flatMap_cons, List.filter_append, ih, List.append_nil,
        List.filter_eq_nil_iff]
      intro x hx
      have hshape := guessAXInnerBlockElems_shape I a
      have hxshape : (x.1.loc, x.1.op) ∈ guessAXInnerBlockShape := by
        rw [← hshape]; exact List.mem_map_of_mem hx
      have hxne : x.1.loc ≠ Loc.zAxy := guessAXInnerBlockShape_no_zAxy _ hxshape
      unfold guessAXZAxyWritePred
      rw [zAxyWritePredCore_false_of_ne x.1.loc x.1.op (fun ⟨heq, _⟩ => hxne heq)]
      decide

/-- `guessAXOuterBlockElems` has one `zAxy`-write, its first entry. -/
theorem guessAXOuterBlockElems_zAxy_filter (b : Val I × Val I) (vs : List (Val I × Val I × Val I)) :
    (guessAXOuterBlockElems I b vs).filter (guessAXZAxyWritePred I) =
      [(⟨EventLabel.wt Tid.guessAX Loc.zAxy b.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)] := by
  show List.filter (guessAXZAxyWritePred I)
      ((⟨EventLabel.wt Tid.guessAX Loc.zAxy b.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX) ::
        (vs.flatMap (guessAXInnerBlockElems I) ++
          [⟨EventLabel.rd Tid.guessAX Loc.ellAyx b.2, rfl⟩]))
      = [(⟨EventLabel.wt Tid.guessAX Loc.zAxy b.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
  rw [List.filter_cons_of_pos
      (by unfold guessAXZAxyWritePred; exact (zAxyWritePredCore_iff Loc.zAxy OpType.wt).mpr ⟨rfl, rfl⟩),
    List.filter_append, guessAXInnerFlatMap_zAxy_filter, List.nil_append,
    List.filter_cons_of_neg
      (by unfold guessAXZAxyWritePred
          simpa [EventLabel.loc, EventLabel.op] using
            zAxyWritePredCore_false_of_ne Loc.ellAyx OpType.rd (by decide)),
    List.filter_nil]

/-- `guessAXBlockWord`'s `zAxy`-writes: `vB0.1`, then one per entry of
`outerRest`. -/
theorem guessAXBlockWord_zAxy_filter_eq (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I))) :
    (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter (guessAXZAxyWritePred I)
      = [(⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.wt Tid.guessAX Loc.zAxy p.1.1, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAX)) := by
  show List.filter (guessAXZAxyWritePred I)
      (([ (⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
        , ⟨EventLabel.wt Tid.guessAX Loc.xA v1, rfl⟩
        , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x v2, rfl⟩ ] ++
        inner0Rest.flatMap (guessAXInnerBlockElems I) ++
        [ ⟨EventLabel.rd Tid.guessAX Loc.ellAyx vB0.2, rfl⟩ ]) ++
        outerRest.flatMap (fun p => guessAXOuterBlockElems I p.1 p.2))
      = [(⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.wt Tid.guessAX Loc.zAxy p.1.1, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessAX))
  rw [List.filter_append, List.filter_append, List.filter_append,
    List.filter_cons_of_pos
      (by unfold guessAXZAxyWritePred; exact (zAxyWritePredCore_iff Loc.zAxy OpType.wt).mpr ⟨rfl, rfl⟩),
    List.filter_cons_of_neg
      (by unfold guessAXZAxyWritePred
          simpa [EventLabel.loc, EventLabel.op] using
            zAxyWritePredCore_false_of_ne Loc.xA OpType.wt (by decide)),
    List.filter_cons_of_neg
      (by unfold guessAXZAxyWritePred
          simpa [EventLabel.loc, EventLabel.op] using
            zAxyWritePredCore_false_of_ne Loc.zAx'x OpType.wt (by decide)),
    List.filter_nil, guessAXInnerFlatMap_zAxy_filter,
    List.filter_cons_of_neg
      (by unfold guessAXZAxyWritePred
          simpa [EventLabel.loc, EventLabel.op] using
            zAxyWritePredCore_false_of_ne Loc.ellAyx OpType.rd (by decide)),
    List.filter_nil, list_filter_flatMap_distrib]
  simp only [List.append_nil]
  congr 1
  rw [show (fun p : (Val I × Val I) × List (Val I × Val I × Val I) =>
      (guessAXOuterBlockElems I p.1 p.2).filter (guessAXZAxyWritePred I))
      = (fun p => [(⟨EventLabel.wt Tid.guessAX Loc.zAxy p.1.1, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAX)]) from by
    funext p
    exact guessAXOuterBlockElems_zAxy_filter I p.1 p.2]
  induction outerRest with
  | nil => rfl
  | cons p ps ih => rw [List.flatMap_cons, List.map_cons, ih]; rfl

theorem rawNthWrite_guessAX_zAxy_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htrace : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessAX Loc.zAxy i = some ew) :
    (i = 0 ∧ ew.val = vB0.1) ∨
    (∃ m, i = m + 1 ∧ ∃ a vs, outerRest[m]? = some (a, vs) ∧ ew.val = a.1) := by
  have hpredL := guessAXZAxyWritePred_iff I
  have hfilt := guessAXBlockWord_zAxy_filter_eq I v1 v2 vB0 inner0Rest outerRest
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessAXZAxyWritePred I) 0
      (⟨EventLabel.wt Tid.guessAX Loc.zAxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
      (by rw [hfilt]; rfl)
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAX)
      (l := guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessAX Loc.zAxy OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set m := i - 1 with hm
    have him : i = m + 1 := by omega
    obtain ⟨a, hval⟩ : ∃ a, outerRest[m]? = some a :=
      by
        have hilt : i < (rawOpEvents trace Tid.guessAX Loc.zAxy OpType.wt).length :=
          (List.getElem?_eq_some_iff.mp h).1
        have hlen_eq := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAX)
          (x := Loc.zAxy) (op := OpType.wt) (predL := guessAXZAxyWritePred I) htrace hpredL
        rw [hlen_eq, hfilt, List.length_append, List.length_singleton, List.length_map] at hilt
        exact ⟨outerRest[m]'(by omega), List.getElem?_eq_getElem (by omega)⟩
    refine ⟨m, him, a.1, a.2, hval, ?_⟩
    have hgetf :
        ((guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
          (guessAXZAxyWritePred I))[i]? =
        some (⟨EventLabel.wt Tid.guessAX Loc.zAxy a.1.1, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAX) := by
      rw [hfilt, him, List.getElem?_append_right (by simp), List.length_singleton]
      have hidxeq : m + 1 - 1 = m := by omega
      rw [hidxeq, List.getElem?_map, hval]
      rfl
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessAXZAxyWritePred I) i
      (⟨EventLabel.wt Tid.guessAX Loc.zAxy a.1.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessAX)
      hgetf
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAX)
      (l := guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessAX Loc.zAxy OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl

def zAxyReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zAxy, OpType.rd => true | _, _ => false

theorem zAxyReadPredCore_iff (y : Loc) (z : OpType) :
