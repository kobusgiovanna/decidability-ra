    (h : ∃ i, rawNthWrite trace Tid.checkY Loc.yB i = some ew ∧
      rawNthRead trace Tid.primeCheckY Loc.yB i = some er) :
    ew.val = er.val :=
  traceRf_matches_checkY_primeCheckY_yB I v0 kws htraceVY hkwsVal cnts htracePVY hcntsVal h

