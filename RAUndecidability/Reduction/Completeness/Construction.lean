        ((⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 1)
        (by rw [List.getElem?_zipIdx]; rfl)
        (by unfold guessAYEllAWritePred
            exact (ellAyxWritePredCore_iff Loc.ellAyx OpType.wt).mpr ⟨rfl, rfl⟩)
        (by
          intro q b hq hget
