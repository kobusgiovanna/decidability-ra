theorem traceRf_matches_primeCheckX_checkX_xBprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xB' i = some ew ∧
      rawNthRead trace Tid.checkX Loc.xB' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, hewval⟩ := rawNthWrite_primeCheckX_xBprime_eq I cnts htracePVX hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_checkX_xBprime_eq I v0 kws htraceVX her
  have hclen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hcform := hcntsVal i hclen
  rw [hcform] at hc
  injection hc with hc
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hc, hkweq]
  congr 2
  omega

/-- `traceRf_matches_primeCheckX_checkX_xBprime` for the general
construction. -/
theorem traceRf_matches_primeCheckX_checkX_xBprime_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xB' i = some ew ∧
      rawNthRead trace Tid.checkX Loc.xB' i = some er) :
    ew.val = er.val :=
  traceRf_matches_primeCheckX_checkX_xBprime I cnts htracePVX hcntsVal v0 kws htraceVX hkwsVal h

/-! ## `CheckY`

As for `CheckX`. `checkYLoop` is the loop, without the leading
`aux ← NDet({1,…,n})`. -/

/-- `CheckY.program`'s loop, without the leading `ndetAssign`. -/
def checkYLoop (I : PCPInstance) : Command (domainOf I) (CheckY.Vocab I) :=
  Command.whileLoop CheckY.BExpr.tt (CheckY.body I)

/-- The tail `if aux = ⊥ then break; aux ← NDet(…)` of each iteration of
`CheckY.body`. -/
def checkYTail (I : PCPInstance) : Command (domainOf I) (CheckY.Vocab I) :=
  Command.seq (Command.ite CheckY.BExpr.isBot Command.brk Command.skip)
    (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSetBot I) (CheckY.auxSetBot_nonempty I))

/-- The `First()` branch of `CheckY.body`: `fst ← False`, then the two
`First()`-tagged reads. -/
def checkYFirstBranch (I : PCPInstance) : Command (domainOf I) (CheckY.Vocab I) :=
  Command.seq (Command.assign CheckY.Vars.fst CheckY.Expr.fstFalse)
    (Command.seq (Command.read Loc.yA CheckY.VExpr.yAFirst)
      (Command.read Loc.yB CheckY.VExpr.yBFirst))

/-- The `else` branch of `CheckY.body`: the four reads `yA`, `yB`, `yA'`,
`yB'`. -/
def checkYElseBranch (I : PCPInstance) : Command (domainOf I) (CheckY.Vocab I) :=
  Command.seq (Command.read Loc.yA CheckY.VExpr.yARest)
    (Command.seq (Command.read Loc.yB CheckY.VExpr.yBRest)
      (Command.seq (Command.read Loc.yA' CheckY.VExpr.primeCheckVal)
        (Command.read Loc.yB' CheckY.VExpr.primeCheckVal)))

/-- The `ite` of `Command.firstIt` in `CheckY.body`. -/
def checkYIteFirst (I : PCPInstance) : Command (domainOf I) (CheckY.Vocab I) :=
  Command.ite CheckY.BExpr.isFirst (checkYFirstBranch I) (checkYElseBranch I)

/-- `CheckY`'s events in an iteration after the first, with counter `k` and
`aux = w` (as `checkXBlockRestElems`). -/
def checkYBlockRestElems (I : PCPInstance) (kw : Fin 4 × Option (Fin I.n)) :
    List (ThreadLabel (domainOf I) Tid.checkY) :=
  [ ⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yA' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yB' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ ]

/-- The first iteration of `checkYLoop` (as `checkX_block0_step`). -/
theorem checkY_block0_step (I : PCPInstance) (v : CheckY.Vals I)
    (rest : List (CheckY.Vals I)) (φ : (CheckY.Vocab I).Store)
    (hfst : φ CheckY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ CheckY.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : Fin I.n) (haux0 : φ CheckY.Vars.aux = Sum.inl (some v0))
    (hv : v ∈ CheckY.auxSetBot I) :
    ∃ (φ' : (CheckY.Vocab I).Store) (cLast : Config (domainOf I) (CheckY.Vocab I)),
      φ' CheckY.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' CheckY.Vars.cnt = Sum.inr (Sum.inl 1) ∧ φ' CheckY.Vars.aux = v ∧
      Command.Run Tid.checkY (v :: rest)
        (checkYLoop I, φ)
        [ ⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩
        , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩
        , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
        , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ ]
        cLast rest (checkYLoop I, φ') := by
  set φ1 : (CheckY.Vocab I).Store :=
    Function.update φ CheckY.Vars.prev (CheckY.eval I CheckY.Expr.readCnt φ) with hφ1
  set φ2 : (CheckY.Vocab I).Store :=
    Function.update φ1 CheckY.Vars.cnt (CheckY.eval I CheckY.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 CheckY.Vars.cnt = φ CheckY.Vars.cnt := rfl
  have hcnt2eq : φ2 CheckY.Vars.cnt = CheckY.eval I CheckY.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2 : CheckY.cntOf I φ2 = 1 := by
    simp only [CheckY.cntOf, hcnt2eq, CheckY.eval, hcnt_φ1, hcnt0]
    decide
  have hcnt2raw : φ2 CheckY.Vars.cnt = Sum.inr (Sum.inl 1) := by
    simp only [hcnt2eq, CheckY.eval, CheckY.cntOf, hcnt_φ1, hcnt0]
    rfl
  have hne_aux_cnt : CheckY.Vars.aux ≠ CheckY.Vars.cnt := by decide
  have haux_φ1 : φ1 CheckY.Vars.aux = φ CheckY.Vars.aux := rfl
  have haux2 : φ2 CheckY.Vars.aux = Sum.inl (some v0) := by
    have h1' : φ2 CheckY.Vars.aux = φ1 CheckY.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    rw [h1', haux_φ1, haux0]
  have hcnt1 : (CheckY.Vocab I).evalV CheckY.VExpr.cntTagVal φ2 = Val.primeTag Tid.checkY 1 := by
    simp only [CheckY.Vocab, CheckY.evalV, hcnt2]
    rfl
  have h1 : Command.RunStep Tid.checkY (v :: rest) none (checkYLoop I, φ) (v :: rest)
      (Command.loopSeq (CheckY.body I) (checkYLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkYLoop, Command.step, CheckY.Vocab, CheckY.evalB, if_true])
  have h2 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (CheckY.body I) (checkYLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckY.Vars.cnt CheckY.Expr.nextCnt)
          (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
              (Command.seq (checkYIteFirst I) (checkYTail I))))))
        (checkYLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [CheckY.body, Command.step, CheckY.Vocab]; rfl)
  have h3 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckY.Vars.cnt CheckY.Expr.nextCnt)
          (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
              (Command.seq (checkYIteFirst I) (checkYTail I))))))
        (checkYLoop I), φ1) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.assign CheckY.Vars.cnt CheckY.Expr.nextCnt)
          (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
              (Command.seq (checkYIteFirst I) (checkYTail I)))))
        (checkYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq
        (Command.seq (Command.assign CheckY.Vars.cnt CheckY.Expr.nextCnt)
          (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
              (Command.seq (checkYIteFirst I) (checkYTail I)))))
        (checkYLoop I), φ1) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
            (Command.seq (checkYIteFirst I) (checkYTail I)))))
        (checkYLoop I), φ2) := by
    rw [hφ2]
    exact Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckY.Vocab])
  have h5 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
            (Command.seq (checkYIteFirst I) (checkYTail I)))))
        (checkYLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
            (Command.seq (checkYIteFirst I) (checkYTail I))))
        (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.checkY (v :: rest)
      (some ⟨EventLabel.wt Tid.checkY Loc.yA
        ((CheckY.Vocab I).evalV CheckY.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.yA CheckY.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
            (Command.seq (checkYIteFirst I) (checkYTail I))))
        (checkYLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
          (Command.seq (checkYIteFirst I) (checkYTail I))))
        (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, CheckY.Vocab, CheckY.evalV])
  have h7 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
          (Command.seq (checkYIteFirst I) (checkYTail I))))
        (checkYLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
          (Command.seq (checkYIteFirst I) (checkYTail I)))
        (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.checkY (v :: rest)
      (some ⟨EventLabel.wt Tid.checkY Loc.yB
        ((CheckY.Vocab I).evalV CheckY.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.yB CheckY.VExpr.cntTagVal)
          (Command.seq (checkYIteFirst I) (checkYTail I)))
        (checkYLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkYIteFirst I) (checkYTail I)))
        (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckY.Vocab, CheckY.evalV])
  have h9 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkYIteFirst I) (checkYTail I)))
        (checkYLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq (checkYIteFirst I) (checkYTail I)) (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hne_fst_cnt : CheckY.Vars.fst ≠ CheckY.Vars.cnt := by decide
  have hfst_φ1 : φ1 CheckY.Vars.fst = φ CheckY.Vars.fst := rfl
  have hfst2 : φ2 CheckY.Vars.fst = Sum.inr (Sum.inr true) := by
    have h1' : φ2 CheckY.Vars.fst = φ1 CheckY.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have h10 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq (checkYIteFirst I) (checkYTail I)) (checkYLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (checkYFirstBranch I) (checkYTail I)) (checkYLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkYIteFirst, Command.step, CheckY.Vocab, CheckY.evalB, hfst2, if_true])
  set φ3 : (CheckY.Vocab I).Store :=
    Function.update φ2 CheckY.Vars.fst (CheckY.eval I CheckY.Expr.fstFalse φ2) with hφ3
  have hcnt3 : φ3 CheckY.Vars.cnt = Sum.inr (Sum.inl 1) :=
    (Function.update_of_ne hne_fst_cnt.symm _ _).trans hcnt2raw
  have hne_aux_fst : CheckY.Vars.aux ≠ CheckY.Vars.fst := by decide
  have haux3 : φ3 CheckY.Vars.aux = Sum.inl (some v0) := by
    have h1' : φ3 CheckY.Vars.aux = φ2 CheckY.Vars.aux := Function.update_of_ne hne_aux_fst _ _
    rw [h1', haux2]
  have hyAFirst : (CheckY.Vocab I).evalV CheckY.VExpr.yAFirst φ3
      = Val.yTag (Tid.guessAY, true) (some v0) := by
    simp only [CheckY.Vocab, CheckY.evalV, CheckY.auxOf, haux3]
    rfl
  have hyBFirst : (CheckY.Vocab I).evalV CheckY.VExpr.yBFirst φ3
      = Val.yTag (Tid.guessBY, true) (some v0) := by
    simp only [CheckY.Vocab, CheckY.evalV, CheckY.auxOf, haux3]
    rfl
  have h11 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq (checkYFirstBranch I) (checkYTail I)) (checkYLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.yA CheckY.VExpr.yAFirst)
          (Command.read Loc.yB CheckY.VExpr.yBFirst))) (checkYTail I)) (checkYLoop I), φ3) := by
    rw [hφ3]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkYFirstBranch, Command.step, CheckY.Vocab]; rfl)
  have h12 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.yA CheckY.VExpr.yAFirst)
          (Command.read Loc.yB CheckY.VExpr.yBFirst))) (checkYTail I)) (checkYLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.yA CheckY.VExpr.yAFirst)
          (Command.read Loc.yB CheckY.VExpr.yBFirst)) (checkYTail I)) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h13 : Command.RunStep Tid.checkY (v :: rest)
      (some ⟨EventLabel.rd Tid.checkY Loc.yA
        ((CheckY.Vocab I).evalV CheckY.VExpr.yAFirst φ3), rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.yA CheckY.VExpr.yAFirst)
          (Command.read Loc.yB CheckY.VExpr.yBFirst)) (checkYTail I)) (checkYLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.yB CheckY.VExpr.yBFirst)) (checkYTail I)) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckY.Vocab, CheckY.evalV])
  have h14 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.yB CheckY.VExpr.yBFirst)) (checkYTail I)) (checkYLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.read Loc.yB CheckY.VExpr.yBFirst) (checkYTail I))
        (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h15 : Command.RunStep Tid.checkY (v :: rest)
      (some ⟨EventLabel.rd Tid.checkY Loc.yB
        ((CheckY.Vocab I).evalV CheckY.VExpr.yBFirst φ3), rfl⟩)
      (Command.loopSeq (Command.seq (Command.read Loc.yB CheckY.VExpr.yBFirst) (checkYTail I))
        (checkYLoop I), φ3) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (checkYTail I)) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckY.Vocab, CheckY.evalV])
  have h16 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (checkYTail I)) (checkYLoop I), φ3) (v :: rest)
      (Command.loopSeq (checkYTail I) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hisBot3 : CheckY.evalB I CheckY.BExpr.isBot φ3 = false := by
    simp only [CheckY.evalB]
    cases hφ : φ3 CheckY.Vars.aux with
    | inl w => cases w with
        | none => rw [haux3] at hφ; injection hφ with hφ2; injection hφ2
        | some _ => simp
    | inr w => simp
  have h17 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (checkYTail I) (checkYLoop I), φ3) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSetBot I)
          (CheckY.auxSetBot_nonempty I))) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkYTail, Command.step, CheckY.Vocab, hisBot3, Bool.false_eq_true, if_false])
  have h18 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSetBot I)
          (CheckY.auxSetBot_nonempty I))) (checkYLoop I), φ3) (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSetBot I)
          (CheckY.auxSetBot_nonempty I)) (checkYLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h19 : Command.RunStep Tid.checkY (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSetBot I)
          (CheckY.auxSetBot_nonempty I)) (checkYLoop I), φ3) rest
      (Command.loopSeq Command.skip (checkYLoop I), Function.update φ3 CheckY.Vars.aux v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h20 : Command.RunStep Tid.checkY rest none
      (Command.loopSeq Command.skip (checkYLoop I), Function.update φ3 CheckY.Vars.aux v) rest
      (checkYLoop I, Function.update φ3 CheckY.Vars.aux v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.checkY) (s := v :: rest) (c := (checkYLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.silentSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have run12 := Command.Run.silentSnoc run11 h12
  have run13 := Command.Run.labelledSnoc run12 h13
  have run14 := Command.Run.silentSnoc run13 h14
  have run15 := Command.Run.labelledSnoc run14 h15
  have run16 := Command.Run.silentSnoc run15 h16
  have run17 := Command.Run.silentSnoc run16 h17
  have run18 := Command.Run.silentSnoc run17 h18
  have run19 := Command.Run.silentSnoc run18 h19
  have run20 := Command.Run.silentSnoc run19 h20
  rw [hcnt1, hyAFirst, hyBFirst] at run20
  have hne_fst_aux : CheckY.Vars.fst ≠ CheckY.Vars.aux := by decide
  have hfst3 : φ3 CheckY.Vars.fst = Sum.inr (Sum.inr false) := Function.update_self _ _ _
  have hfst_final : Function.update φ3 CheckY.Vars.aux v CheckY.Vars.fst
