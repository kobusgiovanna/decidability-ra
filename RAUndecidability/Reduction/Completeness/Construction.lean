/-- `rf_total` for the `guessBY`/`zByy'` branch (Eq. (15)). -/
theorem traceRf_total_guessBY_zByy' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (vals : List (Val I)) (htraceP : trace Tid.primeBY = primeBYBlockWord I vals)
    (hcount : kws.length ≤ vals.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessBY) (her_loc : er.loc = Loc.zByy')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.guessBY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.guessBY Loc.zByy' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.guessBY Loc.zByy' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.guessBY Loc.zByy' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.guessBY Loc.zByy' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.zByy') (op := OpType.rd) (predL := guessBYZByReadPred I) htraceG
    (guessBYZByReadPred_iff I)
  have hlen2 : ((guessBYBlockWord I v0 kws).filter (guessBYZByReadPred I)).length
      = kws.length := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_zByy'_filter,
      guessBYBlockRestElems_zByy'_filter]
    simp
  rw [hlen.trans hlen2] at hilt_reader
  have hpredW : ∀ lab : ThreadLabel (domainOf I) Tid.primeBY,
      (match lab.1.loc, lab.1.op with | Loc.zByy', OpType.wt => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zByy' ∧ lab.1.op = OpType.wt) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBY)
    (x := Loc.zByy') (op := OpType.wt) htraceP hpredW
  have hilt_writer : i < (rawOpEvents trace Tid.primeBY Loc.zByy' OpType.wt).length := by
    rw [hlenW.trans (primeBYBlockWord_zByy'_length I vals)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_primeBY_guessBY_zByy' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htracePAY : trace Tid.primeBY = primeBYBlockWord I vals)
    (cnt0 : Fin 4) (hcnt0 : cnt0 = 0)
    (hvalsVal : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4)))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeBY Loc.zByy' i = some ew ∧
      rawNthRead trace Tid.guessBY Loc.zByy' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨v, hv, hewval⟩ := rawNthWrite_primeBY_zByy'_eq I vals htracePAY hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_guessBY_zByy'_eq I v0 kws htraceGAY her
  have hvlen : i < vals.length := (List.getElem?_eq_some_iff.mp hv).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hvform := hvalsVal i hvlen
  rw [hvform] at hv
  injection hv with hv
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hv, hkweq]
  congr 2
  rw [hcnt0]
  simp
  omega

/-- `traceRf_matches_primeBY_guessBY_zByy'` for the general construction. -/
theorem traceRf_matches_primeBY_guessBY_zByy'_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htracePBY : trace Tid.primeBY = primeBYBlockWord I vals)
    (hvalsVal : ∀ i, i < vals.length → vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeBY Loc.zByy' i = some ew ∧
      rawNthRead trace Tid.guessBY Loc.zByy' i = some er) :
    ew.val = er.val := by
  have hvalsVal' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨((0 : Fin 4).val + i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; rw [hvalsVal i hi]; congr 2; apply Fin.ext; simp
  exact traceRf_matches_primeBY_guessBY_zByy' I vals htracePBY 0 rfl hvalsVal' v0 kws htraceGBY
    hkwsVal h

/-! ## `rf_matches`: `guessBY`/`primeBY` `zBy'y` (Eq. (15)) -/

theorem primeBYBlockWord_zBy'y_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeBYBlockWord I vals).filter
      (fun lab => match lab.1.loc, lab.1.op with
        | Loc.zBy'y, OpType.rd => true | _, _ => false)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY)
        , ⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ ] ++ (primeBYBlockWord I vs)).filter
        (fun lab => match lab.1.loc, lab.1.op with
          | Loc.zBy'y, OpType.rd => true | _, _ => false)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih]
      rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : ¬ (match Loc.yB', OpType.wt with
            | Loc.zBy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : ¬ (match Loc.zByy', OpType.wt with
            | Loc.zBy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by exact (by decide : (match Loc.zBy'y, OpType.rd with
            | Loc.zBy'y, OpType.rd => true | _, _ => false) = true)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_primeBY_zBy'y_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htrace : trace Tid.primeBY = primeBYBlockWord I vals)
