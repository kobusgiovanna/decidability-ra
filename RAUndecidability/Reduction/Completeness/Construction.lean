    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 0 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
