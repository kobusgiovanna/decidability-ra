    (fun p => guessBYZByprimeWritePred I p.1) 2
    ((⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY), k + 2)
    (by rw [List.getElem?_zipIdx]; rfl)
    (by unfold guessBYZByprimeWritePred
        exact (zBy'yWritePredCore_iff Loc.zBy'y OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      rw [List.getElem?_zipIdx] at hget
      have hqlt : q < 3 := by
        rcases Nat.lt_or_ge q 3 with hqlt | hqge
        · exact hqlt
        · exfalso
          have hqge3 : (guessBYBlock0Elems I v0).length ≤ q := by
            simp only [guessBYBlock0Elems, List.length_cons, List.length_nil]
            omega
          have : (guessBYBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge3
          rw [this] at hget
          simp at hget
      have hq01 : q = 0 ∨ q = 1 := by omega
      rcases hq01 with rfl | rfl <;>
        simp only [guessBYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.map_some, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessBYZByprimeWritePred
      · exact zBy'yWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact zBy'yWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide))

theorem rawNthWrite_guessBY_zBy'y_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessBY Loc.zBy'y i = some ew) :
    (i = 0 ∧ ew.val = Val.cnt 1) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.cnt (kw.1 + 1)) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.zBy'y) (op := OpType.wt)
    (predL := guessBYZByprimeWritePred I) htrace (guessBYZByprimeWritePred_iff I)
  have hlen2 : ((guessBYBlockWord I v0 kws).filter (guessBYZByprimeWritePred I)).length
      = kws.length + 1 := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_zBy'y_filter,
      guessBYBlockRestElems_zBy'y_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (guessBYBlockWord I v0 kws).zipIdx.filter (fun p => guessBYZByprimeWritePred I p.1) =
      [((⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 2)] ++
      ((kws.flatMap (guessBYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessBYZByprimeWritePred I p.1) := by
    unfold guessBYBlockWord
    rw [List.zipIdx_append, List.filter_append, guessBYBlock0Elems_zBy'y_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBY)
      (l := guessBYBlockWord I v0 kws) htrace (guessBYZByprimeWritePred_iff I)
      (n := 0) (lab := (⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY)) (origPos := 2)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.guessBY Loc.zBy'y OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessBY)
      (guessBYBlockRestElems I) 5 2
      (fun kw => rfl)
      (guessBYZByprimeWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (kw.1 + 1)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY))
      (fun a => rfl)
      (fun a => by
        unfold guessBYZByprimeWritePred
        exact (zBy'yWritePredCore_iff Loc.zBy'y OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
        have hq4 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 := by omega
        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessBYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessBYZByprimeWritePred
        · exact zBy'yWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
        · exact zBy'yWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide)
        · exact zBy'yWritePredCore_false_of_ne Loc.zBxy OpType.rd (by decide)
        · exact zBy'yWritePredCore_false_of_ne Loc.zByy' OpType.rd (by decide))
      kws 3 j kw hkw
    have hzipj :
        ((guessBYBlockWord I v0 kws).zipIdx.filter (fun p => guessBYZByprimeWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (kw.1 + 1)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 3 + j * 5 + 2) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBY)
      (l := guessBYBlockWord I v0 kws) htrace (guessBYZByprimeWritePred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.guessBY Loc.zBy'y OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `primeBY`/`zBy'y` branch (Eq. (15)). -/
theorem traceRf_total_primeBY_zBy'y (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceP : trace Tid.primeBY = primeBYBlockWord I vals)
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hcount : vals.length ≤ 1 + kws.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeBY) (her_loc : er.loc = Loc.zBy'y)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeBY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeBY Loc.zBy'y OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeBY Loc.zBy'y OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeBY Loc.zBy'y i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeBY Loc.zBy'y OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeBY,
      (match lab.1.loc, lab.1.op with | Loc.zBy'y, OpType.rd => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zBy'y ∧ lab.1.op = OpType.rd) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBY)
    (x := Loc.zBy'y) (op := OpType.rd) htraceP hpredL
  rw [hlen.trans (primeBYBlockWord_zBy'y_length I vals)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.zBy'y) (op := OpType.wt) (predL := guessBYZByprimeWritePred I) htraceG
    (guessBYZByprimeWritePred_iff I)
  have hlenW2 : ((guessBYBlockWord I v0 kws).filter (guessBYZByprimeWritePred I)).length
      = 1 + kws.length := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_zBy'y_filter,
      guessBYBlockRestElems_zBy'y_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessBY Loc.zBy'y OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_guessBY_primeBY_zBy'y (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (vals : List (Val I)) (htracePAY : trace Tid.primeBY = primeBYBlockWord I vals)
    (cnt0 : Fin 4) (hcnt0eq : cnt0 = 0)
    (hvalsVal : ∀ n, n < vals.length →
      vals[n]? = some (Val.cnt (⟨(cnt0.val + n + 1) % 4, by omega⟩ : Fin 4)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.zBy'y i = some ew ∧
      rawNthRead trace Tid.primeBY Loc.zBy'y i = some er) :
    ew.val = er.val := by
  subst hcnt0eq
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨v, hv, herval⟩ := rawNthRead_primeBY_zBy'y_eq I vals htracePAY her
  have hvlen : i < vals.length := (List.getElem?_eq_some_iff.mp hv).1
  have hvform := hvalsVal i hvlen
  rw [hvform] at hv
  injection hv with hv
  rcases rawNthWrite_guessBY_zBy'y_eq I v0 kws htraceGAY hew with
    ⟨hi0, hewval⟩ | ⟨kw, hkw, hi1, hewval⟩
  · subst hi0
    rw [hewval, herval, ← hv]
    congr 1
  · have hjlen : i - 1 < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
    obtain ⟨w, hw⟩ := hkwsVal (i - 1) hjlen
    have hkweq := hkw.symm.trans hw
    injection hkweq with hkweq
    rw [hewval, herval, ← hv, hkweq]
    congr 1
    apply Fin.ext
    simp [Fin.add_def]
    omega

/-- `traceRf_matches_guessBY_primeBY_zBy'y` for the general construction. -/
theorem traceRf_matches_guessBY_primeBY_zBy'y_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (vals : List (Val I)) (htracePBY : trace Tid.primeBY = primeBYBlockWord I vals)
    (hvalsVal : ∀ n, n < vals.length → vals[n]? = some (Val.cnt (⟨(n + 1) % 4, by omega⟩ : Fin 4)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.zBy'y i = some ew ∧
      rawNthRead trace Tid.primeBY Loc.zBy'y i = some er) :
    ew.val = er.val := by
  have hvalsVal' : ∀ n, n < vals.length →
      vals[n]? = some (Val.cnt (⟨((0 : Fin 4).val + n + 1) % 4, by omega⟩ : Fin 4)) := by
    intro n hn; rw [hvalsVal n hn]; congr 2; apply Fin.ext; simp
  exact traceRf_matches_guessBY_primeBY_zBy'y I v0 kws htraceGBY hkwsVal vals htracePBY 0 rfl
    hvalsVal' h

/-! ## Lemma 3.4 for the threads skipping a first read

For `CheckX`, `CheckY`, `GuessAY`, `GuessBY`, whose word is
`block0 v0 ++ kws.flatMap blockRest` with `block0` a prefix of `blockRest`
(`flatLoop_po_monotone_of_shape_skip`, with `block0` given as a constant
function). `CheckX`/`CheckY` access no bridge location; `GuessAY`/`GuessBY` do
(`ellAyx`/`ellByx`, `*BlockShape_has_bridge`), but the hypothesis `hnb2` is not
used by the argument. -/

/-- `CheckX`'s block-0 shape: two writes (`xA`, `xB`) then two reads
(`xA`, `xB`). -/
def checkXBlock0Shape : List (Loc × OpType) :=
  [(Loc.xA, .wt), (Loc.xB, .wt), (Loc.xA, .rd), (Loc.xB, .rd)]

theorem checkXBlock0Elems_shape (I : PCPInstance) :
    ∀ v0 : I.Γ,
      (checkXBlock0Elems I v0).map (fun ev => (ev.1.loc, ev.1.op)) = checkXBlock0Shape :=
  fun _ => rfl

/-- `CheckX`'s shape for later blocks: two writes (`xA`, `xB`) then four reads
(`xA`, `xB`, `xA'`, `xB'`), of which `checkXBlock0Shape` is a prefix. -/
def checkXBlockShape : List (Loc × OpType) :=
  [(Loc.xA, .wt), (Loc.xB, .wt), (Loc.xA, .rd), (Loc.xB, .rd), (Loc.xA', .rd), (Loc.xB', .rd)]

theorem checkXBlockRestElems_shape (I : PCPInstance) :
    ∀ kw : Fin 4 × Option I.Γ,
      (checkXBlockRestElems I kw).map (fun ev => (ev.1.loc, ev.1.op)) = checkXBlockShape :=
  fun _ => rfl

theorem checkXBlockShape_prefix :
    checkXBlock0Shape = checkXBlockShape.take checkXBlock0Shape.length := by decide

theorem checkXBlockShape_nodup : checkXBlockShape.Nodup := by decide

/-- `CheckX` accesses no bridge location. -/
theorem checkXBlockShape_no_bridge : ∀ p ∈ checkXBlockShape, p.1 ∉ BridgeLoc := by decide

/-- Lemma 3.4 for the threads skipping a first read for `CheckX`. -/
theorem checkX_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkX) (he2 : e2 ∈ traceEventsOf trace Tid.checkX)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 2 ≤ checkXBlock0Shape.length := by decide
  have hshapewrites : ∀ p x, checkXBlockShape[p]? = some (x, OpType.rd) → 2 ≤ p := by
    intro p x hpx
    have h6 := blockShapeLen_lt (N := 6) (shape := checkXBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [checkXBlockShape]
  have hshapewrites2 : ∀ p x, checkXBlockShape[p]? = some (x, OpType.wt) → p < 2 := by
    intro p x hpx
    have h6 := blockShapeLen_lt (N := 6) (shape := checkXBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [checkXBlockShape]
  exact flatLoop_po_monotone_of_shape_skip
    (fun (_ : Fin 4 × Option I.Γ) => checkXBlock0Elems I v0) (checkXBlockRestElems I)
    checkXBlock0Shape checkXBlockShape (fun _ => checkXBlock0Elems_shape I v0)
    (checkXBlockRestElems_shape I) checkXBlockShape_prefix checkXBlockShape_nodup 2 hWL
    hshapewrites hshapewrites2 trace (0, none) kws htrace he1 he2 hpo hwt2

/-- Lemma 3.5 for `CheckX`: a decreasing `tracePo`-edge between
two reads of `CheckX` decreases the index by exactly one, and its locations
are one of `⟨xA,xA'⟩`/`⟨xA,xB'⟩`/`⟨xB,xA'⟩`/`⟨xB,xB'⟩` (the first four pairs
of Eq. (19)). Both events lie in later blocks, at `(n1, p1)` and `(n2, p2)`
with `n1 ≤ n2`; only `p1 < 4 ≤ p2` with `n1 = n2` decreases. -/
theorem checkX_po_reads_decreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkX) (he2 : e2 ∈ traceEventsOf trace Tid.checkX)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hrd2 : e2.op = .rd)
    (_hnb1 : ¬ e1.IsBridge) (_hnb2 : ¬ e2.IsBridge)
    (hdec : rawIndex trace e2 < rawIndex trace e1) :
    rawIndex trace e1 = rawIndex trace e2 + 1 ∧
      ((e1.loc = Loc.xA ∧ e2.loc = Loc.xA') ∨ (e1.loc = Loc.xA ∧ e2.loc = Loc.xB') ∨
       (e1.loc = Loc.xB ∧ e2.loc = Loc.xA') ∨ (e1.loc = Loc.xB ∧ e2.loc = Loc.xB')) := by
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option I.Γ) => checkXBlock0Elems I v0) (checkXBlockRestElems I)
    checkXBlock0Shape checkXBlockShape (fun _ => checkXBlock0Elems_shape I v0)
    (checkXBlockRestElems_shape I) checkXBlockShape_prefix checkXBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option I.Γ) => checkXBlock0Elems I v0) (checkXBlockRestElems I)
    checkXBlock0Shape checkXBlockShape (fun _ => checkXBlock0Elems_shape I v0)
    (checkXBlockRestElems_shape I) checkXBlockShape_prefix checkXBlockShape_nodup
    trace (0, none) kws htrace he2
  rcases h1 with ⟨p1', hp1'4, hidPos1', hrawIdx1', hshape1'⟩ |
         ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
  · exfalso; rw [hrawIdx1'] at hdec; omega
  · rcases h2 with ⟨p2', hp2'4, hidPos2', hrawIdx2', hshape2'⟩ |
         ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · exfalso
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · have hidPos1' : idPos e1 = 4 + n1 * 6 + p1 := hidPos1
      have hidPos2' : idPos e2 = 4 + n2 * 6 + p2 := hidPos2
      have hrawIdx1' : rawIndex trace e1 = if p1 < 4 then n1 + 1 else n1 := hrawIdx1
      have hrawIdx2' : rawIndex trace e2 = if p2 < 4 then n2 + 1 else n2 := hrawIdx2
      have hp1L' : p1 < 6 := hp1L
      have hp2L' : p2 < 6 := hp2L
      clear hidPos1 hidPos2 hrawIdx1 hrawIdx2 hp1L hp2L
      have hpos0 : checkXBlockShape[0]? = some (Loc.xA, OpType.wt) := by decide
      have hpos1 : checkXBlockShape[1]? = some (Loc.xB, OpType.wt) := by decide
      have hpos2 : checkXBlockShape[2]? = some (Loc.xA, OpType.rd) := by decide
      have hpos3 : checkXBlockShape[3]? = some (Loc.xB, OpType.rd) := by decide
      have hpos4 : checkXBlockShape[4]? = some (Loc.xA', OpType.rd) := by decide
      have hpos5 : checkXBlockShape[5]? = some (Loc.xB', OpType.rd) := by decide
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      have e1p1 : p1 = 0 → e1.loc = Loc.xA ∧ e1.op = OpType.wt := by
        rintro rfl
        have h := hshape1.symm.trans hpos0; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p2 : p1 = 1 → e1.loc = Loc.xB ∧ e1.op = OpType.wt := by
        rintro rfl
        have h := hshape1.symm.trans hpos1; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p3 : p1 = 2 → e1.loc = Loc.xA ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos2; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p4 : p1 = 3 → e1.loc = Loc.xB ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos3; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p5 : p1 = 4 → e1.loc = Loc.xA' ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos4; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p6 : p1 = 5 → e1.loc = Loc.xB' ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos5; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p1 : p2 = 0 → e2.loc = Loc.xA ∧ e2.op = OpType.wt := by
        rintro rfl
        have h := hshape2.symm.trans hpos0; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p2 : p2 = 1 → e2.loc = Loc.xB ∧ e2.op = OpType.wt := by
        rintro rfl
        have h := hshape2.symm.trans hpos1; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p3 : p2 = 2 → e2.loc = Loc.xA ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos2; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p4 : p2 = 3 → e2.loc = Loc.xB ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos3; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p5 : p2 = 4 → e2.loc = Loc.xA' ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos4; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p6 : p2 = 5 → e2.loc = Loc.xB' ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos5; injection h with h; injection h with a b; exact ⟨a, b⟩
      have hr1 : 2 ≤ p1 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e1p1 rfl).2.symm.trans hrd1) (by decide)
        · exact absurd ((e1p2 rfl).2.symm.trans hrd1) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hr2 : 2 ≤ p2 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e2p1 rfl).2.symm.trans hrd2) (by decide)
        · exact absurd ((e2p2 rfl).2.symm.trans hrd2) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hp1cases' : p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases' : p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1', hidPos2'] at hidlt
      have hn1n2 : n1 ≤ n2 := by omega
      rw [hrawIdx1', hrawIdx2'] at hdec
      have hn1eq2 : n1 = n2 ∧ p1 < 4 ∧ 4 ≤ p2 := by
        rcases hp1cases' with rfl | rfl | rfl | rfl <;>
        rcases hp2cases' with rfl | rfl | rfl | rfl <;>
          simp only [show (2:ℕ) < 4 from by omega, show (3:ℕ) < 4 from by omega,
            show ¬ (4:ℕ) < 4 from by omega, show ¬ (5:ℕ) < 4 from by omega, if_true, if_false]
              at hdec <;> omega
      obtain ⟨hn1eq2', hp1lt4, hp24le⟩ := hn1eq2
      subst hn1eq2'
      refine ⟨by rw [hrawIdx1', hrawIdx2']; simp only [hp1lt4, hp24le, if_true, if_false,
        show ¬ p2 < 4 from by omega], ?_⟩
      have hloc1 : e1.loc = Loc.xA ∨ e1.loc = Loc.xB := by
        rcases hp1cases' with rfl | rfl | rfl | rfl
        · exact Or.inl (e1p3 rfl).1
        · exact Or.inr (e1p4 rfl).1
        · omega
        · omega
      have hloc2 : e2.loc = Loc.xA' ∨ e2.loc = Loc.xB' := by
        rcases hp2cases' with rfl | rfl | rfl | rfl
        · omega
        · omega
        · exact Or.inl (e2p5 rfl).1
        · exact Or.inr (e2p6 rfl).1
      rcases hloc1 with h1' | h1' <;> rcases hloc2 with h2' | h2'
      · exact Or.inl ⟨h1', h2'⟩
      · exact Or.inr (Or.inl ⟨h1', h2'⟩)
      · exact Or.inr (Or.inr (Or.inl ⟨h1', h2'⟩))
      · exact Or.inr (Or.inr (Or.inr ⟨h1', h2'⟩))

/-- The "single `po`-edge" case of `hb_c_monotonic` for `CheckX`: along a
`tracePo`-edge from a write to a read of the same location, `rawIndex` is
non-decreasing (the read is at position `2`/`3`, read in every iteration). -/
theorem checkX_po_monotone_write_read (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkX) (he2 : e2 ∈ traceEventsOf trace Tid.checkX)
    (hpo : tracePo e1 e2) (hwt1 : e1.op = .wt) (hrd2 : e2.op = .rd) (hloc : e1.loc = e2.loc) :
    rawIndex trace e1 ≤ rawIndex trace e2 := by
  obtain h1 | ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula_skip
      (fun (_ : Fin 4 × Option I.Γ) => checkXBlock0Elems I v0) (checkXBlockRestElems I)
      checkXBlock0Shape checkXBlockShape (fun _ => checkXBlock0Elems_shape I v0)
      (checkXBlockRestElems_shape I) checkXBlockShape_prefix checkXBlockShape_nodup
      trace (0, none) kws htrace he1
  · obtain ⟨p1', hp1'4, hidPos1', hrawIdx1', hshape1'⟩ := h1
    rw [hrawIdx1']
    exact Nat.zero_le _
  · obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip
        (fun (_ : Fin 4 × Option I.Γ) => checkXBlock0Elems I v0) (checkXBlockRestElems I)
        checkXBlock0Shape checkXBlockShape (fun _ => checkXBlock0Elems_shape I v0)
        (checkXBlockRestElems_shape I) checkXBlockShape_prefix checkXBlockShape_nodup
        trace (0, none) kws htrace he2
    · exfalso
      obtain ⟨p2', hp2'4, hidPos2', hrawIdx2', hshape2'⟩ := h2
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · have hidPos1' : idPos e1 = 4 + n1 * 6 + p1 := hidPos1
      have hidPos2' : idPos e2 = 4 + n2 * 6 + p2 := hidPos2
      have hrawIdx1' : rawIndex trace e1 = if p1 < 4 then n1 + 1 else n1 := hrawIdx1
      have hrawIdx2' : rawIndex trace e2 = if p2 < 4 then n2 + 1 else n2 := hrawIdx2
      have hp1L' : p1 < 6 := hp1L
      have hp2L' : p2 < 6 := hp2L
      clear hidPos1 hidPos2 hrawIdx1 hrawIdx2 hp1L hp2L
      have hpos0 : checkXBlockShape[0]? = some (Loc.xA, OpType.wt) := by decide
      have hpos1 : checkXBlockShape[1]? = some (Loc.xB, OpType.wt) := by decide
      have hpos2 : checkXBlockShape[2]? = some (Loc.xA, OpType.rd) := by decide
      have hpos3 : checkXBlockShape[3]? = some (Loc.xB, OpType.rd) := by decide
      have hpos4 : checkXBlockShape[4]? = some (Loc.xA', OpType.rd) := by decide
      have hpos5 : checkXBlockShape[5]? = some (Loc.xB', OpType.rd) := by decide
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      have e1p1 : p1 = 0 → e1.loc = Loc.xA ∧ e1.op = OpType.wt := by
        rintro rfl; have h := hshape1.symm.trans hpos0; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p2 : p1 = 1 → e1.loc = Loc.xB ∧ e1.op = OpType.wt := by
        rintro rfl; have h := hshape1.symm.trans hpos1; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p3 : p1 = 2 → e1.loc = Loc.xA ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos2; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p4 : p1 = 3 → e1.loc = Loc.xB ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos3; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p5 : p1 = 4 → e1.loc = Loc.xA' ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos4; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p6 : p1 = 5 → e1.loc = Loc.xB' ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos5; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p1 : p2 = 0 → e2.loc = Loc.xA ∧ e2.op = OpType.wt := by
        rintro rfl; have h := hshape2.symm.trans hpos0; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p2 : p2 = 1 → e2.loc = Loc.xB ∧ e2.op = OpType.wt := by
        rintro rfl; have h := hshape2.symm.trans hpos1; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p5 : p2 = 4 → e2.loc = Loc.xA' ∧ e2.op = OpType.rd := by
        rintro rfl; have h := hshape2.symm.trans hpos4; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p6 : p2 = 5 → e2.loc = Loc.xB' ∧ e2.op = OpType.rd := by
        rintro rfl; have h := hshape2.symm.trans hpos5; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have hp1lt2 : p1 < 2 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl | rfl
        · omega
        · omega
        · exact absurd ((e1p3 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p4 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p5 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p6 rfl).2.symm.trans hwt1) (by decide)
      have hp1cases' : p1 = 0 ∨ p1 = 1 := by omega
      have hp2cases' : p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e2p1 rfl).2.symm.trans hrd2) (by decide)
        · exact absurd ((e2p2 rfl).2.symm.trans hrd2) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hp2lt4 : p2 < 4 := by
        rcases hp1cases' with rfl | rfl
        · have he1loc : e1.loc = Loc.xA := (e1p1 rfl).1
          rcases hp2cases' with rfl | rfl | rfl | rfl
          · omega
          · omega
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p5 rfl).1))
              (by decide : Loc.xA ≠ Loc.xA')
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p6 rfl).1))
              (by decide : Loc.xA ≠ Loc.xB')
        · have he1loc : e1.loc = Loc.xB := (e1p2 rfl).1
          rcases hp2cases' with rfl | rfl | rfl | rfl
          · omega
          · omega
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p5 rfl).1))
              (by decide : Loc.xB ≠ Loc.xA')
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p6 rfl).1))
              (by decide : Loc.xB ≠ Loc.xB')
      have hn1n2 : n1 ≤ n2 := by
        obtain ⟨-, hidlt⟩ := hpo
        rw [hidPos1', hidPos2'] at hidlt
        omega
      have hp1lt4 : p1 < 4 := by omega
      rw [hrawIdx1', if_pos hp1lt4, hrawIdx2', if_pos hp2lt4]
      omega

/-- `CheckY`'s block-0 shape: two writes (`yA`, `yB`) then two reads
(`yA`, `yB`). -/
def checkYBlock0Shape : List (Loc × OpType) :=
  [(Loc.yA, .wt), (Loc.yB, .wt), (Loc.yA, .rd), (Loc.yB, .rd)]

theorem checkYBlock0Elems_shape (I : PCPInstance) :
    ∀ v0 : Fin I.n,
      (checkYBlock0Elems I v0).map (fun ev => (ev.1.loc, ev.1.op)) = checkYBlock0Shape :=
  fun _ => rfl

/-- `CheckY`'s shape for later blocks: two writes (`yA`, `yB`) then four reads
(`yA`, `yB`, `yA'`, `yB'`). -/
def checkYBlockShape : List (Loc × OpType) :=
  [(Loc.yA, .wt), (Loc.yB, .wt), (Loc.yA, .rd), (Loc.yB, .rd), (Loc.yA', .rd), (Loc.yB', .rd)]

theorem checkYBlockRestElems_shape (I : PCPInstance) :
    ∀ kw : Fin 4 × Option (Fin I.n),
      (checkYBlockRestElems I kw).map (fun ev => (ev.1.loc, ev.1.op)) = checkYBlockShape :=
  fun _ => rfl

theorem checkYBlockShape_prefix :
    checkYBlock0Shape = checkYBlockShape.take checkYBlock0Shape.length := by decide

theorem checkYBlockShape_nodup : checkYBlockShape.Nodup := by decide

/-- `CheckY` accesses no bridge location. -/
theorem checkYBlockShape_no_bridge : ∀ p ∈ checkYBlockShape, p.1 ∉ BridgeLoc := by decide

/-- Lemma 3.4 for the threads skipping a first read for `CheckY`. -/
theorem checkY_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkY) (he2 : e2 ∈ traceEventsOf trace Tid.checkY)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 2 ≤ checkYBlock0Shape.length := by decide
  have hshapewrites : ∀ p x, checkYBlockShape[p]? = some (x, OpType.rd) → 2 ≤ p := by
    intro p x hpx
    have h6 := blockShapeLen_lt (N := 6) (shape := checkYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [checkYBlockShape]
  have hshapewrites2 : ∀ p x, checkYBlockShape[p]? = some (x, OpType.wt) → p < 2 := by
    intro p x hpx
    have h6 := blockShapeLen_lt (N := 6) (shape := checkYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 ∨ p = 5 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl | rfl <;> simp_all [checkYBlockShape]
  exact flatLoop_po_monotone_of_shape_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => checkYBlock0Elems I v0) (checkYBlockRestElems I)
    checkYBlock0Shape checkYBlockShape (fun _ => checkYBlock0Elems_shape I v0)
    (checkYBlockRestElems_shape I) checkYBlockShape_prefix checkYBlockShape_nodup 2 hWL
    hshapewrites hshapewrites2 trace (0, none) kws htrace he1 he2 hpo hwt2



/-- Lemma 3.5 for `CheckY`: a decreasing `tracePo`-edge between
two reads of `CheckY` decreases the index by exactly one, and its locations
are one of `⟨yA,yA'⟩`/`⟨yA,yB'⟩`/`⟨yB,yA'⟩`/`⟨yB,yB'⟩` (as
`checkX_po_reads_decreasing`). -/
theorem checkY_po_reads_decreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkY) (he2 : e2 ∈ traceEventsOf trace Tid.checkY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hrd2 : e2.op = .rd)
    (_hnb1 : ¬ e1.IsBridge) (_hnb2 : ¬ e2.IsBridge)
    (hdec : rawIndex trace e2 < rawIndex trace e1) :
    rawIndex trace e1 = rawIndex trace e2 + 1 ∧
      ((e1.loc = Loc.yA ∧ e2.loc = Loc.yA') ∨ (e1.loc = Loc.yA ∧ e2.loc = Loc.yB') ∨
       (e1.loc = Loc.yB ∧ e2.loc = Loc.yA') ∨ (e1.loc = Loc.yB ∧ e2.loc = Loc.yB')) := by
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => checkYBlock0Elems I v0) (checkYBlockRestElems I)
    checkYBlock0Shape checkYBlockShape (fun _ => checkYBlock0Elems_shape I v0)
    (checkYBlockRestElems_shape I) checkYBlockShape_prefix checkYBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => checkYBlock0Elems I v0) (checkYBlockRestElems I)
    checkYBlock0Shape checkYBlockShape (fun _ => checkYBlock0Elems_shape I v0)
    (checkYBlockRestElems_shape I) checkYBlockShape_prefix checkYBlockShape_nodup
    trace (0, none) kws htrace he2
  rcases h1 with ⟨p1', hp1'4, hidPos1', hrawIdx1', hshape1'⟩ |
         ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
  · exfalso; rw [hrawIdx1'] at hdec; omega
  · rcases h2 with ⟨p2', hp2'4, hidPos2', hrawIdx2', hshape2'⟩ |
         ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · exfalso
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · have hidPos1' : idPos e1 = 4 + n1 * 6 + p1 := hidPos1
      have hidPos2' : idPos e2 = 4 + n2 * 6 + p2 := hidPos2
      have hrawIdx1' : rawIndex trace e1 = if p1 < 4 then n1 + 1 else n1 := hrawIdx1
      have hrawIdx2' : rawIndex trace e2 = if p2 < 4 then n2 + 1 else n2 := hrawIdx2
      have hp1L' : p1 < 6 := hp1L
      have hp2L' : p2 < 6 := hp2L
      clear hidPos1 hidPos2 hrawIdx1 hrawIdx2 hp1L hp2L
      have hpos0 : checkYBlockShape[0]? = some (Loc.yA, OpType.wt) := by decide
      have hpos1 : checkYBlockShape[1]? = some (Loc.yB, OpType.wt) := by decide
      have hpos2 : checkYBlockShape[2]? = some (Loc.yA, OpType.rd) := by decide
      have hpos3 : checkYBlockShape[3]? = some (Loc.yB, OpType.rd) := by decide
      have hpos4 : checkYBlockShape[4]? = some (Loc.yA', OpType.rd) := by decide
      have hpos5 : checkYBlockShape[5]? = some (Loc.yB', OpType.rd) := by decide
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      have e1p1 : p1 = 0 → e1.loc = Loc.yA ∧ e1.op = OpType.wt := by
        rintro rfl
        have h := hshape1.symm.trans hpos0; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p2 : p1 = 1 → e1.loc = Loc.yB ∧ e1.op = OpType.wt := by
        rintro rfl
        have h := hshape1.symm.trans hpos1; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p3 : p1 = 2 → e1.loc = Loc.yA ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos2; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p4 : p1 = 3 → e1.loc = Loc.yB ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos3; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p5 : p1 = 4 → e1.loc = Loc.yA' ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos4; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e1p6 : p1 = 5 → e1.loc = Loc.yB' ∧ e1.op = OpType.rd := by
        rintro rfl
        have h := hshape1.symm.trans hpos5; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p1 : p2 = 0 → e2.loc = Loc.yA ∧ e2.op = OpType.wt := by
        rintro rfl
        have h := hshape2.symm.trans hpos0; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p2 : p2 = 1 → e2.loc = Loc.yB ∧ e2.op = OpType.wt := by
        rintro rfl
        have h := hshape2.symm.trans hpos1; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p3 : p2 = 2 → e2.loc = Loc.yA ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos2; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p4 : p2 = 3 → e2.loc = Loc.yB ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos3; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p5 : p2 = 4 → e2.loc = Loc.yA' ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos4; injection h with h; injection h with a b; exact ⟨a, b⟩
      have e2p6 : p2 = 5 → e2.loc = Loc.yB' ∧ e2.op = OpType.rd := by
        rintro rfl
        have h := hshape2.symm.trans hpos5; injection h with h; injection h with a b; exact ⟨a, b⟩
      have hr1 : 2 ≤ p1 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e1p1 rfl).2.symm.trans hrd1) (by decide)
        · exact absurd ((e1p2 rfl).2.symm.trans hrd1) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hr2 : 2 ≤ p2 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e2p1 rfl).2.symm.trans hrd2) (by decide)
        · exact absurd ((e2p2 rfl).2.symm.trans hrd2) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hp1cases' : p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases' : p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1', hidPos2'] at hidlt
      have hn1n2 : n1 ≤ n2 := by omega
      rw [hrawIdx1', hrawIdx2'] at hdec
      have hn1eq2 : n1 = n2 ∧ p1 < 4 ∧ 4 ≤ p2 := by
        rcases hp1cases' with rfl | rfl | rfl | rfl <;>
        rcases hp2cases' with rfl | rfl | rfl | rfl <;>
          simp only [show (2:ℕ) < 4 from by omega, show (3:ℕ) < 4 from by omega,
            show ¬ (4:ℕ) < 4 from by omega, show ¬ (5:ℕ) < 4 from by omega, if_true, if_false]
              at hdec <;> omega
      obtain ⟨hn1eq2', hp1lt4, hp24le⟩ := hn1eq2
      subst hn1eq2'
      refine ⟨by rw [hrawIdx1', hrawIdx2']; simp only [hp1lt4, hp24le, if_true, if_false,
        show ¬ p2 < 4 from by omega], ?_⟩
      have hloc1 : e1.loc = Loc.yA ∨ e1.loc = Loc.yB := by
        rcases hp1cases' with rfl | rfl | rfl | rfl
        · exact Or.inl (e1p3 rfl).1
        · exact Or.inr (e1p4 rfl).1
        · omega
        · omega
      have hloc2 : e2.loc = Loc.yA' ∨ e2.loc = Loc.yB' := by
        rcases hp2cases' with rfl | rfl | rfl | rfl
        · omega
        · omega
        · exact Or.inl (e2p5 rfl).1
        · exact Or.inr (e2p6 rfl).1
      rcases hloc1 with h1' | h1' <;> rcases hloc2 with h2' | h2'
      · exact Or.inl ⟨h1', h2'⟩
      · exact Or.inr (Or.inl ⟨h1', h2'⟩)
      · exact Or.inr (Or.inr (Or.inl ⟨h1', h2'⟩))
      · exact Or.inr (Or.inr (Or.inr ⟨h1', h2'⟩))

/-- The "single `po`-edge" case of `hb_c_monotonic` for `CheckY`. -/
theorem checkY_po_monotone_write_read (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.checkY) (he2 : e2 ∈ traceEventsOf trace Tid.checkY)
    (hpo : tracePo e1 e2) (hwt1 : e1.op = .wt) (hrd2 : e2.op = .rd) (hloc : e1.loc = e2.loc) :
    rawIndex trace e1 ≤ rawIndex trace e2 := by
  obtain h1 | ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula_skip
      (fun (_ : Fin 4 × Option (Fin I.n)) => checkYBlock0Elems I v0) (checkYBlockRestElems I)
      checkYBlock0Shape checkYBlockShape (fun _ => checkYBlock0Elems_shape I v0)
      (checkYBlockRestElems_shape I) checkYBlockShape_prefix checkYBlockShape_nodup
      trace (0, none) kws htrace he1
  · obtain ⟨p1', hp1'4, hidPos1', hrawIdx1', hshape1'⟩ := h1
    rw [hrawIdx1']
    exact Nat.zero_le _
  · obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip
        (fun (_ : Fin 4 × Option (Fin I.n)) => checkYBlock0Elems I v0) (checkYBlockRestElems I)
        checkYBlock0Shape checkYBlockShape (fun _ => checkYBlock0Elems_shape I v0)
        (checkYBlockRestElems_shape I) checkYBlockShape_prefix checkYBlockShape_nodup
        trace (0, none) kws htrace he2
    · exfalso
      obtain ⟨p2', hp2'4, hidPos2', hrawIdx2', hshape2'⟩ := h2
      obtain ⟨-, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · have hidPos1' : idPos e1 = 4 + n1 * 6 + p1 := hidPos1
      have hidPos2' : idPos e2 = 4 + n2 * 6 + p2 := hidPos2
      have hrawIdx1' : rawIndex trace e1 = if p1 < 4 then n1 + 1 else n1 := hrawIdx1
      have hrawIdx2' : rawIndex trace e2 = if p2 < 4 then n2 + 1 else n2 := hrawIdx2
      have hp1L' : p1 < 6 := hp1L
      have hp2L' : p2 < 6 := hp2L
      clear hidPos1 hidPos2 hrawIdx1 hrawIdx2 hp1L hp2L
      have hpos0 : checkYBlockShape[0]? = some (Loc.yA, OpType.wt) := by decide
      have hpos1 : checkYBlockShape[1]? = some (Loc.yB, OpType.wt) := by decide
      have hpos2 : checkYBlockShape[2]? = some (Loc.yA, OpType.rd) := by decide
      have hpos3 : checkYBlockShape[3]? = some (Loc.yB, OpType.rd) := by decide
      have hpos4 : checkYBlockShape[4]? = some (Loc.yA', OpType.rd) := by decide
      have hpos5 : checkYBlockShape[5]? = some (Loc.yB', OpType.rd) := by decide
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 ∨ p1 = 5 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by omega
      have e1p1 : p1 = 0 → e1.loc = Loc.yA ∧ e1.op = OpType.wt := by
        rintro rfl; have h := hshape1.symm.trans hpos0; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p2 : p1 = 1 → e1.loc = Loc.yB ∧ e1.op = OpType.wt := by
        rintro rfl; have h := hshape1.symm.trans hpos1; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p3 : p1 = 2 → e1.loc = Loc.yA ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos2; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p4 : p1 = 3 → e1.loc = Loc.yB ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos3; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p5 : p1 = 4 → e1.loc = Loc.yA' ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos4; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e1p6 : p1 = 5 → e1.loc = Loc.yB' ∧ e1.op = OpType.rd := by
        rintro rfl; have h := hshape1.symm.trans hpos5; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p1 : p2 = 0 → e2.loc = Loc.yA ∧ e2.op = OpType.wt := by
        rintro rfl; have h := hshape2.symm.trans hpos0; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p2 : p2 = 1 → e2.loc = Loc.yB ∧ e2.op = OpType.wt := by
        rintro rfl; have h := hshape2.symm.trans hpos1; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p5 : p2 = 4 → e2.loc = Loc.yA' ∧ e2.op = OpType.rd := by
        rintro rfl; have h := hshape2.symm.trans hpos4; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have e2p6 : p2 = 5 → e2.loc = Loc.yB' ∧ e2.op = OpType.rd := by
        rintro rfl; have h := hshape2.symm.trans hpos5; injection h with h; injection h with a b
        exact ⟨a, b⟩
      have hp1lt2 : p1 < 2 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl | rfl
        · omega
        · omega
        · exact absurd ((e1p3 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p4 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p5 rfl).2.symm.trans hwt1) (by decide)
        · exact absurd ((e1p6 rfl).2.symm.trans hwt1) (by decide)
      have hp1cases' : p1 = 0 ∨ p1 = 1 := by omega
      have hp2cases' : p2 = 2 ∨ p2 = 3 ∨ p2 = 4 ∨ p2 = 5 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl | rfl
        · exact absurd ((e2p1 rfl).2.symm.trans hrd2) (by decide)
        · exact absurd ((e2p2 rfl).2.symm.trans hrd2) (by decide)
        · omega
        · omega
        · omega
        · omega
      have hp2lt4 : p2 < 4 := by
        rcases hp1cases' with rfl | rfl
        · have he1loc : e1.loc = Loc.yA := (e1p1 rfl).1
          rcases hp2cases' with rfl | rfl | rfl | rfl
          · omega
          · omega
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p5 rfl).1))
              (by decide : Loc.yA ≠ Loc.yA')
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p6 rfl).1))
              (by decide : Loc.yA ≠ Loc.yB')
        · have he1loc : e1.loc = Loc.yB := (e1p2 rfl).1
          rcases hp2cases' with rfl | rfl | rfl | rfl
          · omega
          · omega
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p5 rfl).1))
              (by decide : Loc.yB ≠ Loc.yA')
          · exact absurd (he1loc.symm.trans (hloc.trans (e2p6 rfl).1))
              (by decide : Loc.yB ≠ Loc.yB')
      have hn1n2 : n1 ≤ n2 := by
        obtain ⟨-, hidlt⟩ := hpo
        rw [hidPos1', hidPos2'] at hidlt
        omega
      have hp1lt4 : p1 < 4 := by omega
      rw [hrawIdx1', if_pos hp1lt4, hrawIdx2', if_pos hp2lt4]
      omega

/-- `GuessAY`'s block-0 shape: three writes (`yA`, `ellAyx`, `zAy'y`), no
reads. -/
def guessAYBlock0Shape : List (Loc × OpType) :=
  [(Loc.yA, .wt), (Loc.ellAyx, .wt), (Loc.zAy'y, .wt)]

theorem guessAYBlock0Elems_shape (I : PCPInstance) :
    ∀ v0 : Fin I.n,
      (guessAYBlock0Elems I v0).map (fun ev => (ev.1.loc, ev.1.op)) = guessAYBlock0Shape :=
  fun _ => rfl

/-- `GuessAY`'s shape for later blocks: three writes (`yA`, `ellAyx`, `zAy'y`)
then two reads (`zAxy`, `zAyy'`), of which `guessAYBlock0Shape` is a
prefix. -/
def guessAYBlockShape : List (Loc × OpType) :=
  [(Loc.yA, .wt), (Loc.ellAyx, .wt), (Loc.zAy'y, .wt), (Loc.zAxy, .rd), (Loc.zAyy', .rd)]

theorem guessAYBlockRestElems_shape (I : PCPInstance) :
    ∀ kw : Fin 4 × Option (Fin I.n),
      (guessAYBlockRestElems I kw).map (fun ev => (ev.1.loc, ev.1.op)) = guessAYBlockShape :=
  fun _ => rfl

theorem guessAYBlockShape_prefix :
    guessAYBlock0Shape = guessAYBlockShape.take guessAYBlock0Shape.length := by decide

theorem guessAYBlockShape_nodup : guessAYBlockShape.Nodup := by decide

/-- Lemma 3.4 for the threads skipping a first read for `GuessAY`. -/
theorem guessAY_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessAY) (he2 : e2 ∈ traceEventsOf trace Tid.guessAY)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 3 ≤ guessAYBlock0Shape.length := by decide
  have hshapewrites : ∀ p x, guessAYBlockShape[p]? = some (x, OpType.rd) → 3 ≤ p := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessAYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessAYBlockShape]
  have hshapewrites2 : ∀ p x, guessAYBlockShape[p]? = some (x, OpType.wt) → p < 3 := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessAYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessAYBlockShape]
  exact flatLoop_po_monotone_of_shape_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0) (guessAYBlockRestElems I)
    guessAYBlock0Shape guessAYBlockShape (fun _ => guessAYBlock0Elems_shape I v0)
    (guessAYBlockRestElems_shape I) guessAYBlockShape_prefix guessAYBlockShape_nodup 3 hWL
    hshapewrites hshapewrites2 trace (0, none) kws htrace he1 he2 hpo hwt2

/-- `ww_dec_2`'s closing step for `GuessAY`: along a `tracePo`-edge from a
read to a write, `rawIndex` increases by more than one. Both lie in later
blocks `n1 < n2` (the reads are at positions `≥ 3`, after the three writes),
with `rawIndex e1 = n1` and `rawIndex e2 = n2 + 1`. -/
theorem guessAY_po_monotone_read_gap (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessAY) (he2 : e2 ∈ traceEventsOf trace Tid.guessAY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hwt2 : e2.op = .wt) :
    rawIndex trace e1 + 1 < rawIndex trace e2 := by
  have hshapewrites : ∀ p x, guessAYBlockShape[p]? = some (x, OpType.rd) → 3 ≤ p := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessAYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessAYBlockShape]
  have hshapewrites2 : ∀ p x, guessAYBlockShape[p]? = some (x, OpType.wt) → p < 3 := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessAYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessAYBlockShape]
  have hB0len : guessAYBlock0Shape.length = 3 := by decide
  obtain h1 | ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula_skip (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0)
      (guessAYBlockRestElems I) guessAYBlock0Shape guessAYBlockShape
      (fun _ => guessAYBlock0Elems_shape I v0) (guessAYBlockRestElems_shape I)
      guessAYBlockShape_prefix guessAYBlockShape_nodup trace (0, none) kws htrace he1
  · exfalso
    obtain ⟨p1', hp1L', hidPos1', hrawIdx1', hshape1'⟩ := h1
    rw [hrd1] at hshape1'
    have hge3 := hshapewrites p1' e1.loc hshape1'
    have hlt3 : p1' < 3 := hB0len ▸ hp1L'
    omega
  · obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0)
        (guessAYBlockRestElems I) guessAYBlock0Shape guessAYBlockShape
        (fun _ => guessAYBlock0Elems_shape I v0) (guessAYBlockRestElems_shape I)
        guessAYBlockShape_prefix guessAYBlockShape_nodup trace (0, none) kws htrace he2
    · exfalso
      obtain ⟨p2', hp2L', hidPos2', _, _⟩ := h2
      obtain ⟨_, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · rw [hwt2] at hshape2
      have hw2 : p2 < 3 := hshapewrites2 p2 e2.loc hshape2
      rw [hrd1] at hshape1
      have hr1 : 3 ≤ p1 := hshapewrites p1 e1.loc hshape1
      set len0 : ℕ := guessAYBlock0Shape.length with hlen0
      set lenB : ℕ := guessAYBlockShape.length with hlenB
      have hcore := blockIndex_po_monotone
        (blockStart := fun n => len0 + n * lenB)
        (blockLen := fun _ => lenB) (writesLen := fun _ => 3)
        (fun n => by rw [Nat.succ_mul]; omega) hp1L hp2L hidPos1 hidPos2
        (fun _ => hr1) (fun _ => hw2) hpo hwt2
      have hrawIdx1' : rawIndex trace e1 = n1 := by
        have h3 : (3 : ℕ) = guessAYBlock0Shape.length := hB0len.symm
        rw [hrawIdx1, if_neg (h3 ▸ (by omega : ¬ p1 < 3))]
      have hrawIdx2' : rawIndex trace e2 = n2 + 1 := by
        have h3 : (3 : ℕ) = guessAYBlock0Shape.length := hB0len.symm
        rw [hrawIdx2, if_pos (h3 ▸ (by omega : p2 < 3))]
      have hn1n2 := hcore.2 hrd1
      omega

/-- Lemma 3.5 for `GuessAY`: its only non-bridge read location
is `zAyy'`, so `po`-edges between non-bridge reads are increasing. -/
theorem guessAY_reads_nondecreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessAY) (he2 : e2 ∈ traceEventsOf trace Tid.guessAY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hrd2 : e2.op = .rd)
    (hnb1 : ¬ e1.IsBridge) (hnb2 : ¬ e2.IsBridge)
    (hdec : rawIndex trace e2 < rawIndex trace e1) : False := by
  have hb0pos0 : guessAYBlock0Shape[0]? = some (Loc.yA, OpType.wt) := by decide
  have hb0pos1 : guessAYBlock0Shape[1]? = some (Loc.ellAyx, OpType.wt) := by decide
  have hb0pos2 : guessAYBlock0Shape[2]? = some (Loc.zAy'y, OpType.wt) := by decide
  have hpos0 : guessAYBlockShape[0]? = some (Loc.yA, OpType.wt) := by decide
  have hpos1 : guessAYBlockShape[1]? = some (Loc.ellAyx, OpType.wt) := by decide
  have hpos2 : guessAYBlockShape[2]? = some (Loc.zAy'y, OpType.wt) := by decide
  have hpos3 : guessAYBlockShape[3]? = some (Loc.zAxy, OpType.rd) := by decide
  have hpos4 : guessAYBlockShape[4]? = some (Loc.zAyy', OpType.rd) := by decide
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0) (guessAYBlockRestElems I)
    guessAYBlock0Shape guessAYBlockShape (fun _ => guessAYBlock0Elems_shape I v0)
    (guessAYBlockRestElems_shape I) guessAYBlockShape_prefix guessAYBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0) (guessAYBlockRestElems I)
    guessAYBlock0Shape guessAYBlockShape (fun _ => guessAYBlock0Elems_shape I v0)
    (guessAYBlockRestElems_shape I) guessAYBlockShape_prefix guessAYBlockShape_nodup
    trace (0, none) kws htrace he2
  rcases h1 with ⟨p1', hp1'3, hidPos1', hrawIdx1', hshape1'⟩ |
      ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
  · have hp1'3' : p1' < 3 := hp1'3
    have hp1cases : p1' = 0 ∨ p1' = 1 ∨ p1' = 2 := by omega
    rcases hp1cases with rfl | rfl | rfl
    · have h := hshape1'.symm.trans hb0pos0
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1'.symm.trans hb0pos1
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1'.symm.trans hb0pos2
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
  · rcases h2 with ⟨p2', hp2'3, hidPos2', hrawIdx2', hshape2'⟩ |
        ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · have hp2'3' : p2' < 3 := hp2'3
      have hp2cases : p2' = 0 ∨ p2' = 1 ∨ p2' = 2 := by omega
      rcases hp2cases with rfl | rfl | rfl
      · have h := hshape2'.symm.trans hb0pos0
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
      · have h := hshape2'.symm.trans hb0pos1
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
      · have h := hshape2'.symm.trans hb0pos2
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
    · have hp1L' : p1 < 5 := hp1L
      have hp2L' : p2 < 5 := hp2L
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 := by omega
      have e1p3 : p1 = 3 → e1.loc = Loc.zAxy := by
        rintro rfl
        have h := hshape1.symm.trans hpos3
        injection h with h; injection h with a _
      have e1p4 : p1 = 4 → e1.loc = Loc.zAyy' := by
        rintro rfl
        have h := hshape1.symm.trans hpos4
        injection h with h; injection h with a _
      have e2p3 : p2 = 3 → e2.loc = Loc.zAxy := by
        rintro rfl
        have h := hshape2.symm.trans hpos3
        injection h with h; injection h with a _
      have e2p4 : p2 = 4 → e2.loc = Loc.zAyy' := by
        rintro rfl
        have h := hshape2.symm.trans hpos4
        injection h with h; injection h with a _
      have hp1eq : p1 = 3 ∨ p1 = 4 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape1.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact Or.inl rfl
        · exact Or.inr rfl
      have hp2eq : p2 = 3 ∨ p2 = 4 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape2.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact absurd (hshape2.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact absurd (hshape2.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact Or.inl rfl
        · exact Or.inr rfl
      have hzAxybridge : Loc.zAxy ∈ BridgeLoc := by decide
      have hp1val : p1 = 4 := by
        rcases hp1eq with h | h
        · exfalso
          have heq := e1p3 h
          have hbridge : e1.loc ∈ BridgeLoc := by rw [heq]; exact hzAxybridge
          exact hnb1 hbridge
        · exact h
      have hp2val : p2 = 4 := by
        rcases hp2eq with h | h
        · exfalso
          have heq := e2p3 h
          have hbridge : e2.loc ∈ BridgeLoc := by rw [heq]; exact hzAxybridge
          exact hnb2 hbridge
        · exact h
      have heloc : e1.loc = e2.loc := (e1p4 hp1val).trans (e2p4 hp2val).symm
      have heop : e1.op = e2.op := hrd1.trans hrd2.symm
      exact absurd (rawIndex_lt_of_tracePo_sameLocOp he1 he2 hpo heloc heop) (by omega)

/-- The bridge counterpart of Lemma 3.4 for `GuessAY`, from
the proof of Lemma 3.6 in Section 3.5 ("Pairs `{g_α^x,g_α^y}` and
`{g_β^x,g_β^y}`"): "`g_α^y` alternates writes to `ellAyx` and reads from
`zAxy`, and additionally skips the first read to `zAxy`. Therefore, po-edges
of the form `r(g_α^y,zAxy) → w(g_α^y,ellAyx)` are also increasing." The read
is in later block `n1` (`rawIndex n1`), and the write in a later block
`n2 ≥ n1 + 1` (`rawIndex n2 + 1`). -/
theorem guessAY_bridge_rw_increasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessAY) (he2 : e2 ∈ traceEventsOf trace Tid.guessAY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hwt2 : e2.op = .wt)
    (hb1 : e1.IsBridge) (hb2 : e2.IsBridge) :
    rawIndex trace e1 < rawIndex trace e2 := by
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0) (guessAYBlockRestElems I)
    guessAYBlock0Shape guessAYBlockShape (fun _ => guessAYBlock0Elems_shape I v0)
    (guessAYBlockRestElems_shape I) guessAYBlockShape_prefix guessAYBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessAYBlock0Elems I v0) (guessAYBlockRestElems I)
    guessAYBlock0Shape guessAYBlockShape (fun _ => guessAYBlock0Elems_shape I v0)
    (guessAYBlockRestElems_shape I) guessAYBlockShape_prefix guessAYBlockShape_nodup
    trace (0, none) kws htrace he2
  have hb0pos0 : guessAYBlock0Shape[0]? = some (Loc.yA, OpType.wt) := by decide
  have hb0pos1 : guessAYBlock0Shape[1]? = some (Loc.ellAyx, OpType.wt) := by decide
  have hb0pos2 : guessAYBlock0Shape[2]? = some (Loc.zAy'y, OpType.wt) := by decide
  have hpos0 : guessAYBlockShape[0]? = some (Loc.yA, OpType.wt) := by decide
  have hpos1 : guessAYBlockShape[1]? = some (Loc.ellAyx, OpType.wt) := by decide
  have hpos2 : guessAYBlockShape[2]? = some (Loc.zAy'y, OpType.wt) := by decide
  have hpos3 : guessAYBlockShape[3]? = some (Loc.zAxy, OpType.rd) := by decide
  have hpos4 : guessAYBlockShape[4]? = some (Loc.zAyy', OpType.rd) := by decide
  have hzAyy'bridge : Loc.zAyy' ∉ BridgeLoc := by decide
  have hyAbridge : Loc.yA ∉ BridgeLoc := by decide
  have hzAyy'Pbridge : Loc.zAy'y ∉ BridgeLoc := by decide
  have hn1p1 : ∃ n1, idPos e1 = 3 + n1 * 5 + 3 ∧ rawIndex trace e1 = n1 := by
    rcases h1 with ⟨p1', hp1'3, hidPos1', hrawIdx1', hshape1'⟩ |
        ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
    · exfalso
      have hp1'3' : p1' < 3 := hp1'3
      have hp1cases : p1' = 0 ∨ p1' = 1 ∨ p1' = 2 := by omega
      rcases hp1cases with rfl | rfl | rfl
      · have h := hshape1'.symm.trans hb0pos0
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
      · have h := hshape1'.symm.trans hb0pos1
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
      · have h := hshape1'.symm.trans hb0pos2
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have hp1L' : p1 < 5 := hp1L
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 := by omega
      have hp1eq3 : p1 = 3 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape1.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · rfl
        · exfalso
          have h := hshape1.symm.trans hpos4
          injection h with h; injection h with a _
          exact hzAyy'bridge (a ▸ hb1)
      subst hp1eq3
      exact ⟨n1, hidPos1, hrawIdx1⟩
  have hn2p2 : (idPos e2 = 1 ∧ rawIndex trace e2 = 0) ∨
      (∃ n2, idPos e2 = 3 + n2 * 5 + 1 ∧ rawIndex trace e2 = n2 + 1) := by
    rcases h2 with ⟨p2', hp2'3, hidPos2', hrawIdx2', hshape2'⟩ |
        ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · have hp2'3' : p2' < 3 := hp2'3
      have hp2cases : p2' = 0 ∨ p2' = 1 ∨ p2' = 2 := by omega
      left
      rcases hp2cases with rfl | rfl | rfl
      · exfalso
        have h := hshape2'.symm.trans hb0pos0
        injection h with h; injection h with a _
        exact hyAbridge (a ▸ hb2)
      · exact ⟨hidPos2', hrawIdx2'⟩
      · exfalso
        have h := hshape2'.symm.trans hb0pos2
        injection h with h; injection h with a _
        exact hzAyy'Pbridge (a ▸ hb2)
    · have hp2L' : p2 < 5 := hp2L
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 := by omega
      have hp2eq1 : p2 = 1 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl
        · exfalso
          have h := hshape2.symm.trans hpos0
          injection h with h; injection h with a _
          exact hyAbridge (a ▸ hb2)
        · rfl
        · exfalso
          have h := hshape2.symm.trans hpos2
          injection h with h; injection h with a _
          exact hzAyy'Pbridge (a ▸ hb2)
        · exact absurd (hshape2.symm.trans hpos3 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hwt2) (by decide))
        · exact absurd (hshape2.symm.trans hpos4 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hwt2) (by decide))
      subst hp2eq1
      right
      exact ⟨n2, hidPos2, hrawIdx2⟩
  obtain ⟨n1, hidPos1, hrawIdx1⟩ := hn1p1
  have hidlt : idPos e1 < idPos e2 := hpo.2
  rcases hn2p2 with ⟨hidPos2, hrawIdx2⟩ | ⟨n2, hidPos2, hrawIdx2⟩
  · omega
  · omega


/-- `GuessBY`'s block-0 shape: three writes (`yB`, `ellByx`, `zBy'y`), no
reads. -/
def guessBYBlock0Shape : List (Loc × OpType) :=
  [(Loc.yB, .wt), (Loc.ellByx, .wt), (Loc.zBy'y, .wt)]

theorem guessBYBlock0Elems_shape (I : PCPInstance) :
    ∀ v0 : Fin I.n,
      (guessBYBlock0Elems I v0).map (fun ev => (ev.1.loc, ev.1.op)) = guessBYBlock0Shape :=
  fun _ => rfl

/-- `GuessBY`'s shape for later blocks: three writes (`yB`, `ellByx`, `zBy'y`)
then two reads (`zBxy`, `zByy'`). -/
def guessBYBlockShape : List (Loc × OpType) :=
  [(Loc.yB, .wt), (Loc.ellByx, .wt), (Loc.zBy'y, .wt), (Loc.zBxy, .rd), (Loc.zByy', .rd)]

theorem guessBYBlockRestElems_shape (I : PCPInstance) :
    ∀ kw : Fin 4 × Option (Fin I.n),
      (guessBYBlockRestElems I kw).map (fun ev => (ev.1.loc, ev.1.op)) = guessBYBlockShape :=
  fun _ => rfl

theorem guessBYBlockShape_prefix :
    guessBYBlock0Shape = guessBYBlockShape.take guessBYBlock0Shape.length := by decide

theorem guessBYBlockShape_nodup : guessBYBlockShape.Nodup := by decide

/-- Lemma 3.4 for the threads skipping a first read for `GuessBY`. -/
theorem guessBY_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessBY) (he2 : e2 ∈ traceEventsOf trace Tid.guessBY)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 3 ≤ guessBYBlock0Shape.length := by decide
  have hshapewrites : ∀ p x, guessBYBlockShape[p]? = some (x, OpType.rd) → 3 ≤ p := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessBYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessBYBlockShape]
  have hshapewrites2 : ∀ p x, guessBYBlockShape[p]? = some (x, OpType.wt) → p < 3 := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessBYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessBYBlockShape]
  exact flatLoop_po_monotone_of_shape_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0) (guessBYBlockRestElems I)
    guessBYBlock0Shape guessBYBlockShape (fun _ => guessBYBlock0Elems_shape I v0)
    (guessBYBlockRestElems_shape I) guessBYBlockShape_prefix guessBYBlockShape_nodup 3 hWL
    hshapewrites hshapewrites2 trace (0, none) kws htrace he1 he2 hpo hwt2

/-- `ww_dec_2`'s closing step for `GuessBY` (as
`guessAY_po_monotone_read_gap`). -/
theorem guessBY_po_monotone_read_gap (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessBY) (he2 : e2 ∈ traceEventsOf trace Tid.guessBY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hwt2 : e2.op = .wt) :
    rawIndex trace e1 + 1 < rawIndex trace e2 := by
  have hshapewrites : ∀ p x, guessBYBlockShape[p]? = some (x, OpType.rd) → 3 ≤ p := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessBYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessBYBlockShape]
  have hshapewrites2 : ∀ p x, guessBYBlockShape[p]? = some (x, OpType.wt) → p < 3 := by
    intro p x hpx
    have h5 := blockShapeLen_lt (N := 5) (shape := guessBYBlockShape) rfl p hpx
    have : p = 0 ∨ p = 1 ∨ p = 2 ∨ p = 3 ∨ p = 4 := by omega
    rcases this with rfl | rfl | rfl | rfl | rfl <;> simp_all [guessBYBlockShape]
  have hB0len : guessBYBlock0Shape.length = 3 := by decide
  obtain h1 | ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula_skip (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0)
      (guessBYBlockRestElems I) guessBYBlock0Shape guessBYBlockShape
      (fun _ => guessBYBlock0Elems_shape I v0) (guessBYBlockRestElems_shape I)
      guessBYBlockShape_prefix guessBYBlockShape_nodup trace (0, none) kws htrace he1
  · exfalso
    obtain ⟨p1', hp1L', hidPos1', hrawIdx1', hshape1'⟩ := h1
    rw [hrd1] at hshape1'
    have hge3 := hshapewrites p1' e1.loc hshape1'
    have hlt3 : p1' < 3 := hB0len ▸ hp1L'
    omega
  · obtain h2 | ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
      flatLoop_index_formula_skip (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0)
        (guessBYBlockRestElems I) guessBYBlock0Shape guessBYBlockShape
        (fun _ => guessBYBlock0Elems_shape I v0) (guessBYBlockRestElems_shape I)
        guessBYBlockShape_prefix guessBYBlockShape_nodup trace (0, none) kws htrace he2
    · exfalso
      obtain ⟨p2', hp2L', hidPos2', _, _⟩ := h2
      obtain ⟨_, hidlt⟩ := hpo
      rw [hidPos1, hidPos2'] at hidlt
      omega
    · rw [hwt2] at hshape2
      have hw2 : p2 < 3 := hshapewrites2 p2 e2.loc hshape2
      rw [hrd1] at hshape1
      have hr1 : 3 ≤ p1 := hshapewrites p1 e1.loc hshape1
      set len0 : ℕ := guessBYBlock0Shape.length with hlen0
      set lenB : ℕ := guessBYBlockShape.length with hlenB
      have hcore := blockIndex_po_monotone
        (blockStart := fun n => len0 + n * lenB)
        (blockLen := fun _ => lenB) (writesLen := fun _ => 3)
        (fun n => by rw [Nat.succ_mul]; omega) hp1L hp2L hidPos1 hidPos2
        (fun _ => hr1) (fun _ => hw2) hpo hwt2
      have hrawIdx1' : rawIndex trace e1 = n1 := by
        have h3 : (3 : ℕ) = guessBYBlock0Shape.length := hB0len.symm
        rw [hrawIdx1, if_neg (h3 ▸ (by omega : ¬ p1 < 3))]
      have hrawIdx2' : rawIndex trace e2 = n2 + 1 := by
        have h3 : (3 : ℕ) = guessBYBlock0Shape.length := hB0len.symm
        rw [hrawIdx2, if_pos (h3 ▸ (by omega : p2 < 3))]
      have hn1n2 := hcore.2 hrd1
      omega

/-- Lemma 3.5 for `GuessBY`: its only non-bridge read location
is `zByy'`. -/
theorem guessBY_reads_nondecreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessBY) (he2 : e2 ∈ traceEventsOf trace Tid.guessBY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hrd2 : e2.op = .rd)
    (hnb1 : ¬ e1.IsBridge) (hnb2 : ¬ e2.IsBridge)
    (hdec : rawIndex trace e2 < rawIndex trace e1) : False := by
  have hb0pos0 : guessBYBlock0Shape[0]? = some (Loc.yB, OpType.wt) := by decide
  have hb0pos1 : guessBYBlock0Shape[1]? = some (Loc.ellByx, OpType.wt) := by decide
  have hb0pos2 : guessBYBlock0Shape[2]? = some (Loc.zBy'y, OpType.wt) := by decide
  have hpos0 : guessBYBlockShape[0]? = some (Loc.yB, OpType.wt) := by decide
  have hpos1 : guessBYBlockShape[1]? = some (Loc.ellByx, OpType.wt) := by decide
  have hpos2 : guessBYBlockShape[2]? = some (Loc.zBy'y, OpType.wt) := by decide
  have hpos3 : guessBYBlockShape[3]? = some (Loc.zBxy, OpType.rd) := by decide
  have hpos4 : guessBYBlockShape[4]? = some (Loc.zByy', OpType.rd) := by decide
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0) (guessBYBlockRestElems I)
    guessBYBlock0Shape guessBYBlockShape (fun _ => guessBYBlock0Elems_shape I v0)
    (guessBYBlockRestElems_shape I) guessBYBlockShape_prefix guessBYBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0) (guessBYBlockRestElems I)
    guessBYBlock0Shape guessBYBlockShape (fun _ => guessBYBlock0Elems_shape I v0)
    (guessBYBlockRestElems_shape I) guessBYBlockShape_prefix guessBYBlockShape_nodup
    trace (0, none) kws htrace he2
  rcases h1 with ⟨p1', hp1'3, hidPos1', hrawIdx1', hshape1'⟩ |
      ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
  · have hp1'3' : p1' < 3 := hp1'3
    have hp1cases : p1' = 0 ∨ p1' = 1 ∨ p1' = 2 := by omega
    rcases hp1cases with rfl | rfl | rfl
    · have h := hshape1'.symm.trans hb0pos0
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1'.symm.trans hb0pos1
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1'.symm.trans hb0pos2
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
  · rcases h2 with ⟨p2', hp2'3, hidPos2', hrawIdx2', hshape2'⟩ |
        ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · have hp2'3' : p2' < 3 := hp2'3
      have hp2cases : p2' = 0 ∨ p2' = 1 ∨ p2' = 2 := by omega
      rcases hp2cases with rfl | rfl | rfl
      · have h := hshape2'.symm.trans hb0pos0
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
      · have h := hshape2'.symm.trans hb0pos1
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
      · have h := hshape2'.symm.trans hb0pos2
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd2) (by decide)
    · have hp1L' : p1 < 5 := hp1L
      have hp2L' : p2 < 5 := hp2L
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 := by omega
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 := by omega
      have e1p3 : p1 = 3 → e1.loc = Loc.zBxy := by
        rintro rfl
        have h := hshape1.symm.trans hpos3
        injection h with h; injection h with a _
      have e1p4 : p1 = 4 → e1.loc = Loc.zByy' := by
        rintro rfl
        have h := hshape1.symm.trans hpos4
        injection h with h; injection h with a _
      have e2p3 : p2 = 3 → e2.loc = Loc.zBxy := by
        rintro rfl
        have h := hshape2.symm.trans hpos3
        injection h with h; injection h with a _
      have e2p4 : p2 = 4 → e2.loc = Loc.zByy' := by
        rintro rfl
        have h := hshape2.symm.trans hpos4
        injection h with h; injection h with a _
      have hp1eq : p1 = 3 ∨ p1 = 4 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape1.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd1) (by decide))
        · exact Or.inl rfl
        · exact Or.inr rfl
      have hp2eq : p2 = 3 ∨ p2 = 4 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape2.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact absurd (hshape2.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact absurd (hshape2.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; 
            injection h with _ b; exact absurd (b.trans hrd2) (by decide))
        · exact Or.inl rfl
        · exact Or.inr rfl
      have hzBxybridge : Loc.zBxy ∈ BridgeLoc := by decide
      have hp1val : p1 = 4 := by
        rcases hp1eq with h | h
        · exfalso
          have heq := e1p3 h
          have hbridge : e1.loc ∈ BridgeLoc := by rw [heq]; exact hzBxybridge
          exact hnb1 hbridge
        · exact h
      have hp2val : p2 = 4 := by
        rcases hp2eq with h | h
        · exfalso
          have heq := e2p3 h
          have hbridge : e2.loc ∈ BridgeLoc := by rw [heq]; exact hzBxybridge
          exact hnb2 hbridge
        · exact h
      have heloc : e1.loc = e2.loc := (e1p4 hp1val).trans (e2p4 hp2val).symm
      have heop : e1.op = e2.op := hrd1.trans hrd2.symm
      exact absurd (rawIndex_lt_of_tracePo_sameLocOp he1 he2 hpo heloc heop) (by omega)

/-- The bridge counterpart of Lemma 3.4 for `GuessBY`: "`g_β^y`
alternates writes to `ellByx` and reads from `zBxy`, additionally skipping
the first read". -/
theorem guessBY_bridge_rw_increasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.guessBY) (he2 : e2 ∈ traceEventsOf trace Tid.guessBY)
    (hpo : tracePo e1 e2) (hrd1 : e1.op = .rd) (hwt2 : e2.op = .wt)
    (hb1 : e1.IsBridge) (hb2 : e2.IsBridge) :
    rawIndex trace e1 < rawIndex trace e2 := by
  have h1 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0) (guessBYBlockRestElems I)
    guessBYBlock0Shape guessBYBlockShape (fun _ => guessBYBlock0Elems_shape I v0)
    (guessBYBlockRestElems_shape I) guessBYBlockShape_prefix guessBYBlockShape_nodup
    trace (0, none) kws htrace he1
  have h2 := flatLoop_index_formula_skip
    (fun (_ : Fin 4 × Option (Fin I.n)) => guessBYBlock0Elems I v0) (guessBYBlockRestElems I)
    guessBYBlock0Shape guessBYBlockShape (fun _ => guessBYBlock0Elems_shape I v0)
    (guessBYBlockRestElems_shape I) guessBYBlockShape_prefix guessBYBlockShape_nodup
    trace (0, none) kws htrace he2
  have hb0pos0 : guessBYBlock0Shape[0]? = some (Loc.yB, OpType.wt) := by decide
  have hb0pos1 : guessBYBlock0Shape[1]? = some (Loc.ellByx, OpType.wt) := by decide
  have hb0pos2 : guessBYBlock0Shape[2]? = some (Loc.zBy'y, OpType.wt) := by decide
  have hpos0 : guessBYBlockShape[0]? = some (Loc.yB, OpType.wt) := by decide
  have hpos1 : guessBYBlockShape[1]? = some (Loc.ellByx, OpType.wt) := by decide
  have hpos2 : guessBYBlockShape[2]? = some (Loc.zBy'y, OpType.wt) := by decide
  have hpos3 : guessBYBlockShape[3]? = some (Loc.zBxy, OpType.rd) := by decide
  have hpos4 : guessBYBlockShape[4]? = some (Loc.zByy', OpType.rd) := by decide
  have hzByy'bridge : Loc.zByy' ∉ BridgeLoc := by decide
  have hyBbridge : Loc.yB ∉ BridgeLoc := by decide
  have hzByy'Pbridge : Loc.zBy'y ∉ BridgeLoc := by decide
  have hn1p1 : ∃ n1, idPos e1 = 3 + n1 * 5 + 3 ∧ rawIndex trace e1 = n1 := by
    rcases h1 with ⟨p1', hp1'3, hidPos1', hrawIdx1', hshape1'⟩ |
        ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩
    · exfalso
      have hp1'3' : p1' < 3 := hp1'3
      have hp1cases : p1' = 0 ∨ p1' = 1 ∨ p1' = 2 := by omega
      rcases hp1cases with rfl | rfl | rfl
      · have h := hshape1'.symm.trans hb0pos0
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
      · have h := hshape1'.symm.trans hb0pos1
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
      · have h := hshape1'.symm.trans hb0pos2
        injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have hp1L' : p1 < 5 := hp1L
      have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 ∨ p1 = 3 ∨ p1 = 4 := by omega
      have hp1eq3 : p1 = 3 := by
        rcases hp1cases with rfl | rfl | rfl | rfl | rfl
        · exact absurd (hshape1.symm.trans hpos0 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos1 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · exact absurd (hshape1.symm.trans hpos2 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hrd1) (by decide))
        · rfl
        · exfalso
          have h := hshape1.symm.trans hpos4
          injection h with h; injection h with a _
          exact hzByy'bridge (a ▸ hb1)
      subst hp1eq3
      exact ⟨n1, hidPos1, hrawIdx1⟩
  have hn2p2 : (idPos e2 = 1 ∧ rawIndex trace e2 = 0) ∨
      (∃ n2, idPos e2 = 3 + n2 * 5 + 1 ∧ rawIndex trace e2 = n2 + 1) := by
    rcases h2 with ⟨p2', hp2'3, hidPos2', hrawIdx2', hshape2'⟩ |
        ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩
    · have hp2'3' : p2' < 3 := hp2'3
      have hp2cases : p2' = 0 ∨ p2' = 1 ∨ p2' = 2 := by omega
      left
      rcases hp2cases with rfl | rfl | rfl
      · exfalso
        have h := hshape2'.symm.trans hb0pos0
        injection h with h; injection h with a _
        exact hyBbridge (a ▸ hb2)
      · exact ⟨hidPos2', hrawIdx2'⟩
      · exfalso
        have h := hshape2'.symm.trans hb0pos2
        injection h with h; injection h with a _
        exact hzByy'Pbridge (a ▸ hb2)
    · have hp2L' : p2 < 5 := hp2L
      have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 ∨ p2 = 3 ∨ p2 = 4 := by omega
      have hp2eq1 : p2 = 1 := by
        rcases hp2cases with rfl | rfl | rfl | rfl | rfl
        · exfalso
          have h := hshape2.symm.trans hpos0
          injection h with h; injection h with a _
          exact hyBbridge (a ▸ hb2)
        · rfl
        · exfalso
          have h := hshape2.symm.trans hpos2
          injection h with h; injection h with a _
          exact hzByy'Pbridge (a ▸ hb2)
        · exact absurd (hshape2.symm.trans hpos3 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hwt2) (by decide))
        · exact absurd (hshape2.symm.trans hpos4 |>.symm) (by
            intro h; injection h with h; injection h with _ b
            exact absurd (b.trans hwt2) (by decide))
      subst hp2eq1
      right
      exact ⟨n2, hidPos2, hrawIdx2⟩
  obtain ⟨n1, hidPos1, hrawIdx1⟩ := hn1p1
  have hidlt : idPos e1 < idPos e2 := hpo.2
  rcases hn2p2 with ⟨hidPos2, hrawIdx2⟩ | ⟨n2, hidPos2, hrawIdx2⟩
  · omega
  · omega


/-! ## `GuessAX` (`g_α^x`)

`GuessAX`'s outer loop contains an inner `for` loop whose number of iterations
`|α_{aux}|` depends on `aux`. The `First()` of the inner body is never reset,
so only the thread's first inner call skips its `zAxx'` read. -/

/-- `GuessAX`'s inner `for` loop, as the `Command.whileLoop` of
`Command.forLoop` (without the preamble `j ← 1; N ← alphaLen`). -/
def guessAXInnerLoop (I : PCPInstance) : Command (domainOf I) (GuessAX.Vocab I) :=
  Command.whileLoop GuessAX.BExpr.jLeN
    (Command.seq (GuessAX.innerBody I) (Command.assign GuessAX.Vars.j GuessAX.Expr.jIncr))

/-- One iteration of `guessAXInnerLoop` with `fst = false` (every inner call
but the first): emits `w(xA)`, `w(zAx'x)`, `r(zAxx')` and returns to the inner
loop with `cnt` and `j` incremented; the resolution is untouched. Fourteen
`Command.RunStep`s. -/
theorem guessAX_innerLoop_rest_step (I : PCPInstance) (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store)
    (hguard : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ = true)
    (hfst : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (k : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl k)) :
    ∃ (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      φ' GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) ∧
      φ' GuessAX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) ∧
      φ' GuessAX.Vars.j = GuessAX.eval I GuessAX.Expr.jIncr φ ∧
      φ' GuessAX.Vars.aux = φ GuessAX.Vars.aux ∧
      φ' GuessAX.Vars.cntY = φ GuessAX.Vars.cntY ∧
      φ' GuessAX.Vars.N = φ GuessAX.Vars.N ∧
      Command.Run Tid.guessAX rest
        (guessAXInnerLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessAX Loc.xA
            (Val.xTag (Tid.guessAX, false)
              (GuessAX.jthLetter I (GuessAX.auxOf I φ) (GuessAX.jOf I φ))),
            rfl⟩
        , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x (Val.cnt (k + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.guessAX Loc.zAxx' (Val.cnt k), rfl⟩ ]
        cLast rest (guessAXInnerLoop I, φ') := by
  set φ1 : (GuessAX.Vocab I).Store :=
    Function.update φ GuessAX.Vars.prev (GuessAX.eval I GuessAX.Expr.readCnt φ) with hφ1
  set φ2 : (GuessAX.Vocab I).Store :=
    Function.update φ1 GuessAX.Vars.cnt (GuessAX.eval I GuessAX.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 GuessAX.Vars.cnt = φ GuessAX.Vars.cnt := rfl
  have hcntOf_φ1 : GuessAX.cntOf I φ1 = k := by
    simp only [GuessAX.cntOf, hcnt_φ1, hcnt0]
  have hcnt2eq : φ2 GuessAX.Vars.cnt = GuessAX.eval I GuessAX.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2raw : φ2 GuessAX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) := by
    simp only [hcnt2eq, GuessAX.eval, hcntOf_φ1]; rfl
  have hguard' : GuessAX.evalB I GuessAX.BExpr.jLeN φ = true := hguard
  have hne_prev_cnt : GuessAX.Vars.prev ≠ GuessAX.Vars.cnt := by decide
  have hprev_φ1 : GuessAX.prevOf I φ1 = k := by
    simp only [hφ1, GuessAX.prevOf, GuessAX.eval, hcnt0]; rfl
  have hprev_φ2 : GuessAX.prevOf I φ2 = k := by
    have h1' : φ2 GuessAX.Vars.prev = φ1 GuessAX.Vars.prev := Function.update_of_ne hne_prev_cnt _ _
    simp only [GuessAX.prevOf, h1']
    exact hprev_φ1
  have hne_fst_cnt : GuessAX.Vars.fst ≠ GuessAX.Vars.cnt := by decide
  have hne_fst_prev : GuessAX.Vars.fst ≠ GuessAX.Vars.prev := by decide
  have hfst_φ1 : φ1 GuessAX.Vars.fst = φ GuessAX.Vars.fst := rfl
  have hfst2 : φ2 GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) := by
    have h1' : φ2 GuessAX.Vars.fst = φ1 GuessAX.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have hisFirst2 : (GuessAX.Vocab I).evalB GuessAX.BExpr.isFirst φ2 = false := by
    simp [GuessAX.Vocab, GuessAX.evalB, hfst2]
  have hisFirst2' : GuessAX.evalB I GuessAX.BExpr.isFirst φ2 = false := hisFirst2
  have hne_aux_cnt : GuessAX.Vars.aux ≠ GuessAX.Vars.cnt := by decide
  have hne_aux_prev : GuessAX.Vars.aux ≠ GuessAX.Vars.prev := by decide
  have haux_φ2 : φ2 GuessAX.Vars.aux = φ GuessAX.Vars.aux := by
    have h1' : φ2 GuessAX.Vars.aux = φ1 GuessAX.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    have h2' : φ1 GuessAX.Vars.aux = φ GuessAX.Vars.aux := Function.update_of_ne hne_aux_prev _ _
    rw [h1', h2']
  have hj_φ2 : GuessAX.jOf I φ2 = GuessAX.jOf I φ := by
    have hne1 : GuessAX.Vars.j ≠ GuessAX.Vars.cnt := by decide
    have hne2 : GuessAX.Vars.j ≠ GuessAX.Vars.prev := by decide
    have h1' : φ2 GuessAX.Vars.j = φ1 GuessAX.Vars.j := Function.update_of_ne hne1 _ _
    have h2' : φ1 GuessAX.Vars.j = φ GuessAX.Vars.j := Function.update_of_ne hne2 _ _
    simp only [GuessAX.jOf, h1', h2']
  have hxTagRest2 : (GuessAX.Vocab I).evalV GuessAX.VExpr.xTagRest φ2 =
      Val.xTag (Tid.guessAX, false)
        (GuessAX.jthLetter I (GuessAX.auxOf I φ) (GuessAX.jOf I φ)) := by
    simp only [GuessAX.Vocab, GuessAX.evalV, GuessAX.auxOf, haux_φ2, hj_φ2]; rfl
  have hcntVal2 : (GuessAX.Vocab I).evalV GuessAX.VExpr.cntVal φ2 = Val.cnt (k + 1) := by
    have hcnt2 : GuessAX.cntOf I φ2 = k + 1 := by simp only [GuessAX.cntOf, hcnt2raw]
    simp only [GuessAX.Vocab, GuessAX.evalV, hcnt2]; rfl
  have hprevVal2 : (GuessAX.Vocab I).evalV GuessAX.VExpr.prevVal φ2 = Val.cnt k := by
    simp only [GuessAX.Vocab, GuessAX.evalV, hprev_φ2]; rfl
  have h1 : Command.RunStep Tid.guessAX rest none (guessAXInnerLoop I, φ) rest
      (Command.loopSeq (Command.seq (GuessAX.innerBody I)
        (Command.assign GuessAX.Vars.j GuessAX.Expr.jIncr)) (guessAXInnerLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [guessAXInnerLoop, Command.step, GuessAX.Vocab, hguard', if_true])
  have h2 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq (Command.seq (GuessAX.innerBody I)
        (Command.assign GuessAX.Vars.j GuessAX.Expr.jIncr)) (guessAXInnerLoop I), φ) rest
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.assign GuessAX.Vars.cnt GuessAX.Expr.nextCnt)
          (Command.ite GuessAX.BExpr.isFirst
            (Command.seq (Command.assign GuessAX.Vars.fst GuessAX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagFirst)
                (Command.write Loc.zAx'x GuessAX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zAx'x GuessAX.VExpr.cntVal)
                (Command.read Loc.zAxx' GuessAX.VExpr.prevVal))))))
        (Command.assign GuessAX.Vars.j GuessAX.Expr.jIncr)) (guessAXInnerLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [GuessAX.innerBody, Command.firstIt, Command.step, GuessAX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.guessAX rest none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.assign GuessAX.Vars.cnt GuessAX.Expr.nextCnt)
          (Command.ite GuessAX.BExpr.isFirst
            (Command.seq (Command.assign GuessAX.Vars.fst GuessAX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagFirst)
                (Command.write Loc.zAx'x GuessAX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zAx'x GuessAX.VExpr.cntVal)
                (Command.read Loc.zAxx' GuessAX.VExpr.prevVal))))))
        (Command.assign GuessAX.Vars.j GuessAX.Expr.jIncr)) (guessAXInnerLoop I), φ1) rest
      (Command.loopSeq (Command.seq
        (Command.seq (Command.assign GuessAX.Vars.cnt GuessAX.Expr.nextCnt)
          (Command.ite GuessAX.BExpr.isFirst
            (Command.seq (Command.assign GuessAX.Vars.fst GuessAX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagFirst)
                (Command.write Loc.zAx'x GuessAX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xA GuessAX.VExpr.xTagRest)
