      (by
        intro a q b hq hget
        have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
        have hq4 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessAYYAWritePred
        · exact yAWritePredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
        · exact yAWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
        · exact yAWritePredCore_false_of_ne Loc.zAxy OpType.rd (by decide)
        · exact yAWritePredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
      kws 3 j kw hkw
    have hzipj :
        ((guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYYAWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 3 + j * 5 + 0) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
      (l := guessAYBlockWord I v0 kws) htrace hpredL hzipj
    have hraw : rawNthEvent trace Tid.guessAY Loc.yA OpType.wt i = some ew := h
    rw [hraw] at hconn
    refine ⟨kw, hkw, by omega, ?_⟩
    injection hconn with hconn
    rw [hconn]; rfl

/-- `checkY`'s `yA`-read predicate, lifted from `yAReadPredCore`. -/
def checkYYAReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) : Bool :=
  yAReadPredCore lab.1.loc lab.1.op

theorem checkYYAReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) :
    checkYYAReadPred I lab = true ↔ (lab.1.loc = Loc.yA ∧ lab.1.op = OpType.rd) := by
  unfold checkYYAReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yAReadPredCore_iff y z

/-- `checkYBlock0Elems` has one `yA`-read, at offset `2`. -/
theorem checkYBlock0Elems_yA_read_filter (I : PCPInstance) (v0 : (Fin I.n)) :
    (checkYBlock0Elems I v0).filter (checkYYAReadPred I) =
      [(⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)] := by
  apply list_filter_singleton_of_unique' (checkYBlock0Elems I v0) (checkYYAReadPred I) 2
    (⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩)
    rfl
    (by unfold checkYYAReadPred; exact (yAReadPredCore_iff Loc.yA OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 0 ∨ q = 1 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYAReadPred
      · exact yAReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yAReadPredCore_false_of_ne Loc.yB OpType.rd (by decide))

/-- `checkYBlockRestElems` has one `yA`-read per entry of `kws`. -/
theorem checkYBlockRestElems_yA_read_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYAReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkYBlockRestElems I kw) ++ kws.flatMap (checkYBlockRestElems I)).filter
        (checkYYAReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkYBlockRestElems I kw).filter (checkYYAReadPred I) =
          [(⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw) (checkYYAReadPred I) 2
          (⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩)
          rfl
          (by unfold checkYYAReadPred
              exact (yAReadPredCore_iff Loc.yA OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkYYAReadPred
            · exact yAReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact yAReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
            · exact yAReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
            · exact yAReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)
            · exact yAReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

