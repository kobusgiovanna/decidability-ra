/-- `checkY`'s `i`-th `yA`-read: for `i = 0` it expects `v0` (tag `true`), for
`i ≥ 1` the second component of `kws[i-1]` (tag `false`). -/
theorem rawNthRead_checkY_yA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkY Loc.yA i = some er) :
    (i = 0 ∧ er.val = Val.yTag (Tid.guessAY, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ er.val = Val.yTag (Tid.guessAY, false) kw.2) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA) (op := OpType.rd)
    (predL := checkYYAReadPred I) htrace (checkYYAReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYAReadPred I)).length
      = kws.length + 1 := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yA_read_filter,
      checkYBlockRestElems_yA_read_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAReadPred I p.1) =
      [((⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 2)] ++
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYAReadPred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, checkYBlock0Elems_yA_read_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYAReadPred_iff I)
      (n := 0) (lab := (⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true)
        (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY)) (origPos := 2)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkY Loc.yA OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
      (checkYBlockRestElems I) 6 2
      (fun kw => rfl)
      (checkYYAReadPred I)
      (fun kw => (⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY))
      (fun a => rfl)
      (fun a => by
        unfold checkYYAReadPred
        exact (yAReadPredCore_iff Loc.yA OpType.rd).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkYYAReadPred
        · exact yAReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact yAReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
        · exact yAReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
        · exact yAReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)
        · exact yAReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAReadPred I p.1))[i]?
        = some ((⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 4 + j * 6 + 2) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYAReadPred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkY Loc.yA OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `checkY`/`yA` branch (Eq. (17)): `checkY` makes
`1 + kwsVY.length` `yA`-reads and `guessAY` makes `1 + kwsAY.length`
`yA`-writes. -/
theorem traceRf_total_checkY_yA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (js : List (Fin I.n))
    (v0G : Fin I.n) (kwsAY : List (Fin 4 × Option (Fin I.n)))
    (hkwsAY : kwsAY.length = js.length + 1)
    (htraceG : trace Tid.guessAY = guessAYBlockWord I v0G kwsAY)
    (v0V : Fin I.n) (kwsVY : List (Fin 4 × Option (Fin I.n)))
    (hkwsVY : kwsVY.length = js.length + 1)
    (htraceV : trace Tid.checkY = checkYBlockWord I v0V kwsVY)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.checkY) (her_loc : er.loc = Loc.yA)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.checkY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.checkY Loc.yA OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.checkY Loc.yA OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.checkY Loc.yA i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.checkY Loc.yA OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA) (op := OpType.rd) (predL := checkYYAReadPred I) htraceV
    (checkYYAReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0V kwsVY).filter (checkYYAReadPred I)).length
      = 1 + kwsVY.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yA_read_filter,
      checkYBlockRestElems_yA_read_filter, List.length_singleton]
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.yA) (op := OpType.wt) (predL := guessAYYAWritePred I) htraceG
    (guessAYYAWritePred_iff I)
  have hlenW2 : ((guessAYBlockWord I v0G kwsAY).filter (guessAYYAWritePred I)).length
      = 1 + kwsAY.length := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_yA_filter,
      guessAYBlockRestElems_yA_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessAY Loc.yA OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_checkY_guessAY_yA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0G : Fin I.n) (kwsG : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0G kwsG)
    (v0V : Fin I.n) (kwsV : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I v0V kwsV)
    (hv0eq : v0V = v0G)
    (hkwsAgree : ∀ i, i < kwsG.length → ∃ kwG kwV, kwsG[i]? = some kwG ∧ kwsV[i]? = some kwV ∧
      kwV.2 = kwG.2)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.yA i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yA i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  rcases rawNthWrite_guessAY_yA_eq I v0G kwsG htraceGAY hew with
    ⟨hi0, hewval⟩ | ⟨kwG, hkwG, hipos, hewval⟩
  · subst hi0
    rcases rawNthRead_checkY_yA_eq I v0V kwsV htraceVY her with
      ⟨-, herval⟩ | ⟨kwV, hkwV, hipos', herval⟩
    · rw [hewval, herval, hv0eq]
    · omega
  · rcases rawNthRead_checkY_yA_eq I v0V kwsV htraceVY her with
      ⟨hi0, herval⟩ | ⟨kwV, hkwV, hipos', herval⟩
    · omega
    · have hglt : i - 1 < kwsG.length := (List.getElem?_eq_some_iff.mp hkwG).1
      obtain ⟨kwG', kwV', hkwG', hkwV', hkweq⟩ := hkwsAgree (i - 1) hglt
      rw [hkwG] at hkwG'
      injection hkwG' with hkwG'
      subst hkwG'
      rw [hkwV] at hkwV'
      injection hkwV' with hkwV'
      subst hkwV'
      rw [hewval, herval, hkweq]

/-- `traceRf_matches_checkY_guessAY_yA` for the general construction: both
threads draw the same solution. -/
theorem traceRf_matches_checkY_guessAY_yA_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (j0 : Fin I.n) (js : List (Fin I.n))
    (kwsG : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I j0 kwsG)
    (hlenG : kwsG.length = js.length + 1)
    (hvalG : ∀ i, i < kwsG.length → ∃ w, kwsG[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    (kwsV : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I j0 kwsV)
    (hlenV : kwsV.length = js.length + 1)
    (hvalV : ∀ i, i < kwsV.length → ∃ w, kwsV[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.yA i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yA i = some er) :
    ew.val = er.val := by
  have hkwsAgree : ∀ i, i < kwsG.length → ∃ kwG kwV, kwsG[i]? = some kwG ∧ kwsV[i]? = some kwV ∧
      kwV.2 = kwG.2 := by
    intro i hi
    obtain ⟨wG, hwG, hweqG⟩ := hvalG i hi
    have hiV : i < kwsV.length := by omega
    obtain ⟨wV, hwV, hweqV⟩ := hvalV i hiV
    refine ⟨(⟨(1 + i) % 4, by omega⟩, wG), (⟨(1 + i) % 4, by omega⟩, wV), hwG, hwV, ?_⟩
    simp [hweqG, hweqV]
  exact traceRf_matches_checkY_guessAY_yA I j0 kwsG htraceGAY j0 kwsV htraceVY rfl hkwsAgree h

/-! ## The resolutions given by a solution

"We assign to the respective locations `aux` the sequence of values
`j_1,…,j_k,⊥`" (for `GuessAX`, `GuessBX`, `GuessAY`, `GuessBY`, `CheckY`), and
"for `c^x`, we assign the sequence of letters in `α_{j_1}⋯α_{j_k}·⊥`". -/

/-- The flattened `α`-word of a non-empty tile-index list is non-empty
(`I.hα`). -/
theorem PCPInstance.flatten_alpha_ne_nil (I : PCPInstance) {js : List (Fin I.n)}
    (hjs : js ≠ []) : (js.map I.α).flatten ≠ [] := by
  obtain ⟨j0, js', rfl⟩ := List.exists_cons_of_ne_nil hjs
  have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil (I.hα j0)
  refine List.ne_nil_of_length_pos ?_
  rw [List.length_flatten]
  simp only [List.map_cons, List.sum_cons]
  omega

/-- The resolution data given by a solution: the tile indices `j0 :: js`, and
the flattened `α`-word `c0 :: cs`. -/
theorem PCPInstance.solution_streams (I : PCPInstance) (hsol : I.HasSolution) :
    ∃ (j0 : Fin I.n) (js : List (Fin I.n)) (c0 : I.Γ) (cs : List I.Γ),
      I.IsSolution (j0 :: js) ∧ ((j0 :: js).map I.α).flatten = c0 :: cs := by
  obtain ⟨js0, hjs0⟩ := hsol
  obtain ⟨j0, js, hcons⟩ := List.exists_cons_of_ne_nil hjs0.1
  have hjs0' : I.IsSolution (j0 :: js) := by rw [← hcons]; exact hjs0
  have hflat_ne : ((j0 :: js).map I.α).flatten ≠ [] :=
    I.flatten_alpha_ne_nil (List.cons_ne_nil j0 js)
  obtain ⟨c0, cs, hcons2⟩ := List.exists_cons_of_ne_nil hflat_ne
  exact ⟨j0, js, c0, cs, hjs0', hcons2⟩

/-! ## `GuessBX` (`g_β^x`)

As for `GuessAX`, sharing the arithmetic of `Completeness/Monotonicity.lean`. -/

/-- `GuessBX`'s events in one inner call (as `guessAXInnerBlockElems`). -/
def guessBXInnerBlockElems (I : PCPInstance) (vs : Val I × Val I × Val I) :
    List (ThreadLabel (domainOf I) Tid.guessBX) :=
  [ ⟨EventLabel.wt Tid.guessBX Loc.xB vs.1, rfl⟩
  , ⟨EventLabel.wt Tid.guessBX Loc.zBx'x vs.2.1, rfl⟩
  , ⟨EventLabel.rd Tid.guessBX Loc.zBxx' vs.2.2, rfl⟩ ]

/-- The shape of an inner call of `GuessBX` (as `guessAXInnerBlockShape`). -/
def guessBXInnerBlockShape : List (Loc × OpType) :=
  [(Loc.xB, .wt), (Loc.zBx'x, .wt), (Loc.zBxx', .rd)]

theorem guessBXInnerBlockElems_shape (I : PCPInstance) :
    ∀ vs : Val I × Val I × Val I,
      (guessBXInnerBlockElems I vs).map (fun ev => (ev.1.loc, ev.1.op)) =
        guessBXInnerBlockShape :=
  fun _ => rfl

/-- An inner call of `GuessBX` accesses no bridge location. -/
theorem guessBXInnerBlockShape_no_bridge : ∀ p ∈ guessBXInnerBlockShape, p.1 ∉ BridgeLoc := by
  decide

/-- `GuessBX`'s events in one outer iteration (as `guessAXOuterBlockElems`). -/
def guessBXOuterBlockElems (I : PCPInstance) (b : Val I × Val I)
    (vs : List (Val I × Val I × Val I)) : List (ThreadLabel (domainOf I) Tid.guessBX) :=
  ⟨EventLabel.wt Tid.guessBX Loc.zBxy b.1, rfl⟩ ::
    (vs.flatMap (guessBXInnerBlockElems I) ++ [⟨EventLabel.rd Tid.guessBX Loc.ellByx b.2, rfl⟩])

/-- The word of `guessBXLoop`, from its five pieces (as `guessAXBlockWord`). -/
def guessBXBlockWord (I : PCPInstance) (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I))) :
    Word (ThreadLabel (domainOf I) Tid.guessBX) :=
  ([ ⟨EventLabel.wt Tid.guessBX Loc.zBxy vB0.1, rfl⟩
   , ⟨EventLabel.wt Tid.guessBX Loc.xB v1, rfl⟩
   , ⟨EventLabel.wt Tid.guessBX Loc.zBx'x v2, rfl⟩ ] ++
    inner0Rest.flatMap (guessBXInnerBlockElems I) ++
    [ ⟨EventLabel.rd Tid.guessBX Loc.ellByx vB0.2, rfl⟩ ]) ++
  outerRest.flatMap (fun p => guessBXOuterBlockElems I p.1 p.2)

/-! ## `GuessBX`'s runs

As for `GuessAX`, with `I.β` and `Loc.xB`/`Loc.zBx'x`/`Loc.zBxx'`/`Loc.zBxy`/
`Loc.ellByx`. -/

def guessBXInnerLoop (I : PCPInstance) : Command (domainOf I) (GuessBX.Vocab I) :=
  Command.whileLoop GuessBX.BExpr.jLeN
    (Command.seq (GuessBX.innerBody I) (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr))

/-- One iteration of `guessBXInnerLoop` with `fst = false` (as
`guessAX_innerLoop_rest_step`). -/
theorem guessBX_innerLoop_rest_step (I : PCPInstance) (rest : List (GuessBX.Vals I))
    (φ : (GuessBX.Vocab I).Store)
    (hguard : (GuessBX.Vocab I).evalB GuessBX.BExpr.jLeN φ = true)
    (hfst : φ GuessBX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (k : Fin 4) (hcnt0 : φ GuessBX.Vars.cnt = Sum.inr (Sum.inl k)) :
    ∃ (φ' : (GuessBX.Vocab I).Store) (cLast : Config (domainOf I) (GuessBX.Vocab I)),
      φ' GuessBX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) ∧
      φ' GuessBX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) ∧
      φ' GuessBX.Vars.j = GuessBX.eval I GuessBX.Expr.jIncr φ ∧
      φ' GuessBX.Vars.aux = φ GuessBX.Vars.aux ∧
      φ' GuessBX.Vars.cntY = φ GuessBX.Vars.cntY ∧
      φ' GuessBX.Vars.N = φ GuessBX.Vars.N ∧
      Command.Run Tid.guessBX rest
        (guessBXInnerLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessBX Loc.xB
            (Val.xTag (Tid.guessBX, false)
              (GuessBX.jthLetter I (GuessBX.auxOf I φ) (GuessBX.jOf I φ))),
            rfl⟩
        , ⟨EventLabel.wt Tid.guessBX Loc.zBx'x (Val.cnt (k + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.guessBX Loc.zBxx' (Val.cnt k), rfl⟩ ]
        cLast rest (guessBXInnerLoop I, φ') := by
  set φ1 : (GuessBX.Vocab I).Store :=
    Function.update φ GuessBX.Vars.prev (GuessBX.eval I GuessBX.Expr.readCnt φ) with hφ1
  set φ2 : (GuessBX.Vocab I).Store :=
    Function.update φ1 GuessBX.Vars.cnt (GuessBX.eval I GuessBX.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 GuessBX.Vars.cnt = φ GuessBX.Vars.cnt := rfl
  have hcntOf_φ1 : GuessBX.cntOf I φ1 = k := by
    simp only [GuessBX.cntOf, hcnt_φ1, hcnt0]
  have hcnt2eq : φ2 GuessBX.Vars.cnt = GuessBX.eval I GuessBX.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2raw : φ2 GuessBX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) := by
    simp only [hcnt2eq, GuessBX.eval, hcntOf_φ1]; rfl
  have hguard' : GuessBX.evalB I GuessBX.BExpr.jLeN φ = true := hguard
  have hne_prev_cnt : GuessBX.Vars.prev ≠ GuessBX.Vars.cnt := by decide
  have hprev_φ1 : GuessBX.prevOf I φ1 = k := by
    simp only [hφ1, GuessBX.prevOf, GuessBX.eval, hcnt0]; rfl
  have hprev_φ2 : GuessBX.prevOf I φ2 = k := by
    have h1' : φ2 GuessBX.Vars.prev = φ1 GuessBX.Vars.prev := Function.update_of_ne hne_prev_cnt _ _
    simp only [GuessBX.prevOf, h1']
    exact hprev_φ1
  have hne_fst_cnt : GuessBX.Vars.fst ≠ GuessBX.Vars.cnt := by decide
  have hne_fst_prev : GuessBX.Vars.fst ≠ GuessBX.Vars.prev := by decide
  have hfst_φ1 : φ1 GuessBX.Vars.fst = φ GuessBX.Vars.fst := rfl
  have hfst2 : φ2 GuessBX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) := by
    have h1' : φ2 GuessBX.Vars.fst = φ1 GuessBX.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have hisFirst2 : (GuessBX.Vocab I).evalB GuessBX.BExpr.isFirst φ2 = false := by
    simp [GuessBX.Vocab, GuessBX.evalB, hfst2]
  have hisFirst2' : GuessBX.evalB I GuessBX.BExpr.isFirst φ2 = false := hisFirst2
  have hne_aux_cnt : GuessBX.Vars.aux ≠ GuessBX.Vars.cnt := by decide
  have hne_aux_prev : GuessBX.Vars.aux ≠ GuessBX.Vars.prev := by decide
  have haux_φ2 : φ2 GuessBX.Vars.aux = φ GuessBX.Vars.aux := by
    have h1' : φ2 GuessBX.Vars.aux = φ1 GuessBX.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    have h2' : φ1 GuessBX.Vars.aux = φ GuessBX.Vars.aux := Function.update_of_ne hne_aux_prev _ _
    rw [h1', h2']
  have hj_φ2 : GuessBX.jOf I φ2 = GuessBX.jOf I φ := by
    have hne1 : GuessBX.Vars.j ≠ GuessBX.Vars.cnt := by decide
    have hne2 : GuessBX.Vars.j ≠ GuessBX.Vars.prev := by decide
    have h1' : φ2 GuessBX.Vars.j = φ1 GuessBX.Vars.j := Function.update_of_ne hne1 _ _
    have h2' : φ1 GuessBX.Vars.j = φ GuessBX.Vars.j := Function.update_of_ne hne2 _ _
    simp only [GuessBX.jOf, h1', h2']
  have hxTagRest2 : (GuessBX.Vocab I).evalV GuessBX.VExpr.xTagRest φ2 =
      Val.xTag (Tid.guessBX, false)
        (GuessBX.jthLetter I (GuessBX.auxOf I φ) (GuessBX.jOf I φ)) := by
    simp only [GuessBX.Vocab, GuessBX.evalV, GuessBX.auxOf, haux_φ2, hj_φ2]; rfl
  have hcntVal2 : (GuessBX.Vocab I).evalV GuessBX.VExpr.cntVal φ2 = Val.cnt (k + 1) := by
    have hcnt2 : GuessBX.cntOf I φ2 = k + 1 := by simp only [GuessBX.cntOf, hcnt2raw]
    simp only [GuessBX.Vocab, GuessBX.evalV, hcnt2]; rfl
  have hprevVal2 : (GuessBX.Vocab I).evalV GuessBX.VExpr.prevVal φ2 = Val.cnt k := by
    simp only [GuessBX.Vocab, GuessBX.evalV, hprev_φ2]; rfl
  have h1 : Command.RunStep Tid.guessBX rest none (guessBXInnerLoop I, φ) rest
      (Command.loopSeq (Command.seq (GuessBX.innerBody I)
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [guessBXInnerLoop, Command.step, GuessBX.Vocab, hguard', if_true])
  have h2 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq (GuessBX.innerBody I)
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ) rest
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.assign GuessBX.Vars.cnt GuessBX.Expr.nextCnt)
          (Command.ite GuessBX.BExpr.isFirst
            (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
                (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
                (Command.read Loc.zBxx' GuessBX.VExpr.prevVal))))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [GuessBX.innerBody, Command.firstIt, Command.step, GuessBX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.assign GuessBX.Vars.cnt GuessBX.Expr.nextCnt)
          (Command.ite GuessBX.BExpr.isFirst
            (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
                (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
                (Command.read Loc.zBxx' GuessBX.VExpr.prevVal))))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ1) rest
      (Command.loopSeq (Command.seq
        (Command.seq (Command.assign GuessBX.Vars.cnt GuessBX.Expr.nextCnt)
          (Command.ite GuessBX.BExpr.isFirst
            (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
                (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
                (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq
        (Command.seq (Command.assign GuessBX.Vars.cnt GuessBX.Expr.nextCnt)
          (Command.ite GuessBX.BExpr.isFirst
            (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
              (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
                (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
              (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
                (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ1) rest
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.ite GuessBX.BExpr.isFirst
          (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
              (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
          (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
            (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
              (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) := by
    rw [hφ2]
    exact Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, GuessBX.Vocab])
  have h5 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.ite GuessBX.BExpr.isFirst
          (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
              (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
          (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
            (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
              (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) rest
      (Command.loopSeq (Command.seq
        (Command.ite GuessBX.BExpr.isFirst
          (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
              (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
          (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
            (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
              (Command.read Loc.zBxx' GuessBX.VExpr.prevVal))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq
        (Command.ite GuessBX.BExpr.isFirst
          (Command.seq (Command.assign GuessBX.Vars.fst GuessBX.Expr.fstFalse)
            (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagFirst)
              (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)))
          (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
            (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
              (Command.read Loc.zBxx' GuessBX.VExpr.prevVal))))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) rest
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
          (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
            (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, GuessBX.Vocab, hisFirst2']; rfl)
  have h7 : Command.RunStep Tid.guessBX rest
      (some ⟨EventLabel.wt Tid.guessBX Loc.xB ((GuessBX.Vocab I).evalV GuessBX.VExpr.xTagRest φ2),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.xB GuessBX.VExpr.xTagRest)
          (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
            (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) rest
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip
          (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
            (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.guessBX rest none
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip
          (Command.seq (Command.write Loc.zBx'x GuessBX.VExpr.cntVal)
            (Command.read Loc.zBxx' GuessBX.VExpr.prevVal)))
        (Command.assign GuessBX.Vars.j GuessBX.Expr.jIncr)) (guessBXInnerLoop I), φ2) rest
