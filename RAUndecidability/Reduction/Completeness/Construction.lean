theorem checkYBlockRestElems_yAprime_filter (I : PCPInstance)
    (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYAprimeReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkYBlockRestElems I kw) ++ kws.flatMap (checkYBlockRestElems I)).filter
        (checkYYAprimeReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkYBlockRestElems I kw).filter (checkYYAprimeReadPred I) =
          [(⟨EventLabel.rd Tid.checkY Loc.yA' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw)
          (checkYYAprimeReadPred I) 4
          (⟨EventLabel.rd Tid.checkY Loc.yA' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩)
          rfl
          (by unfold checkYYAprimeReadPred
              exact (yAprimeReadPredCore_iff Loc.yA' OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkYYAprimeReadPred
            · exact yAprimeReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact yAprimeReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
            · exact yAprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
            · exact yAprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
            · exact yAprimeReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_checkY_yAprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkY Loc.yA' i = some er) :
    ∃ kw, kws[i]? = some kw ∧ er.val = Val.primeTag Tid.primeCheckY kw.1 := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA') (op := OpType.rd)
    (predL := checkYYAprimeReadPred I) htrace (checkYYAprimeReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYAprimeReadPred I)).length
      = kws.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yAprime_filter,
      checkYBlockRestElems_yAprime_filter]
    simp
  have hilt : i < kws.length :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  obtain ⟨kw, hkw⟩ : ∃ kw, kws[i]? = some kw := ⟨kws[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfiltrest := zipIdx_flatMap_filter_getElem
    (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
    (checkYBlockRestElems I) 6 4
    (fun kw => rfl)
    (checkYYAprimeReadPred I)
    (fun kw => (⟨EventLabel.rd Tid.checkY Loc.yA' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.checkY))
    (fun a => rfl)
    (fun a => by
      unfold checkYYAprimeReadPred
      exact (yAprimeReadPredCore_iff Loc.yA' OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYAprimeReadPred
      · exact yAprimeReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yAprimeReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yAprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
      · exact yAprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
      · exact yAprimeReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
    kws 4 i kw hkw
  have hz0 : (((checkYBlock0Elems I v0).zipIdx).filter
      (fun p => checkYYAprimeReadPred I p.1)) = [] := by
    show List.filter (fun p => checkYYAprimeReadPred I p.1)
      (List.zipIdx
        [ (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY)
      , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩
      , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
      , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ ])
      = ([] : List (ThreadLabel (domainOf I) Tid.checkY × ℕ))
    rfl
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAprimeReadPred I p.1) =
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYAprimeReadPred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, hz0]
    rfl
  have hzipj :
      ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAprimeReadPred I p.1))[i]?
      = some ((⟨EventLabel.rd Tid.checkY Loc.yA' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY), 4 + i * 6 + 4) := by
    rw [hzip]
    exact hfiltrest
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
    (l := checkYBlockWord I v0 kws) htrace (checkYYAprimeReadPred_iff I) hzipj
  have hraw : rawNthEvent trace Tid.checkY Loc.yA' OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨kw, hkw, by injection hconn with hconn; rw [hconn]; rfl⟩




/-- `rf_total` for the `checkY`/`yA'` branch (Eq. (16)). -/
theorem traceRf_total_checkY_yAprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (js : List (Fin I.n)) (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (hkws : kws.length = js.length + 1)
    (htraceV : trace Tid.checkY = checkYBlockWord I v0 kws)
    (cnts : List (Fin 4)) (hcnts : cnts.length = js.length + 1)
    (htraceP : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.checkY) (her_loc : er.loc = Loc.yA')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.checkY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.checkY Loc.yA' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.checkY Loc.yA' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.checkY Loc.yA' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.checkY Loc.yA' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA') (op := OpType.rd) (predL := checkYYAprimeReadPred I) htraceV
    (checkYYAprimeReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYAprimeReadPred I)).length
      = kws.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yAprime_filter,
      checkYBlockRestElems_yAprime_filter]
    simp
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckY)
    (x := Loc.yA') (op := OpType.wt) (predL := primeCheckYYAprimeWritePred I) htraceP
    (primeCheckYYAprimeWritePred_iff I)
  have hilt_writer : i < (rawOpEvents trace Tid.primeCheckY Loc.yA' OpType.wt).length := by
    rw [hlenW.trans (primeCheckYBlockWord_yAprimewrite_length I cnts)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_primeCheckY_checkY_yAprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVX : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yA' i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yA' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, hewval⟩ := rawNthWrite_primeCheckY_yAprime_eq I cnts htracePVX hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_checkY_yAprime_eq I v0 kws htraceVX her
  have hclen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hcform := hcntsVal i hclen
  rw [hcform] at hc
  injection hc with hc
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hc, hkweq]
  congr 2
  omega

/-- `traceRf_matches_primeCheckY_checkY_yAprime` for the general
construction. -/
theorem traceRf_matches_primeCheckY_checkY_yAprime_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVY : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckY Loc.yA' i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yA' i = some er) :
    ew.val = er.val :=
  traceRf_matches_primeCheckY_checkY_yAprime I cnts htracePVY hcntsVal v0 kws htraceVY hkwsVal h

/-! ## `rf_matches`: `primeCheckY`/`checkY` `yB'` (Eq. (16))

As for `yA'`, with `yB'` at offset `1` of `primeCheckY`'s block and offset
`5` of `checkYBlockRestElems`. -/



def yBprimeWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yB', OpType.wt => true | _, _ => false

theorem yBprimeWritePredCore_iff (y : Loc) (z : OpType) :
    yBprimeWritePredCore y z = true ↔ (y = Loc.yB' ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem yBprimeWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.yB' ∧ z = OpType.wt)) :
    yBprimeWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)


def primeCheckYYBprimeWritePred (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) : Bool :=
  yBprimeWritePredCore lab.1.loc lab.1.op

theorem primeCheckYYBprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    primeCheckYYBprimeWritePred I lab = true ↔ (lab.1.loc = Loc.yB' ∧ lab.1.op = OpType.wt) := by
  unfold primeCheckYYBprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBprimeWritePredCore_iff y z

theorem primeCheckYBlockWord_yBprimewrite_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckYBlockWord I cnts).filter (primeCheckYYBprimeWritePred I)).length
      = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckY)
        , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])
        ++ (primeCheckYBlockWord I cs)).filter (primeCheckYYBprimeWritePred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.yA' OpType.wt (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              exact (yBprimeWritePredCore_iff Loc.yB' OpType.wt).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.yA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.yB' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.yB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

