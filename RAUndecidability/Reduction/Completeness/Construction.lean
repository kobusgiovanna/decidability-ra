      (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY))
    (by unfold checkYYAprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
