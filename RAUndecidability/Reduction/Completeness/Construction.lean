def yBprimeReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yB', OpType.rd => true | _, _ => false

theorem yBprimeReadPredCore_iff (y : Loc) (z : OpType) :
    yBprimeReadPredCore y z = true ↔ (y = Loc.yB' ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem yBprimeReadPredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.yB' ∧ z = OpType.rd)) :
    yBprimeReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `primeBY`'s `yB'`-write predicate. -/
def primeBYYBprimeWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.primeBY) :
    Bool :=
  yBprimeWritePredCore lab.1.loc lab.1.op

theorem primeBYYBprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeBY) :
    primeBYYBprimeWritePred I lab = true ↔ (lab.1.loc = Loc.yB' ∧ lab.1.op = OpType.wt) := by
  unfold primeBYYBprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBprimeWritePredCore_iff y z

/-- `primeBYBlockWord` has one `yB'`-write per entry of `vals`. -/
theorem primeBYBlockWord_yBprime_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeBYBlockWord I vals).filter (primeBYYBprimeWritePred I)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY)
        , ⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ ] ++ (primeBYBlockWord I vs)).filter
        (primeBYYBprimeWritePred I)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeBY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeBY))
          (by unfold primeBYYBprimeWritePred
              exact (yBprimeWritePredCore_iff Loc.yB' OpType.wt).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBY Loc.zByy' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by unfold primeBYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.zByy' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeBY Loc.zBy'y v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBY))
          (by unfold primeBYYBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeWritePredCore_false_of_ne Loc.zBy'y OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `primeCheckY`'s `yB'`-read predicate. -/
def primeCheckYYBprimeReadPred (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) : Bool :=
  yBprimeReadPredCore lab.1.loc lab.1.op

theorem primeCheckYYBprimeReadPred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    primeCheckYYBprimeReadPred I lab = true ↔
      (lab.1.loc = Loc.yB' ∧ lab.1.op = OpType.rd) := by
  unfold primeCheckYYBprimeReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBprimeReadPredCore_iff y z

/-- `primeCheckYBlockWord` has one `yB'`-read per entry of `cnts` (offset
`3`). -/
theorem primeCheckYBlockWord_yBprimeread_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckYBlockWord I cnts).filter (primeCheckYYBprimeReadPred I)).length
      = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckY)
        , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])
        ++ (primeCheckYBlockWord I cs)).filter (primeCheckYYBprimeReadPred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeReadPredCore_false_of_ne Loc.yA' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeCheckY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeReadPredCore_false_of_ne Loc.yB' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA'
            (Val.primeTag Tid.primeAY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB'
            (Val.primeTag Tid.primeBY 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              exact (yBprimeReadPredCore_iff Loc.yB' OpType.rd).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yA
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckY Loc.yB
            (Val.primeTag Tid.checkY c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckY))
          (by unfold primeCheckYYBprimeReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                yBprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `rf_total` for the `primeCheckY`/`yB'` branch (Eq. (17)). -/
theorem traceRf_total_primeCheckY_yBprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (js : List (Fin I.n)) (cnts : List (Fin 4)) (hcnts : cnts.length = js.length + 1)
    (htraceP : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (vals : List (Val I)) (hvals : vals.length = js.length + 1)
    (htraceB : trace Tid.primeBY = primeBYBlockWord I vals)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeCheckY) (her_loc : er.loc = Loc.yB')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeCheckY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeCheckY Loc.yB' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeCheckY Loc.yB' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeCheckY Loc.yB' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeCheckY Loc.yB' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckY)
    (x := Loc.yB') (op := OpType.rd) (predL := primeCheckYYBprimeReadPred I) htraceP
    (primeCheckYYBprimeReadPred_iff I)
  rw [hlen.trans (primeCheckYBlockWord_yBprimeread_length I cnts)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeBY)
    (x := Loc.yB') (op := OpType.wt) (predL := primeBYYBprimeWritePred I) htraceB
    (primeBYYBprimeWritePred_iff I)
  have hilt_writer : i < (rawOpEvents trace Tid.primeBY Loc.yB' OpType.wt).length := by
    rw [hlenW.trans (primeBYBlockWord_yBprime_length I vals)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

def checkYYBprimeReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) : Bool :=
  yBprimeReadPredCore lab.1.loc lab.1.op

theorem checkYYBprimeReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) :
    checkYYBprimeReadPred I lab = true ↔ (lab.1.loc = Loc.yB' ∧ lab.1.op = OpType.rd) := by
  unfold checkYYBprimeReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBprimeReadPredCore_iff y z

theorem checkYBlock0Elems_yBprime_filter (I : PCPInstance) (v0 : (Fin I.n)) :
    (checkYBlock0Elems I v0).filter (checkYYBprimeReadPred I) = [] := by
  show List.filter (checkYYBprimeReadPred I)
      [ (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)
    , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩
    , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
    , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ ]
      = ([] : List (ThreadLabel (domainOf I) Tid.checkY))
  rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.checkY Loc.yA
      (Val.primeTag Tid.checkY 1), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY))
    (by unfold checkYYBprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          yBprimeReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.checkY Loc.yB
      (Val.primeTag Tid.checkY 1), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY))
    (by unfold checkYYBprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          yBprimeReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.checkY Loc.yA
      (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY))
    (by unfold checkYYBprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          yBprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.checkY Loc.yB
      (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY))
    (by unfold checkYYBprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          yBprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)),
    List.filter_nil]

theorem checkYBlockRestElems_yBprime_filter (I : PCPInstance)
    (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYBprimeReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkYBlockRestElems I kw) ++ kws.flatMap (checkYBlockRestElems I)).filter
        (checkYYBprimeReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkYBlockRestElems I kw).filter (checkYYBprimeReadPred I) =
          [(⟨EventLabel.rd Tid.checkY Loc.yB' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw)
          (checkYYBprimeReadPred I) 5
          (⟨EventLabel.rd Tid.checkY Loc.yB' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩)
          rfl
          (by unfold checkYYBprimeReadPred
              exact (yBprimeReadPredCore_iff Loc.yB' OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkYYBprimeReadPred
            · exact yBprimeReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact yBprimeReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
            · exact yBprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
            · exact yBprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
            · exact yBprimeReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_checkY_yBprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkY Loc.yB' i = some er) :
    ∃ kw, kws[i]? = some kw ∧ er.val = Val.primeTag Tid.primeCheckY kw.1 := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yB') (op := OpType.rd)
    (predL := checkYYBprimeReadPred I) htrace (checkYYBprimeReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYBprimeReadPred I)).length
      = kws.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yBprime_filter,
      checkYBlockRestElems_yBprime_filter]
    simp
  have hilt : i < kws.length :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  obtain ⟨kw, hkw⟩ : ∃ kw, kws[i]? = some kw := ⟨kws[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfiltrest := zipIdx_flatMap_filter_getElem
    (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
    (checkYBlockRestElems I) 6 5
    (fun kw => rfl)
    (checkYYBprimeReadPred I)
    (fun kw => (⟨EventLabel.rd Tid.checkY Loc.yB' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.checkY))
    (fun a => rfl)
    (fun a => by
      unfold checkYYBprimeReadPred
      exact (yBprimeReadPredCore_iff Loc.yB' OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYBprimeReadPred
      · exact yBprimeReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yBprimeReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yBprimeReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
      · exact yBprimeReadPredCore_false_of_ne Loc.yB OpType.rd (by decide)
      · exact yBprimeReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide))
    kws 4 i kw hkw
  have hz0 : (((checkYBlock0Elems I v0).zipIdx).filter
      (fun p => checkYYBprimeReadPred I p.1)) = [] := by
    show List.filter (fun p => checkYYBprimeReadPred I p.1)
      (List.zipIdx
        [ (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY)
      , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩
      , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
      , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ ])
      = ([] : List (ThreadLabel (domainOf I) Tid.checkY × ℕ))
    rfl
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBprimeReadPred I p.1) =
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYBprimeReadPred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, hz0]
    rfl
  have hzipj :
      ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBprimeReadPred I p.1))[i]?
      = some ((⟨EventLabel.rd Tid.checkY Loc.yB' (Val.primeTag Tid.primeCheckY kw.1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY), 4 + i * 6 + 5) := by
    rw [hzip]
    exact hfiltrest
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
    (l := checkYBlockWord I v0 kws) htrace (checkYYBprimeReadPred_iff I) hzipj
  have hraw : rawNthEvent trace Tid.checkY Loc.yB' OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨kw, hkw, by injection hconn with hconn; rw [hconn]; rfl⟩




