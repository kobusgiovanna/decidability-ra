/-- `rf_total` for the `primeCheckX`/`xA'` branch (Eq. (17)): `primeCheckX`
makes `cnts.length` `xA'`-reads and `primeAX` makes `vals.length`
`xA'`-writes. -/
theorem traceRf_total_primeCheckX_xAprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cs : List I.Γ) (cnts : List (Fin 4)) (hcnts : cnts.length = cs.length + 1)
    (htraceP : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (vals : List (Val I)) (hvals : vals.length = cs.length + 1)
    (htraceA : trace Tid.primeAX = primeAXBlockWord I vals)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeCheckX) (her_loc : er.loc = Loc.xA')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeCheckX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeCheckX Loc.xA' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xA') (op := OpType.rd) (predL := primeCheckXXAprimeReadPred I) htraceP
    (primeCheckXXAprimeReadPred_iff I)
  rw [hlen.trans (primeCheckXBlockWord_xAprimeread_length I cnts)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAX)
    (x := Loc.xA') (op := OpType.wt) (predL := primeAXXAprimeWritePred I) htraceA
    (primeAXXAprimeWritePred_iff I)
  have hilt_writer : i < (rawOpEvents trace Tid.primeAX Loc.xA' OpType.wt).length := by
    rw [hlenW.trans (primeAXBlockWord_xAprime_length I vals)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩



def checkXXAprimeReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) : Bool :=
  xAprimeReadPredCore lab.1.loc lab.1.op

theorem checkXXAprimeReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) :
    checkXXAprimeReadPred I lab = true ↔ (lab.1.loc = Loc.xA' ∧ lab.1.op = OpType.rd) := by
  unfold checkXXAprimeReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xAprimeReadPredCore_iff y z

/-- `checkXBlock0Elems` has no primed reads. -/
theorem checkXBlock0Elems_xAprime_filter (I : PCPInstance) (v0 : I.Γ) :
    (checkXBlock0Elems I v0).filter (checkXXAprimeReadPred I) = [] := by
  show List.filter (checkXXAprimeReadPred I)
      [ (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX)
    , ⟨EventLabel.wt Tid.checkX Loc.xB (Val.primeTag Tid.checkX 1), rfl⟩
    , ⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩
    , ⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ ]
      = ([] : List (ThreadLabel (domainOf I) Tid.checkX))
  rw [List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.checkX Loc.xA
      (Val.primeTag Tid.checkX 1), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX))
    (by unfold checkXXAprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          xAprimeReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.checkX Loc.xB
      (Val.primeTag Tid.checkX 1), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX))
    (by unfold checkXXAprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          xAprimeReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.checkX Loc.xA
      (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX))
    (by unfold checkXXAprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          xAprimeReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)),
    List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.checkX Loc.xB
      (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX))
    (by unfold checkXXAprimeReadPred
        simpa [EventLabel.loc, EventLabel.op] using
          xAprimeReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)),
    List.filter_nil]

theorem checkXBlockRestElems_xAprime_filter (I : PCPInstance) (kws : List (Fin 4 × Option I.Γ)) :
    ((kws.flatMap (checkXBlockRestElems I)).filter (checkXXAprimeReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkXBlockRestElems I kw) ++ kws.flatMap (checkXBlockRestElems I)).filter
        (checkXXAprimeReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkXBlockRestElems I kw).filter (checkXXAprimeReadPred I) =
          [(⟨EventLabel.rd Tid.checkX Loc.xA' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkX)] := by
        apply list_filter_singleton_of_unique' (checkXBlockRestElems I kw)
          (checkXXAprimeReadPred I) 4
          (⟨EventLabel.rd Tid.checkX Loc.xA' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩)
          rfl
          (by unfold checkXXAprimeReadPred
              exact (xAprimeReadPredCore_iff Loc.xA' OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkXXAprimeReadPred
            · exact xAprimeReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
            · exact xAprimeReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
            · exact xAprimeReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)
            · exact xAprimeReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)
            · exact xAprimeReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthRead_checkX_xAprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkX Loc.xA' i = some er) :
    ∃ kw, kws[i]? = some kw ∧ er.val = Val.primeTag Tid.primeCheckX kw.1 := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xA') (op := OpType.rd)
    (predL := checkXXAprimeReadPred I) htrace (checkXXAprimeReadPred_iff I)
  have hlen2 : ((checkXBlockWord I v0 kws).filter (checkXXAprimeReadPred I)).length
      = kws.length := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xAprime_filter,
      checkXBlockRestElems_xAprime_filter]
    simp
  have hilt : i < kws.length :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  obtain ⟨kw, hkw⟩ : ∃ kw, kws[i]? = some kw := ⟨kws[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfiltrest := zipIdx_flatMap_filter_getElem
    (α := Fin 4 × Option I.Γ) (β := ThreadLabel (domainOf I) Tid.checkX)
    (checkXBlockRestElems I) 6 4
    (fun kw => rfl)
    (checkXXAprimeReadPred I)
    (fun kw => (⟨EventLabel.rd Tid.checkX Loc.xA' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.checkX))
    (fun a => rfl)
    (fun a => by
      unfold checkXXAprimeReadPred
      exact (xAprimeReadPredCore_iff Loc.xA' OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkXXAprimeReadPred
      · exact xAprimeReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
      · exact xAprimeReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
      · exact xAprimeReadPredCore_false_of_ne Loc.xA OpType.rd (by decide)
      · exact xAprimeReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)
      · exact xAprimeReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide))
    kws 4 i kw hkw
  have hz0 : (((checkXBlock0Elems I v0).zipIdx).filter
      (fun p => checkXXAprimeReadPred I p.1)) = [] := by
    show List.filter (fun p => checkXXAprimeReadPred I p.1)
      (List.zipIdx
        [ (⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX)
      , ⟨EventLabel.wt Tid.checkX Loc.xB (Val.primeTag Tid.checkX 1), rfl⟩
      , ⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩
      , ⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ ])
      = ([] : List (ThreadLabel (domainOf I) Tid.checkX × ℕ))
    rfl
  have hzip : (checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAprimeReadPred I p.1) =
      ((kws.flatMap (checkXBlockRestElems I)).zipIdx 4).filter
        (fun p => checkXXAprimeReadPred I p.1) := by
    unfold checkXBlockWord
    rw [List.zipIdx_append, List.filter_append, hz0]
    rfl
  have hzipj :
      ((checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAprimeReadPred I p.1))[i]?
      = some ((⟨EventLabel.rd Tid.checkX Loc.xA' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX), 4 + i * 6 + 4) := by
    rw [hzip]
    exact hfiltrest
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
    (l := checkXBlockWord I v0 kws) htrace (checkXXAprimeReadPred_iff I) hzipj
  have hraw : rawNthEvent trace Tid.checkX Loc.xA' OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨kw, hkw, by injection hconn with hconn; rw [hconn]; rfl⟩




/-- `rf_total` for the `checkX`/`xA'` branch (Eq. (16)): `checkX` makes
`kws.length` `xA'`-reads (none in block 0) and `primeCheckX` makes
`cnts.length` `xA'`-writes. -/
theorem traceRf_total_checkX_xAprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cs : List I.Γ) (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (hkws : kws.length = cs.length + 1)
    (htraceV : trace Tid.checkX = checkXBlockWord I v0 kws)
    (cnts : List (Fin 4)) (hcnts : cnts.length = cs.length + 1)
    (htraceP : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.checkX) (her_loc : er.loc = Loc.xA')
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.checkX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.checkX Loc.xA' OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.checkX Loc.xA' OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.checkX Loc.xA' i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.checkX Loc.xA' OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xA') (op := OpType.rd) (predL := checkXXAprimeReadPred I) htraceV
    (checkXXAprimeReadPred_iff I)
  have hlen2 : ((checkXBlockWord I v0 kws).filter (checkXXAprimeReadPred I)).length
      = kws.length := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xAprime_filter,
      checkXBlockRestElems_xAprime_filter]
    simp
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xA') (op := OpType.wt) (predL := primeCheckXXAprimeWritePred I) htraceP
    (primeCheckXXAprimeWritePred_iff I)
  have hilt_writer : i < (rawOpEvents trace Tid.primeCheckX Loc.xA' OpType.wt).length := by
    rw [hlenW.trans (primeCheckXBlockWord_xAprimewrite_length I cnts)]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_primeCheckX_checkX_xAprime (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xA' i = some ew ∧
      rawNthRead trace Tid.checkX Loc.xA' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, hewval⟩ := rawNthWrite_primeCheckX_xAprime_eq I cnts htracePVX hew
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_checkX_xAprime_eq I v0 kws htraceVX her
  have hclen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hklen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  have hcform := hcntsVal i hclen
  rw [hcform] at hc
  injection hc with hc
  obtain ⟨w, hw⟩ := hkwsVal i hklen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rw [hewval, herval, ← hc, hkweq]
  congr 2
  omega

/-- `traceRf_matches_primeCheckX_checkX_xAprime` for the general
construction. -/
theorem traceRf_matches_primeCheckX_checkX_xAprime_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htraceVX : trace Tid.checkX = checkXBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeCheckX Loc.xA' i = some ew ∧
      rawNthRead trace Tid.checkX Loc.xA' i = some er) :
    ew.val = er.val :=
  traceRf_matches_primeCheckX_checkX_xAprime I cnts htracePVX hcntsVal v0 kws htraceVX hkwsVal h

/-! ## `rf_matches`: `primeCheckX`/`checkX` `xB'` (Eq. (16))

As for `xA'`, with `xB'` at offset `1` of `primeCheckX`'s block and offset
`5` of `checkXBlockRestElems`. -/

/-- The `xB'`-write match, as a predicate on `Loc`/`OpType` alone. -/
def xBprimeWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xB', OpType.wt => true | _, _ => false

theorem xBprimeWritePredCore_iff (y : Loc) (z : OpType) :
    xBprimeWritePredCore y z = true ↔ (y = Loc.xB' ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem xBprimeWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.xB' ∧ z = OpType.wt)) :
    xBprimeWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

def primeCheckXXBprimeWritePred (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckX) : Bool :=
  xBprimeWritePredCore lab.1.loc lab.1.op

theorem primeCheckXXBprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckX) :
    primeCheckXXBprimeWritePred I lab = true ↔ (lab.1.loc = Loc.xB' ∧ lab.1.op = OpType.wt) := by
  unfold primeCheckXXBprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xBprimeWritePredCore_iff y z

theorem primeCheckXBlockWord_xBprimewrite_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckXBlockWord I cnts).filter (primeCheckXXBprimeWritePred I)).length
      = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckX)
        , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
        ++ (primeCheckXBlockWord I cs)).filter (primeCheckXXBprimeWritePred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.xA' OpType.wt (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              exact (xBprimeWritePredCore_iff Loc.xB' OpType.wt).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeAX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeBX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.xB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthWrite_primeCheckX_xBprime_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
