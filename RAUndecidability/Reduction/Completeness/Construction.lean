def ellAyxWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.ellAyx, OpType.wt => true | _, _ => false

theorem ellAyxWritePredCore_iff (y : Loc) (z : OpType) :
    ellAyxWritePredCore y z = true ↔ (y = Loc.ellAyx ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem ellAyxWritePredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.ellAyx ∧ z = OpType.wt)) :
    ellAyxWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

def guessAYEllAWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) : Bool :=
  ellAyxWritePredCore lab.1.loc lab.1.op

theorem guessAYEllAWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessAY) :
    guessAYEllAWritePred I lab = true ↔ (lab.1.loc = Loc.ellAyx ∧ lab.1.op = OpType.wt) := by
  unfold guessAYEllAWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact ellAyxWritePredCore_iff y z

theorem guessAYBlock0Elems_ellAyx_filter (I : PCPInstance) (v0 : Fin I.n) :
