/-- See `primeAX_stop_step`. -/
theorem primeCheckX_stop_step (I : PCPInstance) (rest : List PrimeCheckX.Vals)
    (φ : (PrimeCheckX.Vocab I).Store) (hb : φ PrimeCheckX.Vars.b = Sum.inr false) :
    Command.Run Tid.primeCheckX rest (primeCheckXLoop I, φ) [] (primeCheckXLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeCheckX rest none (primeCheckXLoop I, φ) rest
      (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeCheckXLoop, Command.step, PrimeCheckX.Vocab, PrimeCheckX.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- `M + 1` iterations of `primeCheckXLoop` (as `primeAX_shape`), with
counters `(cnt0 + i + 1) mod 4`. -/
theorem primeCheckX_shape (I : PCPInstance) (M : ℕ) (φ : (PrimeCheckX.Vocab I).Store)
    (hb : φ PrimeCheckX.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeCheckX.Vars.cnt = Sum.inl cnt0) :
    ∃ (cnts : List (Fin 4)) (φ' : (PrimeCheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckX.Vocab I)),
      cnts.length = M + 1 ∧
      (∀ i, i < cnts.length →
        cnts[i]? = some (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4)) ∧
      φ' PrimeCheckX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeCheckX (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeCheckXLoop I, φ) (primeCheckXBlockWord I cnts) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeCheckX_iter_step I (Sum.inr false) [] φ hb (by simp [PrimeCheckX.X]) cnt0 hcnt0
      have hrun2 := primeCheckX_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[cnt0 + 1], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeCheckX_iter_step I (Sum.inr true)
          (List.replicate M (Sum.inr true) ++ [Sum.inr false]) φ hb (by simp [PrimeCheckX.X])
          cnt0 hcnt0
      obtain ⟨cnts, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(cnt0 + 1) :: cnts, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < cnts.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 1
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-! ## `PrimeCheckX`'s whole run -/

/-- `PrimeCheckX`'s program, run from its initial store (as
`primeAX_general_run`). -/
theorem primeCheckX_general_run (I : PCPInstance) (M : ℕ) :
    ∃ (cnts : List (Fin 4)) (φ' : (PrimeCheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckX.Vocab I)),
      cnts.length = M + 1 ∧
      (∀ i, i < cnts.length →
        cnts[i]? = some (⟨(i + 1) % 4, by omega⟩ : Fin 4)) ∧
      φ' PrimeCheckX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeCheckX
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeCheckX.program I,
          (PrimeCheckX.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeCheckXBlockWord I cnts)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeCheckX.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeCheckX.Vars.b PrimeCheckX.X PrimeCheckX.X_nonempty)
        (primeCheckXLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeCheckX.Vocab I).Store :=
    (PrimeCheckX.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeCheckX.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeCheckX.Vals) ∈ PrimeCheckX.X := by
    unfold PrimeCheckX.X; decide
  set rest0 : List PrimeCheckX.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeCheckX (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeCheckX.Vars.b PrimeCheckX.X PrimeCheckX.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeCheckX.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeCheckX.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeCheckX (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeCheckX.Vars.b PrimeCheckX.X PrimeCheckX.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeCheckX.Vars.b PrimeCheckX.X PrimeCheckX.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeCheckX.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeCheckXLoop I) hrun1
  set φ1 : (PrimeCheckX.Vocab I).Store := Function.update φ0 PrimeCheckX.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeCheckX rest0 none
      (⟨Command.seq Command.skip (primeCheckXLoop I), φ1⟩ : Config (domainOf I) (PrimeCheckX.Vocab I))
      rest0 ⟨primeCheckXLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeCheckX.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeCheckX.Vars.cnt ≠ PrimeCheckX.Vars.b := by decide
  have hcnt1 : φ1 PrimeCheckX.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨cnts, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeCheckX_shape I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < cnts.length →
      cnts[i]? = some (⟨(i + 1) % 4, by omega⟩ : Fin 4) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeCheckX ([] : List PrimeCheckX.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeCheckX.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨cnts, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩

/-! ## `rf_matches`: `primeCheckX`/`xA` (Eq. (16))

Here the values written by `checkX` and read by `primeCheckX` vary with the
index. -/

/-- The `xA`-read match, as a predicate on `Loc`/`OpType` alone. -/
def xAReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xA, OpType.rd => true | _, _ => false

theorem xAReadPredCore_iff (y : Loc) (z : OpType) :
    xAReadPredCore y z = true ↔ (y = Loc.xA ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem xAReadPredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.xA ∧ z = OpType.rd)) :
    xAReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `primeCheckX`'s `xA`-read predicate, lifted from `xAReadPredCore`. -/
def primeCheckXXAReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.primeCheckX) :
    Bool :=
  xAReadPredCore lab.1.loc lab.1.op

theorem primeCheckXXAReadPred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckX) :
    primeCheckXXAReadPred I lab = true ↔ (lab.1.loc = Loc.xA ∧ lab.1.op = OpType.rd) := by
  unfold primeCheckXXAReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xAReadPredCore_iff y z

/-- `primeCheckXBlockWord` has one `xA`-read per entry of `cnts` (offset `4`
of each block). -/
theorem primeCheckXBlockWord_xA_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckXBlockWord I cnts).filter (primeCheckXXAReadPred I)).length = cnts.length := by
  induction cnts with
  | nil => rfl
  | cons c cs ih =>
      show ((([ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeCheckX)
        , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
        ++ (primeCheckXBlockWord I cs)).filter (primeCheckXXAReadPred I)).length
        = (c :: cs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                xAReadPredCore_false_of_ne Loc.xA' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeCheckX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                xAReadPredCore_false_of_ne Loc.xB' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA'
            (Val.primeTag Tid.primeAX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                xAReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB'
            (Val.primeTag Tid.primeBX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                xAReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide)),
        List.filter_cons_of_pos (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xA
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              exact (xAReadPredCore_iff Loc.xA OpType.rd).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeCheckX Loc.xB
            (Val.primeTag Tid.checkX c), rfl⟩ : ThreadLabel (domainOf I) Tid.primeCheckX))
          (by unfold primeCheckXXAReadPred
              simpa [EventLabel.loc, EventLabel.op] using
                xAReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `primeCheckX`'s `i`-th `xA`-read expects `Val.primeTag Tid.checkX c` for
`cnts[i]? = some c`. -/
theorem rawNthRead_primeCheckX_xA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.primeCheckX Loc.xA i = some er) :
    ∃ c, cnts[i]? = some c ∧ er.val = Val.primeTag Tid.checkX c := by
  have hilt : i < (rawOpEvents trace Tid.primeCheckX Loc.xA OpType.rd).length :=
    (List.getElem?_eq_some_iff.mp h).1
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckX)
    (x := Loc.xA) (op := OpType.rd)
    (predL := primeCheckXXAReadPred I) htrace (primeCheckXXAReadPred_iff I)
  have hlen' : (rawOpEvents trace Tid.primeCheckX Loc.xA OpType.rd).length = cnts.length :=
    hlen.trans (primeCheckXBlockWord_xA_length I cnts)
  rw [hlen'] at hilt
  obtain ⟨c, hc⟩ : ∃ c, cnts[i]? = some c := ⟨cnts[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (α := Fin 4) (β := ThreadLabel (domainOf I) Tid.primeCheckX)
    (fun c =>
      [ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeCheckX)
      , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
    6 4
    (fun _ => rfl)
    (primeCheckXXAReadPred I)
    (fun c => (⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold primeCheckXXAReadPred
      · exact xAReadPredCore_false_of_ne Loc.xA' OpType.wt (by decide)
      · exact xAReadPredCore_false_of_ne Loc.xB' OpType.wt (by decide)
      · exact xAReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)
      · exact xAReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide)
      · exact xAReadPredCore_false_of_ne Loc.xB OpType.rd (by decide))
    cnts 0 i c hc
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeCheckX)
    (l := primeCheckXBlockWord I cnts) htrace (primeCheckXXAReadPred_iff I) hfilt
  have hraw : rawNthEvent trace Tid.primeCheckX Loc.xA OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨c, hc, by injection hconn with hconn; rw [hconn]; rfl⟩

/-- See `primeAYLoopBody`. -/
def primeCheckYLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeCheckY.Vocab I) :=
  Command.seq (PrimeCheckY.body I)
    (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty)

/-- See `primeAYLoop`. -/
def primeCheckYLoop (I : PCPInstance) : Command (domainOf I) (PrimeCheckY.Vocab I) :=
  Command.whileLoop PrimeCheckY.BExpr.isB (primeCheckYLoopBody I)

/-- The word of `M + 1` iterations of `primeCheckYLoop`: `M + 1` copies of the
block `[wt yA', wt yB', rd yA', rd yB', rd yA, rd yB]`, with counters
`cnts`. -/
def primeCheckYBlockWord (I : PCPInstance) (cnts : List (Fin 4)) :
    Word (ThreadLabel (domainOf I) Tid.primeCheckY) :=
  cnts.flatMap (fun c =>
    [ (⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY c), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeCheckY)
    , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY c), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY c), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY c), rfl⟩ ])

/-- `primeCheckY`'s `yA'`-reads all expect `Val.primeTag Tid.primeAY 0`. -/
theorem primeCheckYBlockWord_yA'read_val (I : PCPInstance) (cnts : List (Fin 4)) :
    ∀ lab ∈ primeCheckYBlockWord I cnts,
      lab.1.loc = (Loc.yA' : (domainOf I).Loc) → lab.1.op = OpType.rd →
      lab.1.val = Val.primeTag Tid.primeAY 0 := by
  intro lab hlab hloc hop
  unfold primeCheckYBlockWord at hlab
  obtain ⟨c, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd hop op_wt_ne_rd
  · exact absurd hop op_wt_ne_rd
  · rfl
  · exact absurd hloc loc_yB'_ne_yA'
  · exact absurd hloc loc_yA_ne_yA'
  · exact absurd hloc loc_yB_ne_yA'

/-- `rf_matches` for the `primeCheckY`/`yA'` branch (Eq. (17)/(17)). -/
theorem traceRf_matches_primeCheckY_yA' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceAY : trace Tid.primeAY = primeAYBlockWord I vals)
    (cnts : List (Fin 4)) (htracePVY : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeAY Loc.yA' i = some ew ∧
      rawNthRead trace Tid.primeCheckY Loc.yA' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  have h1 := rawNthWrite_val_of_forall_mem htraceAY (primeAYBlockWord_yA'_val I vals) hew
  have h2 := rawNthRead_val_of_forall_mem htracePVY (primeCheckYBlockWord_yA'read_val I cnts) her
  rw [h1, h2]

/-- `primeCheckY`'s `yB'`-reads all expect `Val.primeTag Tid.primeBY 0`. -/
theorem primeCheckYBlockWord_yB'read_val (I : PCPInstance) (cnts : List (Fin 4)) :
    ∀ lab ∈ primeCheckYBlockWord I cnts,
      lab.1.loc = (Loc.yB' : (domainOf I).Loc) → lab.1.op = OpType.rd →
      lab.1.val = Val.primeTag Tid.primeBY 0 := by
  intro lab hlab hloc hop
  unfold primeCheckYBlockWord at hlab
  obtain ⟨c, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd hop op_wt_ne_rd
  · exact absurd hop op_wt_ne_rd
  · exact absurd hloc loc_yA'_ne_yB'
  · rfl
  · exact absurd hloc loc_yA_ne_yB'
  · exact absurd hloc loc_yB_ne_yB'

/-- `rf_matches` for the `primeCheckY`/`yB'` branch (Eq. (17)/(17)). -/
theorem traceRf_matches_primeCheckY_yB' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceBY : trace Tid.primeBY = primeBYBlockWord I vals)
    (cnts : List (Fin 4)) (htracePVY : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeBY Loc.yB' i = some ew ∧
      rawNthRead trace Tid.primeCheckY Loc.yB' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  have h1 := rawNthWrite_val_of_forall_mem htraceBY (primeBYBlockWord_yB'_val I vals) hew
  have h2 := rawNthRead_val_of_forall_mem htracePVY (primeCheckYBlockWord_yB'read_val I cnts) her
  rw [h1, h2]
/-- One iteration of `primeCheckYLoop` (as `primeCheckX_iter_step`). -/
theorem primeCheckY_iter_step (I : PCPInstance) (v : PrimeCheckY.Vals)
    (rest : List PrimeCheckY.Vals)
    (φ : (PrimeCheckY.Vocab I).Store) (hb : φ PrimeCheckY.Vars.b = Sum.inr true)
    (hv : v ∈ PrimeCheckY.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeCheckY.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeCheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckY.Vocab I)),
      φ' PrimeCheckY.Vars.b = v ∧
      φ' PrimeCheckY.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeCheckY (v :: rest)
        (primeCheckYLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeCheckY (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.wt Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeCheckY (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yA (Val.primeTag Tid.checkY (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeCheckY Loc.yB (Val.primeTag Tid.checkY (cnt0 + 1)), rfl⟩ ]
        cLast rest (primeCheckYLoop I, φ') := by
  set φ1 : (PrimeCheckY.Vocab I).Store :=
    Function.update φ PrimeCheckY.Vars.cnt (PrimeCheckY.eval PrimeCheckY.Expr.nextCnt φ)
    with hφ1
  have h1 : Command.RunStep Tid.primeCheckY (v :: rest) none (primeCheckYLoop I, φ) (v :: rest)
      (Command.loopSeq (primeCheckYLoopBody I) (primeCheckYLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeCheckYLoop, Command.step, PrimeCheckY.Vocab, PrimeCheckY.evalB, hb,
        if_true])
  have h2 : Command.RunStep Tid.primeCheckY (v :: rest) none
      (Command.loopSeq (primeCheckYLoopBody I) (primeCheckYLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yA' PrimeCheckY.VExpr.cntTagVal)
        (Command.seq (Command.write Loc.yB' PrimeCheckY.VExpr.cntTagVal)
          (Command.seq (Command.read Loc.yA' PrimeCheckY.VExpr.yApExpect)
            (Command.seq (Command.read Loc.yB' PrimeCheckY.VExpr.yBpExpect)
              (Command.seq (Command.read Loc.yA PrimeCheckY.VExpr.checkExpect)
                (Command.read Loc.yB PrimeCheckY.VExpr.checkExpect)))))))
        (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty))
        (primeCheckYLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeCheckYLoopBody, PrimeCheckY.body, Command.step, PrimeCheckY.Vocab]; rfl)
  have h3 : Command.RunStep Tid.primeCheckY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yA' PrimeCheckY.VExpr.cntTagVal)
        (Command.seq (Command.write Loc.yB' PrimeCheckY.VExpr.cntTagVal)
          (Command.seq (Command.read Loc.yA' PrimeCheckY.VExpr.yApExpect)
            (Command.seq (Command.read Loc.yB' PrimeCheckY.VExpr.yBpExpect)
              (Command.seq (Command.read Loc.yA PrimeCheckY.VExpr.checkExpect)
                (Command.read Loc.yB PrimeCheckY.VExpr.checkExpect)))))))
        (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty))
        (primeCheckYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yA' PrimeCheckY.VExpr.cntTagVal)
        (Command.seq (Command.write Loc.yB' PrimeCheckY.VExpr.cntTagVal)
          (Command.seq (Command.read Loc.yA' PrimeCheckY.VExpr.yApExpect)
            (Command.seq (Command.read Loc.yB' PrimeCheckY.VExpr.yBpExpect)
              (Command.seq (Command.read Loc.yA PrimeCheckY.VExpr.checkExpect)
                (Command.read Loc.yB PrimeCheckY.VExpr.checkExpect))))))
        (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty))
        (primeCheckYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.primeCheckY (v :: rest)
      (some ⟨EventLabel.wt Tid.primeCheckY Loc.yA'
        ((PrimeCheckY.Vocab I).evalV PrimeCheckY.VExpr.cntTagVal φ1), rfl⟩)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yA' PrimeCheckY.VExpr.cntTagVal)
        (Command.seq (Command.write Loc.yB' PrimeCheckY.VExpr.cntTagVal)
          (Command.seq (Command.read Loc.yA' PrimeCheckY.VExpr.yApExpect)
            (Command.seq (Command.read Loc.yB' PrimeCheckY.VExpr.yBpExpect)
              (Command.seq (Command.read Loc.yA PrimeCheckY.VExpr.checkExpect)
                (Command.read Loc.yB PrimeCheckY.VExpr.checkExpect))))))
        (Command.ndetAssign PrimeCheckY.Vars.b PrimeCheckY.X PrimeCheckY.X_nonempty))
        (primeCheckYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.yB' PrimeCheckY.VExpr.cntTagVal)
          (Command.seq (Command.read Loc.yA' PrimeCheckY.VExpr.yApExpect)
            (Command.seq (Command.read Loc.yB' PrimeCheckY.VExpr.yBpExpect)
