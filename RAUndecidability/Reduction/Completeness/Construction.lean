      guessAYBlockRestElems_zAxy_filter]
    simp
  have hilt : i < kws.length :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  obtain ⟨kw, hkw⟩ : ∃ kw, kws[i]? = some kw := ⟨kws[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfiltrest := zipIdx_flatMap_filter_getElem
    (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessAY)
    (guessAYBlockRestElems I) 5 3
    (fun kw => rfl)
    (guessAYZAxyReadPred I)
    (fun kw => (⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt kw.1), rfl⟩ :
      ThreadLabel (domainOf I) Tid.guessAY))
    (fun a => rfl)
    (fun a => by
      unfold guessAYZAxyReadPred
      exact (zAxyReadPredCore_iff Loc.zAxy OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro a q b hq hget
      have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
      have hq4 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 := by omega
      rcases hq4 with rfl | rfl | rfl | rfl <;>
        simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessAYZAxyReadPred
      · exact zAxyReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact zAxyReadPredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
      · exact zAxyReadPredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
      · exact zAxyReadPredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
    kws 3 i kw hkw
  have hz0 : (((guessAYBlock0Elems I v0).zipIdx).filter
      (fun p => guessAYZAxyReadPred I p.1)) = [] := by
    show List.filter (fun p => guessAYZAxyReadPred I p.1)
      (List.zipIdx
        [ (⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY)
      , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩
      , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ ])
      = ([] : List (ThreadLabel (domainOf I) Tid.guessAY × ℕ))
    rfl
  have hzip : (guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYZAxyReadPred I p.1) =
      ((kws.flatMap (guessAYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessAYZAxyReadPred I p.1) := by
    unfold guessAYBlockWord
    rw [List.zipIdx_append, List.filter_append, hz0]
    rfl
  have hzipj :
      ((guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYZAxyReadPred I p.1))[i]?
      = some ((⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt kw.1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY), 3 + i * 5 + 3) := by
    rw [hzip]
    exact hfiltrest
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
    (l := guessAYBlockWord I v0 kws) htrace (guessAYZAxyReadPred_iff I) hzipj
  have hraw : rawNthEvent trace Tid.guessAY Loc.zAxy OpType.rd i = some er := h
  rw [hraw] at hconn
  exact ⟨kw, hkw, by injection hconn with hconn; rw [hconn]; rfl⟩

/-- `rf_total` for the `guessAY`/`zAxy` branch (Eq. (15)): `guessAY` makes
`kws.length` `zAxy`-reads, `guessAX` makes `1 + outerRest.length`
`zAxy`-writes. -/
theorem traceRf_total_guessAY_zAxy (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessAX = guessAXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (hcount : kws.length ≤ 1 + outerRest.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessAY) (her_loc : er.loc = Loc.zAxy)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
