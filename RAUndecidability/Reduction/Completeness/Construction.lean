/-- The `guessBX`/`checkX` `xB` pair's letter agreement (as
`guessAX_checkX_rf_matches`, with the same `kws`/`v0` of `checkX`). -/
theorem guessBX_checkX_rf_matches (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.β).flatten = c0 :: cs)
    (K0 : ℕ) (hlen0 : (I.β j0).length = K0 + 1)
    (v1 : Val I) (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (hlen1 : inner0Rest.length = K0)
    (houterLenFacts : ∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
      (guessBXJsToKs I js)[m]? = some km ∧ vs.length = km + 1)
    (hv1raw : ∃ j : Fin (GuessBX.maxLen I + 2), j.val = 1 ∧
      v1 = Val.xTag (Tid.guessBX, true) (GuessBX.jthLetter I (some j0) j))
    (hinnerraw : ∀ n, n < inner0Rest.length → ∃ e j, inner0Rest[n]? = some e ∧ j.val = n + 2 ∧
      e.1 = Val.xTag (Tid.guessBX, false) (GuessBX.jthLetter I (some j0) j))
    (houterraw : ∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
      (m < js.length → ∃ w, js[m]? = some w ∧
        ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessBX, false) (GuessBX.jthLetter I (some w) j)) ∧
      (m = js.length → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
        e.1 = Val.xTag (Tid.guessBX, false) (GuessBX.jthLetter I none j)))
    (v0 : I.Γ) (hv0 : v0 = c0)
    (kws : List (Fin 4 × Option I.Γ))
    (hkwsraw : ∀ i, i < kws.length →
      ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = cs[i]?) :
    v0 = c0 ∧ v1 = Val.xTag (Tid.guessBX, true) (some c0) ∧
    (∀ n, n < inner0Rest.length → ∃ e, inner0Rest[n]? = some e ∧
      ∃ c, cs[n]? = some c ∧ e.1 = Val.xTag (Tid.guessBX, false) (some c)) ∧
    (∀ m, m < js.length + 1 → ∀ b vs, outerRest[m]? = some (b, vs) →
      ∀ n e, n < vs.length → vs[n]? = some e →
      e.1 = Val.xTag (Tid.guessBX, false) (cs[K0 + ksPrefix (guessBXJsToKs I js) m + n]?)) ∧
    (∀ i, i < kws.length → ∃ kw, kws[i]? = some kw ∧ kw.2 = cs[i]?) := by
  refine ⟨hv0, ?_, ?_, ?_, ?_⟩
  · obtain ⟨j, hj, hveq⟩ := hv1raw
    have hjeq0 : j.val = 0 + 1 := by omega
    rw [hveq, GuessBX_jthLetter_some I j0 j 0 hjeq0, hv1_position_β I j0 js c0 cs hflat]
  · intro n hn
    obtain ⟨e, j, he, hj, hev⟩ := hinnerraw n hn
    have hn' : n < K0 := by omega
    have hn1 : n + 1 < (I.β j0).length := by omega
    have hcs : cs[n]? = some (I.β j0)[n + 1] := by
      rw [← hinnerAgree_position_β I j0 js c0 cs hflat K0 hlen0 n hn']
      exact List.getElem?_eq_getElem hn1
    refine ⟨e, he, (I.β j0)[n + 1], hcs, ?_⟩
    rw [hev]
    have hjeq : j.val = (n + 1) + 1 := by omega
    rw [GuessBX_jthLetter_some I j0 j (n + 1) hjeq, List.getElem?_eq_getElem hn1]
  · intro m hm b vs hbv n e hnlt hvsn
    obtain ⟨b', vs', hbv', hcase⟩ := houterraw m hm
    have heq1 : some (b, vs) = some (b', vs') := hbv.symm.trans hbv'
    simp only [Option.some.injEq, Prod.mk.injEq] at heq1
    obtain ⟨hbeq, hvseq⟩ := heq1
    subst hbeq; subst hvseq
    rcases Nat.lt_or_ge m js.length with hmlt | hmge
    · obtain ⟨w, hw, hval⟩ := hcase.1 hmlt
      obtain ⟨e', j, hvsn', hj, hev⟩ := hval n hnlt
      have heq2 : some e = some e' := hvsn.symm.trans hvsn'
      injection heq2 with heq2
      subst heq2
      rw [hev]
      have hwjs : js[m]? = some js[m] := List.getElem?_eq_getElem hmlt
      have heq3 : some w = some js[m] := hw.symm.trans hwjs
      injection heq3 with heq3
      subst heq3
      obtain ⟨b'', vs'', km, hbv'', hkm, hvslen⟩ := houterLenFacts m hmlt
      have heq4 : some (b, vs) = some (b'', vs'') := hbv.symm.trans hbv''
      simp only [Option.some.injEq, Prod.mk.injEq] at heq4
      obtain ⟨_, hvseq2⟩ := heq4
      have hkmeq : (guessBXJsToKs I js)[m]? = some ((I.β js[m]).length - 1) := by
        unfold guessBXJsToKs
        rw [List.getElem?_map, hwjs]
        rfl
      rw [hkmeq] at hkm
      injection hkm with hkm
      have hpos : 0 < (I.β js[m]).length := List.length_pos_of_ne_nil (I.hβ js[m])
      have hnlen : n < (I.β js[m]).length := by
        rw [hvseq2] at hnlt
        omega
      have hjeq : j.val = n + 1 := hj
      rw [GuessBX_jthLetter_some I js[m] j n hjeq,
        houterAgree_position_β I j0 js c0 cs hflat K0 hlen0 m hmlt n hnlen]
    · have hmeq : m = js.length := by omega
      obtain ⟨e', j, hvsn', hj, hev⟩ := hcase.2 hmeq n hnlt
      have heq2 : some e = some e' := hvsn.symm.trans hvsn'
      injection heq2 with heq2
      subst heq2
      rw [hev, GuessBX_jthLetter_none]
      have hge := houterAgree_last_index_β I j0 js c0 cs hflat K0 hlen0
      rw [hmeq]
      have hge2 : K0 + ksPrefix (guessBXJsToKs I js) js.length + n ≥ cs.length := by omega
      rw [List.getElem?_eq_none hge2]
  · intro i hi
    obtain ⟨w, hw, hweq⟩ := hkwsraw i hi
    exact ⟨(⟨(1 + i) % 4, by omega⟩, w), hw, hweq⟩

/-! ## Counts for Eq. (15), for `rf_total`

For each of these pairs, the reader's count is at most the writer's. On the
primed-location direction of each guesser/primed pair, and on `zAxy`/`zBxy`,
the writer makes exactly one more write: the first inner call of
`guessAX`/`guessBX` and block 0 of `guessAY`/`guessBY` write without the
matching read. -/

/-- The `primeAX`/`guessAX` pair on `zAxx'`: equal counts (every inner call
of `guessAX` but the first reads `zAxx'`). -/
theorem primeAX_guessAX_zAxx'_rf_total (I : PCPInstance) (cs : List I.Γ)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1)
    (hsum : 1 + inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum = 1 + kws.length)
    (vals : List (Val I)) (hvals : vals.length = cs.length + 1) :
    inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum ≤ vals.length := by
  omega

/-- The `guessAX`/`primeAX` pair on `zAx'x`: `guessAX` makes one more
`zAx'x`-write than `primeAX` makes reads. -/
theorem guessAX_primeAX_zAx'x_rf_total (I : PCPInstance) (cs : List I.Γ)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1)
    (hsum : 1 + inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum = 1 + kws.length)
    (vals : List (Val I)) (hvals : vals.length = cs.length + 1) :
    vals.length ≤ 1 + inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum := by
  omega

/-- The `primeBX`/`guessBX` pair on `zBxx'`. -/
theorem primeBX_guessBX_zBxx'_rf_total (I : PCPInstance) (cs : List I.Γ)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
