theorem guessBY_blockRest_continue_step (I : PCPInstance) (v : Fin I.n) (v0' : Option (Fin I.n))
    (rest : List (GuessBY.Vals I))
    (φ : (GuessBY.Vocab I).Store) (hfst : φ GuessBY.Vars.fst = Sum.inr (Sum.inr false))
    (k : Fin 4) (hcnt0 : φ GuessBY.Vars.cnt = Sum.inr (Sum.inl k))
    (haux : φ GuessBY.Vars.aux = Sum.inl (some v)) :
    ∃ (φ' : (GuessBY.Vocab I).Store) (cLast : Config (domainOf I) (GuessBY.Vocab I)),
      φ' GuessBY.Vars.aux = Sum.inl v0' ∧ φ' GuessBY.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' GuessBY.Vars.cnt = Sum.inr (Sum.inl (k + 1)) ∧
      Command.Run Tid.guessBY (Sum.inl v0' :: rest)
        (guessBYLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) (some v)), rfl⟩
        , ⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux (k + 1) (some v)), rfl⟩
        , ⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt (k + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.guessBY Loc.zBxy (Val.cnt k), rfl⟩
        , ⟨EventLabel.rd Tid.guessBY Loc.zByy' (Val.cnt k), rfl⟩ ]
        cLast rest (guessBYLoop I, φ') := by
  set φ0 : (GuessBY.Vocab I).Store :=
    Function.update φ GuessBY.Vars.prev (GuessBY.eval I GuessBY.Expr.readCnt φ) with hφ0
  set φ1 : (GuessBY.Vocab I).Store :=
    Function.update φ0 GuessBY.Vars.cnt (GuessBY.eval I GuessBY.Expr.nextCnt φ0) with hφ1
  have hne1 : GuessBY.Vars.fst ≠ GuessBY.Vars.cnt := by decide
  have hne2 : GuessBY.Vars.fst ≠ GuessBY.Vars.prev := by decide
