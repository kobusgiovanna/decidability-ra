/-- `G`'s `rf` preserves indices (`w_i ⟶rf r_i`): in each branch
of `traceRf`, `ew` and `er` are the `i`-th write and read for a common
`i`. -/
theorem traceRf_rawIndex_eq {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {ew er : Event (domainOf I)} (h : traceRf I trace ew er) :
    rawIndex trace ew = rawIndex trace er := by
  unfold traceRf at h
  rcases her : er.tid with _|_|_|_|_|_|_|_|_|_|_|_ <;> rw [her] at h <;>
    rcases hel : er.loc with
      _|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_|_ <;>
    rw [hel] at h <;>
    first
      | (obtain ⟨i, hw, hr⟩ := h
         exact (rawNthEvent_rawIndex hw).trans (rawNthEvent_rawIndex hr).symm)
      | (simp at h)

/-! ## The thread-level `rf` topology (Fig. 4), second half: cyclic sequences have length 2

`ThreadRf` is the paper's notation ("Let `t →rf t'` denote that `G`
has an `rf`-edge from an event of thread `t` to an event of thread `t'`"),
and `traceRf_cycle_length_two` states that every cyclic sequence of pairwise
distinct threads `t_1 → t_2 → ⋯ → t_m → t_1` has length 2 (as
`l : List Tid` with `l.Nodup`, `l ≠ []` and
`List.IsChain ThreadRf (l ++ [l.headI])`).

As in the paper, the threads split into four groups: the checker pairs
`XCheckerTids`/`YCheckerTids`, which no edge leaves (so a cycle meeting one
stays in it, and has length at most 2), and the guesser groups
`AlphaGuesserTids`/`BetaGuesserTids`, which no edge enters from outside;
within a guesser group the edges form the path
`g_α^{x'} - g_α^x - g_α^y - g_α^{y'}` (resp. its `β` analogue), on which every
cycle has length 2. -/

/-- `t →rf t'` (Fig. 4): `traceRf` has an edge from an event of
thread `t` to an event of thread `t'`. -/
def ThreadRf (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (t t' : Tid) : Prop :=
  ∃ ew er, traceRf I trace ew er ∧ ew.tid = t ∧ er.tid = t'

/-- The thread-level `rf` topology (Fig. 4), first half, in terms of `ThreadRf`. -/
theorem threadRf_pairs {trace : ∀ t, Word (ThreadLabel (domainOf I) t)} {t t' : Tid}
    (h : ThreadRf I trace t t') :
    (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY) := by
  obtain ⟨ew, er, hrf, hewtid, hertid⟩ := h
  have hp := traceRf_tid_pairs I hrf
  rwa [hewtid, hertid] at hp

/-- The four groups of the thread-level `rf` topology (Fig. 4), argument: two guesser groups and two
checker groups, partitioning the twelve threads (`threadGroups_cover`). -/
def AlphaGuesserTids : Finset Tid := {Tid.guessAX, Tid.primeAX, Tid.guessAY, Tid.primeAY}

def BetaGuesserTids : Finset Tid := {Tid.guessBX, Tid.primeBX, Tid.guessBY, Tid.primeBY}

def XCheckerTids : Finset Tid := {Tid.checkX, Tid.primeCheckX}

def YCheckerTids : Finset Tid := {Tid.checkY, Tid.primeCheckY}

theorem threadGroups_cover (t : Tid) :
    t ∈ AlphaGuesserTids ∨ t ∈ BetaGuesserTids ∨
      t ∈ XCheckerTids ∨ t ∈ YCheckerTids := by
  revert t; decide

/-- No edge leaves `XCheckerTids = {c^x,c^{x'}}`. -/
theorem xCheckerTids_closed {t t' : Tid} (ht : t ∈ XCheckerTids)
    (hp : (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
