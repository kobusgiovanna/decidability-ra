        ThreadLabel (domainOf I) Tid.guessAY)] := by
  apply list_filter_singleton_of_unique' (guessAYBlock0Elems I v0) (guessAYEllAWritePred I) 1
    (⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩)
    rfl
    (by unfold guessAYEllAWritePred
        exact (ellAyxWritePredCore_iff Loc.ellAyx OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq02 : q = 0 ∨ q = 2 := by omega
      rcases hq02 with rfl | rfl <;>
        simp only [guessAYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessAYEllAWritePred
      · exact ellAyxWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact ellAyxWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide))

theorem guessAYBlockRestElems_ellAyx_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
