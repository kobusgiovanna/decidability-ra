      (guessAXZAxyWritePred I)).length = 1 + outerRest.length := by
    rw [guessAXBlockWord_zAxy_filter_eq, List.length_append, List.length_singleton,
      List.length_map]
  have hilt_writer : i < (rawOpEvents trace Tid.guessAX Loc.zAxy OpType.wt).length := by
