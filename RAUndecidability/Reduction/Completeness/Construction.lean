theorem guessAYBlock0Elems_zAy'y_zipIdx_filter (I : PCPInstance) (v0 : Fin I.n) (k : ℕ) :
    (((guessAYBlock0Elems I v0).zipIdx k).filter (fun p => guessAYZAyprimeWritePred I p.1)) =
