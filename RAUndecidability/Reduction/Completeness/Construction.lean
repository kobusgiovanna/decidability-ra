/-! ## `rf_matches`: `primeCheckX`/`xA'` (Eq. (17))

`primeAX` always writes `Val.primeTag Tid.primeAX 0` to `xA'`, and
`primeCheckX` always expects this value there, so both sides are constant. -/

/-- `Loc.zAxx' ≠ Loc.xA'`. (Stated without parameters so that `decide`
applies.) -/
theorem loc_zAxx'_ne_xA' : Loc.zAxx' ≠ Loc.xA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xB'_ne_xA' : Loc.xB' ≠ Loc.xA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xA_ne_xA' : Loc.xA ≠ Loc.xA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xB_ne_xA' : Loc.xB ≠ Loc.xA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem op_rd_ne_wt : OpType.rd ≠ OpType.wt := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem op_wt_ne_rd : OpType.wt ≠ OpType.rd := by decide

/-- `primeAX`'s `xA'`-writes all carry `Val.primeTag Tid.primeAX 0`. -/
theorem primeAXBlockWord_xA'_val (I : PCPInstance) (vals : List (Val I)) :
    ∀ lab ∈ primeAXBlockWord I vals,
      lab.1.loc = (Loc.xA' : (domainOf I).Loc) → lab.1.op = OpType.wt →
      lab.1.val = Val.primeTag Tid.primeAX 0 := by
  intro lab hlab hloc hop
  unfold primeAXBlockWord at hlab
  obtain ⟨v, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl
  · rfl
  · exact absurd hloc loc_zAxx'_ne_xA'
  · exact absurd hop op_rd_ne_wt

/-- One iteration of `primeAXLoop`, from a state with `φ.b = True` and
`cnt = cnt0`, under resolution `v :: rest`: emits the three-event block with
value `Val.cnt (cnt0 + 1)` (for both the `zAxx'`-write and the
`zAx'x`-read), and returns to the loop with `cnt = cnt0 + 1`, `b = v`.
Eleven `Command.RunStep`s. -/
theorem primeAX_iter_step (I : PCPInstance) (v : PrimeAX.Vals) (rest : List PrimeAX.Vals)
    (φ : (PrimeAX.Vocab I).Store) (hb : φ PrimeAX.Vars.b = Sum.inr true) (hv : v ∈ PrimeAX.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeAX.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeAX.Vocab I).Store) (cLast : Config (domainOf I) (PrimeAX.Vocab I)),
      φ' PrimeAX.Vars.b = v ∧
      φ' PrimeAX.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeAX (v :: rest)
        (primeAXLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
        , ⟨EventLabel.wt Tid.primeAX Loc.zAxx' (Val.cnt (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeAX Loc.zAx'x (Val.cnt (cnt0 + 1)), rfl⟩ ]
        cLast rest (primeAXLoop I, φ') := by
  set φ1 : (PrimeAX.Vocab I).Store :=
    Function.update φ PrimeAX.Vars.cnt (PrimeAX.eval PrimeAX.Expr.nextCnt φ) with hφ1
  have h1 : Command.RunStep Tid.primeAX (v :: rest) none (primeAXLoop I, φ) (v :: rest)
      (Command.loopSeq (primeAXLoopBody I) (primeAXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAXLoop, Command.step, PrimeAX.Vocab, PrimeAX.evalB, hb, if_true])
  have h2 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq (primeAXLoopBody I) (primeAXLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.xA' PrimeAX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAXLoopBody, PrimeAX.body, Command.step, PrimeAX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.xA' PrimeAX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.xA' PrimeAX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.primeAX (v :: rest)
      (some ⟨EventLabel.wt Tid.primeAX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.xA' PrimeAX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, PrimeAX.Vocab, PrimeAX.evalV])
  have h5 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.primeAX (v :: rest)
      (some ⟨EventLabel.wt Tid.primeAX Loc.zAxx' ((PrimeAX.Vocab I).evalV PrimeAX.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zAxx' PrimeAX.VExpr.cntVal)
          (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h7 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal))
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.primeAX (v :: rest)
      (some ⟨EventLabel.rd Tid.primeAX Loc.zAx'x ((PrimeAX.Vocab I).evalV PrimeAX.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zAx'x PrimeAX.VExpr.cntVal)
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h9 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)) (primeAXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty) (primeAXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h10 : Command.RunStep Tid.primeAX (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty) (primeAXLoop I), φ1)
      rest
      (Command.loopSeq Command.skip (primeAXLoop I),
        Function.update φ1 PrimeAX.Vars.b v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h11 : Command.RunStep Tid.primeAX rest none
      (Command.loopSeq Command.skip (primeAXLoop I), Function.update φ1 PrimeAX.Vars.b v)
      rest
      (primeAXLoop I, Function.update φ1 PrimeAX.Vars.b v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.primeAX) (s := v :: rest) (c := (primeAXLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.labelledSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have hcnt1 : φ1 PrimeAX.Vars.cnt = Sum.inl (cnt0 + 1) :=
    (Function.update_self PrimeAX.Vars.cnt (PrimeAX.eval PrimeAX.Expr.nextCnt φ) φ).trans
      (by simp only [PrimeAX.eval, hcnt0]; rfl)
  have hl : (PrimeAX.Vocab I).evalV PrimeAX.VExpr.cntVal φ1 = Val.cnt (cnt0 + 1) := by
    simp only [PrimeAX.Vocab, PrimeAX.evalV, hcnt1]; rfl
  rw [hl] at run11
  have hne_cntb : PrimeAX.Vars.cnt ≠ PrimeAX.Vars.b := by decide
  refine ⟨Function.update φ1 PrimeAX.Vars.b v, _, Function.update_self _ _ _, ?_, run11⟩
  exact (Function.update_of_ne hne_cntb v φ1).trans hcnt1

/-- From `φ.b = False`, `primeAXLoop` halts in one silent step. -/
theorem primeAX_stop_step (I : PCPInstance) (rest : List PrimeAX.Vals)
    (φ : (PrimeAX.Vocab I).Store) (hb : φ PrimeAX.Vars.b = Sum.inr false) :
    Command.Run Tid.primeAX rest (primeAXLoop I, φ) [] (primeAXLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeAX rest none (primeAXLoop I, φ) rest (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAXLoop, Command.step, PrimeAX.Vocab, PrimeAX.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- `M + 1` iterations of `primeAXLoop`: under resolution
`List.replicate M True ++ [False]`, from a state with `φ.b = True` and
`cnt = cnt0`, the loop emits `primeAXBlockWord I vals` with
`vals[i] = Val.cnt ((cnt0 + i + 1) mod 4)`. By induction on `M`. -/
theorem primeAX_shape (I : PCPInstance) (M : ℕ) (φ : (PrimeAX.Vocab I).Store)
    (hb : φ PrimeAX.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeAX.Vars.cnt = Sum.inl cnt0) :
    ∃ (vals : List (Val I)) (φ' : (PrimeAX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeAX.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeAX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeAX (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeAXLoop I, φ) (primeAXBlockWord I vals) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeAX_iter_step I (Sum.inr false) [] φ hb (by simp [PrimeAX.X]) cnt0 hcnt0
      have hrun2 := primeAX_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[Val.cnt (cnt0 + 1)], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeAX_iter_step I (Sum.inr true) (List.replicate M (Sum.inr true) ++ [Sum.inr false])
          φ hb (by simp [PrimeAX.X]) cnt0 hcnt0
      obtain ⟨vals, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨Val.cnt (cnt0 + 1) :: vals, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < vals.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 2
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-! ## `PrimeAX`'s whole run -/

/-- `PrimeAX`'s program, run from its initial store, for an arbitrary
instance `I` and number of iterations: the leading `NDet({False,True})` draw
(`true`), then `primeAX_shape`, then the final step to `Command.term`.
(`Command.whileNdet` desugars to `.seq (.seq (ndetAssign) (primeAXLoop)) .term`.) -/
theorem primeAX_general_run (I : PCPInstance) (M : ℕ) :
    ∃ (vals : List (Val I)) (φ' : (PrimeAX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeAX.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeAX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeAX
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeAX.program I,
          (PrimeAX.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeAXBlockWord I vals)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeAX.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty)
        (primeAXLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeAX.Vocab I).Store :=
    (PrimeAX.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeAX.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeAX.Vals) ∈ PrimeAX.X := by
    unfold PrimeAX.X; decide
  set rest0 : List PrimeAX.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeAX (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeAX.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeAX.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeAX (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeAX.Vars.b PrimeAX.X PrimeAX.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeAX.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeAXLoop I) hrun1
  set φ1 : (PrimeAX.Vocab I).Store := Function.update φ0 PrimeAX.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeAX rest0 none
      (⟨Command.seq Command.skip (primeAXLoop I), φ1⟩ : Config (domainOf I) (PrimeAX.Vocab I))
      rest0 ⟨primeAXLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeAX.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeAX.Vars.cnt ≠ PrimeAX.Vars.b := by decide
  have hcnt1 : φ1 PrimeAX.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨vals, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeAX_shape I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeAX ([] : List PrimeAX.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeAX.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨vals, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩

def primeAYLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeAY.Vocab I) :=
  Command.seq (PrimeAY.body I) (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)

/-- `PrimeAY`'s loop, without the initial `ndetAssign` of
`Command.whileNdet`. -/
def primeAYLoop (I : PCPInstance) : Command (domainOf I) (PrimeAY.Vocab I) :=
  Command.whileLoop PrimeAY.BExpr.isB (primeAYLoopBody I)

/-- The word of `M + 1` iterations of `primeAYLoop`: `M + 1` copies of the
block `[wt yA', wt zAyy', rd zAy'y]`. -/
def primeAYBlockWord (I : PCPInstance) (vals : List (Val I)) :
    Word (ThreadLabel (domainOf I) Tid.primeAY) :=
  vals.flatMap (fun l =>
    [ (⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeAY)
    , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' l, rfl⟩
    , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y l, rfl⟩ ])

/-! ## `rf_matches`: `primeCheckY`/`yA'` (Eq. (17))

`primeAY` always writes `Val.primeTag Tid.primeAY 0` to `yA'`, and
`primeCheckY` always expects this value there. -/

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_zAyy'_ne_yA' : Loc.zAyy' ≠ Loc.yA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yB'_ne_yA' : Loc.yB' ≠ Loc.yA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yA_ne_yA' : Loc.yA ≠ Loc.yA' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yB_ne_yA' : Loc.yB ≠ Loc.yA' := by decide

/-- `primeAY`'s `yA'`-writes all carry `Val.primeTag Tid.primeAY 0`. -/
theorem primeAYBlockWord_yA'_val (I : PCPInstance) (vals : List (Val I)) :
    ∀ lab ∈ primeAYBlockWord I vals,
      lab.1.loc = (Loc.yA' : (domainOf I).Loc) → lab.1.op = OpType.wt →
      lab.1.val = Val.primeTag Tid.primeAY 0 := by
  intro lab hlab hloc hop
  unfold primeAYBlockWord at hlab
  obtain ⟨v, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl
  · rfl
  · exact absurd hloc loc_zAyy'_ne_yA'
  · exact absurd hop op_rd_ne_wt

/-- One iteration of `primeAYLoop` (as `primeAX_iter_step`). -/
theorem primeAY_iter_step (I : PCPInstance) (v : PrimeAY.Vals) (rest : List PrimeAY.Vals)
    (φ : (PrimeAY.Vocab I).Store) (hb : φ PrimeAY.Vars.b = Sum.inr true) (hv : v ∈ PrimeAY.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeAY.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeAY.Vocab I).Store) (cLast : Config (domainOf I) (PrimeAY.Vocab I)),
      φ' PrimeAY.Vars.b = v ∧
      φ' PrimeAY.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeAY (v :: rest)
        (primeAYLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩
        , ⟨EventLabel.wt Tid.primeAY Loc.zAyy' (Val.cnt (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeAY Loc.zAy'y (Val.cnt (cnt0 + 1)), rfl⟩ ]
        cLast rest (primeAYLoop I, φ') := by
  set φ1 : (PrimeAY.Vocab I).Store :=
    Function.update φ PrimeAY.Vars.cnt (PrimeAY.eval PrimeAY.Expr.nextCnt φ) with hφ1
  have h1 : Command.RunStep Tid.primeAY (v :: rest) none (primeAYLoop I, φ) (v :: rest)
      (Command.loopSeq (primeAYLoopBody I) (primeAYLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAYLoop, Command.step, PrimeAY.Vocab, PrimeAY.evalB, hb, if_true])
  have h2 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq (primeAYLoopBody I) (primeAYLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yA' PrimeAY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAYLoopBody, PrimeAY.body, Command.step, PrimeAY.Vocab]; rfl)
  have h3 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yA' PrimeAY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yA' PrimeAY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.primeAY (v :: rest)
      (some ⟨EventLabel.wt Tid.primeAY Loc.yA' (Val.primeTag Tid.primeAY 0), rfl⟩)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yA' PrimeAY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, PrimeAY.Vocab, PrimeAY.evalV])
  have h5 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.primeAY (v :: rest)
      (some ⟨EventLabel.wt Tid.primeAY Loc.zAyy' ((PrimeAY.Vocab I).evalV PrimeAY.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zAyy' PrimeAY.VExpr.cntVal)
          (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h7 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal))
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.primeAY (v :: rest)
      (some ⟨EventLabel.rd Tid.primeAY Loc.zAy'y ((PrimeAY.Vocab I).evalV PrimeAY.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zAy'y PrimeAY.VExpr.cntVal)
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h9 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)) (primeAYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty) (primeAYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h10 : Command.RunStep Tid.primeAY (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty) (primeAYLoop I), φ1)
      rest
      (Command.loopSeq Command.skip (primeAYLoop I),
        Function.update φ1 PrimeAY.Vars.b v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h11 : Command.RunStep Tid.primeAY rest none
      (Command.loopSeq Command.skip (primeAYLoop I), Function.update φ1 PrimeAY.Vars.b v)
      rest
      (primeAYLoop I, Function.update φ1 PrimeAY.Vars.b v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.primeAY) (s := v :: rest) (c := (primeAYLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.labelledSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have hcnt1 : φ1 PrimeAY.Vars.cnt = Sum.inl (cnt0 + 1) :=
    (Function.update_self PrimeAY.Vars.cnt (PrimeAY.eval PrimeAY.Expr.nextCnt φ) φ).trans
      (by simp only [PrimeAY.eval, hcnt0]; rfl)
  have hl : (PrimeAY.Vocab I).evalV PrimeAY.VExpr.cntVal φ1 = Val.cnt (cnt0 + 1) := by
    simp only [PrimeAY.Vocab, PrimeAY.evalV, hcnt1]; rfl
  rw [hl] at run11
  have hne_cntb : PrimeAY.Vars.cnt ≠ PrimeAY.Vars.b := by decide
  refine ⟨Function.update φ1 PrimeAY.Vars.b v, _, Function.update_self _ _ _, ?_, run11⟩
  exact (Function.update_of_ne hne_cntb v φ1).trans hcnt1

/-- From `φ.b = False`, `primeAYLoop` halts in one silent step. -/
theorem primeAY_stop_step (I : PCPInstance) (rest : List PrimeAY.Vals)
    (φ : (PrimeAY.Vocab I).Store) (hb : φ PrimeAY.Vars.b = Sum.inr false) :
    Command.Run Tid.primeAY rest (primeAYLoop I, φ) [] (primeAYLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeAY rest none (primeAYLoop I, φ) rest (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeAYLoop, Command.step, PrimeAY.Vocab, PrimeAY.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- `M + 1` iterations of `primeAYLoop` (as `primeAX_shape`). -/
theorem primeAY_shape (I : PCPInstance) (M : ℕ) (φ : (PrimeAY.Vocab I).Store)
    (hb : φ PrimeAY.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeAY.Vars.cnt = Sum.inl cnt0) :
    ∃ (vals : List (Val I)) (φ' : (PrimeAY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeAY.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeAY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeAY (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeAYLoop I, φ) (primeAYBlockWord I vals) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeAY_iter_step I (Sum.inr false) [] φ hb (by simp [PrimeAY.X]) cnt0 hcnt0
      have hrun2 := primeAY_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[Val.cnt (cnt0 + 1)], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeAY_iter_step I (Sum.inr true) (List.replicate M (Sum.inr true) ++ [Sum.inr false])
          φ hb (by simp [PrimeAY.X]) cnt0 hcnt0
      obtain ⟨vals, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨Val.cnt (cnt0 + 1) :: vals, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < vals.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 2
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-! ## `PrimeAY`'s whole run -/

/-- `PrimeAY`'s program, run from its initial store (as
`primeAX_general_run`). -/
theorem primeAY_general_run (I : PCPInstance) (M : ℕ) :
    ∃ (vals : List (Val I)) (φ' : (PrimeAY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeAY.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeAY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeAY
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeAY.program I,
          (PrimeAY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeAYBlockWord I vals)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeAY.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty)
        (primeAYLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeAY.Vocab I).Store :=
    (PrimeAY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeAY.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeAY.Vals) ∈ PrimeAY.X := by
    unfold PrimeAY.X; decide
  set rest0 : List PrimeAY.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeAY (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeAY.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeAY.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeAY (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeAY.Vars.b PrimeAY.X PrimeAY.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeAY.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeAYLoop I) hrun1
  set φ1 : (PrimeAY.Vocab I).Store := Function.update φ0 PrimeAY.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeAY rest0 none
      (⟨Command.seq Command.skip (primeAYLoop I), φ1⟩ : Config (domainOf I) (PrimeAY.Vocab I))
      rest0 ⟨primeAYLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeAY.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeAY.Vars.cnt ≠ PrimeAY.Vars.b := by decide
  have hcnt1 : φ1 PrimeAY.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨vals, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeAY_shape I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeAY ([] : List PrimeAY.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeAY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨vals, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩

def primeBXLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeBX.Vocab I) :=
  Command.seq (PrimeBX.body I) (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)

/-- `PrimeBX`'s loop alone — see `primeAXLoop`. -/
def primeBXLoop (I : PCPInstance) : Command (domainOf I) (PrimeBX.Vocab I) :=
  Command.whileLoop PrimeBX.BExpr.isB (primeBXLoopBody I)

/-- See `primeAXBlockWord`. -/
def primeBXBlockWord (I : PCPInstance) (vals : List (Val I)) :
    Word (ThreadLabel (domainOf I) Tid.primeBX) :=
  vals.flatMap (fun l =>
    [ (⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeBX)
    , ⟨EventLabel.wt Tid.primeBX Loc.zBxx' l, rfl⟩
    , ⟨EventLabel.rd Tid.primeBX Loc.zBx'x l, rfl⟩ ])

/-- See `primeAX_stop_step`. -/
theorem primeBX_stop_step (I : PCPInstance) (rest : List PrimeBX.Vals)
    (φ : (PrimeBX.Vocab I).Store) (hb : φ PrimeBX.Vars.b = Sum.inr false) :
    Command.Run Tid.primeBX rest (primeBXLoop I, φ) [] (primeBXLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeBX rest none (primeBXLoop I, φ) rest (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBXLoop, Command.step, PrimeBX.Vocab, PrimeBX.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- One iteration of `primeBXLoop`, with the value `Val.cnt (cnt0 + 1)` (as
`primeAX_iter_step`). -/
theorem primeBX_iter_step_val (I : PCPInstance) (v : PrimeBX.Vals) (rest : List PrimeBX.Vals)
    (φ : (PrimeBX.Vocab I).Store) (hb : φ PrimeBX.Vars.b = Sum.inr true) (hv : v ∈ PrimeBX.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeBX.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeBX.Vocab I).Store) (cLast : Config (domainOf I) (PrimeBX.Vocab I)),
      φ' PrimeBX.Vars.b = v ∧
      φ' PrimeBX.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeBX (v :: rest)
        (primeBXLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
        , ⟨EventLabel.wt Tid.primeBX Loc.zBxx' (Val.cnt (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeBX Loc.zBx'x (Val.cnt (cnt0 + 1)), rfl⟩ ]
        cLast rest (primeBXLoop I, φ') := by
  set φ1 : (PrimeBX.Vocab I).Store :=
    Function.update φ PrimeBX.Vars.cnt (PrimeBX.eval PrimeBX.Expr.nextCnt φ) with hφ1
  have h1 : Command.RunStep Tid.primeBX (v :: rest) none (primeBXLoop I, φ) (v :: rest)
      (Command.loopSeq (primeBXLoopBody I) (primeBXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBXLoop, Command.step, PrimeBX.Vocab, PrimeBX.evalB, hb, if_true])
  have h2 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq (primeBXLoopBody I) (primeBXLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.xB' PrimeBX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBXLoopBody, PrimeBX.body, Command.step, PrimeBX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.xB' PrimeBX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.xB' PrimeBX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.primeBX (v :: rest)
      (some ⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.xB' PrimeBX.VExpr.xPrimeTag)
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, PrimeBX.Vocab, PrimeBX.evalV])
  have h5 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.primeBX (v :: rest)
      (some ⟨EventLabel.wt Tid.primeBX Loc.zBxx' ((PrimeBX.Vocab I).evalV PrimeBX.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zBxx' PrimeBX.VExpr.cntVal)
          (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h7 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal))
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.primeBX (v :: rest)
      (some ⟨EventLabel.rd Tid.primeBX Loc.zBx'x ((PrimeBX.Vocab I).evalV PrimeBX.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zBx'x PrimeBX.VExpr.cntVal)
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h9 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)) (primeBXLoop I), φ1)
      (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty) (primeBXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h10 : Command.RunStep Tid.primeBX (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty) (primeBXLoop I), φ1)
      rest
      (Command.loopSeq Command.skip (primeBXLoop I),
        Function.update φ1 PrimeBX.Vars.b v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h11 : Command.RunStep Tid.primeBX rest none
      (Command.loopSeq Command.skip (primeBXLoop I), Function.update φ1 PrimeBX.Vars.b v)
      rest
      (primeBXLoop I, Function.update φ1 PrimeBX.Vars.b v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.primeBX) (s := v :: rest) (c := (primeBXLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.labelledSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have hcnt1 : φ1 PrimeBX.Vars.cnt = Sum.inl (cnt0 + 1) :=
    (Function.update_self PrimeBX.Vars.cnt (PrimeBX.eval PrimeBX.Expr.nextCnt φ) φ).trans
      (by simp only [PrimeBX.eval, hcnt0]; rfl)
  have hl : (PrimeBX.Vocab I).evalV PrimeBX.VExpr.cntVal φ1 = Val.cnt (cnt0 + 1) := by
    simp only [PrimeBX.Vocab, PrimeBX.evalV, hcnt1]; rfl
  rw [hl] at run11
  have hne_cntb : PrimeBX.Vars.cnt ≠ PrimeBX.Vars.b := by decide
  refine ⟨Function.update φ1 PrimeBX.Vars.b v, _, Function.update_self _ _ _, ?_, run11⟩
  exact (Function.update_of_ne hne_cntb v φ1).trans hcnt1

/-- `M + 1` iterations of `primeBXLoop`, with values (as `primeAX_shape`). -/
theorem primeBX_shape_val (I : PCPInstance) (M : ℕ) (φ : (PrimeBX.Vocab I).Store)
    (hb : φ PrimeBX.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeBX.Vars.cnt = Sum.inl cnt0) :
    ∃ (vals : List (Val I)) (φ' : (PrimeBX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeBX.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeBX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeBX (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeBXLoop I, φ) (primeBXBlockWord I vals) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeBX_iter_step_val I (Sum.inr false) [] φ hb (by simp [PrimeBX.X]) cnt0 hcnt0
      have hrun2 := primeBX_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[Val.cnt (cnt0 + 1)], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeBX_iter_step_val I (Sum.inr true) (List.replicate M (Sum.inr true) ++ [Sum.inr false])
          φ hb (by simp [PrimeBX.X]) cnt0 hcnt0
      obtain ⟨vals, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨Val.cnt (cnt0 + 1) :: vals, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < vals.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 2
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-- `PrimeBX`'s program, run from its initial store, with values (as
`primeAX_general_run`). -/
theorem primeBX_general_run_val (I : PCPInstance) (M : ℕ) :
    ∃ (vals : List (Val I)) (φ' : (PrimeBX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeBX.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeBX.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeBX
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeBX.program I,
          (PrimeBX.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeBXBlockWord I vals)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeBX.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty)
        (primeBXLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeBX.Vocab I).Store :=
    (PrimeBX.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeBX.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeBX.Vals) ∈ PrimeBX.X := by
    unfold PrimeBX.X; decide
  set rest0 : List PrimeBX.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeBX (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeBX.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeBX.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeBX (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeBX.Vars.b PrimeBX.X PrimeBX.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeBX.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeBXLoop I) hrun1
  set φ1 : (PrimeBX.Vocab I).Store := Function.update φ0 PrimeBX.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeBX rest0 none
      (⟨Command.seq Command.skip (primeBXLoop I), φ1⟩ : Config (domainOf I) (PrimeBX.Vocab I))
      rest0 ⟨primeBXLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeBX.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeBX.Vars.cnt ≠ PrimeBX.Vars.b := by decide
  have hcnt1 : φ1 PrimeBX.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨vals, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeBX_shape_val I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeBX ([] : List PrimeBX.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeBX.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨vals, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩

