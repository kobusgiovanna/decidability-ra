theorem rawNthWrite_guessAY_zAy'y_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessAY Loc.zAy'y i = some ew) :
    (i = 0 ∧ ew.val = Val.cnt 1) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.cnt (kw.1 + 1)) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.zAy'y) (op := OpType.wt)
    (predL := guessAYZAyprimeWritePred I) htrace (guessAYZAyprimeWritePred_iff I)
  have hlen2 : ((guessAYBlockWord I v0 kws).filter (guessAYZAyprimeWritePred I)).length
      = kws.length + 1 := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_zAy'y_filter,
      guessAYBlockRestElems_zAy'y_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYZAyprimeWritePred I p.1) =
      [((⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 2)] ++
      ((kws.flatMap (guessAYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessAYZAyprimeWritePred I p.1) := by
    unfold guessAYBlockWord
    rw [List.zipIdx_append, List.filter_append, guessAYBlock0Elems_zAy'y_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
      (l := guessAYBlockWord I v0 kws) htrace (guessAYZAyprimeWritePred_iff I)
      (n := 0) (lab := (⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY)) (origPos := 2)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.guessAY Loc.zAy'y OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessAY)
      (guessAYBlockRestElems I) 5 2
      (fun kw => rfl)
      (guessAYZAyprimeWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt (kw.1 + 1)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessAY))
      (fun a => rfl)
      (fun a => by
        unfold guessAYZAyprimeWritePred
        exact (zAy'yWritePredCore_iff Loc.zAy'y OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
        have hq4 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 := by omega
        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessAYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessAYZAyprimeWritePred
        · exact zAy'yWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact zAy'yWritePredCore_false_of_ne Loc.ellAyx OpType.wt (by decide)
        · exact zAy'yWritePredCore_false_of_ne Loc.zAxy OpType.rd (by decide)
        · exact zAy'yWritePredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
      kws 3 j kw hkw
    have hzipj :
        ((guessAYBlockWord I v0 kws).zipIdx.filter (fun p => guessAYZAyprimeWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt (kw.1 + 1)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessAY), 3 + j * 5 + 2) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessAY)
      (l := guessAYBlockWord I v0 kws) htrace (guessAYZAyprimeWritePred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.guessAY Loc.zAy'y OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `primeAY`/`zAy'y` branch (Eq. (15)): `primeAY` makes
`vals.length` `zAy'y`-reads, `guessAY` makes `1 + kws.length`
`zAy'y`-writes. -/
theorem traceRf_total_primeAY_zAy'y (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceP : trace Tid.primeAY = primeAYBlockWord I vals)
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hcount : vals.length ≤ 1 + kws.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeAY) (her_loc : er.loc = Loc.zAy'y)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeAY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeAY Loc.zAy'y OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeAY Loc.zAy'y OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeAY Loc.zAy'y i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeAY Loc.zAy'y OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hpredL : ∀ lab : ThreadLabel (domainOf I) Tid.primeAY,
      (match lab.1.loc, lab.1.op with | Loc.zAy'y, OpType.rd => true | _, _ => false) = true ↔
        (lab.1.loc = Loc.zAy'y ∧ lab.1.op = OpType.rd) := by
    intro lab
    obtain ⟨x, hx⟩ : ∃ x : Loc, lab.1.loc = x := ⟨lab.1.loc, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : OpType, lab.1.op = y := ⟨lab.1.op, rfl⟩
    rw [hx, hy]
    cases x <;> cases y <;> simp; rfl
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeAY)
    (x := Loc.zAy'y) (op := OpType.rd) htraceP hpredL
  rw [hlen.trans (primeAYBlockWord_zAy'y_length I vals)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessAY)
    (x := Loc.zAy'y) (op := OpType.wt) (predL := guessAYZAyprimeWritePred I) htraceG
    (guessAYZAyprimeWritePred_iff I)
  have hlenW2 : ((guessAYBlockWord I v0 kws).filter (guessAYZAyprimeWritePred I)).length
      = 1 + kws.length := by
    unfold guessAYBlockWord
    rw [List.filter_append, List.length_append, guessAYBlock0Elems_zAy'y_filter,
      guessAYBlockRestElems_zAy'y_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessAY Loc.zAy'y OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_guessAY_primeAY_zAy'y (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (vals : List (Val I)) (htracePAY : trace Tid.primeAY = primeAYBlockWord I vals)
    (cnt0 : Fin 4) (hcnt0eq : cnt0 = 0)
    (hvalsVal : ∀ n, n < vals.length →
      vals[n]? = some (Val.cnt (⟨(cnt0.val + n + 1) % 4, by omega⟩ : Fin 4)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.zAy'y i = some ew ∧
      rawNthRead trace Tid.primeAY Loc.zAy'y i = some er) :
    ew.val = er.val := by
  subst hcnt0eq
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨v, hv, herval⟩ := rawNthRead_primeAY_zAy'y_eq I vals htracePAY her
  have hvlen : i < vals.length := (List.getElem?_eq_some_iff.mp hv).1
  have hvform := hvalsVal i hvlen
  rw [hvform] at hv
  injection hv with hv
  rcases rawNthWrite_guessAY_zAy'y_eq I v0 kws htraceGAY hew with
    ⟨hi0, hewval⟩ | ⟨kw, hkw, hi1, hewval⟩
  · subst hi0
    rw [hewval, herval, ← hv]
    congr 1
  · have hjlen : i - 1 < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
    obtain ⟨w, hw⟩ := hkwsVal (i - 1) hjlen
    have hkweq := hkw.symm.trans hw
    injection hkweq with hkweq
    rw [hewval, herval, ← hv, hkweq]
    congr 1
    apply Fin.ext
    simp [Fin.add_def]
    omega

/-- `traceRf_matches_guessAY_primeAY_zAy'y` for the general construction. -/
theorem traceRf_matches_guessAY_primeAY_zAy'y_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessAY = guessAYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (vals : List (Val I)) (htracePAY : trace Tid.primeAY = primeAYBlockWord I vals)
    (hvalsVal : ∀ n, n < vals.length → vals[n]? = some (Val.cnt (⟨(n + 1) % 4, by omega⟩ : Fin 4)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessAY Loc.zAy'y i = some ew ∧
      rawNthRead trace Tid.primeAY Loc.zAy'y i = some er) :
    ew.val = er.val := by
  have hvalsVal' : ∀ n, n < vals.length →
      vals[n]? = some (Val.cnt (⟨((0 : Fin 4).val + n + 1) % 4, by omega⟩ : Fin 4)) := by
    intro n hn; rw [hvalsVal n hn]; congr 2; apply Fin.ext; simp
  exact traceRf_matches_guessAY_primeAY_zAy'y I v0 kws htraceGAY hkwsVal vals htracePAY 0 rfl
    hvalsVal' h

/-! ## `GuessBY`

As for `GuessAY`. -/

/-- `GuessBY.program`'s loop, without the leading `ndetAssign`. -/
def guessBYLoop (I : PCPInstance) : Command (domainOf I) (GuessBY.Vocab I) :=
  Command.whileLoop GuessBY.BExpr.tt (GuessBY.loopBody I)

/-- The first iteration of `guessBYLoop` (as `guessAY_block0_step`). -/
theorem guessBY_block0_step (I : PCPInstance) (v0 : Fin I.n) (v0' : Option (Fin I.n))
    (rest : List (GuessBY.Vals I))
    (φ : (GuessBY.Vocab I).Store) (hfst : φ GuessBY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ GuessBY.Vars.cnt = Sum.inr (Sum.inl 0))
    (haux : φ GuessBY.Vars.aux = Sum.inl (some v0)) :
    ∃ (φ' : (GuessBY.Vocab I).Store) (cLast : Config (domainOf I) (GuessBY.Vocab I)),
      φ' GuessBY.Vars.aux = Sum.inl v0' ∧ φ' GuessBY.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' GuessBY.Vars.cnt = Sum.inr (Sum.inl 1) ∧
      Command.Run Tid.guessBY (Sum.inl v0' :: rest)
        (guessBYLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩
        , ⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩
        , ⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ ]
        cLast rest (guessBYLoop I, φ') := by
  set φ0 : (GuessBY.Vocab I).Store :=
    Function.update φ GuessBY.Vars.prev (GuessBY.eval I GuessBY.Expr.readCnt φ) with hφ0
  set φ1 : (GuessBY.Vocab I).Store :=
    Function.update φ0 GuessBY.Vars.cnt (GuessBY.eval I GuessBY.Expr.nextCnt φ0) with hφ1
  have hne1 : GuessBY.Vars.fst ≠ GuessBY.Vars.cnt := by decide
  have hne2 : GuessBY.Vars.fst ≠ GuessBY.Vars.prev := by decide
  have hfst1 : φ1 GuessBY.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne1 _ _).trans ((Function.update_of_ne hne2 _ _).trans hfst)
  set φ2 : (GuessBY.Vocab I).Store :=
    Function.update φ1 GuessBY.Vars.fst (GuessBY.eval I GuessBY.Expr.fstFalse φ1) with hφ2
  have hne3 : GuessBY.Vars.aux ≠ GuessBY.Vars.fst := by decide
  have hne4 : GuessBY.Vars.aux ≠ GuessBY.Vars.cnt := by decide
  have hne5 : GuessBY.Vars.aux ≠ GuessBY.Vars.prev := by decide
  have haux2 : φ2 GuessBY.Vars.aux = Sum.inl (some v0) :=
    (Function.update_of_ne hne3 _ _).trans ((Function.update_of_ne hne4 _ _).trans
      ((Function.update_of_ne hne5 _ _).trans haux))
  have hcnt_φ0 : φ0 GuessBY.Vars.cnt = φ GuessBY.Vars.cnt := rfl
  have hcnt1eq : φ1 GuessBY.Vars.cnt = GuessBY.eval I GuessBY.Expr.nextCnt φ0 :=
    Function.update_self _ _ _
  have hcnt1raw : φ1 GuessBY.Vars.cnt = Sum.inr (Sum.inl 1) := by
    simp only [hcnt1eq, GuessBY.eval, hcnt_φ0, hcnt0]; rfl
  have hcnt2raw : φ2 GuessBY.Vars.cnt = Sum.inr (Sum.inl 1) :=
    (Function.update_of_ne hne1.symm _ _).trans hcnt1raw
  have hell2 : (GuessBY.Vocab I).evalV GuessBY.VExpr.cntAuxVal φ2 = Val.cntAux 1 (some v0) := by
    simp only [GuessBY.Vocab, GuessBY.evalV, GuessBY.cntOf, GuessBY.auxOf, hcnt2raw, haux2]; rfl
  have hz2 : (GuessBY.Vocab I).evalV GuessBY.VExpr.cntVal φ2 = Val.cnt 1 := by
    simp only [GuessBY.Vocab, GuessBY.evalV, GuessBY.cntOf, hcnt2raw]; rfl
  have h1 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
      (guessBYLoop I, φ) (Sum.inl v0' :: rest)
      (Command.loopSeq (GuessBY.loopBody I) (guessBYLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [guessBYLoop, Command.step, GuessBY.Vocab, GuessBY.evalB, if_true])
  have h2 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
      (Command.loopSeq (GuessBY.loopBody I) (guessBYLoop I), φ) (Sum.inl v0' :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign GuessBY.Vars.cnt GuessBY.Expr.nextCnt)
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
                      (Command.read Loc.zByy' GuessBY.VExpr.prevVal))))))
            (Command.seq (Command.ite GuessBY.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSetBot I)
                (GuessBY.auxSetBot_nonempty I))))))
        (guessBYLoop I), φ0) := by
    rw [hφ0]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [GuessBY.loopBody, Command.firstIt, Command.step, GuessBY.Vocab]; rfl)
  have h3 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign GuessBY.Vars.cnt GuessBY.Expr.nextCnt)
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
                      (Command.read Loc.zByy' GuessBY.VExpr.prevVal))))))
            (Command.seq (Command.ite GuessBY.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSetBot I)
                (GuessBY.auxSetBot_nonempty I))))))
        (guessBYLoop I), φ0)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.seq (Command.assign GuessBY.Vars.cnt GuessBY.Expr.nextCnt)
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
                      (Command.read Loc.zByy' GuessBY.VExpr.prevVal))))))
            (Command.seq (Command.ite GuessBY.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSetBot I)
                (GuessBY.auxSetBot_nonempty I)))))
        (guessBYLoop I), φ0) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.seq (Command.assign GuessBY.Vars.cnt GuessBY.Expr.nextCnt)
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
                      (Command.read Loc.zByy' GuessBY.VExpr.prevVal))))))
            (Command.seq (Command.ite GuessBY.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSetBot I)
                (GuessBY.auxSetBot_nonempty I)))))
        (guessBYLoop I), φ0)
      (Sum.inl v0' :: rest)
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
                      (Command.read Loc.zByy' GuessBY.VExpr.prevVal))))))
            (Command.seq (Command.ite GuessBY.BExpr.isBot Command.brk Command.skip)
              (Command.ndetAssign GuessBY.Vars.aux (GuessBY.auxSetBot I)
                (GuessBY.auxSetBot_nonempty I)))))
        (guessBYLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, GuessBY.Vocab])
  have h5 : Command.RunStep Tid.guessBY (Sum.inl v0' :: rest) none
      (Command.loopSeq
        (Command.seq Command.skip
          (Command.seq
            (Command.ite GuessBY.BExpr.isFirst
              (Command.seq (Command.assign GuessBY.Vars.fst GuessBY.Expr.fstFalse)
                (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagFirst)
                  (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                    (Command.write Loc.zBy'y GuessBY.VExpr.cntVal))))
              (Command.seq (Command.write Loc.yB GuessBY.VExpr.yTagRest)
                (Command.seq (Command.write Loc.ellByx GuessBY.VExpr.cntAuxVal)
                  (Command.seq (Command.write Loc.zBy'y GuessBY.VExpr.cntVal)
                    (Command.seq (Command.read Loc.zBxy GuessBY.VExpr.prevVal)
