/-- `primeCheckXBlockWord` has one `xB`-read per entry of `cnts` (offset `5`). -/
theorem primeCheckXBlockWord_xB_length (I : PCPInstance) (cnts : List (Fin 4)) :
    ((primeCheckXBlockWord I cnts).filter (primeCheckXXBReadPred I)).length = cnts.length := by
  induction cnts with
