      (fun kw => rfl)
      (guessBYYBWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY))
      (fun a => rfl)
      (fun a => by
        unfold guessBYYBWritePred
        exact (yBWritePredCore_iff Loc.yB OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
        have hq4 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessBYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessBYYBWritePred
        · exact yBWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide)
        · exact yBWritePredCore_false_of_ne Loc.zBy'y OpType.wt (by decide)
        · exact yBWritePredCore_false_of_ne Loc.zBxy OpType.rd (by decide)
