    vals 0 i v hv
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeBY)
    (l := primeBYBlockWord I vals) htrace hpredL hfilt
  have hraw : rawNthEvent trace Tid.primeBY Loc.zByy' OpType.wt i = some ew := h
  rw [hraw] at hconn
  refine ⟨v, hv, ?_⟩
  injection hconn with hconn
  rw [hconn]
  rfl

def zByy'ReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.zByy', OpType.rd => true | _, _ => false

theorem zByy'ReadPredCore_iff (y : Loc) (z : OpType) :
    zByy'ReadPredCore y z = true ↔ (y = Loc.zByy' ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem zByy'ReadPredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.zByy' ∧ z = OpType.rd)) :
    zByy'ReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)


def guessBYZByReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessBY) : Bool :=
  zByy'ReadPredCore lab.1.loc lab.1.op

theorem guessBYZByReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessBY) :
    guessBYZByReadPred I lab = true ↔ (lab.1.loc = Loc.zByy' ∧ lab.1.op = OpType.rd) := by
  unfold guessBYZByReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact zByy'ReadPredCore_iff y z

