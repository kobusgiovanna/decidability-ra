/-- The word of `checkY_block0_step`. -/
def checkYBlock0Elems (I : PCPInstance) (v0 : Fin I.n) :
    List (ThreadLabel (domainOf I) Tid.checkY) :=
  [ ⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩
  , ⟨EventLabel.wt Tid.checkY Loc.yB (Val.primeTag Tid.checkY 1), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
  , ⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ ]

/-- The word of `checkYLoop`: block 0, then one `checkYBlockRestElems` block
per entry of `kws`. -/
def checkYBlockWord (I : PCPInstance) (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n))) :
    Word (ThreadLabel (domainOf I) Tid.checkY) :=
  checkYBlock0Elems I v0 ++ kws.flatMap (checkYBlockRestElems I)

/-! ## `CheckY`'s whole run -/

/-- The chain shape of `CheckY`'s loop, with the second components of `kws` determined (as
`checkXChain_shape_val`). -/
theorem checkYChain_shape_val (I : PCPInstance) (ws : List (Fin I.n))
    (φ : (CheckY.Vocab I).Store)
    (hfst : φ CheckY.Vars.fst = Sum.inr (Sum.inr false))
    (k0 : Fin 4) (hcnt0 : φ CheckY.Vars.cnt = Sum.inr (Sum.inl k0))
    (w0 : Fin I.n) (haux0 : φ CheckY.Vars.aux = Sum.inl (some w0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (CheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckY.Vocab I)),
      kws.length = ws.length + 2 ∧
      (∀ n, n < kws.length → ∃ w, kws[n]? = some (⟨(k0.val + n) % 4, by omega⟩, w) ∧
        w = (w0 :: ws)[n]?) ∧
      Command.Run Tid.checkY
        (ws.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none])
        (checkYLoop I, φ) (kws.flatMap (checkYBlockRestElems I))
        cLast [] (Command.skip, φ') := by
  induction ws generalizing φ k0 w0 with
  | nil =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkY_blockRest_continue_step I (Sum.inl none) [] φ hfst k0 hcnt0 w0 haux0 (by
          simp only [CheckY.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
          exact ⟨none, rfl⟩)
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        checkY_blockRest_break_step I [] φ1 hfst1 (k0 + 1) hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(k0, some w0), (k0 + 1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro n hn
      simp only [List.length_cons, List.length_nil] at hn
      have hn01 : n = 0 ∨ n = 1 := by omega
      rcases hn01 with rfl | rfl
      · refine ⟨some w0, ?_, rfl⟩
        simp only [List.getElem?_cons_zero]
        congr 2
        apply Fin.ext
        have hk0 := k0.isLt
        simp only [Nat.add_zero]
        omega
      · refine ⟨none, ?_, rfl⟩
        simp only [List.getElem?_cons_succ, List.getElem?_cons_zero]
        congr 2
  | cons w1 ws' ih =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkY_blockRest_continue_step I (Sum.inl (some w1))
          (ws'.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none])
          φ hfst k0 hcnt0 w0 haux0 (by
            simp only [CheckY.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
            exact ⟨some w1, rfl⟩)
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        ih (φ := φ1) (k0 := k0 + 1) (w0 := w1) hfst1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨(k0, some w0) :: kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro n hn
      cases n with
      | zero =>
          refine ⟨some w0, ?_, rfl⟩
          simp only [List.getElem?_cons_zero]
          congr 2
          apply Fin.ext
          have hk0 := k0.isLt
          simp only [Nat.add_zero]
          omega
      | succ n' =>
          simp only [List.length_cons] at hn
          have hn' : n' < kws.length := by omega
          obtain ⟨w, hw, hweq⟩ := hval n' hn'
          refine ⟨w, ?_, ?_⟩
          · simp only [List.getElem?_cons_succ]
            rw [hw]
            congr 2
            apply Fin.ext
            simp [Fin.add_def]
            omega
          · simpa using hweq

/-- The shape of `CheckY`'s loop, with the second components of `kws` determined. -/
theorem checkY_shape_val (I : PCPInstance) (ws : List (Fin I.n)) (φ : (CheckY.Vocab I).Store)
    (hfst : φ CheckY.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ CheckY.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : Fin I.n) (haux0 : φ CheckY.Vars.aux = Sum.inl (some v0)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (CheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckY.Vocab I)),
      kws.length = ws.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = ws[i]?) ∧
      Command.Run Tid.checkY
        (ws.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none])
        (checkYLoop I, φ) (checkYBlockWord I v0 kws)
        cLast [] (Command.skip, φ') := by
  match ws with
  | [] =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkY_block0_step I (Sum.inl none) [] φ hfst hcnt0 v0 haux0 (by
          simp only [CheckY.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
          exact ⟨none, rfl⟩)
      obtain ⟨φ2, cLast2, hrun2⟩ :=
        checkY_blockRest_break_step I [] φ1 hfst1 1 hcnt1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[(1, none)], φ2, cLast, rfl, ?_, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      exact ⟨none, rfl, rfl⟩
  | w1 :: ws' =>
      obtain ⟨φ1, cLast1, hfst1, hcnt1, haux1, hrun1⟩ :=
        checkY_block0_step I (Sum.inl (some w1))
          (ws'.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none])
          φ hfst hcnt0 v0 haux0 (by
            simp only [CheckY.auxSetBot, Finset.mem_image, Finset.mem_univ, true_and]
            exact ⟨some w1, rfl⟩)
      obtain ⟨kws, φ', cLast2, hlen, hval, hrun2⟩ :=
        checkYChain_shape_val I ws' φ1 hfst1 1 hcnt1 w1 haux1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨kws, φ', cLast, by simp [hlen], ?_, hcomb⟩
      intro i hi
      obtain ⟨w, hw, hweq⟩ := hval i hi
      exact ⟨w, hw, hweq⟩

/-- A term-reaching run of `CheckY.program`, with the values read determined. -/
theorem checkY_general_run_val (I : PCPInstance) (v0 : Fin I.n) (js : List (Fin I.n)) :
    ∃ (kws : List (Fin 4 × Option (Fin I.n))) (φ' : (CheckY.Vocab I).Store)
      (cLast : Config (domainOf I) (CheckY.Vocab I)),
      kws.length = js.length + 1 ∧
      (∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = js[i]?) ∧
      Command.Run Tid.checkY
        (Sum.inl (some v0) ::
          (js.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none]))
        (CheckY.program I,
          (CheckY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
            | .fst => some (Sum.inr (Sum.inr true))
            | _ => none) (Sum.inl none))
        (checkYBlockWord I v0 kws)
        cLast [] (Command.term, φ') := by
  set φ0 : (CheckY.Vocab I).Store :=
    (CheckY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inr (Sum.inl (0 : Fin 4)))
      | .fst => some (Sum.inr (Sum.inr true))
      | _ => none) (Sum.inl none) with hφ0
  have hfst0 : φ0 CheckY.Vars.fst = Sum.inr (Sum.inr true) := rfl
  have hcnt0 : φ0 CheckY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) := rfl
  have hmem : (Sum.inl (some v0) : CheckY.Vals I) ∈ CheckY.auxSet I := by
    unfold CheckY.auxSet
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    exact ⟨v0, rfl⟩
  set rest0 : List (CheckY.Vals I) :=
    js.map (fun w => (Sum.inl (some w) : CheckY.Vals I)) ++ [Sum.inl none] with hrest0
  have hstep1 : Command.RunStep Tid.checkY (Sum.inl (some v0) :: rest0) none
      (⟨Command.ndetAssign CheckY.Vars.aux (CheckY.auxSet I) (CheckY.auxSet_nonempty I),
        φ0⟩ : Config (domainOf I) (CheckY.Vocab I))
      rest0
      ⟨Command.skip, Function.update φ0 CheckY.Vars.aux (Sum.inl (some v0))⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.checkY (Sum.inl (some v0) :: rest0)
      (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSet I) (CheckY.auxSet_nonempty I), φ0)
      [] (Command.ndetAssign CheckY.Vars.aux (CheckY.auxSet I) (CheckY.auxSet_nonempty I), φ0)
      rest0 ⟨Command.skip, Function.update φ0 CheckY.Vars.aux (Sum.inl (some v0))⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (Command.seq (checkYLoop I) Command.term) hrun1
  set φ1 : (CheckY.Vocab I).Store := Function.update φ0 CheckY.Vars.aux (Sum.inl (some v0))
    with hφ1
  have hstep2 : Command.RunStep Tid.checkY rest0 none
      (⟨Command.seq Command.skip (Command.seq (checkYLoop I) Command.term), φ1⟩ :
        Config (domainOf I) (CheckY.Vocab I))
      rest0 ⟨Command.seq (checkYLoop I) Command.term, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have haux1 : φ1 CheckY.Vars.aux = Sum.inl (some v0) := Function.update_self _ _ _
  have hne_fst_aux : CheckY.Vars.fst ≠ CheckY.Vars.aux := by decide
  have hne_cnt_aux : CheckY.Vars.cnt ≠ CheckY.Vars.aux := by decide
  have hfst1 : φ1 CheckY.Vars.fst = Sum.inr (Sum.inr true) :=
    (Function.update_of_ne hne_fst_aux (Sum.inl (some v0)) φ0).trans hfst0
  have hcnt1 : φ1 CheckY.Vars.cnt = Sum.inr (Sum.inl (0 : Fin 4)) :=
    (Function.update_of_ne hne_cnt_aux (Sum.inl (some v0)) φ0).trans hcnt0
  obtain ⟨kws, φ', cLastL, hlen, hval, hrun3⟩ :=
    checkY_shape_val I js φ1 hfst1 hcnt1 v0 haux1
  have hrun3' := Command.Run.seqCongr Command.term hrun3
  obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun2 hrun3'
  have hstep4 : Command.RunStep Tid.checkY ([] : List (CheckY.Vals I)) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (CheckY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨kws, φ', cLast, hlen, hval, Command.Run.silentSnoc hcomb hstep4⟩

/-! ## `rf_matches`: `checkY`/`primeCheckY` `yA` (Eq. (16))

As for `checkX`/`primeCheckX` `xA`. -/

/-- The `yA`-write match, as a predicate on `Loc`/`OpType` alone. -/
def yAWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yA, OpType.wt => true | _, _ => false

theorem yAWritePredCore_iff (y : Loc) (z : OpType) :
    yAWritePredCore y z = true ↔ (y = Loc.yA ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem yAWritePredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.yA ∧ z = OpType.wt)) :
    yAWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `checkY`'s `yA`-write predicate, lifted from `yAWritePredCore`. -/
def checkYYAWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) : Bool :=
  yAWritePredCore lab.1.loc lab.1.op

theorem checkYYAWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) :
    checkYYAWritePred I lab = true ↔ (lab.1.loc = Loc.yA ∧ lab.1.op = OpType.wt) := by
  unfold checkYYAWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yAWritePredCore_iff y z

/-- `checkYBlock0Elems` has one `yA`-write, its first entry. -/
theorem checkYBlock0Elems_yA_filter (I : PCPInstance) (v0 : (Fin I.n)) :
    (checkYBlock0Elems I v0).filter (checkYYAWritePred I) =
      [(⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)] := by
  apply list_filter_singleton_of_unique' (checkYBlock0Elems I v0) (checkYYAWritePred I) 0
    (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩)
    rfl
    (by unfold checkYYAWritePred; exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 1 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYAWritePred
      · exact yAWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yAWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
      · exact yAWritePredCore_false_of_ne Loc.yB OpType.rd (by decide))

/-- `checkYBlockRestElems` has one `yA`-write per entry of `kws`. -/
theorem checkYBlockRestElems_yA_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYAWritePred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkYBlockRestElems I kw) ++ kws.flatMap (checkYBlockRestElems I)).filter
        (checkYYAWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkYBlockRestElems I kw).filter (checkYYAWritePred I) =
          [(⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw) (checkYYAWritePred I) 0
          (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩)
          rfl
          (by unfold checkYYAWritePred
              exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkYYAWritePred
            · exact yAWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
            · exact yAWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
            · exact yAWritePredCore_false_of_ne Loc.yB OpType.rd (by decide)
            · exact yAWritePredCore_false_of_ne Loc.yA' OpType.rd (by decide)
            · exact yAWritePredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

/-- `checkYBlock0Elems_yA_filter` for the `zipIdx`-filter, starting at
offset `k`. -/
theorem checkYBlock0Elems_yA_zipIdx_filter (I : PCPInstance) (v0 : (Fin I.n)) (k : ℕ) :
    (((checkYBlock0Elems I v0).zipIdx k).filter (fun p => checkYYAWritePred I p.1)) =
      [((⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), k)] := by
  apply list_filter_singleton_of_unique' ((checkYBlock0Elems I v0).zipIdx k)
    (fun p => checkYYAWritePred I p.1) 0
    ((⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY), k)
    (by rw [List.getElem?_zipIdx]; rfl)
    (by unfold checkYYAWritePred; exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      rw [List.getElem?_zipIdx] at hget
      have hqlt : q < 4 := by
        rcases Nat.lt_or_ge q 4 with hqlt | hqge
        · exact hqlt
        · exfalso
          have hqge4 : (checkYBlock0Elems I v0).length ≤ q := by
            simp only [checkYBlock0Elems, List.length_cons, List.length_nil]
            omega
          have : (checkYBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge4
          rw [this] at hget
          simp at hget
      have hq3 : q = 1 ∨ q = 2 ∨ q = 3 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.map_some, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYAWritePred
      · exact yAWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yAWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
      · exact yAWritePredCore_false_of_ne Loc.yB OpType.rd (by decide))

/-- `checkY`'s `i`-th `yA`-write (as `rawNthWrite_checkX_xA_eq`). -/
theorem rawNthWrite_checkY_yA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.checkY Loc.yA i = some ew) :
    (i = 0 ∧ ew.val = Val.primeTag Tid.checkY 1) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.primeTag Tid.checkY (kw.1 + 1)) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA) (op := OpType.wt)
    (predL := checkYYAWritePred I) htrace (checkYYAWritePred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYAWritePred I)).length
      = kws.length + 1 := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yA_filter,
      checkYBlockRestElems_yA_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAWritePred I p.1) =
      [((⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 0)] ++
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYAWritePred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, checkYBlock0Elems_yA_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYAWritePred_iff I)
      (n := 0) (lab := (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY 1), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)) (origPos := 0)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkY Loc.yA OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
      (checkYBlockRestElems I) 6 0
      (fun kw => rfl)
      (checkYYAWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY))
      (fun a => rfl)
      (fun a => by
        unfold checkYYAWritePred
        exact (yAWritePredCore_iff Loc.yA OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkYYAWritePred
        · exact yAWritePredCore_false_of_ne Loc.yB OpType.wt (by decide)
        · exact yAWritePredCore_false_of_ne Loc.yA OpType.rd (by decide)
        · exact yAWritePredCore_false_of_ne Loc.yB OpType.rd (by decide)
        · exact yAWritePredCore_false_of_ne Loc.yA' OpType.rd (by decide)
        · exact yAWritePredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYAWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.checkY Loc.yA (Val.primeTag Tid.checkY (kw.1 + 1)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 4 + j * 6 + 0) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYAWritePred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkY Loc.yA OpType.wt i = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `primeCheckY`/`yA` branch (Eq. (16)). -/
theorem traceRf_total_primeCheckY_yA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (js : List (Fin I.n)) (cnts : List (Fin 4)) (hcnts : cnts.length = js.length + 1)
    (htraceP : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n))) (hkws : kws.length = js.length + 1)
    (htraceV : trace Tid.checkY = checkYBlockWord I v0 kws)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.primeCheckY) (her_loc : er.loc = Loc.yA)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.primeCheckY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.primeCheckY Loc.yA OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.primeCheckY Loc.yA OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.primeCheckY Loc.yA i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.primeCheckY Loc.yA OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.primeCheckY)
    (x := Loc.yA) (op := OpType.rd) (predL := primeCheckYYAReadPred I) htraceP
    (primeCheckYYAReadPred_iff I)
  rw [hlen.trans (primeCheckYBlockWord_yA_length I cnts)] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yA) (op := OpType.wt) (predL := checkYYAWritePred I) htraceV
    (checkYYAWritePred_iff I)
  have hlenW2 : ((checkYBlockWord I v0 kws).filter (checkYYAWritePred I)).length
      = 1 + kws.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yA_filter,
      checkYBlockRestElems_yA_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.checkY Loc.yA OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

/-- `rf_matches` for the `primeCheckY`/`yA` branch (Eq. (16)/(16)), as `traceRf_matches_checkX_primeCheckX_xA`. -/
theorem traceRf_matches_checkY_primeCheckY_yA (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVX : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkY Loc.yA i = some ew ∧
      rawNthRead trace Tid.primeCheckY Loc.yA i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨c, hc, herval⟩ := rawNthRead_primeCheckY_yA_eq I cnts htracePVX her
  have hilen : i < cnts.length := (List.getElem?_eq_some_iff.mp hc).1
  have hcform := hcntsVal i hilen
  rw [hcform] at hc
  injection hc with hc
  rcases rawNthWrite_checkY_yA_eq I v0 kws htraceVX hew with ⟨hi0, hewval⟩ | ⟨kw, hkw, hi1, hewval⟩
  · subst hi0
    rw [hewval, herval, ← hc]
    congr 1
  · have hjlen : i - 1 < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
    obtain ⟨w, hw⟩ := hkwsVal (i - 1) hjlen
    have hkweq := hkw.symm.trans hw
    injection hkweq with hkweq
    rw [hewval, herval, ← hc, hkweq]
    congr 1
    apply Fin.ext
    simp [Fin.add_def]
    omega

/-- `traceRf_matches_checkY_primeCheckY_yA` for the general construction. -/
theorem traceRf_matches_checkY_primeCheckY_yA_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (cnts : List (Fin 4)) (htracePVY : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    (hcntsVal : ∀ n, n < cnts.length → cnts[n]? = some (⟨(n + 1) % 4, by omega⟩ : Fin 4))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.checkY Loc.yA i = some ew ∧
      rawNthRead trace Tid.primeCheckY Loc.yA i = some er) :
    ew.val = er.val :=
  traceRf_matches_checkY_primeCheckY_yA I v0 kws htraceVY hkwsVal cnts htracePVY hcntsVal h

/-! ## `rf_matches`: `checkY`/`primeCheckY` `yB` (Eq. (16))

As for `yA`, with `yB` at offset `1` of `checkY`'s blocks and offset `5` of
`primeCheckY`'s. -/

def yBWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yB, OpType.wt => true | _, _ => false

theorem yBWritePredCore_iff (y : Loc) (z : OpType) :
    yBWritePredCore y z = true ↔ (y = Loc.yB ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem yBWritePredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.yB ∧ z = OpType.wt)) :
    yBWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `checkY`'s `yB`-write predicate, lifted from `yBWritePredCore`. -/
def checkYYBWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) : Bool :=
  yBWritePredCore lab.1.loc lab.1.op

theorem checkYYBWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) :
    checkYYBWritePred I lab = true ↔ (lab.1.loc = Loc.yB ∧ lab.1.op = OpType.wt) := by
  unfold checkYYBWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBWritePredCore_iff y z

def yBReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.yB, OpType.rd => true | _, _ => false

theorem yBReadPredCore_iff (y : Loc) (z : OpType) :
    yBReadPredCore y z = true ↔ (y = Loc.yB ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem yBReadPredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.yB ∧ z = OpType.rd)) :
    yBReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `primeCheckY`'s `yB`-read predicate, lifted from `yBReadPredCore`. -/
def primeCheckYYBReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    Bool :=
  yBReadPredCore lab.1.loc lab.1.op

theorem primeCheckYYBReadPred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeCheckY) :
    primeCheckYYBReadPred I lab = true ↔ (lab.1.loc = Loc.yB ∧ lab.1.op = OpType.rd) := by
  unfold primeCheckYYBReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBReadPredCore_iff y z

/-- `checkYBlock0Elems` has one `yB`-write, at offset `1`. -/
theorem checkYBlock0Elems_yB_filter (I : PCPInstance) (v0 : (Fin I.n)) :
