/-- The word of `guessAY_block0_step`. -/
def guessAYBlock0Elems (I : PCPInstance) (v0 : Fin I.n) :
    List (ThreadLabel (domainOf I) Tid.guessAY) :=
  [ ⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, true) (some v0)), rfl⟩
  , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux 1 (some v0)), rfl⟩
  , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt 1), rfl⟩ ]

/-- `GuessAY`'s events in an iteration after the first, with counter `k` and
`aux = w` (`w = none` in the terminating iteration). -/
def guessAYBlockRestElems (I : PCPInstance) (kw : Fin 4 × Option (Fin I.n)) :
    List (ThreadLabel (domainOf I) Tid.guessAY) :=
  [ ⟨EventLabel.wt Tid.guessAY Loc.yA (Val.yTag (Tid.guessAY, false) kw.2), rfl⟩
  , ⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux (kw.1 + 1) kw.2), rfl⟩
  , ⟨EventLabel.wt Tid.guessAY Loc.zAy'y (Val.cnt (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.rd Tid.guessAY Loc.zAxy (Val.cnt kw.1), rfl⟩
  , ⟨EventLabel.rd Tid.guessAY Loc.zAyy' (Val.cnt kw.1), rfl⟩ ]

/-- The word of `guessAYLoop`: block 0, then one `guessAYBlockRestElems` block
per entry of `kws`. -/
def guessAYBlockWord (I : PCPInstance) (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n))) :
    Word (ThreadLabel (domainOf I) Tid.guessAY) :=
  guessAYBlock0Elems I v0 ++ kws.flatMap (guessAYBlockRestElems I)

