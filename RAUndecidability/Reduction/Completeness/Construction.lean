/-- `checkX`'s `i`-th `xA`-read: for `i = 0` it expects `v0` (tag `true`), for
`i ≥ 1` the second component of `kws[i-1]` (tag `false`). -/
theorem rawNthRead_checkX_xA_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : I.Γ) (kws : List (Fin 4 × Option I.Γ))
    (htrace : trace Tid.checkX = checkXBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkX Loc.xA i = some er) :
    (i = 0 ∧ er.val = Val.xTag (Tid.guessAX, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ er.val = Val.xTag (Tid.guessAX, false) kw.2) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkX)
    (x := Loc.xA) (op := OpType.rd)
    (predL := checkXXAReadPred I) htrace (checkXXAReadPred_iff I)
  have hlen2 : ((checkXBlockWord I v0 kws).filter (checkXXAReadPred I)).length
      = kws.length + 1 := by
    unfold checkXBlockWord
    rw [List.filter_append, List.length_append, checkXBlock0Elems_xA_read_filter,
      checkXBlockRestElems_xA_read_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAReadPred I p.1) =
      [((⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 2)] ++
      ((kws.flatMap (checkXBlockRestElems I)).zipIdx 4).filter
        (fun p => checkXXAReadPred I p.1) := by
    unfold checkXBlockWord
    rw [List.zipIdx_append, List.filter_append, checkXBlock0Elems_xA_read_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXAReadPred_iff I)
      (n := 0) (lab := (⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true)
        (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkX)) (origPos := 2)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkX Loc.xA OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option I.Γ) (β := ThreadLabel (domainOf I) Tid.checkX)
      (checkXBlockRestElems I) 6 2
      (fun kw => rfl)
      (checkXXAReadPred I)
      (fun kw => (⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkX))
      (fun a => rfl)
      (fun a => by
        unfold checkXXAReadPred
        exact (xAReadPredCore_iff Loc.xA OpType.rd).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 0 ∨ q = 1 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkXBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkXXAReadPred
        · exact xAReadPredCore_false_of_ne Loc.xA OpType.wt (by decide)
        · exact xAReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)
        · exact xAReadPredCore_false_of_ne Loc.xB OpType.rd (by decide)
        · exact xAReadPredCore_false_of_ne Loc.xA' OpType.rd (by decide)
        · exact xAReadPredCore_false_of_ne Loc.xB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkXBlockWord I v0 kws).zipIdx.filter (fun p => checkXXAReadPred I p.1))[i]?
        = some ((⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkX), 4 + j * 6 + 2) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkX)
      (l := checkXBlockWord I v0 kws) htrace (checkXXAReadPred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkX Loc.xA OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

