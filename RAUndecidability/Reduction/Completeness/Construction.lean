  exact absurd (rawIndex_lt_of_tracePo_sameLocOp he1 he2 hpo heloc heop) (by omega)



/-- Lemma 3.4 for the primed threads for `PrimeAY`. -/
theorem primeAY_po_monotone (I : PCPInstance) (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (vals : List (Val I)) (htrace : trace Tid.primeAY = primeAYBlockWord I vals)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.primeAY) (he2 : e2 ∈ traceEventsOf trace Tid.primeAY)
    (hpo : tracePo e1 e2) (hwt2 : e2.op = .wt) (_hnb2 : ¬ e2.IsBridge) :
    rawIndex trace e1 ≤ rawIndex trace e2 ∧
      (e1.op = .rd → rawIndex trace e1 < rawIndex trace e2) := by
  have hWL : 2 ≤ primeAYBlockShape.length := by decide
  have hshapewrites : ∀ p x, primeAYBlockShape[p]? = some (x, OpType.rd) → 2 ≤ p := by
