/-- `GuessAX`'s outer `while True do … done` loop, as a `Command.whileLoop`. -/
def guessAXLoop (I : PCPInstance) : Command (domainOf I) (GuessAX.Vocab I) :=
  Command.whileLoop GuessAX.BExpr.tt (GuessAX.outerBody I)

/-- `GuessAX`'s events in one inner call, from the values written to `xA`,
`zAx'x` and read from `zAxx'`. -/
def guessAXInnerBlockElems (I : PCPInstance) (vs : Val I × Val I × Val I) :
    List (ThreadLabel (domainOf I) Tid.guessAX) :=
  [ ⟨EventLabel.wt Tid.guessAX Loc.xA vs.1, rfl⟩
  , ⟨EventLabel.wt Tid.guessAX Loc.zAx'x vs.2.1, rfl⟩
  , ⟨EventLabel.rd Tid.guessAX Loc.zAxx' vs.2.2, rfl⟩ ]

/-- The shape of an inner call of `GuessAX`: two writes (`xA`, `zAx'x`) then
one read (`zAxx'`). -/
def guessAXInnerBlockShape : List (Loc × OpType) :=
  [(Loc.xA, .wt), (Loc.zAx'x, .wt), (Loc.zAxx', .rd)]

theorem guessAXInnerBlockElems_shape (I : PCPInstance) :
    ∀ vs : Val I × Val I × Val I,
      (guessAXInnerBlockElems I vs).map (fun ev => (ev.1.loc, ev.1.op)) =
        guessAXInnerBlockShape :=
  fun _ => rfl

/-- An inner call of `GuessAX` accesses no bridge location (unlike the outer
block around it, whose `zAxy`-write and `ellAyx`-read are bridge events). -/
theorem guessAXInnerBlockShape_no_bridge : ∀ p ∈ guessAXInnerBlockShape, p.1 ∉ BridgeLoc := by
  decide

/-- `K` further inner calls with `fst = false`, from a state within the `for`
loop. The number of iterations is fixed on entry (`hK`, from `j`/`N`); the
bound `hNbound : N ≤ maxLen` keeps `j` from wrapping. The final counter is
`(k0 + K) mod 4`, and the values of each call are given relative to `k0`. By
induction on `K`. -/
theorem guessAXInnerLoop_chain_shape (I : PCPInstance) (K : ℕ) (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store)
    (hfst : φ GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)))
    (k0 : Fin 4) (hcnt0 : φ GuessAX.Vars.cnt = Sum.inr (Sum.inl k0))
    (hNbound : (GuessAX.NOf I φ).val ≤ GuessAX.maxLen I)
    (hK : (GuessAX.jOf I φ).val + K = (GuessAX.NOf I φ).val + 1) :
    ∃ (vs : List (Val I × Val I × Val I)) (φ' : (GuessAX.Vocab I).Store)
      (cLast : Config (domainOf I) (GuessAX.Vocab I)) (kF : Fin 4),
      vs.length = K ∧
      φ' GuessAX.Vars.fst = Sum.inr (Sum.inr (Sum.inr false)) ∧
      φ' GuessAX.Vars.cnt = Sum.inr (Sum.inl kF) ∧
      kF = (⟨(k0.val + K) % 4, by omega⟩ : Fin 4) ∧
      φ' GuessAX.Vars.aux = φ GuessAX.Vars.aux ∧
      φ' GuessAX.Vars.cntY = φ GuessAX.Vars.cntY ∧
      φ' GuessAX.Vars.N = φ GuessAX.Vars.N ∧
      (GuessAX.jOf I φ').val = (GuessAX.jOf I φ).val + K ∧
      (∀ n, n < vs.length → ∃ e, vs[n]? = some e ∧
        e.2.2 = Val.cnt (⟨(k0.val + n) % 4, by omega⟩ : Fin 4) ∧
        e.2.1 = Val.cnt (⟨(k0.val + n + 1) % 4, by omega⟩ : Fin 4)) ∧
      (∀ n, n < K → ∃ e j, vs[n]? = some e ∧ j.val = (GuessAX.jOf I φ).val + n ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (GuessAX.auxOf I φ) j)) ∧
      Command.Run Tid.guessAX rest
        (guessAXInnerLoop I, φ) (vs.flatMap (guessAXInnerBlockElems I))
        cLast rest (guessAXInnerLoop I, φ') := by
  induction K generalizing φ k0 with
  | zero =>
      refine ⟨[], φ, (guessAXInnerLoop I, φ), k0, rfl, hfst, hcnt0, ?_, rfl, rfl, rfl, by omega,
        ?_, ?_, Command.Run.nil⟩
      · apply Fin.ext; simp; omega
      · intro n hn
        simp at hn
      · intro n hn
        simp at hn
  | succ K ih =>
      have hguard : (GuessAX.Vocab I).evalB GuessAX.BExpr.jLeN φ = true := by
        simp only [GuessAX.Vocab, GuessAX.evalB, decide_eq_true_eq]
        exact Fin.le_def.mpr (by omega)
      obtain ⟨φ1, cLast1, hfst1, hcnt1, hj1, haux1, hcntY1, hN1, hrun1⟩ :=
        guessAX_innerLoop_rest_step I rest φ hguard hfst k0 hcnt0
      have hjOf1 : GuessAX.jOf I φ1 = GuessAX.jOf I φ + 1 := by
        simp only [GuessAX.jOf, hj1, GuessAX.eval]
      have hjOf1val : (GuessAX.jOf I φ1).val = (GuessAX.jOf I φ).val + 1 := by
        rw [hjOf1]
        simp only [Fin.add_def, Fin.val_one]
        exact Nat.mod_eq_of_lt (by omega)
      have hNOf1 : GuessAX.NOf I φ1 = GuessAX.NOf I φ := by
        simp only [GuessAX.NOf, hN1]
      have hNbound1 : (GuessAX.NOf I φ1).val ≤ GuessAX.maxLen I := by rw [hNOf1]; exact hNbound
      have hK' : (GuessAX.jOf I φ1).val + K = (GuessAX.NOf I φ1).val + 1 := by
        rw [hjOf1val, hNOf1]; omega
      obtain ⟨vs, φ', cLast', kF, hlen, hfst', hcnt', hkF', haux', hcntY', hN', hj', hval',
        hvalxA', hrun'⟩ :=
        ih (φ := φ1) (k0 := k0 + 1) hfst1 hcnt1 hNbound1 hK'
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun'
      refine ⟨(Val.xTag (Tid.guessAX, false)
          (GuessAX.jthLetter I (GuessAX.auxOf I φ) (GuessAX.jOf I φ)),
          Val.cnt (k0 + 1), Val.cnt k0) :: vs,
        φ', cLast, kF, by simp [hlen], hfst', hcnt', ?_, ?_, ?_, ?_, ?_, ?_, ?_, hcomb⟩
      · rw [hkF']
        apply Fin.ext
        simp only [Fin.ext_iff, Fin.add_def]; omega
      · rw [haux', haux1]
      · rw [hcntY', hcntY1]
      · rw [hN', hN1]
      · rw [hj', hjOf1val]; omega
      · intro n hn
        cases n with
        | zero =>
          refine ⟨(Val.xTag (Tid.guessAX, false)
            (GuessAX.jthLetter I (GuessAX.auxOf I φ) (GuessAX.jOf I φ)),
            Val.cnt (k0+1), Val.cnt k0), rfl, ?_, ?_⟩
          · dsimp only
            simp only [Val.cnt.injEq, Fin.ext_iff, Fin.add_def]; omega
          · dsimp only
            simp only [Val.cnt.injEq, Fin.ext_iff, Fin.add_def]; omega
        | succ n =>
          simp only [List.length_cons] at hn
          have hn' : n < vs.length := by omega
          obtain ⟨e, he, he22, he21⟩ := hval' n hn'
          refine ⟨e, ?_, ?_, ?_⟩
          · simpa using he
          · rw [he22]
            simp only [Val.cnt.injEq, Fin.ext_iff, Fin.add_def]; omega
          · rw [he21]
            simp only [Val.cnt.injEq, Fin.ext_iff, Fin.add_def]; omega
      · intro n hn
        cases n with
        | zero =>
          exact ⟨(Val.xTag (Tid.guessAX, false)
            (GuessAX.jthLetter I (GuessAX.auxOf I φ) (GuessAX.jOf I φ)),
            Val.cnt (k0+1), Val.cnt k0), GuessAX.jOf I φ, rfl, by omega, rfl⟩
        | succ n =>
          have hn' : n < K := by omega
          obtain ⟨e, j, he, hjval, he1⟩ := hvalxA' n hn'
          have hauxOf1 : GuessAX.auxOf I φ1 = GuessAX.auxOf I φ := by
            simp only [GuessAX.auxOf, haux1]
          refine ⟨e, j, ?_, by omega, ?_⟩
          · simpa using he
          · rw [he1, hauxOf1]

/-- The start of an iteration of `guessAXLoop`: the `while True` unfolding,
`cntY ← (cntY + 1) mod 4; w(z_α^{x,y}, cntY)`, and the preamble
`j ← 1; N ← |α_aux|` of the inner loop. Nine `Command.RunStep`s. -/
theorem guessAXOuterHead_step (I : PCPInstance) (rest : List (GuessAX.Vals I))
    (φ : (GuessAX.Vocab I).Store)
    (aux0 : Option (Fin I.n)) (haux0 : φ GuessAX.Vars.aux = Sum.inl aux0)
    (cntY0 : Fin 4) (hcntY0 : φ GuessAX.Vars.cntY = Sum.inr (Sum.inl cntY0)) :
    ∃ (φ' : (GuessAX.Vocab I).Store) (cLast : Config (domainOf I) (GuessAX.Vocab I)),
      φ' GuessAX.Vars.cnt = φ GuessAX.Vars.cnt ∧
      φ' GuessAX.Vars.fst = φ GuessAX.Vars.fst ∧
      φ' GuessAX.Vars.aux = φ GuessAX.Vars.aux ∧
      φ' GuessAX.Vars.cntY = Sum.inr (Sum.inl (cntY0 + 1)) ∧
      (GuessAX.jOf I φ').val = 1 ∧
      (GuessAX.NOf I φ').val = (GuessAX.extAlpha I aux0).length ∧
      Command.Run Tid.guessAX rest
        (guessAXLoop I, φ)
        [ ⟨EventLabel.wt Tid.guessAX Loc.zAxy (Val.cnt (cntY0 + 1)), rfl⟩ ]
        cLast rest
        (Command.loopSeq (Command.seq (guessAXInnerLoop I)
