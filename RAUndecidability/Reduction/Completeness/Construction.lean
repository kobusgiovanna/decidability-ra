def primeBYLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeBY.Vocab I) :=
  Command.seq (PrimeBY.body I) (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)

/-- `PrimeBY`'s loop, without the initial `ndetAssign` of
`Command.whileNdet`. -/
def primeBYLoop (I : PCPInstance) : Command (domainOf I) (PrimeBY.Vocab I) :=
  Command.whileLoop PrimeBY.BExpr.isB (primeBYLoopBody I)

/-- The word of `M + 1` iterations of `primeBYLoop`: `M + 1` copies of the
block `[wt yB', wt zByy', rd zBy'y]`. -/
def primeBYBlockWord (I : PCPInstance) (vals : List (Val I)) :
    Word (ThreadLabel (domainOf I) Tid.primeBY) :=
  vals.flatMap (fun l =>
    [ (⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeBY)
    , ⟨EventLabel.wt Tid.primeBY Loc.zByy' l, rfl⟩
    , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y l, rfl⟩ ])

/-! ## `rf_matches`: `primeCheckY`/`yB'` (Eq. (17))

`primeBY` always writes `Val.primeTag Tid.primeBY 0` to `yB'`, and
`primeCheckY` always expects this value there. -/

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_zByy'_ne_yB' : Loc.zByy' ≠ Loc.yB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yA'_ne_yB' : Loc.yA' ≠ Loc.yB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yA_ne_yB' : Loc.yA ≠ Loc.yB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_yB_ne_yB' : Loc.yB ≠ Loc.yB' := by decide

/-- `primeBY`'s `yB'`-writes all carry `Val.primeTag Tid.primeBY 0`. -/
theorem primeBYBlockWord_yB'_val (I : PCPInstance) (vals : List (Val I)) :
    ∀ lab ∈ primeBYBlockWord I vals,
      lab.1.loc = (Loc.yB' : (domainOf I).Loc) → lab.1.op = OpType.wt →
      lab.1.val = Val.primeTag Tid.primeBY 0 := by
  intro lab hlab hloc hop
  unfold primeBYBlockWord at hlab
  obtain ⟨v, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl
  · rfl
  · exact absurd hloc loc_zByy'_ne_yB'
  · exact absurd hop op_rd_ne_wt

/-- One iteration of `primeBYLoop` (as `primeAX_iter_step`). -/
theorem primeBY_iter_step (I : PCPInstance) (v : PrimeBY.Vals) (rest : List PrimeBY.Vals)
    (φ : (PrimeBY.Vocab I).Store) (hb : φ PrimeBY.Vars.b = Sum.inr true) (hv : v ∈ PrimeBY.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeBY.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeBY.Vocab I).Store) (cLast : Config (domainOf I) (PrimeBY.Vocab I)),
      φ' PrimeBY.Vars.b = v ∧
      φ' PrimeBY.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeBY (v :: rest)
        (primeBYLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩
        , ⟨EventLabel.wt Tid.primeBY Loc.zByy' (Val.cnt (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.rd Tid.primeBY Loc.zBy'y (Val.cnt (cnt0 + 1)), rfl⟩ ]
        cLast rest (primeBYLoop I, φ') := by
  set φ1 : (PrimeBY.Vocab I).Store :=
    Function.update φ PrimeBY.Vars.cnt (PrimeBY.eval PrimeBY.Expr.nextCnt φ) with hφ1
  have h1 : Command.RunStep Tid.primeBY (v :: rest) none (primeBYLoop I, φ) (v :: rest)
      (Command.loopSeq (primeBYLoopBody I) (primeBYLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBYLoop, Command.step, PrimeBY.Vocab, PrimeBY.evalB, hb, if_true])
  have h2 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq (primeBYLoopBody I) (primeBYLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yB' PrimeBY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBYLoopBody, PrimeBY.body, Command.step, PrimeBY.Vocab]; rfl)
  have h3 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip (Command.seq
        (Command.write Loc.yB' PrimeBY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yB' PrimeBY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.primeBY (v :: rest)
      (some ⟨EventLabel.wt Tid.primeBY Loc.yB' (Val.primeTag Tid.primeBY 0), rfl⟩)
      (Command.loopSeq (Command.seq (Command.seq
        (Command.write Loc.yB' PrimeBY.VExpr.yPrimeTag)
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, PrimeBY.Vocab, PrimeBY.evalV])
  have h5 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.primeBY (v :: rest)
      (some ⟨EventLabel.wt Tid.primeBY Loc.zByy' ((PrimeBY.Vocab I).evalV PrimeBY.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.write Loc.zByy' PrimeBY.VExpr.cntVal)
          (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h7 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq (Command.seq
        (Command.seq Command.skip (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal))
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.primeBY (v :: rest)
      (some ⟨EventLabel.rd Tid.primeBY Loc.zBy'y ((PrimeBY.Vocab I).evalV PrimeBY.VExpr.cntVal φ1),
        rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.read Loc.zBy'y PrimeBY.VExpr.cntVal)
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h9 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq (Command.seq
        Command.skip
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)) (primeBYLoop I), φ1)
      (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty) (primeBYLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h10 : Command.RunStep Tid.primeBY (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty) (primeBYLoop I), φ1)
      rest
      (Command.loopSeq Command.skip (primeBYLoop I),
        Function.update φ1 PrimeBY.Vars.b v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h11 : Command.RunStep Tid.primeBY rest none
      (Command.loopSeq Command.skip (primeBYLoop I), Function.update φ1 PrimeBY.Vars.b v)
      rest
      (primeBYLoop I, Function.update φ1 PrimeBY.Vars.b v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.primeBY) (s := v :: rest) (c := (primeBYLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.labelledSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have hcnt1 : φ1 PrimeBY.Vars.cnt = Sum.inl (cnt0 + 1) :=
    (Function.update_self PrimeBY.Vars.cnt (PrimeBY.eval PrimeBY.Expr.nextCnt φ) φ).trans
      (by simp only [PrimeBY.eval, hcnt0]; rfl)
  have hl : (PrimeBY.Vocab I).evalV PrimeBY.VExpr.cntVal φ1 = Val.cnt (cnt0 + 1) := by
    simp only [PrimeBY.Vocab, PrimeBY.evalV, hcnt1]; rfl
  rw [hl] at run11
  have hne_cntb : PrimeBY.Vars.cnt ≠ PrimeBY.Vars.b := by decide
  refine ⟨Function.update φ1 PrimeBY.Vars.b v, _, Function.update_self _ _ _, ?_, run11⟩
  exact (Function.update_of_ne hne_cntb v φ1).trans hcnt1

/-- From `φ.b = False`, `primeBYLoop` halts in one silent step. -/
theorem primeBY_stop_step (I : PCPInstance) (rest : List PrimeBY.Vals)
    (φ : (PrimeBY.Vocab I).Store) (hb : φ PrimeBY.Vars.b = Sum.inr false) :
    Command.Run Tid.primeBY rest (primeBYLoop I, φ) [] (primeBYLoop I, φ) rest
      (Command.skip, φ) := by
  have h1 : Command.RunStep Tid.primeBY rest none (primeBYLoop I, φ) rest (Command.skip, φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [primeBYLoop, Command.step, PrimeBY.Vocab, PrimeBY.evalB, hb,
        Bool.false_eq_true, if_false])
  exact Command.Run.silentSnoc Command.Run.nil h1

/-- `M + 1` iterations of `primeBYLoop` (as `primeAX_shape`). -/
theorem primeBY_shape (I : PCPInstance) (M : ℕ) (φ : (PrimeBY.Vocab I).Store)
    (hb : φ PrimeBY.Vars.b = Sum.inr true)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeBY.Vars.cnt = Sum.inl cnt0) :
    ∃ (vals : List (Val I)) (φ' : (PrimeBY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeBY.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(cnt0.val + i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeBY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeBY (List.replicate M (Sum.inr true) ++ [Sum.inr false])
        (primeBYLoop I, φ) (primeBYBlockWord I vals) cLast [] (Command.skip, φ') := by
  induction M generalizing φ cnt0 with
  | zero =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeBY_iter_step I (Sum.inr false) [] φ hb (by simp [PrimeBY.X]) cnt0 hcnt0
      have hrun2 := primeBY_stop_step I [] φ1 hφ1b
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨[Val.cnt (cnt0 + 1)], φ1, cLast, rfl, ?_, hφ1b, hcomb⟩
      intro i hi
      have hi0 : i = 0 := by simpa using hi
      subst hi0
      simp only [List.getElem?_cons_zero, Option.some.injEq]
      congr 1
  | succ M ih =>
      obtain ⟨φ1, cLast1, hφ1b, hcnt1, hrun1⟩ :=
        primeBY_iter_step I (Sum.inr true) (List.replicate M (Sum.inr true) ++ [Sum.inr false])
          φ hb (by simp [PrimeBY.X]) cnt0 hcnt0
      obtain ⟨vals, φ', cLast2, hlen, hval, hφ'b, hrun2⟩ := ih φ1 hφ1b (cnt0 + 1) hcnt1
      obtain ⟨cLast, hcomb⟩ := Command.Run.append hrun1 hrun2
      refine ⟨Val.cnt (cnt0 + 1) :: vals, φ', cLast, by simp [hlen], ?_, hφ'b, ?_⟩
      · intro i hi
        cases i with
        | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq]
          congr 1
        | succ i =>
          simp only [List.length_cons] at hi
          have hi' : i < vals.length := by omega
          have hval' := hval i hi'
          simp only [List.getElem?_cons_succ]
          rw [hval']
          congr 2
          apply Fin.ext
          simp [Fin.add_def]
          omega
      · simp only [List.replicate_succ]
        exact hcomb

/-! ## `PrimeBY`'s whole run -/

/-- `PrimeBY`'s program, run from its initial store (as
`primeAX_general_run`). -/
theorem primeBY_general_run (I : PCPInstance) (M : ℕ) :
    ∃ (vals : List (Val I)) (φ' : (PrimeBY.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeBY.Vocab I)),
      vals.length = M + 1 ∧
      (∀ i, i < vals.length →
        vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4))) ∧
      φ' PrimeBY.Vars.b = Sum.inr false ∧
      Command.Run Tid.primeBY
        (Sum.inr true :: (List.replicate M (Sum.inr true) ++ [Sum.inr false]))
        (PrimeBY.program I,
          (PrimeBY.Vocab I).mkStore (fun v => match v with
            | .cnt => some (Sum.inl (0 : Fin 4))
            | .b => none) (Sum.inl 0))
        (primeBYBlockWord I vals)
        cLast [] (Command.term, φ') := by
  have hprog_eq : PrimeBY.program I = Command.seq
      (Command.seq (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty)
        (primeBYLoop I)) Command.term := rfl
  rw [hprog_eq]
  set φ0 : (PrimeBY.Vocab I).Store :=
    (PrimeBY.Vocab I).mkStore (fun v => match v with
      | .cnt => some (Sum.inl (0 : Fin 4))
      | .b => none) (Sum.inl 0) with hφ0
  have hcnt0 : φ0 PrimeBY.Vars.cnt = Sum.inl (0 : Fin 4) := rfl
  have hmem : (Sum.inr true : PrimeBY.Vals) ∈ PrimeBY.X := by
    unfold PrimeBY.X; decide
  set rest0 : List PrimeBY.Vals := List.replicate M (Sum.inr true) ++ [Sum.inr false] with hrest0
  have hstep1 : Command.RunStep Tid.primeBY (Sum.inr true :: rest0) none
      (⟨Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty, φ0⟩ :
        Config (domainOf I) (PrimeBY.Vocab I))
      rest0 ⟨Command.skip, Function.update φ0 PrimeBY.Vars.b (Sum.inr true)⟩ :=
    Command.RunStep.ndet hmem
  have hrun1 : Command.Run Tid.primeBY (Sum.inr true :: rest0)
      (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty, φ0)
      [] (Command.ndetAssign PrimeBY.Vars.b PrimeBY.X PrimeBY.X_nonempty, φ0)
      rest0 ⟨Command.skip, Function.update φ0 PrimeBY.Vars.b (Sum.inr true)⟩ :=
    Command.Run.silentSnoc Command.Run.nil hstep1
  have hrun1' := Command.Run.seqCongr (primeBYLoop I) hrun1
  set φ1 : (PrimeBY.Vocab I).Store := Function.update φ0 PrimeBY.Vars.b (Sum.inr true) with hφ1
  have hstep2 : Command.RunStep Tid.primeBY rest0 none
      (⟨Command.seq Command.skip (primeBYLoop I), φ1⟩ : Config (domainOf I) (PrimeBY.Vocab I))
      rest0 ⟨primeBYLoop I, φ1⟩ :=
    Command.RunStep.seqSkip
  have hrun2 := Command.Run.silentSnoc hrun1' hstep2
  have hb1 : φ1 PrimeBY.Vars.b = Sum.inr true := Function.update_self _ _ _
  have hne_cnt_b : PrimeBY.Vars.cnt ≠ PrimeBY.Vars.b := by decide
  have hcnt1 : φ1 PrimeBY.Vars.cnt = Sum.inl (0 : Fin 4) :=
    (Function.update_of_ne hne_cnt_b (Sum.inr true) φ0).trans hcnt0
  obtain ⟨vals, φ', cLastL, hlen, hval, hφ'b, hrun3⟩ := primeBY_shape I M φ1 hb1 0 hcnt1
  have hval' : ∀ i, i < vals.length →
      vals[i]? = some (Val.cnt (⟨(i + 1) % 4, by omega⟩ : Fin 4)) := by
    intro i hi; simpa using hval i hi
  obtain ⟨cLastAB, hcombAB⟩ := Command.Run.append hrun2 hrun3
  have hrunAB' := Command.Run.seqCongr Command.term hcombAB
  simp only [List.nil_append] at hrunAB'
  have hstep4 : Command.RunStep Tid.primeBY ([] : List PrimeBY.Vals) none
      (⟨Command.seq Command.skip Command.term, φ'⟩ : Config (domainOf I) (PrimeBY.Vocab I))
      [] ⟨Command.term, φ'⟩ :=
    Command.RunStep.seqSkip
  exact ⟨vals, φ', (cLastAB.1.seq Command.term, cLastAB.2), hlen, hval', hφ'b,
    Command.Run.silentSnoc hrunAB' hstep4⟩


/-- See `primeAXLoopBody`. -/
def primeCheckXLoopBody (I : PCPInstance) : Command (domainOf I) (PrimeCheckX.Vocab I) :=
  Command.seq (PrimeCheckX.body I)
    (Command.ndetAssign PrimeCheckX.Vars.b PrimeCheckX.X PrimeCheckX.X_nonempty)

/-- See `primeAXLoop`. -/
def primeCheckXLoop (I : PCPInstance) : Command (domainOf I) (PrimeCheckX.Vocab I) :=
  Command.whileLoop PrimeCheckX.BExpr.isB (primeCheckXLoopBody I)

/-- The word of `M + 1` iterations of `primeCheckXLoop`: `M + 1` copies of the
block `[wt xA', wt xB', rd xA', rd xB', rd xA, rd xB]`, with counters `cnts`. -/
def primeCheckXBlockWord (I : PCPInstance) (cnts : List (Fin 4)) :
    Word (ThreadLabel (domainOf I) Tid.primeCheckX) :=
  cnts.flatMap (fun c =>
    [ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
        ThreadLabel (domainOf I) Tid.primeCheckX)
    , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
    , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])

/-- `primeCheckX`'s `xA'`-reads all expect `Val.primeTag Tid.primeAX 0`. -/
theorem primeCheckXBlockWord_xA'read_val (I : PCPInstance) (cnts : List (Fin 4)) :
    ∀ lab ∈ primeCheckXBlockWord I cnts,
      lab.1.loc = (Loc.xA' : (domainOf I).Loc) → lab.1.op = OpType.rd →
      lab.1.val = Val.primeTag Tid.primeAX 0 := by
  intro lab hlab hloc hop
  unfold primeCheckXBlockWord at hlab
  obtain ⟨c, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd hop op_wt_ne_rd
  · exact absurd hop op_wt_ne_rd
  · rfl
  · exact absurd hloc loc_xB'_ne_xA'
  · exact absurd hloc loc_xA_ne_xA'
  · exact absurd hloc loc_xB_ne_xA'

/-- `rf_matches` for the `primeCheckX`/`xA'` branch (Eq. (17)/(17)): both sides are the same constant
(`primeAXBlockWord_xA'_val`, `primeCheckXBlockWord_xA'read_val`). -/
theorem traceRf_matches_primeCheckX_xA' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceAX : trace Tid.primeAX = primeAXBlockWord I vals)
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeAX Loc.xA' i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xA' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  have h1 := rawNthWrite_val_of_forall_mem htraceAX (primeAXBlockWord_xA'_val I vals) hew
  have h2 := rawNthRead_val_of_forall_mem htracePVX (primeCheckXBlockWord_xA'read_val I cnts) her
  rw [h1, h2]

/-! ## `rf_matches`: `primeCheckX`/`xB'` (Eq. (17))

As for `xA'`, with `Val.primeTag Tid.primeBX 0`. -/

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_zBxx'_ne_xB' : Loc.zBxx' ≠ Loc.xB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xA'_ne_xB' : Loc.xA' ≠ Loc.xB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xA_ne_xB' : Loc.xA ≠ Loc.xB' := by decide

/-- See `loc_zAxx'_ne_xA'`. -/
theorem loc_xB_ne_xB' : Loc.xB ≠ Loc.xB' := by decide

/-- `primeBX`'s `xB'`-writes all carry `Val.primeTag Tid.primeBX 0`. -/
theorem primeBXBlockWord_xB'_val (I : PCPInstance) (vals : List (Val I)) :
    ∀ lab ∈ primeBXBlockWord I vals,
      lab.1.loc = (Loc.xB' : (domainOf I).Loc) → lab.1.op = OpType.wt →
      lab.1.val = Val.primeTag Tid.primeBX 0 := by
  intro lab hlab hloc hop
  unfold primeBXBlockWord at hlab
  obtain ⟨v, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl
  · rfl
  · exact absurd hloc loc_zBxx'_ne_xB'
  · exact absurd hop op_rd_ne_wt

/-- `primeCheckX`'s `xB'`-reads all expect `Val.primeTag Tid.primeBX 0`. -/
theorem primeCheckXBlockWord_xB'read_val (I : PCPInstance) (cnts : List (Fin 4)) :
    ∀ lab ∈ primeCheckXBlockWord I cnts,
      lab.1.loc = (Loc.xB' : (domainOf I).Loc) → lab.1.op = OpType.rd →
      lab.1.val = Val.primeTag Tid.primeBX 0 := by
  intro lab hlab hloc hop
  unfold primeCheckXBlockWord at hlab
  obtain ⟨c, -, hlab⟩ := List.mem_flatMap.mp hlab
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hlab
  rcases hlab with rfl | rfl | rfl | rfl | rfl | rfl
  · exact absurd hop op_wt_ne_rd
  · exact absurd hop op_wt_ne_rd
  · exact absurd hloc loc_xA'_ne_xB'
  · rfl
  · exact absurd hloc loc_xA_ne_xB'
  · exact absurd hloc loc_xB_ne_xB'

/-- `rf_matches` for the `primeCheckX`/`xB'` branch (Eq. (17)/(17)). -/
theorem traceRf_matches_primeCheckX_xB' (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (vals : List (Val I)) (htraceBX : trace Tid.primeBX = primeBXBlockWord I vals)
    (cnts : List (Fin 4)) (htracePVX : trace Tid.primeCheckX = primeCheckXBlockWord I cnts)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.primeBX Loc.xB' i = some ew ∧
      rawNthRead trace Tid.primeCheckX Loc.xB' i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  have h1 := rawNthWrite_val_of_forall_mem htraceBX (primeBXBlockWord_xB'_val I vals) hew
  have h2 := rawNthRead_val_of_forall_mem htracePVX (primeCheckXBlockWord_xB'read_val I cnts) her
  rw [h1, h2]

/-- One iteration of `primeCheckXLoop`, from a state with `φ.b = True` and
`cnt = cnt0`, under resolution `v :: rest`: emits the six-event block with
counter `cnt0 + 1`, and returns to the loop with `b = v`. Seventeen
`Command.RunStep`s. -/
theorem primeCheckX_iter_step (I : PCPInstance) (v : PrimeCheckX.Vals)
    (rest : List PrimeCheckX.Vals)
    (φ : (PrimeCheckX.Vocab I).Store) (hb : φ PrimeCheckX.Vars.b = Sum.inr true)
    (hv : v ∈ PrimeCheckX.X)
    (cnt0 : Fin 4) (hcnt0 : φ PrimeCheckX.Vars.cnt = Sum.inl cnt0) :
    ∃ (φ' : (PrimeCheckX.Vocab I).Store)
      (cLast : Config (domainOf I) (PrimeCheckX.Vocab I)),
      φ' PrimeCheckX.Vars.b = v ∧
      φ' PrimeCheckX.Vars.cnt = Sum.inl (cnt0 + 1) ∧
      Command.Run Tid.primeCheckX (v :: rest)
        (primeCheckXLoop I, φ)
        [ ⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX (cnt0 + 1)), rfl⟩
        , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX (cnt0 + 1)), rfl⟩
