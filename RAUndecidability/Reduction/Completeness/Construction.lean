`zAy'y`. -/
theorem primeAY_reads_nondecreasing (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (vals : List (Val I)) (htrace : trace Tid.primeAY = primeAYBlockWord I vals)
    {e1 e2 : Event (domainOf I)}
