/-! ## The thread-level `hb` separation (Fig. 4), closure facts

The first consequence of the thread-level `hb` separation (Fig. 4) uses the set
`AlphaGuesserTids ∪ XCheckerTids ∪ YCheckerTids`: "every `rf`-edge leaving a
thread of `\{g_α^x,g_α^{x'},g_α^y,g_α^{y'}\}` leads to a thread of
`\{g_α^x,g_α^{x'},g_α^y,g_α^{y'}\}∪\{c^x,c^{x'},c^y,c^{y'}\}`". The second uses
`XCheckerTids`/`YCheckerTids` alone. -/

theorem alphaOrChecker_closed {t t' : Tid}
    (ht : t ∈ AlphaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids)
    (hp : (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) :
    t' ∈ AlphaGuesserTids ∨ t' ∈ XCheckerTids ∨ t' ∈ YCheckerTids := by
  rcases ht with ht | ht | ht <;> fin_cases ht <;> revert t' hp <;> decide

/-- `betaOrChecker_closed`'s analogue of `alphaOrChecker_closed`. -/
theorem betaOrChecker_closed {t t' : Tid}
    (ht : t ∈ BetaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids)
    (hp : (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY)) :
    t' ∈ BetaGuesserTids ∨ t' ∈ XCheckerTids ∨ t' ∈ YCheckerTids := by
  rcases ht with ht | ht | ht <;> fin_cases ht <;> revert t' hp <;> decide

/-- `AlphaGuesserTids ∪ XCheckerTids ∪ YCheckerTids` and `BetaGuesserTids` are
disjoint. -/
theorem beta_not_alphaOrChecker :
    ∀ t, t ∈ BetaGuesserTids →
      ¬ (t ∈ AlphaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids) := by
  decide

/-- `alpha_not_betaOrChecker`'s analogue of `beta_not_alphaOrChecker`. -/
theorem alpha_not_betaOrChecker :
    ∀ t, t ∈ AlphaGuesserTids →
      ¬ (t ∈ BetaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids) := by
  decide

/-- `XCheckerTids` and `YCheckerTids` are disjoint. -/
theorem yChecker_not_xChecker : ∀ t, t ∈ YCheckerTids → t ∉ XCheckerTids := by
  decide

/-- `xChecker_not_yChecker`'s analogue of `yChecker_not_xChecker`. -/
theorem xChecker_not_yChecker : ∀ t, t ∈ XCheckerTids → t ∉ YCheckerTids := by
  decide

/-- If `R`-edges out of `S` stay in `S`, and `a ∈ S`, every
`Relation.TransGen R`-successor of `a` lies in `S`. -/
theorem transGen_closed {α} (R : α → α → Prop) (S : Set α)
    (hS : ∀ a ∈ S, ∀ b, R a b → b ∈ S) {a b : α}
    (hab : Relation.TransGen R a b) (ha : a ∈ S) : b ∈ S := by
  induction hab with
  | single h => exact hS a ha _ h
  | tail _ h ih => exact hS _ ih _ h

/-- A `→rf⁺` sequence starting in `AlphaGuesserTids ∪ XCheckerTids ∪
YCheckerTids` stays there. -/
theorem threadRf_transGen_alphaOrChecker_closed {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {t t' : Tid} (ht : t ∈ AlphaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids)
    (htg : Relation.TransGen (ThreadRf I trace) t t') :
    t' ∈ AlphaGuesserTids ∨ t' ∈ XCheckerTids ∨ t' ∈ YCheckerTids :=
  transGen_closed (ThreadRf I trace) _
    (fun _ ha _ hab => alphaOrChecker_closed ha (threadRf_pairs I hab)) htg ht

/-- `threadRf_transGen_betaOrChecker_closed`'s analogue of
`threadRf_transGen_alphaOrChecker_closed`. -/
theorem threadRf_transGen_betaOrChecker_closed {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {t t' : Tid} (ht : t ∈ BetaGuesserTids ∨ t ∈ XCheckerTids ∨ t ∈ YCheckerTids)
    (htg : Relation.TransGen (ThreadRf I trace) t t') :
    t' ∈ BetaGuesserTids ∨ t' ∈ XCheckerTids ∨ t' ∈ YCheckerTids :=
  transGen_closed (ThreadRf I trace) _
    (fun _ ha _ hab => betaOrChecker_closed ha (threadRf_pairs I hab)) htg ht

/-- A `→rf⁺` sequence starting in `XCheckerTids` stays there. -/
theorem threadRf_transGen_xChecker_closed {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {t t' : Tid} (ht : t ∈ XCheckerTids) (htg : Relation.TransGen (ThreadRf I trace) t t') :
    t' ∈ XCheckerTids :=
  transGen_closed (ThreadRf I trace) _
    (fun _ ha _ hab => xCheckerTids_closed ha (threadRf_pairs I hab)) htg ht

/-- `threadRf_transGen_yChecker_closed`'s analogue of
`threadRf_transGen_xChecker_closed`. -/
theorem threadRf_transGen_yChecker_closed {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    {t t' : Tid} (ht : t ∈ YCheckerTids) (htg : Relation.TransGen (ThreadRf I trace) t t') :
    t' ∈ YCheckerTids :=
  transGen_closed (ThreadRf I trace) _
    (fun _ ha _ hab => yCheckerTids_closed ha (threadRf_pairs I hab)) htg ht

/-- If `R`-edges out of `S` stay in `S`, and a chain starts in `S`, all of it
lies in `S`. -/
theorem chain_closure {α} (R : α → α → Prop) (S : Set α)
    (hS : ∀ a ∈ S, ∀ b, R a b → b ∈ S) (x : α) (l : List α)
    (hchain : List.IsChain R (x :: l)) (hx : x ∈ S) :
    ∀ y ∈ (x :: l), y ∈ S := by
  induction l generalizing x with
  | nil => simpa using hx
  | cons y ys ih =>
      rw [List.isChain_cons_cons] at hchain
      obtain ⟨hRxy, hchain'⟩ := hchain
      have hyS : y ∈ S := hS x hx y hRxy
      intro z hz
      simp only [List.mem_cons] at hz
      rcases hz with rfl | rfl | hz
      · exact hx
      · exact hyS
      · exact ih y hchain' hyS z (by simp [hz])

/-- If no `R`-edge enters `S` from outside, and a chain ends in `S`, all of it
lies in `S`. -/
theorem chain_closure_backward {α} (R : α → α → Prop) (S : Set α)
    (hS : ∀ b ∈ S, ∀ a, R a b → a ∈ S) (x : α) (l : List α)
    (hchain : List.IsChain R (l ++ [x])) (hx : x ∈ S) :
    ∀ y ∈ (l ++ [x]), y ∈ S := by
  have hrev : List.IsChain (flip R) (l ++ [x]).reverse := List.isChain_reverse.mpr hchain
  rw [List.reverse_append, List.reverse_singleton, List.singleton_append] at hrev
  have hres := chain_closure (flip R) S (fun a ha b hab => hS a ha b hab) x l.reverse hrev hx
  intro y hy
  apply hres
  simp only [List.mem_cons, List.mem_reverse]
  simp only [List.mem_append, List.mem_singleton] at hy
  tauto

/-- The positions `0,1,2,3` of `g_α^{x'} - g_α^x - g_α^y - g_α^{y'}` along the path of
`AlphaGuesserTids`. Every edge within the group moves by `±1`
(`alphaPosEdge_of_pairs`), and no closed walk on four positions without
repetition has length `3` or `4` (`no_alphaPos_cycle3`/`4`, by `decide` over
`Fin 4 → Fin 4`). -/
def AlphaPos : Tid → Fin 4
  | .primeAX => 0 | .guessAX => 1 | .guessAY => 2 | .primeAY => 3
  | _ => 0

def BetaPos : Tid → Fin 4
  | .primeBX => 0 | .guessBX => 1 | .guessBY => 2 | .primeBY => 3
  | _ => 0

private def PosEdge (a b : Fin 4) : Prop := (a.val + 1 = b.val) ∨ (b.val + 1 = a.val)

instance (a b : Fin 4) : Decidable (PosEdge a b) := by unfold PosEdge; infer_instance

theorem alphaPosEdge_of_pairs {t t' : Tid}
    (hp : (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY))
    (ht : t ∈ AlphaGuesserTids) (ht' : t' ∈ AlphaGuesserTids) :
    PosEdge (AlphaPos t) (AlphaPos t') := by
  fin_cases ht <;> fin_cases ht' <;> revert hp <;> decide

theorem betaPosEdge_of_pairs {t t' : Tid}
    (hp : (t = Tid.primeAX ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessAX ∧ t' = Tid.primeAX) ∨
      (t = Tid.primeAY ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.primeAY) ∨
      (t = Tid.primeBX ∧ t' = Tid.guessBX) ∨
      (t = Tid.guessBX ∧ t' = Tid.primeBX) ∨
      (t = Tid.primeBY ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.primeBY) ∨
      (t = Tid.guessAX ∧ t' = Tid.guessAY) ∨
      (t = Tid.guessAY ∧ t' = Tid.guessAX) ∨
      (t = Tid.guessBX ∧ t' = Tid.guessBY) ∨
      (t = Tid.guessBY ∧ t' = Tid.guessBX) ∨
      (t = Tid.checkX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.primeCheckX ∧ t' = Tid.checkX) ∨
      (t = Tid.checkY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.primeCheckY ∧ t' = Tid.checkY) ∨
      (t = Tid.guessAX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeAX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessBX ∧ t' = Tid.checkX) ∨
      (t = Tid.primeBX ∧ t' = Tid.primeCheckX) ∨
      (t = Tid.guessAY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeAY ∧ t' = Tid.primeCheckY) ∨
      (t = Tid.guessBY ∧ t' = Tid.checkY) ∨
      (t = Tid.primeBY ∧ t' = Tid.primeCheckY))
    (ht : t ∈ BetaGuesserTids) (ht' : t' ∈ BetaGuesserTids) :
    PosEdge (BetaPos t) (BetaPos t') := by
  fin_cases ht <;> fin_cases ht' <;> revert hp <;> decide

theorem alphaPos_inj : ∀ a ∈ AlphaGuesserTids, ∀ b ∈ AlphaGuesserTids,
    AlphaPos a = AlphaPos b → a = b := by decide

theorem betaPos_inj : ∀ a ∈ BetaGuesserTids, ∀ b ∈ BetaGuesserTids,
    BetaPos a = BetaPos b → a = b := by decide

theorem no_alphaPos_cycle3 :
    ¬ ∃ a b c : Fin 4, [a, b, c].Nodup ∧ List.IsChain PosEdge ([a, b, c] ++ [a]) := by decide

theorem no_alphaPos_cycle4 :
    ¬ ∃ a b c d : Fin 4, [a, b, c, d].Nodup ∧
      List.IsChain PosEdge ([a, b, c, d] ++ [a]) := by decide

/-- A chain under `E` within a set `S` on which `E` implies `F` is a chain
under `F`. -/
theorem chain_map_of_mem {α} {E F : α → α → Prop} (S : Set α)
    (hEF : ∀ a b, E a b → a ∈ S → b ∈ S → F a b) :
    ∀ (l : List α), (∀ x ∈ l, x ∈ S) → List.IsChain E l → List.IsChain F l := by
  intro l
  induction l with
  | nil => intro _ _; exact List.IsChain.nil
  | cons a rest ih =>
      intro hsub hchain
      cases rest with
      | nil => exact List.IsChain.singleton _
      | cons b rest' =>
          rw [List.isChain_cons_cons] at hchain ⊢
          exact ⟨hEF a b hchain.1 (hsub a (by simp)) (hsub b (by simp)),
            ih (fun x hx => hsub x (by simp [hx])) hchain.2⟩

/-- For `AlphaGuesserTids`: a cyclic sequence without repetition within the
group, under a relation whose edges within the group are `AlphaPos`-adjacent,
has length `2`. -/
theorem alphaGroup_cycle_length_two {E : Tid → Tid → Prop}
    (hEdge : ∀ t t', E t t' → t ∈ AlphaGuesserTids → t' ∈ AlphaGuesserTids →
      PosEdge (AlphaPos t) (AlphaPos t'))
    (l : List Tid) (hne : l ≠ []) (hnodup : l.Nodup)
    (hsub : ∀ x ∈ l, x ∈ AlphaGuesserTids)
    (hcycle : List.IsChain E (l ++ [l.headI])) :
    l.length = 2 := by
  have hlmap : List.IsChain PosEdge ((l.map AlphaPos) ++ [(l.map AlphaPos).headI]) := by
    have heq : (l.map AlphaPos) ++ [(l.map AlphaPos).headI] = (l ++ [l.headI]).map AlphaPos := by
      rw [List.map_append, List.map_cons, List.map_nil]
      congr 1
      cases l with
      | nil => exact absurd rfl hne
      | cons a l' => rfl
    rw [heq, List.isChain_map]
    have hsub' : ∀ x ∈ l ++ [l.headI], x ∈ AlphaGuesserTids := by
      intro x hx
      simp only [List.mem_append, List.mem_singleton] at hx
      rcases hx with hx | rfl
      · exact hsub x hx
      · exact hsub l.headI (by
          cases l with
          | nil => exact absurd rfl hne
          | cons a l' => simp)
    exact chain_map_of_mem AlphaGuesserTids
      (fun a b h ha hb => hEdge a b h ha hb) (l ++ [l.headI]) hsub' hcycle
  have hnodupmap : (l.map AlphaPos).Nodup :=
    hnodup.map_on (fun x hx y hy => alphaPos_inj x (hsub x hx) y (hsub y hy))
  have hbound : l.length ≤ 4 := by
    have h1 : l.toFinset.card = l.length := List.toFinset_card_of_nodup hnodup
    have h2 : l.toFinset ⊆ AlphaGuesserTids := fun x hx => hsub x (List.mem_toFinset.mp hx)
    have h3 : l.toFinset.card ≤ AlphaGuesserTids.card := Finset.card_le_card h2
    have h4 : AlphaGuesserTids.card = 4 := by decide
    omega
  match hl : l with
  | [] => exact (hne rfl).elim
  | [a] =>
      exfalso
      simp only [List.map_cons, List.map_nil, List.singleton_append, List.headI_cons] at hlmap
      rw [List.isChain_cons_cons] at hlmap
      have hself : PosEdge (AlphaPos a) (AlphaPos a) := hlmap.1
      unfold PosEdge at hself
      omega
  | [a, b] => rfl
  | (a :: b :: c :: rest) =>
      exfalso
      have hrestlen : rest.length ≤ 1 := by
        simp only [List.length_cons] at hbound; omega
      have hcase : rest.length = 0 ∨ rest.length = 1 := by omega
      rcases hcase with hr | hr
      · obtain hrnil := List.length_eq_zero_iff.mp hr
        subst hrnil
        apply no_alphaPos_cycle3
        refine ⟨AlphaPos a, AlphaPos b, AlphaPos c, ?_, ?_⟩
        · have := hnodupmap; simp only [List.map_cons, List.map_nil] at this; simpa using this
        · have := hlmap
          simp only [List.map_cons, List.map_nil, List.headI_cons] at this
          simpa using this
      · obtain ⟨d, hd⟩ := List.length_eq_one_iff.mp hr
        subst hd
        apply no_alphaPos_cycle4
        refine ⟨AlphaPos a, AlphaPos b, AlphaPos c, AlphaPos d, ?_, ?_⟩
        · have := hnodupmap; simp only [List.map_cons, List.map_nil] at this; simpa using this
        · have := hlmap
          simp only [List.map_cons, List.map_nil, List.headI_cons] at this
          simpa using this

/-- `BetaGuesserTids`'s analogue of `alphaGroup_cycle_length_two`. -/
theorem betaGroup_cycle_length_two {E : Tid → Tid → Prop}
