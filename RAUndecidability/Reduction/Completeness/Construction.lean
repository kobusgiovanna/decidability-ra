    (hdec : rawIndex trace e2 < rawIndex trace e1) : False := by
  have htrace' : trace Tid.primeAY = vals.flatMap (primeAYBlockElems I) := by
    rw [htrace, primeAYBlockWord_eq_flatMap]
  have hpos0 : primeAYBlockShape[0]? = some (Loc.yA', OpType.wt) := by decide
  have hpos1 : primeAYBlockShape[1]? = some (Loc.zAyy', OpType.wt) := by decide
  have hpos2 : primeAYBlockShape[2]? = some (Loc.zAy'y, OpType.rd) := by decide
  obtain ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula (primeAYBlockElems I) primeAYBlockShape
      (primeAYBlockElems_shape I) primeAYBlockShape_nodup trace vals htrace' he1
  obtain ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
    flatLoop_index_formula (primeAYBlockElems I) primeAYBlockShape
      (primeAYBlockElems_shape I) primeAYBlockShape_nodup trace vals htrace' he2
  have hp1L' : p1 < 3 := hp1L
  have hp2L' : p2 < 3 := hp2L
  have hp1cases : p1 = 0 ∨ p1 = 1 ∨ p1 = 2 := by omega
  have hp2cases : p2 = 0 ∨ p2 = 1 ∨ p2 = 2 := by omega
  have e1loc : e1.loc = Loc.zAy'y := by
    rcases hp1cases with rfl | rfl | rfl
    · have h := hshape1.symm.trans hpos0
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1.symm.trans hpos1
      injection h with h; injection h with _ b; exact absurd (b.symm.trans hrd1) (by decide)
    · have h := hshape1.symm.trans hpos2
      injection h with h; injection h with a _
