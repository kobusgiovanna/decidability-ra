  obtain ⟨c, hc⟩ : ∃ c, cnts[i]? = some c := ⟨cnts[i]'hilt, List.getElem?_eq_getElem hilt⟩
  have hfilt := zipIdx_flatMap_filter_getElem
    (α := Fin 4) (β := ThreadLabel (domainOf I) Tid.primeCheckX)
    (fun c =>
      [ (⟨EventLabel.wt Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
          ThreadLabel (domainOf I) Tid.primeCheckX)
      , ⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA' (Val.primeTag Tid.primeAX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xA (Val.primeTag Tid.checkX c), rfl⟩
      , ⟨EventLabel.rd Tid.primeCheckX Loc.xB (Val.primeTag Tid.checkX c), rfl⟩ ])
    6 1
    (fun _ => rfl)
    (primeCheckXXBprimeWritePred I)
    (fun c => (⟨EventLabel.wt Tid.primeCheckX Loc.xB' (Val.primeTag Tid.primeCheckX c), rfl⟩ :
      ThreadLabel (domainOf I) Tid.primeCheckX))
    (fun a => rfl)
    (fun a => rfl)
    (by
      intro a q b hq hget
      have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
      have hq5 : q = 0 ∨ q = 2 ∨ q = 3 ∨ q = 4 ∨ q = 5 := by omega
      rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
        simp only [List.getElem?_cons_zero, List.getElem?_cons_succ, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold primeCheckXXBprimeWritePred
      · exact xBprimeWritePredCore_false_of_ne Loc.xA' OpType.wt (by decide)
      · exact xBprimeWritePredCore_false_of_ne Loc.xA' OpType.rd (by decide)
      · exact xBprimeWritePredCore_false_of_ne Loc.xB' OpType.rd (by decide)
      · exact xBprimeWritePredCore_false_of_ne Loc.xA OpType.rd (by decide)
      · exact xBprimeWritePredCore_false_of_ne Loc.xB OpType.rd (by decide))
    cnts 0 i c hc
  have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.primeCheckX)
    (l := primeCheckXBlockWord I cnts) htrace (primeCheckXXBprimeWritePred_iff I) hfilt
  have hraw : rawNthEvent trace Tid.primeCheckX Loc.xB' OpType.wt i = some ew := h
  rw [hraw] at hconn
  exact ⟨c, hc, by injection hconn with hconn; rw [hconn]; rfl⟩



def xBprimeReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xB', OpType.rd => true | _, _ => false

theorem xBprimeReadPredCore_iff (y : Loc) (z : OpType) :
    xBprimeReadPredCore y z = true ↔ (y = Loc.xB' ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem xBprimeReadPredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.xB' ∧ z = OpType.rd)) :
    xBprimeReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `primeBX`'s `xB'`-write predicate. -/
def primeBXXBprimeWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.primeBX) :
    Bool :=
  xBprimeWritePredCore lab.1.loc lab.1.op

theorem primeBXXBprimeWritePred_iff (I : PCPInstance)
    (lab : ThreadLabel (domainOf I) Tid.primeBX) :
    primeBXXBprimeWritePred I lab = true ↔ (lab.1.loc = Loc.xB' ∧ lab.1.op = OpType.wt) := by
  unfold primeBXXBprimeWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xBprimeWritePredCore_iff y z

/-- `primeBXBlockWord` has one `xB'`-write per entry of `vals`. -/
theorem primeBXBlockWord_xBprime_length (I : PCPInstance) (vals : List (Val I)) :
    ((primeBXBlockWord I vals).filter (primeBXXBprimeWritePred I)).length = vals.length := by
  induction vals with
  | nil => rfl
  | cons v vs ih =>
      show (([ (⟨EventLabel.wt Tid.primeBX Loc.xB' (Val.primeTag Tid.primeBX 0), rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX)
        , ⟨EventLabel.wt Tid.primeBX Loc.zBxx' v, rfl⟩
        , ⟨EventLabel.rd Tid.primeBX Loc.zBx'x v, rfl⟩ ] ++ (primeBXBlockWord I vs)).filter
        (primeBXXBprimeWritePred I)).length = (v :: vs).length
      rw [List.filter_append, List.length_append, ih,
        List.filter_cons_of_pos (a := (⟨EventLabel.wt Tid.primeBX Loc.xB'
            (Val.primeTag Tid.primeBX 0), rfl⟩ : ThreadLabel (domainOf I) Tid.primeBX))
          (by unfold primeBXXBprimeWritePred
              exact (xBprimeWritePredCore_iff Loc.xB' OpType.wt).mpr ⟨rfl, rfl⟩),
        List.filter_cons_of_neg (a := (⟨EventLabel.wt Tid.primeBX Loc.zBxx' v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX))
          (by unfold primeBXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.zBxx' OpType.wt (by decide)),
        List.filter_cons_of_neg (a := (⟨EventLabel.rd Tid.primeBX Loc.zBx'x v, rfl⟩ :
            ThreadLabel (domainOf I) Tid.primeBX))
          (by unfold primeBXXBprimeWritePred
              simpa [EventLabel.loc, EventLabel.op] using
                xBprimeWritePredCore_false_of_ne Loc.zBx'x OpType.rd (by decide)),
        List.filter_nil]
      simp only [List.length_cons, List.length_nil]
      omega

