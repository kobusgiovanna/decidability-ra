/-- `rf_total` for the `guessBY`/`zBxy` branch (Eq. (15)). -/
theorem traceRf_total_guessBY_zBxy (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGBX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (hcount : kws.length ≤ 1 + outerRest.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessBY) (her_loc : er.loc = Loc.zBxy)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.guessBY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.guessBY Loc.zBxy OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.guessBY Loc.zBxy OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.guessBY Loc.zBxy i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.guessBY Loc.zBxy OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.zBxy) (op := OpType.rd) (predL := guessBYZBxyReadPred I) htraceG
    (guessBYZBxyReadPred_iff I)
  have hlen2 : ((guessBYBlockWord I v0 kws).filter (guessBYZBxyReadPred I)).length
      = kws.length := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_zBxy_filter,
      guessBYBlockRestElems_zBxy_filter]
    simp
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBX)
    (x := Loc.zBxy) (op := OpType.wt) (predL := guessBXZBxyWritePred I) htraceGBX
    (guessBXZBxyWritePred_iff I)
  have hlenW2 : ((guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
      (guessBXZBxyWritePred I)).length = 1 + outerRest.length := by
    rw [guessBXBlockWord_zBxy_filter_eq, List.length_append, List.length_singleton,
      List.length_map]
  have hilt_writer : i < (rawOpEvents trace Tid.guessBX Loc.zBxy OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_guessBY_guessBX_zBxy (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (cntY0 : Fin 4) (hcntY0 : cntY0 = 0)
    (hvB0 : vB0.1 = Val.cnt (cntY0 + 1))
    (houterB1 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      a.1 = Val.cnt (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBX Loc.zBxy i = some ew ∧
      rawNthRead trace Tid.guessBY Loc.zBxy i = some er) :
    ew.val = er.val := by
  subst hcntY0
  obtain ⟨i, hew, her⟩ := h
  obtain ⟨kw, hkw, herval⟩ := rawNthRead_guessBY_zBxy_eq I v0 kws htraceGAY her
  have hilen : i < kws.length := (List.getElem?_eq_some_iff.mp hkw).1
  obtain ⟨w, hw⟩ := hkwsVal i hilen
  have hkweq := hkw.symm.trans hw
  injection hkweq with hkweq
  rcases rawNthWrite_guessBX_zBxy_eq I v1 v2 vB0 inner0Rest outerRest htraceGAX hew with
    ⟨hi0, hewval⟩ | ⟨m, hieq, a, vs, hav, hewval⟩
  · subst hi0
    rw [hewval, herval, hvB0, hkweq]
    congr 1
  · obtain ⟨a', vs', hav', ha1'⟩ := houterB1 m (by
      have hlt := (List.getElem?_eq_some_iff.mp hav).1
      exact hlt)
    rw [hav] at hav'
    simp only [Option.some.injEq, Prod.mk.injEq] at hav'
    obtain ⟨haeq, hvseq⟩ := hav'
    subst haeq
    rw [hewval, herval, ha1', hkweq]
    congr 1
    apply Fin.ext
    simp
    omega

/-- `traceRf_matches_guessBY_guessBX_zBxy` for the general construction. -/
theorem traceRf_matches_guessBY_guessBX_zBxy_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGBX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (hvB01raw : vB0.1 = Val.cnt (1 : Fin 4))
    (houterBAraw : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      a.1 = Val.cnt (⟨(2 + m) % 4, by omega⟩ : Fin 4))
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ i, i < kws.length → ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBX Loc.zBxy i = some ew ∧
      rawNthRead trace Tid.guessBY Loc.zBxy i = some er) :
    ew.val = er.val := by
  have hvB0 : vB0.1 = Val.cnt ((0 : Fin 4) + 1) := by rw [hvB01raw]; congr 1
  have houterB1 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      a.1 = Val.cnt (⟨((0 : Fin 4).val + 2 + m) % 4, by omega⟩ : Fin 4) := by
    intro m hm
    obtain ⟨a, vs, hav, ha1⟩ := houterBAraw m hm
    exact ⟨a, vs, hav, by rw [ha1]; congr 2⟩
  exact traceRf_matches_guessBY_guessBX_zBxy I v1 v2 vB0 inner0Rest outerRest htraceGBX 0 rfl
    hvB0 houterB1 v0 kws htraceGBY hkwsVal h

