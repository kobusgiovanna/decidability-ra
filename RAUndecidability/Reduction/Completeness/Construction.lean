theorem rawNthWrite_guessBY_ellByx_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessBY Loc.ellByx i = some ew) :
    (i = 0 ∧ ew.val = Val.cntAux 1 (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.cntAux (kw.1 + 1) kw.2) := by
  have hpredL := guessBYEllBWritePred_iff I
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.ellByx) (op := OpType.wt)
    (predL := guessBYEllBWritePred I) htrace hpredL
  have hlen2 : ((guessBYBlockWord I v0 kws).filter (guessBYEllBWritePred I)).length
      = kws.length + 1 := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_ellByx_filter,
      guessBYBlockRestElems_ellByx_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (guessBYBlockWord I v0 kws).zipIdx.filter (fun p => guessBYEllBWritePred I p.1) =
      [((⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 1)] ++
      ((kws.flatMap (guessBYBlockRestElems I)).zipIdx 3).filter
        (fun p => guessBYEllBWritePred I p.1) := by
    unfold guessBYBlockWord
    have hz0 : (((guessBYBlock0Elems I v0).zipIdx).filter
        (fun p => guessBYEllBWritePred I p.1)) =
        [((⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 1)] := by
      apply list_filter_singleton_of_unique' ((guessBYBlock0Elems I v0).zipIdx)
        (fun p => guessBYEllBWritePred I p.1) 1
        ((⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 1)
        (by rw [List.getElem?_zipIdx]; rfl)
        (by unfold guessBYEllBWritePred
            exact (ellByxWritePredCore_iff Loc.ellByx OpType.wt).mpr ⟨rfl, rfl⟩)
        (by
          intro q b hq hget
          rw [List.getElem?_zipIdx] at hget
          have hqlt : q < 3 := by
            rcases Nat.lt_or_ge q 3 with hqlt | hqge
            · exact hqlt
            · exfalso
              have hqge3 : (guessBYBlock0Elems I v0).length ≤ q := by
                simp only [guessBYBlock0Elems, List.length_cons, List.length_nil]; omega
              have : (guessBYBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge3
              rw [this] at hget; simp at hget
          have hq02 : q = 0 ∨ q = 2 := by omega
          rcases hq02 with rfl | rfl <;>
            simp only [guessBYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
              Option.map_some, Option.some.injEq] at hget <;>
            rw [← hget] <;>
            unfold guessBYEllBWritePred
          · exact ellByxWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
          · exact ellByxWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide))
    rw [List.zipIdx_append, List.filter_append, hz0]
    congr 2
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBY)
      (l := guessBYBlockWord I v0 kws) htrace hpredL
      (n := 0) (lab := (⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux 1 (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY)) (origPos := 1)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.guessBY Loc.ellByx OpType.wt 0 = some ew := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.guessBY)
      (guessBYBlockRestElems I) 5 1
      (fun kw => rfl)
      (guessBYEllBWritePred I)
      (fun kw => (⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux (kw.1 + 1) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY))
      (fun a => rfl)
      (fun a => by
        unfold guessBYEllBWritePred
        exact (ellByxWritePredCore_iff Loc.ellByx OpType.wt).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
        have hq4 : q = 0 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
        rcases hq4 with rfl | rfl | rfl | rfl <;>
          simp only [guessBYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold guessBYEllBWritePred
        · exact ellByxWritePredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact ellByxWritePredCore_false_of_ne Loc.zAy'y OpType.wt (by decide)
        · exact ellByxWritePredCore_false_of_ne Loc.zBxy OpType.rd (by decide)
        · exact ellByxWritePredCore_false_of_ne Loc.zAyy' OpType.rd (by decide))
      kws 3 j kw hkw
    have hzipj :
        ((guessBYBlockWord I v0 kws).zipIdx.filter (fun p => guessBYEllBWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.guessBY Loc.ellByx (Val.cntAux (kw.1 + 1) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 3 + j * 5 + 1) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBY)
      (l := guessBYBlockWord I v0 kws) htrace hpredL hzipj
    have hraw : rawNthEvent trace Tid.guessBY Loc.ellByx OpType.wt i = some ew := h
    rw [hraw] at hconn
    refine ⟨kw, hkw, by omega, ?_⟩
    injection hconn with hconn
    rw [hconn]; rfl

def ellByxReadPredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.ellByx, OpType.rd => true | _, _ => false

theorem ellByxReadPredCore_iff (y : Loc) (z : OpType) :
    ellByxReadPredCore y z = true ↔ (y = Loc.ellByx ∧ z = OpType.rd) := by
  cases y <;> cases z <;> decide

theorem ellByxReadPredCore_false_of_ne (y : Loc) (z : OpType)
    (hne : ¬ (y = Loc.ellByx ∧ z = OpType.rd)) :
    ellByxReadPredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

theorem guessBXInnerBlockShape_no_ellByx_rd : ∀ p ∈ guessBXInnerBlockShape,
    ¬ (p.1 = Loc.ellByx ∧ p.2 = OpType.rd) := by decide

variable (I : PCPInstance)

def guessBXEllBReadPred (lab : ThreadLabel (domainOf I) Tid.guessBX) : Bool :=
  ellByxReadPredCore lab.1.loc lab.1.op

theorem guessBXEllBReadPred_iff (lab : ThreadLabel (domainOf I) Tid.guessBX) :
    guessBXEllBReadPred I lab = true ↔ (lab.1.loc = Loc.ellByx ∧ lab.1.op = OpType.rd) := by
  unfold guessBXEllBReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact ellByxReadPredCore_iff y z

theorem guessBXInnerFlatMap_ellByx_filter (vs : List (Val I × Val I × Val I)) :
    (vs.flatMap (guessBXInnerBlockElems I)).filter (guessBXEllBReadPred I) = [] := by
  induction vs with
  | nil => rfl
  | cons a vs ih =>
      rw [List.flatMap_cons, List.filter_append, ih, List.append_nil,
        List.filter_eq_nil_iff]
      intro x hx
      have hshape := guessBXInnerBlockElems_shape I a
      have hxshape : (x.1.loc, x.1.op) ∈ guessBXInnerBlockShape := by
        rw [← hshape]; exact List.mem_map_of_mem hx
      have hxne := guessBXInnerBlockShape_no_ellByx_rd _ hxshape
      unfold guessBXEllBReadPred
      obtain ⟨y, hy⟩ : ∃ y : Loc, x.1.loc = y := ⟨x.1.loc, rfl⟩
      obtain ⟨z, hz⟩ : ∃ z : OpType, x.1.op = z := ⟨x.1.op, rfl⟩
      rw [hy, hz]
      have hne : ¬ (y = Loc.ellByx ∧ z = OpType.rd) := by rw [← hy, ← hz]; exact hxne
      rw [ellByxReadPredCore_false_of_ne y z hne]
      decide

theorem guessBXOuterBlockElems_ellByx_filter (b : Val I × Val I) (vs : List (Val I × Val I × Val I)) :
    (guessBXOuterBlockElems I b vs).filter (guessBXEllBReadPred I) =
      [(⟨EventLabel.rd Tid.guessBX Loc.ellByx b.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)] := by
  show List.filter (guessBXEllBReadPred I)
      ((⟨EventLabel.wt Tid.guessBX Loc.zBxy b.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX) ::
        (vs.flatMap (guessBXInnerBlockElems I) ++
          [⟨EventLabel.rd Tid.guessBX Loc.ellByx b.2, rfl⟩]))
      = [(⟨EventLabel.rd Tid.guessBX Loc.ellByx b.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)]
  rw [List.filter_cons_of_neg
      (by unfold guessBXEllBReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellByxReadPredCore_false_of_ne Loc.zBxy OpType.wt (by decide)),
    List.filter_append, guessBXInnerFlatMap_ellByx_filter, List.nil_append,
    List.filter_cons_of_pos
      (by unfold guessBXEllBReadPred; exact (ellByxReadPredCore_iff Loc.ellByx OpType.rd).mpr ⟨rfl, rfl⟩),
    List.filter_nil]

theorem guessBXBlockWord_ellByx_filter_eq (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I))) :
    (guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter (guessBXEllBReadPred I)
      = [(⟨EventLabel.rd Tid.guessBX Loc.ellByx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.rd Tid.guessBX Loc.ellByx p.1.2, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessBX)) := by
  show List.filter (guessBXEllBReadPred I)
      (([ (⟨EventLabel.wt Tid.guessBX Loc.zBxy vB0.1, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)
        , ⟨EventLabel.wt Tid.guessBX Loc.xB v1, rfl⟩
        , ⟨EventLabel.wt Tid.guessBX Loc.zBx'x v2, rfl⟩ ] ++
        inner0Rest.flatMap (guessBXInnerBlockElems I) ++
        [ ⟨EventLabel.rd Tid.guessBX Loc.ellByx vB0.2, rfl⟩ ]) ++
        outerRest.flatMap (fun p => guessBXOuterBlockElems I p.1 p.2))
      = [(⟨EventLabel.rd Tid.guessBX Loc.ellByx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)]
        ++ outerRest.map (fun p =>
          (⟨EventLabel.rd Tid.guessBX Loc.ellByx p.1.2, rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessBX))
  rw [List.filter_append, List.filter_append, List.filter_append,
    List.filter_cons_of_neg
      (by unfold guessBXEllBReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellByxReadPredCore_false_of_ne Loc.zBxy OpType.wt (by decide)),
    List.filter_cons_of_neg
      (by unfold guessBXEllBReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellByxReadPredCore_false_of_ne Loc.xB OpType.wt (by decide)),
    List.filter_cons_of_neg
      (by unfold guessBXEllBReadPred
          simpa [EventLabel.loc, EventLabel.op] using
            ellByxReadPredCore_false_of_ne Loc.zBx'x OpType.wt (by decide)),
    List.filter_nil, guessBXInnerFlatMap_ellByx_filter,
    List.filter_cons_of_pos
      (by unfold guessBXEllBReadPred; exact (ellByxReadPredCore_iff Loc.ellByx OpType.rd).mpr ⟨rfl, rfl⟩),
    list_filter_flatMap_distrib]
  simp only [List.nil_append, List.append_nil]
  congr 1
  rw [show (fun p : (Val I × Val I) × List (Val I × Val I × Val I) =>
      (guessBXOuterBlockElems I p.1 p.2).filter (guessBXEllBReadPred I))
      = (fun p => [(⟨EventLabel.rd Tid.guessBX Loc.ellByx p.1.2, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBX)]) from by
    funext p
    exact guessBXOuterBlockElems_ellByx_filter I p.1 p.2]
  induction outerRest with
  | nil => rfl
  | cons p ps ih => rw [List.flatMap_cons, List.map_cons, ih]; rfl

theorem rawNthRead_guessBX_ellByx_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htrace : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.guessBX Loc.ellByx i = some er) :
    (i = 0 ∧ er.val = vB0.2) ∨
    (∃ m, i = m + 1 ∧ ∃ a vs, outerRest[m]? = some (a, vs) ∧ er.val = a.2) := by
  have hpredL := guessBXEllBReadPred_iff I
  have hfilt := guessBXBlockWord_ellByx_filter_eq I v1 v2 vB0 inner0Rest outerRest
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessBXEllBReadPred I) 0
      (⟨EventLabel.rd Tid.guessBX Loc.ellByx vB0.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)
      (by rw [hfilt]; rfl)
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBX)
      (l := guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessBX Loc.ellByx OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set m := i - 1 with hm
    have him : i = m + 1 := by omega
    obtain ⟨a, hval⟩ : ∃ a, outerRest[m]? = some a :=
      by
        have hilt : i < (rawOpEvents trace Tid.guessBX Loc.ellByx OpType.rd).length :=
          (List.getElem?_eq_some_iff.mp h).1
        have hlen_eq := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBX)
          (x := Loc.ellByx) (op := OpType.rd) (predL := guessBXEllBReadPred I) htrace hpredL
        rw [hlen_eq, hfilt, List.length_append, List.length_singleton, List.length_map] at hilt
        exact ⟨outerRest[m]'(by omega), List.getElem?_eq_getElem (by omega)⟩
    refine ⟨m, him, a.1, a.2, hval, ?_⟩
    have hgetf :
        ((guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
          (guessBXEllBReadPred I))[i]? =
        some (⟨EventLabel.rd Tid.guessBX Loc.ellByx a.1.2, rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBX) := by
      rw [hfilt, him, List.getElem?_append_right (by simp), List.length_singleton]
      have hidxeq : m + 1 - 1 = m := by omega
      rw [hidxeq, List.getElem?_map, hval]
      rfl
    obtain ⟨k, hzip⟩ := zipIdx_filter_getElem_of_filter_getElem
      (guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest) (guessBXEllBReadPred I) i
      (⟨EventLabel.rd Tid.guessBX Loc.ellByx a.1.2, rfl⟩ : ThreadLabel (domainOf I) Tid.guessBX)
      hgetf
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.guessBX)
      (l := guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest) htrace hpredL hzip
    have hraw : rawNthEvent trace Tid.guessBX Loc.ellByx OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl

/-- `rf_total` for the `guessBX`/`ellByx` branch (Eq. (15)). -/
theorem traceRf_total_guessBX_ellByx (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGBX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceG : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hcount : 1 + outerRest.length ≤ 1 + kws.length)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.guessBX) (her_loc : er.loc = Loc.ellByx)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.guessBX := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.guessBX Loc.ellByx OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.guessBX Loc.ellByx OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.guessBX Loc.ellByx i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.guessBX Loc.ellByx OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBX)
    (x := Loc.ellByx) (op := OpType.rd) (predL := guessBXEllBReadPred I) htraceGBX
    (guessBXEllBReadPred_iff I)
  have hlen2 : ((guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest).filter
      (guessBXEllBReadPred I)).length = 1 + outerRest.length := by
    rw [guessBXBlockWord_ellByx_filter_eq, List.length_append, List.length_singleton,
      List.length_map]
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.ellByx) (op := OpType.wt) (predL := guessBYEllBWritePred I) htraceG
    (guessBYEllBWritePred_iff I)
  have hlenW2 : ((guessBYBlockWord I v0 kws).filter (guessBYEllBWritePred I)).length
      = 1 + kws.length := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_ellByx_filter,
      guessBYBlockRestElems_ellByx_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessBY Loc.ellByx OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_guessBX_guessBY_ellByx (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htraceGAY : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    (hkwsVal : ∀ j, j < kws.length → ∃ w, kws[j]? = some (⟨(1 + j) % 4, by omega⟩, w))
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGAX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (cntY0 : Fin 4) (hcntY0 : cntY0 = 0)
    (hvB0 : vB0.2 = Val.cntAux (cntY0 + 1) (some v0))
    (js : List (Fin I.n)) (hlen2 : outerRest.length = js.length + 1)
    (houterB2 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧
        a.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
       (m = js.length → a.2 = Val.cntAux (⟨(cntY0.val + 2 + m) % 4, by omega⟩ : Fin 4) none)))
    (hauxBgree : ∀ m, m ≤ js.length → ∃ kw, kws[m]? = some kw ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧ kw.2 = some w) ∧
       (m = js.length → kw.2 = none)))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.ellByx i = some ew ∧
      rawNthRead trace Tid.guessBX Loc.ellByx i = some er) :
    ew.val = er.val := by
  subst hcntY0
  obtain ⟨i, hew, her⟩ := h
  rcases rawNthWrite_guessBY_ellByx_eq I v0 kws htraceGAY hew with
    ⟨hi0, hewval⟩ | ⟨kw, hkw, hipos, hewval⟩
  · subst hi0
    rcases rawNthRead_guessBX_ellByx_eq I v1 v2 vB0 inner0Rest outerRest htraceGAX her with
      ⟨-, herval⟩ | ⟨m, hieq, a, vs, hav, herval⟩
    · rw [hewval, herval, hvB0]
      congr 1
    · omega
  · rcases rawNthRead_guessBX_ellByx_eq I v1 v2 vB0 inner0Rest outerRest htraceGAX her with
      ⟨hi0, herval⟩ | ⟨m, hieq, a, vs, hav, herval⟩
    · omega
    · have hilen : i - 1 = m := by omega
      rw [hilen] at hkw
      have hmlt : m < outerRest.length := (List.getElem?_eq_some_iff.mp hav).1
      have hmle : m ≤ js.length := by rw [hlen2] at hmlt; omega
      obtain ⟨a', vs', hav', hb2⟩ := houterB2 m hmlt
      rw [hav] at hav'
      simp only [Option.some.injEq, Prod.mk.injEq] at hav'
      obtain ⟨haeq, -⟩ := hav'
      subst haeq
      obtain ⟨kw', hkw', hkwb⟩ := hauxBgree m hmle
      rw [hkw] at hkw'
      injection hkw' with hkw'
      subst hkw'
      have hklen : m < kws.length := by
        have := (List.getElem?_eq_some_iff.mp hkw).1; exact this
      obtain ⟨w0, hkwform⟩ := hkwsVal m hklen
      rw [hkw] at hkwform
      injection hkwform with hkwform
      rcases Nat.lt_or_ge m js.length with hmlt' | hmge'
      · obtain ⟨w, hjw, ha2⟩ := hb2.1 hmlt'
        obtain ⟨w', hjw', hkwaux⟩ := hkwb.1 hmlt'
        rw [hjw] at hjw'
        injection hjw' with hjw'
        subst hjw'
        rw [hewval, herval, ha2, hkwaux, hkwform]
        congr 1
        apply Fin.ext
        simp [Fin.add_def]
        omega
      · have hmeq : m = js.length := by omega
        have ha2 := hb2.2 hmeq
        have hkwaux := hkwb.2 hmeq
        rw [hewval, herval, ha2, hkwaux, hkwform]
        congr 1
        apply Fin.ext
        simp [Fin.add_def]
        omega

/-- `traceRf_matches_guessBX_guessBY_ellByx` for the general construction. -/
theorem traceRf_matches_guessBX_guessBY_ellByx_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (j0 : Fin I.n) (js : List (Fin I.n))
    (kwsBY : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I j0 kwsBY)
    (hlenBY : kwsBY.length = js.length + 1)
    (hvalBY : ∀ i, i < kwsBY.length → ∃ w, kwsBY[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    (v1 v2 : Val I) (vB0 : Val I × Val I)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (htraceGBX : trace Tid.guessBX = guessBXBlockWord I v1 v2 vB0 inner0Rest outerRest)
    (hlen2B : outerRest.length = js.length + 1)
    (hvB02B : vB0.2 = Val.cntAux (1 : Fin 4) (some j0))
    (houterBB : ∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
      b.1 = Val.cnt (⟨(2 + m) % 4, by omega⟩ : Fin 4) ∧
      (m < js.length → ∃ w, js[m]? = some w ∧
        b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
      (m = js.length → b.2 = Val.cntAux (⟨(2 + m) % 4, by omega⟩ : Fin 4) none))
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.ellByx i = some ew ∧
      rawNthRead trace Tid.guessBX Loc.ellByx i = some er) :
    ew.val = er.val := by
  have hkwsVal : ∀ j, j < kwsBY.length → ∃ w, kwsBY[j]? = some (⟨(1 + j) % 4, by omega⟩, w) := by
    intro j hj
    obtain ⟨w, hw, _⟩ := hvalBY j hj
    exact ⟨w, hw⟩
  have hvB0 : vB0.2 = Val.cntAux ((0 : Fin 4) + 1) (some j0) := by
    rw [hvB02B]; congr 1
  have houterB2 : ∀ m, m < outerRest.length → ∃ a vs, outerRest[m]? = some (a, vs) ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧
        a.2 = Val.cntAux (⟨((0 : Fin 4).val + 2 + m) % 4, by omega⟩ : Fin 4) (some w)) ∧
       (m = js.length →
        a.2 = Val.cntAux (⟨((0 : Fin 4).val + 2 + m) % 4, by omega⟩ : Fin 4) none)) := by
    intro m hm
    rw [hlen2B] at hm
    obtain ⟨b, vs, hbv, _, hb2lt, hb2eq⟩ := houterBB m hm
    exact ⟨b, vs, hbv, hb2lt, hb2eq⟩
  have hauxBgree : ∀ m, m ≤ js.length → ∃ kw, kwsBY[m]? = some kw ∧
      ((m < js.length → ∃ w, js[m]? = some w ∧ kw.2 = some w) ∧
       (m = js.length → kw.2 = none)) := by
    intro m hm
    have hmlt : m < kwsBY.length := by omega
    obtain ⟨w, hw, hweq⟩ := hvalBY m hmlt
    refine ⟨(⟨(1 + m) % 4, by omega⟩, w), hw, ?_, ?_⟩
    · intro hmlt2
      refine ⟨js[m], List.getElem?_eq_getElem hmlt2, ?_⟩
      rw [hweq, List.getElem?_eq_getElem hmlt2]
    · intro hmeq
      rw [hweq, hmeq]
      exact List.getElem?_eq_none (le_refl _)
  exact traceRf_matches_guessBX_guessBY_ellByx I j0 kwsBY htraceGBY hkwsVal v1 v2 vB0
    inner0Rest outerRest htraceGBX 0 rfl hvB0 js hlen2B houterB2 hauxBgree h

/-! ## `rf_matches`: `guessBY`/`checkY` `yB` (Eq. (17))

As for `yA`: `guessBY` writes `yB` at offset `0` of each block, `checkY`
reads it at offset `3`. -/

def guessBYYBWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessBY) : Bool :=
  yBWritePredCore lab.1.loc lab.1.op

theorem guessBYYBWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.guessBY) :
    guessBYYBWritePred I lab = true ↔ (lab.1.loc = Loc.yB ∧ lab.1.op = OpType.wt) := by
  unfold guessBYYBWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBWritePredCore_iff y z

theorem guessBYBlock0Elems_yB_filter (I : PCPInstance) (v0 : Fin I.n) :
    (guessBYBlock0Elems I v0).filter (guessBYYBWritePred I) =
      [(⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.guessBY)] := by
  apply list_filter_singleton_of_unique' (guessBYBlock0Elems I v0) (guessBYYBWritePred I) 0
    (⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩)
    rfl
    (by unfold guessBYYBWritePred
        exact (yBWritePredCore_iff Loc.yB OpType.wt).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 3 := (List.getElem?_eq_some_iff.mp hget).1
      have hq12 : q = 1 ∨ q = 2 := by omega
      rcases hq12 with rfl | rfl <;>
        simp only [guessBYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold guessBYYBWritePred
      · exact yBWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide)
      · exact yBWritePredCore_false_of_ne Loc.zBy'y OpType.wt (by decide))

theorem guessBYBlockRestElems_yB_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (guessBYBlockRestElems I)).filter (guessBYYBWritePred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessBYBlockRestElems I kw) ++ kws.flatMap (guessBYBlockRestElems I)).filter
        (guessBYYBWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessBYBlockRestElems I kw).filter (guessBYYBWritePred I) =
          [(⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
            ThreadLabel (domainOf I) Tid.guessBY)] := by
        apply list_filter_singleton_of_unique' (guessBYBlockRestElems I kw)
          (guessBYYBWritePred I) 0
          (⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩)
          rfl
          (by unfold guessBYYBWritePred
              exact (yBWritePredCore_iff Loc.yB OpType.wt).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 5 := (List.getElem?_eq_some_iff.mp hget).1
            have hq4 : q = 1 ∨ q = 2 ∨ q = 3 ∨ q = 4 := by omega
            rcases hq4 with rfl | rfl | rfl | rfl <;>
              simp only [guessBYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold guessBYYBWritePred
            · exact yBWritePredCore_false_of_ne Loc.ellByx OpType.wt (by decide)
            · exact yBWritePredCore_false_of_ne Loc.zBy'y OpType.wt (by decide)
            · exact yBWritePredCore_false_of_ne Loc.zBxy OpType.rd (by decide)
            · exact yBWritePredCore_false_of_ne Loc.zByy' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem rawNthWrite_guessBY_yB_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : Fin I.n) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.guessBY = guessBYBlockWord I v0 kws)
    {i : ℕ} {ew : Event (domainOf I)}
    (h : rawNthWrite trace Tid.guessBY Loc.yB i = some ew) :
    (i = 0 ∧ ew.val = Val.yTag (Tid.guessBY, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ ew.val = Val.yTag (Tid.guessBY, false) kw.2) := by
  have hpredL := guessBYYBWritePred_iff I
