/-- The "single `po`-edge" case of `hb_c_monotonic` for `PrimeCheckY`. -/
theorem primeCheckY_po_monotone_write_read (I : PCPInstance)
    (trace : ∀ t, Word (ThreadLabel (domainOf I) t))
    (cnts : List (Fin 4)) (htrace : trace Tid.primeCheckY = primeCheckYBlockWord I cnts)
    {e1 e2 : Event (domainOf I)}
    (he1 : e1 ∈ traceEventsOf trace Tid.primeCheckY)
    (he2 : e2 ∈ traceEventsOf trace Tid.primeCheckY)
    (hpo : tracePo e1 e2) (_hwt1 : e1.op = .wt) (_hrd2 : e2.op = .rd) (_hloc : e1.loc = e2.loc) :
    rawIndex trace e1 ≤ rawIndex trace e2 := by
  have htrace' : trace Tid.primeCheckY = cnts.flatMap (primeCheckYBlockElems I) := by
    rw [htrace, primeCheckYBlockWord_eq_flatMap]
  obtain ⟨n1, p1, hp1L, hidPos1, hrawIdx1, hshape1⟩ :=
    flatLoop_index_formula (primeCheckYBlockElems I) primeCheckYBlockShape
      (primeCheckYBlockElems_shape I) primeCheckYBlockShape_nodup trace cnts htrace' he1
  obtain ⟨n2, p2, hp2L, hidPos2, hrawIdx2, hshape2⟩ :=
    flatLoop_index_formula (primeCheckYBlockElems I) primeCheckYBlockShape
      (primeCheckYBlockElems_shape I) primeCheckYBlockShape_nodup trace cnts htrace' he2
  have hp1L' : p1 < 6 := hp1L
  have hp2L' : p2 < 6 := hp2L
  have hidPos1' : idPos e1 = n1 * 6 + p1 := hidPos1
  have hidPos2' : idPos e2 = n2 * 6 + p2 := hidPos2
  obtain ⟨-, hidlt⟩ := hpo
  rw [hidPos1', hidPos2'] at hidlt
  rw [hrawIdx1, hrawIdx2]
  omega

/-! ## `CheckX`

`CheckX`'s loop is `while True do … break …` (`Command.whileLoop`), and its
first iteration (`fst = true`) skips the two primed reads of the later ones.
`checkXLoop` is the loop, without the leading `aux ← NDet(Γ)`. -/

/-- `CheckX.program`'s loop, without the leading `ndetAssign`. -/
def checkXLoop (I : PCPInstance) : Command (domainOf I) (CheckX.Vocab I) :=
  Command.whileLoop CheckX.BExpr.tt (CheckX.body I)

/-- The tail `if aux = ⊥ then break; aux ← NDet(Γ ∪ {⊥})` of each iteration of
`CheckX.body`. -/
def checkXTail (I : PCPInstance) : Command (domainOf I) (CheckX.Vocab I) :=
  Command.seq (Command.ite CheckX.BExpr.isBot Command.brk Command.skip)
    (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I) (CheckX.auxSetBot_nonempty I))

/-- The `First()` branch of `CheckX.body`: `fst ← False`, then the two
`First()`-tagged reads. -/
def checkXFirstBranch (I : PCPInstance) : Command (domainOf I) (CheckX.Vocab I) :=
  Command.seq (Command.assign CheckX.Vars.fst CheckX.Expr.fstFalse)
    (Command.seq (Command.read Loc.xA CheckX.VExpr.xAFirst)
      (Command.read Loc.xB CheckX.VExpr.xBFirst))

/-- The `else` branch of `CheckX.body`: the four reads `xA`, `xB`, `xA'`,
`xB'`. -/
def checkXElseBranch (I : PCPInstance) : Command (domainOf I) (CheckX.Vocab I) :=
  Command.seq (Command.read Loc.xA CheckX.VExpr.xARest)
    (Command.seq (Command.read Loc.xB CheckX.VExpr.xBRest)
      (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
        (Command.read Loc.xB' CheckX.VExpr.primeCheckVal)))

/-- The `ite` of `Command.firstIt` in `CheckX.body`. -/
def checkXIteFirst (I : PCPInstance) : Command (domainOf I) (CheckX.Vocab I) :=
  Command.ite CheckX.BExpr.isFirst (checkXFirstBranch I) (checkXElseBranch I)

/-- `CheckX`'s events in an iteration after the first (`fst = false`), with
counter `k` and `aux = w` (`w = none` in the terminating iteration). The
writes carry the new counter `k + 1`, the reads of `xA`/`xB` the value `w`,
and the reads of `xA'`/`xB'` the previous counter `k` (`prev`): the lag of
one that Lemma 3.5 is about. -/
def checkXBlockRestElems (I : PCPInstance) (kw : Fin 4 × Option I.Γ) :
    List (ThreadLabel (domainOf I) Tid.checkX) :=
  [ ⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.wt Tid.checkX Loc.xB (Val.primeTag Tid.checkX (kw.1 + 1)), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, false) kw.2), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, false) kw.2), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xA' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩
  , ⟨EventLabel.rd Tid.checkX Loc.xB' (Val.primeTag Tid.primeCheckX kw.1), rfl⟩ ]

/-- The first iteration of `checkXLoop`, from a store with `fst = true`,
`cnt = 0`, `aux = some v0`: emits the four-event block 0 (writes carrying
`1`, `First()`-tagged reads of `v0`), and returns to the loop with
`fst = false` and `aux` drawn from `v :: rest`. Twenty `Command.RunStep`s. -/
theorem checkX_block0_step (I : PCPInstance) (v : CheckX.Vals I)
    (rest : List (CheckX.Vals I)) (φ : (CheckX.Vocab I).Store)
    (hfst : φ CheckX.Vars.fst = Sum.inr (Sum.inr true))
    (hcnt0 : φ CheckX.Vars.cnt = Sum.inr (Sum.inl 0))
    (v0 : I.Γ) (haux0 : φ CheckX.Vars.aux = Sum.inl (some v0))
    (hv : v ∈ CheckX.auxSetBot I) :
    ∃ (φ' : (CheckX.Vocab I).Store) (cLast : Config (domainOf I) (CheckX.Vocab I)),
      φ' CheckX.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' CheckX.Vars.cnt = Sum.inr (Sum.inl 1) ∧ φ' CheckX.Vars.aux = v ∧
      Command.Run Tid.checkX (v :: rest)
        (checkXLoop I, φ)
        [ ⟨EventLabel.wt Tid.checkX Loc.xA (Val.primeTag Tid.checkX 1), rfl⟩
        , ⟨EventLabel.wt Tid.checkX Loc.xB (Val.primeTag Tid.checkX 1), rfl⟩
        , ⟨EventLabel.rd Tid.checkX Loc.xA (Val.xTag (Tid.guessAX, true) (some v0)), rfl⟩
        , ⟨EventLabel.rd Tid.checkX Loc.xB (Val.xTag (Tid.guessBX, true) (some v0)), rfl⟩ ]
        cLast rest (checkXLoop I, φ') := by
  set φ1 : (CheckX.Vocab I).Store :=
    Function.update φ CheckX.Vars.prev (CheckX.eval I CheckX.Expr.readCnt φ) with hφ1
  set φ2 : (CheckX.Vocab I).Store :=
    Function.update φ1 CheckX.Vars.cnt (CheckX.eval I CheckX.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 CheckX.Vars.cnt = φ CheckX.Vars.cnt := rfl
  have hcnt2eq : φ2 CheckX.Vars.cnt = CheckX.eval I CheckX.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2 : CheckX.cntOf I φ2 = 1 := by
    simp only [CheckX.cntOf, hcnt2eq, CheckX.eval, hcnt_φ1, hcnt0]
    decide
  have hcnt2raw : φ2 CheckX.Vars.cnt = Sum.inr (Sum.inl 1) := by
    simp only [hcnt2eq, CheckX.eval, CheckX.cntOf, hcnt_φ1, hcnt0]
    rfl
  have hne_aux_cnt : CheckX.Vars.aux ≠ CheckX.Vars.cnt := by decide
  have haux_φ1 : φ1 CheckX.Vars.aux = φ CheckX.Vars.aux := rfl
  have haux2 : φ2 CheckX.Vars.aux = Sum.inl (some v0) := by
    have h1' : φ2 CheckX.Vars.aux = φ1 CheckX.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    rw [h1', haux_φ1, haux0]
  have hcnt1 : (CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2 = Val.primeTag Tid.checkX 1 := by
    simp only [CheckX.Vocab, CheckX.evalV, hcnt2]
    rfl
  have h1 : Command.RunStep Tid.checkX (v :: rest) none (checkXLoop I, φ) (v :: rest)
      (Command.loopSeq (CheckX.body I) (checkXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXLoop, Command.step, CheckX.Vocab, CheckX.evalB, if_true])
  have h2 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (CheckX.body I) (checkXLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I))))))
        (checkXLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [CheckX.body, Command.step, CheckX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I))))))
        (checkXLoop I), φ1) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ1) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ2) := by
    rw [hφ2]
    exact Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab])
  have h5 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.wt Tid.checkX Loc.xA
        ((CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h7 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.wt Tid.checkX Loc.xB
        ((CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h9 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq (checkXIteFirst I) (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hne_fst_cnt : CheckX.Vars.fst ≠ CheckX.Vars.cnt := by decide
  have hfst_φ1 : φ1 CheckX.Vars.fst = φ CheckX.Vars.fst := rfl
  have hfst2 : φ2 CheckX.Vars.fst = Sum.inr (Sum.inr true) := by
    have h1' : φ2 CheckX.Vars.fst = φ1 CheckX.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have h10 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (checkXIteFirst I) (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (checkXFirstBranch I) (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXIteFirst, Command.step, CheckX.Vocab, CheckX.evalB, hfst2, if_true])
  set φ3 : (CheckX.Vocab I).Store :=
    Function.update φ2 CheckX.Vars.fst (CheckX.eval I CheckX.Expr.fstFalse φ2) with hφ3
  have hcnt3 : φ3 CheckX.Vars.cnt = Sum.inr (Sum.inl 1) :=
    (Function.update_of_ne hne_fst_cnt.symm _ _).trans hcnt2raw
  have hne_aux_fst : CheckX.Vars.aux ≠ CheckX.Vars.fst := by decide
  have haux3 : φ3 CheckX.Vars.aux = Sum.inl (some v0) := by
    have h1' : φ3 CheckX.Vars.aux = φ2 CheckX.Vars.aux := Function.update_of_ne hne_aux_fst _ _
    rw [h1', haux2]
  have hxAFirst : (CheckX.Vocab I).evalV CheckX.VExpr.xAFirst φ3
      = Val.xTag (Tid.guessAX, true) (some v0) := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux3]
    rfl
  have hxBFirst : (CheckX.Vocab I).evalV CheckX.VExpr.xBFirst φ3
      = Val.xTag (Tid.guessBX, true) (some v0) := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux3]
    rfl
  have h11 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (checkXFirstBranch I) (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xA CheckX.VExpr.xAFirst)
          (Command.read Loc.xB CheckX.VExpr.xBFirst))) (checkXTail I)) (checkXLoop I), φ3) := by
    rw [hφ3]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXFirstBranch, Command.step, CheckX.Vocab]; rfl)
  have h12 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xA CheckX.VExpr.xAFirst)
          (Command.read Loc.xB CheckX.VExpr.xBFirst))) (checkXTail I)) (checkXLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xA CheckX.VExpr.xAFirst)
          (Command.read Loc.xB CheckX.VExpr.xBFirst)) (checkXTail I)) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h13 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xA
        ((CheckX.Vocab I).evalV CheckX.VExpr.xAFirst φ3), rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xA CheckX.VExpr.xAFirst)
          (Command.read Loc.xB CheckX.VExpr.xBFirst)) (checkXTail I)) (checkXLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.xB CheckX.VExpr.xBFirst)) (checkXTail I)) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h14 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.xB CheckX.VExpr.xBFirst)) (checkXTail I)) (checkXLoop I), φ3)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.read Loc.xB CheckX.VExpr.xBFirst) (checkXTail I))
        (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h15 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xB
        ((CheckX.Vocab I).evalV CheckX.VExpr.xBFirst φ3), rfl⟩)
      (Command.loopSeq (Command.seq (Command.read Loc.xB CheckX.VExpr.xBFirst) (checkXTail I))
        (checkXLoop I), φ3) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (checkXTail I)) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h16 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (checkXTail I)) (checkXLoop I), φ3) (v :: rest)
      (Command.loopSeq (checkXTail I) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hisBot3 : CheckX.evalB I CheckX.BExpr.isBot φ3 = false := by
    simp only [CheckX.evalB]
    cases hφ : φ3 CheckX.Vars.aux with
    | inl w => cases w with
        | none => rw [haux3] at hφ; injection hφ with hφ2; injection hφ2
        | some _ => simp
    | inr w => simp
  have h17 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (checkXTail I) (checkXLoop I), φ3) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I))) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXTail, Command.step, CheckX.Vocab, hisBot3, Bool.false_eq_true, if_false])
  have h18 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I))) (checkXLoop I), φ3) (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I)) (checkXLoop I), φ3) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h19 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I)) (checkXLoop I), φ3) rest
      (Command.loopSeq Command.skip (checkXLoop I), Function.update φ3 CheckX.Vars.aux v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h20 : Command.RunStep Tid.checkX rest none
      (Command.loopSeq Command.skip (checkXLoop I), Function.update φ3 CheckX.Vars.aux v) rest
      (checkXLoop I, Function.update φ3 CheckX.Vars.aux v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.checkX) (s := v :: rest) (c := (checkXLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.silentSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.silentSnoc run10 h11
  have run12 := Command.Run.silentSnoc run11 h12
  have run13 := Command.Run.labelledSnoc run12 h13
  have run14 := Command.Run.silentSnoc run13 h14
  have run15 := Command.Run.labelledSnoc run14 h15
  have run16 := Command.Run.silentSnoc run15 h16
  have run17 := Command.Run.silentSnoc run16 h17
  have run18 := Command.Run.silentSnoc run17 h18
  have run19 := Command.Run.silentSnoc run18 h19
  have run20 := Command.Run.silentSnoc run19 h20
  rw [hcnt1, hxAFirst, hxBFirst] at run20
  have hne_fst_aux : CheckX.Vars.fst ≠ CheckX.Vars.aux := by decide
  have hfst3 : φ3 CheckX.Vars.fst = Sum.inr (Sum.inr false) := Function.update_self _ _ _
  have hfst_final : Function.update φ3 CheckX.Vars.aux v CheckX.Vars.fst
      = Sum.inr (Sum.inr false) := (Function.update_of_ne hne_fst_aux v φ3).trans hfst3
  have hcnt_final : Function.update φ3 CheckX.Vars.aux v CheckX.Vars.cnt
      = Sum.inr (Sum.inl 1) := (Function.update_of_ne hne_aux_cnt.symm v φ3).trans hcnt3
  exact ⟨Function.update φ3 CheckX.Vars.aux v, _, hfst_final, hcnt_final,
    Function.update_self _ _ _, run20⟩

/-- An iteration of `checkXLoop` after the first, from a store with
`fst = false`, `cnt = k`, `aux = some w`: emits
`checkXBlockRestElems I (k, some w)` and returns to the loop with
`cnt = k + 1` and `aux` drawn from `v :: rest`. Twenty-two
`Command.RunStep`s. -/
theorem checkX_blockRest_continue_step (I : PCPInstance) (v : CheckX.Vals I)
    (rest : List (CheckX.Vals I)) (φ : (CheckX.Vocab I).Store)
    (hfst : φ CheckX.Vars.fst = Sum.inr (Sum.inr false))
    (k : Fin 4) (hcnt0 : φ CheckX.Vars.cnt = Sum.inr (Sum.inl k))
    (w : I.Γ) (haux0 : φ CheckX.Vars.aux = Sum.inl (some w))
    (hv : v ∈ CheckX.auxSetBot I) :
    ∃ (φ' : (CheckX.Vocab I).Store) (cLast : Config (domainOf I) (CheckX.Vocab I)),
      φ' CheckX.Vars.fst = Sum.inr (Sum.inr false) ∧
      φ' CheckX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) ∧ φ' CheckX.Vars.aux = v ∧
      Command.Run Tid.checkX (v :: rest)
        (checkXLoop I, φ) (checkXBlockRestElems I (k, some w))
        cLast rest (checkXLoop I, φ') := by
  set φ1 : (CheckX.Vocab I).Store :=
    Function.update φ CheckX.Vars.prev (CheckX.eval I CheckX.Expr.readCnt φ) with hφ1
  set φ2 : (CheckX.Vocab I).Store :=
    Function.update φ1 CheckX.Vars.cnt (CheckX.eval I CheckX.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 CheckX.Vars.cnt = φ CheckX.Vars.cnt := rfl
  have hcnt2eq : φ2 CheckX.Vars.cnt = CheckX.eval I CheckX.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2raw : φ2 CheckX.Vars.cnt = Sum.inr (Sum.inl (k + 1)) := by
    simp only [hcnt2eq, CheckX.eval, CheckX.cntOf, hcnt_φ1, hcnt0]
    rfl
  have hcnt2 : CheckX.cntOf I φ2 = k + 1 := by
    simp only [CheckX.cntOf, hcnt2raw]
  have hne_aux_cnt : CheckX.Vars.aux ≠ CheckX.Vars.cnt := by decide
  have haux_φ1 : φ1 CheckX.Vars.aux = φ CheckX.Vars.aux := rfl
  have haux2 : φ2 CheckX.Vars.aux = Sum.inl (some w) := by
    have h1' : φ2 CheckX.Vars.aux = φ1 CheckX.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    rw [h1', haux_φ1, haux0]
  have hcnt1 : (CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2
      = Val.primeTag Tid.checkX (k + 1) := by
    simp only [CheckX.Vocab, CheckX.evalV, hcnt2]
    rfl
  have hprev_φ1 : CheckX.prevOf I φ1 = k := by
    simp only [hφ1, CheckX.prevOf, CheckX.eval, hcnt0]
    rfl
  have hne_fst_cnt : CheckX.Vars.fst ≠ CheckX.Vars.cnt := by decide
  have hfst_φ1 : φ1 CheckX.Vars.fst = φ CheckX.Vars.fst := rfl
  have hfst2 : φ2 CheckX.Vars.fst = Sum.inr (Sum.inr false) := by
    have h1' : φ2 CheckX.Vars.fst = φ1 CheckX.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have hne_prev_cnt : CheckX.Vars.prev ≠ CheckX.Vars.cnt := by decide
  have hprev_φ2 : CheckX.prevOf I φ2 = k := by
    have h1' : φ2 CheckX.Vars.prev = φ1 CheckX.Vars.prev :=
      Function.update_of_ne hne_prev_cnt _ _
    simp only [CheckX.prevOf, h1']
    exact hprev_φ1
  have hxARest : (CheckX.Vocab I).evalV CheckX.VExpr.xARest φ2
      = Val.xTag (Tid.guessAX, false) (some w) := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux2]
    rfl
  have hxBRest : (CheckX.Vocab I).evalV CheckX.VExpr.xBRest φ2
      = Val.xTag (Tid.guessBX, false) (some w) := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux2]
    rfl
  have hprimeCheck : (CheckX.Vocab I).evalV CheckX.VExpr.primeCheckVal φ2
      = Val.primeTag Tid.primeCheckX k := by
    simp only [CheckX.Vocab, CheckX.evalV, hprev_φ2]
    rfl
  have h1 : Command.RunStep Tid.checkX (v :: rest) none (checkXLoop I, φ) (v :: rest)
      (Command.loopSeq (CheckX.body I) (checkXLoop I), φ) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXLoop, Command.step, CheckX.Vocab, CheckX.evalB, if_true])
  have h2 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (CheckX.body I) (checkXLoop I), φ) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I))))))
        (checkXLoop I), φ1) := by
    rw [hφ1]
    exact Command.step_sound _ _ _ _ _ _ _ (by
      simp only [CheckX.body, Command.step, CheckX.Vocab]; rfl)
  have h3 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I))))))
        (checkXLoop I), φ1) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ1) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h4 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq
        (Command.seq (Command.assign CheckX.Vars.cnt CheckX.Expr.nextCnt)
          (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
            (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
              (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ1) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ2) := by
    rw [hφ2]
    exact Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab])
  have h5 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I)))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h6 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.wt Tid.checkX Loc.xA
        ((CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xA CheckX.VExpr.cntTagVal)
          (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
            (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h7 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I))))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h8 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.wt Tid.checkX Loc.xB
        ((CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.write Loc.xB CheckX.VExpr.cntTagVal)
          (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h9 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (Command.seq (checkXIteFirst I) (checkXTail I)))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq (checkXIteFirst I) (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h10 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (checkXIteFirst I) (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (checkXElseBranch I) (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXIteFirst, Command.step, CheckX.Vocab, CheckX.evalB, hfst2]
      rfl)
  have h11 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xA
        ((CheckX.Vocab I).evalV CheckX.VExpr.xARest φ2), rfl⟩)
      (Command.loopSeq (Command.seq (checkXElseBranch I) (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xB CheckX.VExpr.xBRest)
          (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
            (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))))
        (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXElseBranch, Command.step, CheckX.Vocab, CheckX.evalV])
  have h12 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xB CheckX.VExpr.xBRest)
          (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
            (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))))
        (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xB CheckX.VExpr.xBRest)
          (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
            (Command.read Loc.xB' CheckX.VExpr.primeCheckVal)))
        (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h13 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xB
        ((CheckX.Vocab I).evalV CheckX.VExpr.xBRest φ2), rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xB CheckX.VExpr.xBRest)
          (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
            (Command.read Loc.xB' CheckX.VExpr.primeCheckVal)))
        (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
          (Command.read Loc.xB' CheckX.VExpr.primeCheckVal)))
        (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h14 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
          (Command.read Loc.xB' CheckX.VExpr.primeCheckVal)))
        (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
          (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))
        (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h15 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xA'
        ((CheckX.Vocab I).evalV CheckX.VExpr.primeCheckVal φ2), rfl⟩)
      (Command.loopSeq (Command.seq
        (Command.seq (Command.read Loc.xA' CheckX.VExpr.primeCheckVal)
          (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))
        (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))
        (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h16 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq (Command.seq Command.skip
        (Command.read Loc.xB' CheckX.VExpr.primeCheckVal))
        (checkXTail I)) (checkXLoop I), φ2)
      (v :: rest)
      (Command.loopSeq
        (Command.seq (Command.read Loc.xB' CheckX.VExpr.primeCheckVal) (checkXTail I))
        (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h17 : Command.RunStep Tid.checkX (v :: rest)
      (some ⟨EventLabel.rd Tid.checkX Loc.xB'
        ((CheckX.Vocab I).evalV CheckX.VExpr.primeCheckVal φ2), rfl⟩)
      (Command.loopSeq
        (Command.seq (Command.read Loc.xB' CheckX.VExpr.primeCheckVal) (checkXTail I))
        (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip (checkXTail I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step, CheckX.Vocab, CheckX.evalV])
  have h18 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip (checkXTail I)) (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (checkXTail I) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have hisBot2 : CheckX.evalB I CheckX.BExpr.isBot φ2 = false := by
    simp only [CheckX.evalB]
    cases hφ : φ2 CheckX.Vars.aux with
    | inl w' => cases w' with
        | none => rw [haux2] at hφ; injection hφ with hφ2; injection hφ2
        | some _ => simp
    | inr w' => simp
  have h19 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (checkXTail I) (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I))) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by
      simp only [checkXTail, Command.step, CheckX.Vocab, hisBot2, Bool.false_eq_true, if_false])
  have h20 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq (Command.seq Command.skip
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I))) (checkXLoop I), φ2) (v :: rest)
      (Command.loopSeq
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I)) (checkXLoop I), φ2) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have h21 : Command.RunStep Tid.checkX (v :: rest) none
      (Command.loopSeq
        (Command.ndetAssign CheckX.Vars.aux (CheckX.auxSetBot I)
          (CheckX.auxSetBot_nonempty I)) (checkXLoop I), φ2) rest
      (Command.loopSeq Command.skip (checkXLoop I), Function.update φ2 CheckX.Vars.aux v) := by
    apply Command.step_sound
    simp only [Command.step]
    split_ifs with h
    · rfl
    · exact absurd hv h
  have h22 : Command.RunStep Tid.checkX rest none
      (Command.loopSeq Command.skip (checkXLoop I), Function.update φ2 CheckX.Vars.aux v) rest
      (checkXLoop I, Function.update φ2 CheckX.Vars.aux v) :=
    Command.step_sound _ _ _ _ _ _ _ (by simp only [Command.step])
  have run0 := Command.Run.nil (t := Tid.checkX) (s := v :: rest) (c := (checkXLoop I, φ))
  have run1 := Command.Run.silentSnoc run0 h1
  have run2 := Command.Run.silentSnoc run1 h2
  have run3 := Command.Run.silentSnoc run2 h3
  have run4 := Command.Run.silentSnoc run3 h4
  have run5 := Command.Run.silentSnoc run4 h5
  have run6 := Command.Run.labelledSnoc run5 h6
  have run7 := Command.Run.silentSnoc run6 h7
  have run8 := Command.Run.labelledSnoc run7 h8
  have run9 := Command.Run.silentSnoc run8 h9
  have run10 := Command.Run.silentSnoc run9 h10
  have run11 := Command.Run.labelledSnoc run10 h11
  have run12 := Command.Run.silentSnoc run11 h12
  have run13 := Command.Run.labelledSnoc run12 h13
  have run14 := Command.Run.silentSnoc run13 h14
  have run15 := Command.Run.labelledSnoc run14 h15
  have run16 := Command.Run.silentSnoc run15 h16
  have run17 := Command.Run.labelledSnoc run16 h17
  have run18 := Command.Run.silentSnoc run17 h18
  have run19 := Command.Run.silentSnoc run18 h19
  have run20 := Command.Run.silentSnoc run19 h20
  have run21 := Command.Run.silentSnoc run20 h21
  have run22 := Command.Run.silentSnoc run21 h22
  rw [hcnt1, hxARest, hxBRest, hprimeCheck] at run22
  have hne_fst_aux : CheckX.Vars.fst ≠ CheckX.Vars.aux := by decide
  have hne_cnt_aux : CheckX.Vars.cnt ≠ CheckX.Vars.aux := by decide
  have hfst_final : Function.update φ2 CheckX.Vars.aux v CheckX.Vars.fst
      = Sum.inr (Sum.inr false) := (Function.update_of_ne hne_fst_aux v φ2).trans hfst2
  have hcnt_final : Function.update φ2 CheckX.Vars.aux v CheckX.Vars.cnt
      = Sum.inr (Sum.inl (k + 1)) := (Function.update_of_ne hne_cnt_aux v φ2).trans hcnt2raw
  exact ⟨Function.update φ2 CheckX.Vars.aux v, _, hfst_final, hcnt_final,
    Function.update_self _ _ _, run22⟩

/-- The terminating iteration of `checkXLoop` (`aux = none`): emits
`checkXBlockRestElems I (k, none)`, then `break` skips the trailing draw and
exits the loop to `Command.skip`. Twenty-one `Command.RunStep`s. -/
theorem checkX_blockRest_break_step (I : PCPInstance) (rest : List (CheckX.Vals I))
    (φ : (CheckX.Vocab I).Store) (hfst : φ CheckX.Vars.fst = Sum.inr (Sum.inr false))
    (k : Fin 4) (hcnt0 : φ CheckX.Vars.cnt = Sum.inr (Sum.inl k))
    (haux0 : φ CheckX.Vars.aux = Sum.inl none) :
    ∃ (φ' : (CheckX.Vocab I).Store) (cLast : Config (domainOf I) (CheckX.Vocab I)),
      Command.Run Tid.checkX rest
        (checkXLoop I, φ) (checkXBlockRestElems I (k, none))
        cLast rest (Command.skip, φ') := by
  set φ1 : (CheckX.Vocab I).Store :=
    Function.update φ CheckX.Vars.prev (CheckX.eval I CheckX.Expr.readCnt φ) with hφ1
  set φ2 : (CheckX.Vocab I).Store :=
    Function.update φ1 CheckX.Vars.cnt (CheckX.eval I CheckX.Expr.nextCnt φ1) with hφ2
  have hcnt_φ1 : φ1 CheckX.Vars.cnt = φ CheckX.Vars.cnt := rfl
  have hcnt2eq : φ2 CheckX.Vars.cnt = CheckX.eval I CheckX.Expr.nextCnt φ1 :=
    Function.update_self _ _ _
  have hcnt2 : CheckX.cntOf I φ2 = k + 1 := by
    simp only [CheckX.cntOf, hcnt2eq, CheckX.eval, hcnt_φ1, hcnt0]
  have hne_aux_cnt : CheckX.Vars.aux ≠ CheckX.Vars.cnt := by decide
  have haux_φ1 : φ1 CheckX.Vars.aux = φ CheckX.Vars.aux := rfl
  have haux2 : φ2 CheckX.Vars.aux = Sum.inl none := by
    have h1' : φ2 CheckX.Vars.aux = φ1 CheckX.Vars.aux := Function.update_of_ne hne_aux_cnt _ _
    rw [h1', haux_φ1, haux0]
  have hcnt1 : (CheckX.Vocab I).evalV CheckX.VExpr.cntTagVal φ2
      = Val.primeTag Tid.checkX (k + 1) := by
    simp only [CheckX.Vocab, CheckX.evalV, hcnt2]
    rfl
  have hprev_φ1 : CheckX.prevOf I φ1 = k := by
    simp only [hφ1, CheckX.prevOf, CheckX.eval, hcnt0]
    rfl
  have hne_fst_cnt : CheckX.Vars.fst ≠ CheckX.Vars.cnt := by decide
  have hfst_φ1 : φ1 CheckX.Vars.fst = φ CheckX.Vars.fst := rfl
  have hfst2 : φ2 CheckX.Vars.fst = Sum.inr (Sum.inr false) := by
    have h1' : φ2 CheckX.Vars.fst = φ1 CheckX.Vars.fst := Function.update_of_ne hne_fst_cnt _ _
    rw [h1', hfst_φ1, hfst]
  have hne_prev_cnt : CheckX.Vars.prev ≠ CheckX.Vars.cnt := by decide
  have hprev_φ2 : CheckX.prevOf I φ2 = k := by
    have h1' : φ2 CheckX.Vars.prev = φ1 CheckX.Vars.prev :=
      Function.update_of_ne hne_prev_cnt _ _
    simp only [CheckX.prevOf, h1']
    exact hprev_φ1
  have hxARest : (CheckX.Vocab I).evalV CheckX.VExpr.xARest φ2
      = Val.xTag (Tid.guessAX, false) none := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux2]
    rfl
  have hxBRest : (CheckX.Vocab I).evalV CheckX.VExpr.xBRest φ2
      = Val.xTag (Tid.guessBX, false) none := by
    simp only [CheckX.Vocab, CheckX.evalV, CheckX.auxOf, haux2]
    rfl
  have hprimeCheck : (CheckX.Vocab I).evalV CheckX.VExpr.primeCheckVal φ2
      = Val.primeTag Tid.primeCheckX k := by
    simp only [CheckX.Vocab, CheckX.evalV, hprev_φ2]
    rfl
  have h1 : Command.RunStep Tid.checkX rest none (checkXLoop I, φ) rest
