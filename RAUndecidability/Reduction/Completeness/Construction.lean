/-- `checkY`'s `yB`-read predicate, lifted from `yBReadPredCore`. -/
def checkYYBReadPred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) : Bool :=
  yBReadPredCore lab.1.loc lab.1.op

theorem checkYYBReadPred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkY) :
    checkYYBReadPred I lab = true ↔ (lab.1.loc = Loc.yB ∧ lab.1.op = OpType.rd) := by
  unfold checkYYBReadPred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact yBReadPredCore_iff y z

/-- `checkYBlock0Elems` has one `yB`-read, at offset `3`. -/
theorem checkYBlock0Elems_yB_read_filter (I : PCPInstance) (v0 : (Fin I.n)) :
    (checkYBlock0Elems I v0).filter (checkYYBReadPred I) =
      [(⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY)] := by
  apply list_filter_singleton_of_unique' (checkYBlock0Elems I v0) (checkYYBReadPred I) 3
    (⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩)
    rfl
    (by unfold checkYYBReadPred; exact (yBReadPredCore_iff Loc.yB OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      have hqlt : q < 4 := (List.getElem?_eq_some_iff.mp hget).1
      have hq3 : q = 0 ∨ q = 1 ∨ q = 2 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYBReadPred
      · exact yBReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yBReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yBReadPredCore_false_of_ne Loc.yA OpType.rd (by decide))

/-- `checkYBlockRestElems` has one `yB`-read per entry of `kws`. -/
theorem checkYBlockRestElems_yB_read_filter (I : PCPInstance) (kws : List (Fin 4 × Option (Fin I.n))) :
    ((kws.flatMap (checkYBlockRestElems I)).filter (checkYYBReadPred I)).length
      = kws.length := by
  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((checkYBlockRestElems I kw) ++ kws.flatMap (checkYBlockRestElems I)).filter
        (checkYYBReadPred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (checkYBlockRestElems I kw).filter (checkYYBReadPred I) =
          [(⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
            ThreadLabel (domainOf I) Tid.checkY)] := by
        apply list_filter_singleton_of_unique' (checkYBlockRestElems I kw) (checkYYBReadPred I) 3
          (⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩)
          rfl
          (by unfold checkYYBReadPred
              exact (yBReadPredCore_iff Loc.yB OpType.rd).mpr ⟨rfl, rfl⟩)
          (by
            intro q b hq hget
            have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
            have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 ∨ q = 5 := by omega
            rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
              simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
                Option.some.injEq] at hget <;>
              rw [← hget] <;>
              unfold checkYYBReadPred
            · exact yBReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
            · exact yBReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
            · exact yBReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
            · exact yBReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)
            · exact yBReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      rw [hbl]
      simp only [List.length_cons, List.length_nil]
      omega

theorem checkYBlock0Elems_yB_read_zipIdx_filter (I : PCPInstance) (v0 : (Fin I.n)) (k : ℕ) :
    (((checkYBlock0Elems I v0).zipIdx k).filter (fun p => checkYYBReadPred I p.1)) =
      [((⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), k + 3)] := by
  apply list_filter_singleton_of_unique' ((checkYBlock0Elems I v0).zipIdx k)
    (fun p => checkYYBReadPred I p.1) 3
    ((⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY), k + 3)
    (by rw [List.getElem?_zipIdx]; rfl)
    (by unfold checkYYBReadPred; exact (yBReadPredCore_iff Loc.yB OpType.rd).mpr ⟨rfl, rfl⟩)
    (by
      intro q b hq hget
      rw [List.getElem?_zipIdx] at hget
      have hqlt : q < 4 := by
        rcases Nat.lt_or_ge q 4 with hqlt | hqge
        · exact hqlt
        · exfalso
          have hqge4 : (checkYBlock0Elems I v0).length ≤ q := by
            simp only [checkYBlock0Elems, List.length_cons, List.length_nil]
            omega
          have : (checkYBlock0Elems I v0)[q]? = none := List.getElem?_eq_none hqge4
          rw [this] at hget
          simp at hget
      have hq3 : q = 0 ∨ q = 1 ∨ q = 2 := by omega
      rcases hq3 with rfl | rfl | rfl <;>
        simp only [checkYBlock0Elems, List.getElem?_cons_zero, List.getElem?_cons_succ,
          Option.map_some, Option.some.injEq] at hget <;>
        rw [← hget] <;>
        unfold checkYYBReadPred
      · exact yBReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
      · exact yBReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
      · exact yBReadPredCore_false_of_ne Loc.yA OpType.rd (by decide))

/-- `checkY`'s `i`-th `yB`-read: for `i = 0` it expects `v0` (tag `true`), for
`i ≥ 1` the second component of `kws[i-1]` (tag `false`). -/
theorem rawNthRead_checkY_yB_eq (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0 : (Fin I.n)) (kws : List (Fin 4 × Option (Fin I.n)))
    (htrace : trace Tid.checkY = checkYBlockWord I v0 kws)
    {i : ℕ} {er : Event (domainOf I)}
    (h : rawNthRead trace Tid.checkY Loc.yB i = some er) :
    (i = 0 ∧ er.val = Val.yTag (Tid.guessBY, true) (some v0)) ∨
    (∃ kw, kws[i - 1]? = some kw ∧ 1 ≤ i ∧ er.val = Val.yTag (Tid.guessBY, false) kw.2) := by
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yB) (op := OpType.rd)
    (predL := checkYYBReadPred I) htrace (checkYYBReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0 kws).filter (checkYYBReadPred I)).length
      = kws.length + 1 := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yB_read_filter,
      checkYBlockRestElems_yB_read_filter]
    simp only [List.length_cons, List.length_nil]
    omega
  have hilt : i < kws.length + 1 :=
    hlen2 ▸ hlen ▸ (List.getElem?_eq_some_iff.mp h).1
  have hzip : (checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBReadPred I p.1) =
      [((⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true) (some v0)), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 3)] ++
      ((kws.flatMap (checkYBlockRestElems I)).zipIdx 4).filter
        (fun p => checkYYBReadPred I p.1) := by
    unfold checkYBlockWord
    rw [List.zipIdx_append, List.filter_append, checkYBlock0Elems_yB_read_zipIdx_filter]
    rfl
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    left
    refine ⟨rfl, ?_⟩
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYBReadPred_iff I)
      (n := 0) (lab := (⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, true)
        (some v0)), rfl⟩ : ThreadLabel (domainOf I) Tid.checkY)) (origPos := 3)
      (by rw [hzip]; rfl)
    have hraw : rawNthEvent trace Tid.checkY Loc.yB OpType.rd 0 = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    rw [hconn]; rfl
  · right
    set j := i - 1 with hj
    have hij : i = j + 1 := by omega
    have hjlt : j < kws.length := by omega
    obtain ⟨kw, hkw⟩ : ∃ kw, kws[j]? = some kw := ⟨kws[j]'hjlt, List.getElem?_eq_getElem hjlt⟩
    have hfiltrest := zipIdx_flatMap_filter_getElem
      (α := Fin 4 × Option (Fin I.n)) (β := ThreadLabel (domainOf I) Tid.checkY)
      (checkYBlockRestElems I) 6 3
      (fun kw => rfl)
      (checkYYBReadPred I)
      (fun kw => (⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
        ThreadLabel (domainOf I) Tid.checkY))
      (fun a => rfl)
      (fun a => by
        unfold checkYYBReadPred
        exact (yBReadPredCore_iff Loc.yB OpType.rd).mpr ⟨rfl, rfl⟩)
      (by
        intro a q b hq hget
        have hqlt : q < 6 := (List.getElem?_eq_some_iff.mp hget).1
        have hq5 : q = 0 ∨ q = 1 ∨ q = 2 ∨ q = 4 ∨ q = 5 := by omega
        rcases hq5 with rfl | rfl | rfl | rfl | rfl <;>
          simp only [checkYBlockRestElems, List.getElem?_cons_zero, List.getElem?_cons_succ,
            Option.some.injEq] at hget <;>
          rw [← hget] <;>
          unfold checkYYBReadPred
        · exact yBReadPredCore_false_of_ne Loc.yA OpType.wt (by decide)
        · exact yBReadPredCore_false_of_ne Loc.yB OpType.wt (by decide)
        · exact yBReadPredCore_false_of_ne Loc.yA OpType.rd (by decide)
        · exact yBReadPredCore_false_of_ne Loc.yA' OpType.rd (by decide)
        · exact yBReadPredCore_false_of_ne Loc.yB' OpType.rd (by decide))
      kws 4 j kw hkw
    have hzipj : ((checkYBlockWord I v0 kws).zipIdx.filter (fun p => checkYYBReadPred I p.1))[i]?
        = some ((⟨EventLabel.rd Tid.checkY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.checkY), 4 + j * 6 + 3) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
      exact hfiltrest
    have hconn := rawNthEvent_of_zipIdx_filter (trace := trace) (t := Tid.checkY)
      (l := checkYBlockWord I v0 kws) htrace (checkYYBReadPred_iff I) hzipj
    have hraw : rawNthEvent trace Tid.checkY Loc.yB OpType.rd i = some er := h
    rw [hraw] at hconn
    injection hconn with hconn
    exact ⟨kw, hkw, hipos, by rw [hconn]; rfl⟩

/-- `rf_total` for the `checkY`/`yB` branch (Eq. (17)). -/
theorem traceRf_total_checkY_yB (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (js : List (Fin I.n))
    (v0G : Fin I.n) (kwsBY : List (Fin 4 × Option (Fin I.n)))
    (hkwsBY : kwsBY.length = js.length + 1)
    (htraceG : trace Tid.guessBY = guessBYBlockWord I v0G kwsBY)
    (v0V : Fin I.n) (kwsVY : List (Fin 4 × Option (Fin I.n)))
    (hkwsVY : kwsVY.length = js.length + 1)
    (htraceV : trace Tid.checkY = checkYBlockWord I v0V kwsVY)
    {er : Event (domainOf I)} (her_tid : er.tid = Tid.checkY) (her_loc : er.loc = Loc.yB)
    (her : er ∈ traceEvents trace) (herop : er.op = .rd) :
    ∃ ew, traceRf I trace ew er := by
  have hmemT : er ∈ traceEventsOf trace Tid.checkY := mem_traceEvents_of_tid her her_tid
  have hmemOp : er ∈ rawOpEvents trace Tid.checkY Loc.yB OpType.rd := by
    unfold rawOpEvents
    exact List.mem_filter.mpr ⟨hmemT, by rw [her_loc, herop]; rfl⟩
  set i := (rawOpEvents trace Tid.checkY Loc.yB OpType.rd).idxOf er with hidef
  have hread : rawNthRead trace Tid.checkY Loc.yB i = some er := rawNthEvent_of_mem hmemOp
  have hilt_reader : i < (rawOpEvents trace Tid.checkY Loc.yB OpType.rd).length :=
    List.idxOf_lt_length_iff.mpr hmemOp
  have hlen := rawOpEvents_length_eq (D := domainOf I) (t := Tid.checkY)
    (x := Loc.yB) (op := OpType.rd) (predL := checkYYBReadPred I) htraceV
    (checkYYBReadPred_iff I)
  have hlen2 : ((checkYBlockWord I v0V kwsVY).filter (checkYYBReadPred I)).length
      = 1 + kwsVY.length := by
    unfold checkYBlockWord
    rw [List.filter_append, List.length_append, checkYBlock0Elems_yB_read_filter,
      checkYBlockRestElems_yB_read_filter, List.length_singleton]
  rw [hlen.trans hlen2] at hilt_reader
  have hlenW := rawOpEvents_length_eq (D := domainOf I) (t := Tid.guessBY)
    (x := Loc.yB) (op := OpType.wt) (predL := guessBYYBWritePred I) htraceG
    (guessBYYBWritePred_iff I)
  have hlenW2 : ((guessBYBlockWord I v0G kwsBY).filter (guessBYYBWritePred I)).length
      = 1 + kwsBY.length := by
    unfold guessBYBlockWord
    rw [List.filter_append, List.length_append, guessBYBlock0Elems_yB_filter,
      guessBYBlockRestElems_yB_filter, List.length_singleton]
  have hilt_writer : i < (rawOpEvents trace Tid.guessBY Loc.yB OpType.wt).length := by
    rw [hlenW.trans hlenW2]
    omega
  obtain ⟨ew, hew⟩ := rawNthEvent_exists_of_lt_length hilt_writer
  refine ⟨ew, ?_⟩
  unfold traceRf
  rw [her_tid, her_loc]
  exact ⟨i, hew, hread⟩

theorem traceRf_matches_checkY_guessBY_yB (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (v0G : Fin I.n) (kwsG : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I v0G kwsG)
    (v0V : Fin I.n) (kwsV : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I v0V kwsV)
    (hv0eq : v0V = v0G)
    (hkwsAgree : ∀ i, i < kwsG.length → ∃ kwG kwV, kwsG[i]? = some kwG ∧ kwsV[i]? = some kwV ∧
      kwV.2 = kwG.2)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.yB i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yB i = some er) :
    ew.val = er.val := by
  obtain ⟨i, hew, her⟩ := h
  rcases rawNthWrite_guessBY_yB_eq I v0G kwsG htraceGBY hew with
    ⟨hi0, hewval⟩ | ⟨kwG, hkwG, hipos, hewval⟩
  · subst hi0
    rcases rawNthRead_checkY_yB_eq I v0V kwsV htraceVY her with
      ⟨-, herval⟩ | ⟨kwV, hkwV, hipos', herval⟩
    · rw [hewval, herval, hv0eq]
    · omega
  · rcases rawNthRead_checkY_yB_eq I v0V kwsV htraceVY her with
      ⟨hi0, herval⟩ | ⟨kwV, hkwV, hipos', herval⟩
    · omega
    · have hglt : i - 1 < kwsG.length := (List.getElem?_eq_some_iff.mp hkwG).1
      obtain ⟨kwG', kwV', hkwG', hkwV', hkweq⟩ := hkwsAgree (i - 1) hglt
      rw [hkwG] at hkwG'
      injection hkwG' with hkwG'
      subst hkwG'
      rw [hkwV] at hkwV'
      injection hkwV' with hkwV'
      subst hkwV'
      rw [hewval, herval, hkweq]

/-- `traceRf_matches_checkY_guessBY_yB` for the general construction. -/
theorem traceRf_matches_checkY_guessBY_yB_general (I : PCPInstance)
    {trace : ∀ t, Word (ThreadLabel (domainOf I) t)}
    (j0 : Fin I.n) (js : List (Fin I.n))
    (kwsG : List (Fin 4 × Option (Fin I.n)))
    (htraceGBY : trace Tid.guessBY = guessBYBlockWord I j0 kwsG)
    (hlenG : kwsG.length = js.length + 1)
    (hvalG : ∀ i, i < kwsG.length → ∃ w, kwsG[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    (kwsV : List (Fin 4 × Option (Fin I.n)))
    (htraceVY : trace Tid.checkY = checkYBlockWord I j0 kwsV)
    (hlenV : kwsV.length = js.length + 1)
    (hvalV : ∀ i, i < kwsV.length → ∃ w, kwsV[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧
      w = js[i]?)
    {ew er : Event (domainOf I)}
    (h : ∃ i, rawNthWrite trace Tid.guessBY Loc.yB i = some ew ∧
      rawNthRead trace Tid.checkY Loc.yB i = some er) :
    ew.val = er.val := by
  have hkwsAgree : ∀ i, i < kwsG.length → ∃ kwG kwV, kwsG[i]? = some kwG ∧ kwsV[i]? = some kwV ∧
      kwV.2 = kwG.2 := by
    intro i hi
    obtain ⟨wG, hwG, hweqG⟩ := hvalG i hi
    have hiV : i < kwsV.length := by omega
    obtain ⟨wV, hwV, hweqV⟩ := hvalV i hiV
    refine ⟨(⟨(1 + i) % 4, by omega⟩, wG), (⟨(1 + i) % 4, by omega⟩, wV), hwG, hwV, ?_⟩
    simp [hweqG, hweqV]
  exact traceRf_matches_checkY_guessBY_yB I j0 kwsG htraceGBY j0 kwsV htraceVY rfl hkwsAgree h

/-- The total number of inner calls of `GuessBX` for tiles `js` is the length
of `(js.map I.β).flatten`. -/
theorem guessBXJsToKs_succ_sum_eq_flatten_length (I : PCPInstance) :
    ∀ js : List (Fin I.n), ((guessBXJsToKs I js).map (· + 1)).sum = (js.map I.β).flatten.length
  | [] => rfl
  | j0 :: js' => by
      have hne : I.β j0 ≠ [] := I.hβ j0
      have hpos : 0 < (I.β j0).length := List.length_pos_of_ne_nil hne
      have hcons : guessBXJsToKs I (j0 :: js') = ((I.β j0).length - 1) :: guessBXJsToKs I js' :=
        rfl
      have ih := guessBXJsToKs_succ_sum_eq_flatten_length I js'
      rw [hcons]
      simp only [List.map_cons, List.sum_cons, List.flatten_cons, List.length_append]
      omega

/-! ## Counts of reads and writes, for `rf_total`

`traceRf` pairs `w_i(t,x)` with `r_i(t',x)`, so for each branch the reader's
number of reads must not exceed the writer's number of writes. The two
pairs `guessAX`/`checkX` on `x_α` and `guessBX`/`checkX` on `x_β` have equal
counts. -/

/-- The `guessAX`/`checkX` pair: `guessAX` makes
`1 + inner0Rest.length + Σ (outerRest entries)` `x_α`-writes and `checkX` makes
`1 + kws.length` `x_α`-reads, and these agree for a common flattened `α`-word
`c0 :: cs`. Stated for any lists with the length facts of `guessAX_shape` and
`checkX_shape_val`. -/
theorem guessAX_checkX_rf_total (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (hinner0 : inner0Rest.length = (I.α j0).length - 1)
    (houterLen : outerRest.length = js.length + 1)
    (houter : ∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
      (guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1)
    (houterLast : ∃ b vs, outerRest[js.length]? = some (b, vs) ∧ vs.length = 1)
    (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1) :
    1 + inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum = 1 + kws.length := by
  have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil (I.hα j0)
  have hks_len : (guessAXJsToKs I js).length = js.length := by simp [guessAXJsToKs]
  have houterLen' : outerRest.length = (guessAXJsToKs I js).length + 1 := by
    rw [hks_len]; exact houterLen
  have houter' : ∀ m, m < (guessAXJsToKs I js).length → ∃ a vs km, outerRest[m]? = some (a, vs) ∧
      (guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1 := by
    rw [hks_len]; exact houter
  have houterLast' : ∃ a vs, outerRest[(guessAXJsToKs I js).length]? = some (a, vs) ∧
      vs.length = 1 := by
    rw [hks_len]; exact houterLast
  have hsum : (outerRest.map (fun p => p.2.length)).sum
      = ((guessAXJsToKs I js).map (· + 1)).sum + 1 :=
    sum_snd_length_of_forall_getElem outerRest (guessAXJsToKs I js) houterLen' houter' houterLast'
  have hflatlen : ((j0 :: js).map I.α).flatten.length = (c0 :: cs).length := by rw [hflat]
  have hflatlen' : (I.α j0).length + (js.map I.α).flatten.length = cs.length + 1 := by
    simpa [List.length_cons] using hflatlen
  rw [hinner0, hsum, guessAXJsToKs_succ_sum_eq_flatten_length]
  omega

/-- `GuessAX.jthLetter` at `aux = ⊥` is `none` (`extAlpha I none = [none]`). -/
theorem GuessAX_jthLetter_none (I : PCPInstance) (j : Fin (GuessAX.maxLen I + 2)) :
    GuessAX.jthLetter I none j = none := by
  unfold GuessAX.jthLetter GuessAX.extAlpha
  rcases Nat.eq_zero_or_pos (j.val - 1) with h0 | hpos
  · rw [h0]; rfl
  · rw [List.getElem?_eq_none (by simp; omega)]; rfl

/-- `GuessAX.jthLetter` at `aux = some w`, `j = n + 1`, is `(I.α w)[n]?`. -/
theorem GuessAX_jthLetter_some (I : PCPInstance) (w : Fin I.n)
    (j : Fin (GuessAX.maxLen I + 2)) (n : ℕ) (hj : j.val = n + 1) :
    GuessAX.jthLetter I (some w) j = (I.α w)[n]? := by
  unfold GuessAX.jthLetter GuessAX.extAlpha
  rw [hj]
  simp only [Nat.add_sub_cancel]
  rw [List.getElem?_map]
  exact Option_map_some_getD _

/-- The first letter of block 0: `(I.α j0)[0]?` is `c0`. -/
theorem hv1_position (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs) :
    (I.α j0)[0]? = some c0 := by
  have h1 : (I.α j0) ++ (js.map I.α).flatten = c0 :: cs := by simpa using hflat
  have hpos : 0 < (I.α j0).length := List.length_pos_of_ne_nil (I.hα j0)
  have hget := List.getElem?_append_left (l₁ := I.α j0) (l₂ := (js.map I.α).flatten) hpos
  rw [← hget, h1]
  rfl

/-- The other letters of block 0: `(I.α j0)[n+1]?` is `cs[n]?`, for `n < K0`. -/
theorem hinnerAgree_position (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs)
    (K0 : ℕ) (hlen0 : (I.α j0).length = K0 + 1) (n : ℕ) (hn : n < K0) :
    (I.α j0)[n + 1]? = cs[n]? := by
  have h1 : (I.α j0) ++ (js.map I.α).flatten = c0 :: cs := by simpa using hflat
  have hlt : n + 1 < (I.α j0).length := by omega
  have hget := List.getElem?_append_left (l₁ := I.α j0) (l₂ := (js.map I.α).flatten) hlt
  rw [← hget, h1]
  rfl

/-- `ksPrefix (guessAXJsToKs I js) m` is the length of the flattened
`α`-words of the first `m` tiles. -/
theorem ksPrefix_guessAXJsToKs_eq_flatten_length (I : PCPInstance) (js : List (Fin I.n))
    (m : ℕ) (hm : m ≤ js.length) :
    ksPrefix (guessAXJsToKs I js) m = ((js.take m).map I.α).flatten.length := by
  have hlen : (guessAXJsToKs I js).length = js.length := by unfold guessAXJsToKs; simp
  rw [ksPrefix_eq_sum_take m (by rw [hlen]; exact hm)]
  unfold guessAXJsToKs
  rw [← List.map_take, flatten_map_length, List.map_map]
  congr 1
  apply List.map_congr_left
  intro idx hidx
  have hpos : 0 < (I.α idx).length := List.length_pos_of_ne_nil (I.hα idx)
  simp only [Function.comp]
  omega

/-- The letters of block `m < js.length`: `(I.α js[m])[n]?` is
`cs[K0 + ksPrefix (guessAXJsToKs I js) m + n]?`. -/
theorem houterAgree_position (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ)
    (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs)
    (K0 : ℕ) (hlen0 : (I.α j0).length = K0 + 1)
    (m : ℕ) (hm : m < js.length) (n : ℕ) (hn : n < (I.α js[m]).length) :
    (I.α js[m])[n]? = cs[K0 + ksPrefix (guessAXJsToKs I js) m + n]? := by
  have h1 : (I.α j0) ++ (js.map I.α).flatten = c0 :: cs := by simpa using hflat
  have hksP := ksPrefix_guessAXJsToKs_eq_flatten_length I js m (by omega)
  set w := js[m] with hw
  set A := (js.take m).map I.α |>.flatten with hA
  set B := (js.drop (m + 1)).map I.α |>.flatten with hB
  have hsplit : (js.map I.α).flatten = A ++ (I.α w ++ B) := by
    have h2 : js.map I.α = (js.take m).map I.α ++ (js.drop m).map I.α := by
      rw [← List.map_append, List.take_append_drop]
    have h3 : js.drop m = w :: js.drop (m + 1) := by
      rw [hw, ← List.getElem_cons_drop hm]
    rw [h2, h3]
    simp [List.flatten_append, List.flatten_cons, hA, hB]
  have hAlen : A.length = ksPrefix (guessAXJsToKs I js) m := hksP.symm
  have hbig : (I.α j0 ++ (js.map I.α).flatten)[(K0 + ksPrefix (guessAXJsToKs I js) m + n) + 1]?
      = (I.α w)[n]? := by
    rw [List.getElem?_append_right (by rw [hlen0]; omega)]
    rw [hlen0]
    have heq : K0 + ksPrefix (guessAXJsToKs I js) m + n + 1 - (K0 + 1)
        = ksPrefix (guessAXJsToKs I js) m + n := by omega
    rw [heq, hsplit, List.getElem?_append_right (by omega), hAlen]
    simp only [Nat.add_sub_cancel_left]
    exact List.getElem?_append_left hn
  rw [h1] at hbig
  simpa using hbig.symm

/-- The terminating write of `guessAX` (`m = js.length`) is at a flattened
index `≥ cs.length`, where the letter is `none`. -/
theorem houterAgree_last_index (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs)
    (K0 : ℕ) (hlen0 : (I.α j0).length = K0 + 1) :
    K0 + ksPrefix (guessAXJsToKs I js) js.length ≥ cs.length := by
  have hksP := ksPrefix_guessAXJsToKs_eq_flatten_length I js js.length (le_refl _)
  rw [List.take_length] at hksP
  have h1 : (I.α j0) ++ (js.map I.α).flatten = c0 :: cs := by simpa using hflat
  have hlen1 : (I.α j0).length + (js.map I.α).flatten.length = cs.length + 1 := by
    have := congrArg List.length h1
    simpa using this
  omega

/-- The `guessAX`/`checkX` `xA` pair's letter agreement: the hypotheses
`hv0eq`/`hv1eq`/`hinnerAgree`/`houterAgree`/`hkwsAgree` of
`traceRf_matches_checkX_guessAX_xA`, from a common solution `j0`/`js`/`c0`/`cs`
and the value conjuncts of `guessAX_general_run` and `checkX_general_run_val`. -/
theorem guessAX_checkX_rf_matches (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.α).flatten = c0 :: cs)
    (K0 : ℕ) (hlen0 : (I.α j0).length = K0 + 1)
    (v1 : Val I) (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (hlen1 : inner0Rest.length = K0)
    (houterLenFacts : ∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
      (guessAXJsToKs I js)[m]? = some km ∧ vs.length = km + 1)
    (hv1raw : ∃ j : Fin (GuessAX.maxLen I + 2), j.val = 1 ∧
      v1 = Val.xTag (Tid.guessAX, true) (GuessAX.jthLetter I (some j0) j))
    (hinnerraw : ∀ n, n < inner0Rest.length → ∃ e j, inner0Rest[n]? = some e ∧ j.val = n + 2 ∧
      e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some j0) j))
    (houterraw : ∀ m, m < js.length + 1 → ∃ b vs, outerRest[m]? = some (b, vs) ∧
      (m < js.length → ∃ w, js[m]? = some w ∧
        ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
          e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I (some w) j)) ∧
      (m = js.length → ∀ n, n < vs.length → ∃ e j, vs[n]? = some e ∧ j.val = n + 1 ∧
        e.1 = Val.xTag (Tid.guessAX, false) (GuessAX.jthLetter I none j)))
    (v0 : I.Γ) (hv0 : v0 = c0)
    (kws : List (Fin 4 × Option I.Γ))
    (hkwsraw : ∀ i, i < kws.length →
      ∃ w, kws[i]? = some (⟨(1 + i) % 4, by omega⟩, w) ∧ w = cs[i]?) :
    v0 = c0 ∧ v1 = Val.xTag (Tid.guessAX, true) (some c0) ∧
    (∀ n, n < inner0Rest.length → ∃ e, inner0Rest[n]? = some e ∧
      ∃ c, cs[n]? = some c ∧ e.1 = Val.xTag (Tid.guessAX, false) (some c)) ∧
    (∀ m, m < js.length + 1 → ∀ b vs, outerRest[m]? = some (b, vs) →
      ∀ n e, n < vs.length → vs[n]? = some e →
      e.1 = Val.xTag (Tid.guessAX, false) (cs[K0 + ksPrefix (guessAXJsToKs I js) m + n]?)) ∧
    (∀ i, i < kws.length → ∃ kw, kws[i]? = some kw ∧ kw.2 = cs[i]?) := by
  refine ⟨hv0, ?_, ?_, ?_, ?_⟩
  · obtain ⟨j, hj, hveq⟩ := hv1raw
    have hjeq0 : j.val = 0 + 1 := by omega
    rw [hveq, GuessAX_jthLetter_some I j0 j 0 hjeq0, hv1_position I j0 js c0 cs hflat]
  · intro n hn
    obtain ⟨e, j, he, hj, hev⟩ := hinnerraw n hn
    have hn' : n < K0 := by omega
    have hn1 : n + 1 < (I.α j0).length := by omega
    have hcs : cs[n]? = some (I.α j0)[n + 1] := by
      rw [← hinnerAgree_position I j0 js c0 cs hflat K0 hlen0 n hn']
      exact List.getElem?_eq_getElem hn1
    refine ⟨e, he, (I.α j0)[n + 1], hcs, ?_⟩
    rw [hev]
    have hjeq : j.val = (n + 1) + 1 := by omega
    rw [GuessAX_jthLetter_some I j0 j (n + 1) hjeq, List.getElem?_eq_getElem hn1]
  · intro m hm b vs hbv n e hnlt hvsn
    obtain ⟨b', vs', hbv', hcase⟩ := houterraw m hm
    have heq1 : some (b, vs) = some (b', vs') := hbv.symm.trans hbv'
    simp only [Option.some.injEq, Prod.mk.injEq] at heq1
    obtain ⟨hbeq, hvseq⟩ := heq1
    subst hbeq; subst hvseq
    rcases Nat.lt_or_ge m js.length with hmlt | hmge
    · obtain ⟨w, hw, hval⟩ := hcase.1 hmlt
      obtain ⟨e', j, hvsn', hj, hev⟩ := hval n hnlt
      have heq2 : some e = some e' := hvsn.symm.trans hvsn'
      injection heq2 with heq2
      subst heq2
      rw [hev]
      have hwjs : js[m]? = some js[m] := List.getElem?_eq_getElem hmlt
      have heq3 : some w = some js[m] := hw.symm.trans hwjs
      injection heq3 with heq3
      subst heq3
      obtain ⟨b'', vs'', km, hbv'', hkm, hvslen⟩ := houterLenFacts m hmlt
      have heq4 : some (b, vs) = some (b'', vs'') := hbv.symm.trans hbv''
      simp only [Option.some.injEq, Prod.mk.injEq] at heq4
      obtain ⟨_, hvseq2⟩ := heq4
      have hkmeq : (guessAXJsToKs I js)[m]? = some ((I.α js[m]).length - 1) := by
        unfold guessAXJsToKs
        rw [List.getElem?_map, hwjs]
        rfl
      rw [hkmeq] at hkm
      injection hkm with hkm
      have hpos : 0 < (I.α js[m]).length := List.length_pos_of_ne_nil (I.hα js[m])
      have hnlen : n < (I.α js[m]).length := by
        rw [hvseq2] at hnlt
        omega
      have hjeq : j.val = n + 1 := hj
      rw [GuessAX_jthLetter_some I js[m] j n hjeq,
        houterAgree_position I j0 js c0 cs hflat K0 hlen0 m hmlt n hnlen]
    · have hmeq : m = js.length := by omega
      obtain ⟨e', j, hvsn', hj, hev⟩ := hcase.2 hmeq n hnlt
      have heq2 : some e = some e' := hvsn.symm.trans hvsn'
      injection heq2 with heq2
      subst heq2
      rw [hev, GuessAX_jthLetter_none]
      have hge := houterAgree_last_index I j0 js c0 cs hflat K0 hlen0
      rw [hmeq]
      have hge2 : K0 + ksPrefix (guessAXJsToKs I js) js.length + n ≥ cs.length := by omega
      rw [List.getElem?_eq_none hge2]
  · intro i hi
    obtain ⟨w, hw, hweq⟩ := hkwsraw i hi
    exact ⟨(⟨(1 + i) % 4, by omega⟩, w), hw, hweq⟩

/-- The `guessBX`/`checkX` pair (as `guessAX_checkX_rf_total`, with `I.β` and
the same `c0 :: cs`, since `I.IsSolution` makes the flattened words equal). -/
theorem guessBX_checkX_rf_total (I : PCPInstance) (j0 : Fin I.n) (js : List (Fin I.n))
    (c0 : I.Γ) (cs : List I.Γ) (hflat : ((j0 :: js).map I.β).flatten = c0 :: cs)
    (inner0Rest : List (Val I × Val I × Val I))
    (outerRest : List ((Val I × Val I) × List (Val I × Val I × Val I)))
    (hinner0 : inner0Rest.length = (I.β j0).length - 1)
    (houterLen : outerRest.length = js.length + 1)
    (houter : ∀ m, m < js.length → ∃ b vs km, outerRest[m]? = some (b, vs) ∧
      (guessBXJsToKs I js)[m]? = some km ∧ vs.length = km + 1)
    (houterLast : ∃ b vs, outerRest[js.length]? = some (b, vs) ∧ vs.length = 1)
    (kws : List (Fin 4 × Option I.Γ)) (hkws : kws.length = cs.length + 1) :
    1 + inner0Rest.length + (outerRest.map (fun p => p.2.length)).sum = 1 + kws.length := by
  have hpos : 0 < (I.β j0).length := List.length_pos_of_ne_nil (I.hβ j0)
  have hks_len : (guessBXJsToKs I js).length = js.length := by simp [guessBXJsToKs]
  have houterLen' : outerRest.length = (guessBXJsToKs I js).length + 1 := by
    rw [hks_len]; exact houterLen
  have houter' : ∀ m, m < (guessBXJsToKs I js).length → ∃ a vs km, outerRest[m]? = some (a, vs) ∧
      (guessBXJsToKs I js)[m]? = some km ∧ vs.length = km + 1 := by
    rw [hks_len]; exact houter
  have houterLast' : ∃ a vs, outerRest[(guessBXJsToKs I js).length]? = some (a, vs) ∧
      vs.length = 1 := by
    rw [hks_len]; exact houterLast
  have hsum : (outerRest.map (fun p => p.2.length)).sum
      = ((guessBXJsToKs I js).map (· + 1)).sum + 1 :=
    sum_snd_length_of_forall_getElem outerRest (guessBXJsToKs I js) houterLen' houter' houterLast'
  have hflatlen : ((j0 :: js).map I.β).flatten.length = (c0 :: cs).length := by rw [hflat]
  have hflatlen' : (I.β j0).length + (js.map I.β).flatten.length = cs.length + 1 := by
    simpa [List.length_cons] using hflatlen
  rw [hinner0, hsum, guessBXJsToKs_succ_sum_eq_flatten_length]
  omega

/-- `GuessBX.jthLetter` at `aux = ⊥` is `none`. -/
theorem GuessBX_jthLetter_none (I : PCPInstance) (j : Fin (GuessBX.maxLen I + 2)) :
    GuessBX.jthLetter I none j = none := by
  unfold GuessBX.jthLetter GuessBX.extBeta
  rcases Nat.eq_zero_or_pos (j.val - 1) with h0 | hpos
  · rw [h0]; rfl
  · rw [List.getElem?_eq_none (by simp; omega)]; rfl

