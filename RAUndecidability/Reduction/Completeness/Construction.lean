As for `xA`, with `xB` at offset `1` of `checkX`'s blocks and offset `5` of
`primeCheckX`'s. -/

def xBWritePredCore (loc : Loc) (op : OpType) : Bool :=
  match loc, op with | Loc.xB, OpType.wt => true | _, _ => false

theorem xBWritePredCore_iff (y : Loc) (z : OpType) :
    xBWritePredCore y z = true ↔ (y = Loc.xB ∧ z = OpType.wt) := by
  cases y <;> cases z <;> decide

theorem xBWritePredCore_false_of_ne (y : Loc) (z : OpType) (hne : ¬ (y = Loc.xB ∧ z = OpType.wt)) :
    xBWritePredCore y z = false := by
  cases y <;> cases z <;> first | rfl | (exfalso; exact hne ⟨rfl, rfl⟩)

/-- `xB` is not a bridge location. -/
theorem xBWritePredCore_bridge : ∀ y : Loc, ∀ z : OpType, y ∈ BridgeLoc →
    xBWritePredCore y z = false := by
  intro y z hb0
  cases y <;> cases z <;> revert hb0 <;> decide

/-- `checkX`'s `xB`-write predicate, lifted from `xBWritePredCore`. -/
def checkXXBWritePred (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) : Bool :=
  xBWritePredCore lab.1.loc lab.1.op

theorem checkXXBWritePred_iff (I : PCPInstance) (lab : ThreadLabel (domainOf I) Tid.checkX) :
    checkXXBWritePred I lab = true ↔ (lab.1.loc = Loc.xB ∧ lab.1.op = OpType.wt) := by
  unfold checkXXBWritePred
  obtain ⟨y, hy⟩ : ∃ y : Loc, lab.1.loc = y := ⟨lab.1.loc, rfl⟩
  obtain ⟨z, hz⟩ : ∃ z : OpType, lab.1.op = z := ⟨lab.1.op, rfl⟩
  rw [hy, hz]
  exact xBWritePredCore_iff y z

