  induction kws with
  | nil => rfl
  | cons kw kws ih =>
      show (((guessAYBlockRestElems I kw) ++ kws.flatMap (guessAYBlockRestElems I)).filter
        (guessAYEllAWritePred I)).length = (kw :: kws).length
      rw [List.filter_append, List.length_append, ih]
      have hbl : (guessAYBlockRestElems I kw).filter (guessAYEllAWritePred I) =
          [(⟨EventLabel.wt Tid.guessAY Loc.ellAyx (Val.cntAux (kw.1 + 1) kw.2), rfl⟩ :
