theorem guessBYBlock0Elems_zBy'y_zipIdx_filter (I : PCPInstance) (v0 : Fin I.n) (k : ℕ) :
    (((guessBYBlock0Elems I v0).zipIdx k).filter (fun p => guessBYZByprimeWritePred I p.1)) =
      [((⟨EventLabel.wt Tid.guessBY Loc.zBy'y (Val.cnt 1), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), k + 2)] := by
