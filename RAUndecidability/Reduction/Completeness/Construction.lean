      kws 3 j kw hkw
    have hzipj :
        ((guessBYBlockWord I v0 kws).zipIdx.filter (fun p => guessBYYBWritePred I p.1))[i]?
        = some ((⟨EventLabel.wt Tid.guessBY Loc.yB (Val.yTag (Tid.guessBY, false) kw.2), rfl⟩ :
          ThreadLabel (domainOf I) Tid.guessBY), 3 + j * 5 + 0) := by
      rw [hzip, hij]
      simp only [List.singleton_append, List.getElem?_cons_succ]
